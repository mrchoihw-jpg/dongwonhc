  {key:'expRate', label:'품절예상율', pct:true, bar:'amber', group:'품절예상 현황'},
  {key:'expOrdered', label:'발주수', num:true, group:'품절예상 현황'},
  {key:'expOrderRate', label:'발주율', pct:true, group:'품절예상 현황'},
];

// map raw row arrays (from openpyxl export) -> keyed objects matching headers above
function mokrokRowToObj(row){
  return {
    code: row[0], client: row[1], itemCount: row[2], stockout: row[3], noOrder: row[4],
    expected: row[5], noOrder2: row[6], totalNoOrder: row[7], lastOrderDate: row[8],
    region: row[9], managerPrev: row[10], manager: row[11], paymentBasis: row[12],
    turn: row[13], status: row[14]
  };
}
const ORIGINAL_LIST = MOKROK_RAW.rows.map(mokrokRowToObj);

let listData = [];
let mgrData = [];
let sortState = { list: {key:null, dir:1}, mgr: {key:null, dir:1}, stock: {key:null, dir:1} };

const STORAGE_KEY = 'stockout_dashboard_edits_v1';

// ---------- storage ----------
// 공유 저장소(shared=true)를 사용합니다 — 즉 누군가 저장을 누르면 이 대시보드를 보는 모든 사람에게 그 데이터가 보입니다.
async function loadEdits(){
  try{
    const res = await window.storage.get(STORAGE_KEY, true);
    if(res && res.value) return JSON.parse(res.value);
  }catch(e){ /* no saved edits yet */ }
  return null;
}
let saveTimer = null;
let lastSavedAt = null;
function formatSavedTime(iso){
  if(!iso) return '';
  return new Date(iso).toLocaleString('ko-KR', { year:'numeric', month:'numeric', day:'numeric', hour:'2-digit', minute:'2-digit', second:'2-digit' });
}
function updateGlobalSavedLabel(){
  const el = document.getElementById('lastSavedGlobal');
  if(!el) return;
  if(!lastSavedAt){ el.textContent = '아직 저장 이력 없음'; el.classList.remove('fresh'); return; }
  el.textContent = `마지막 저장 ${formatSavedTime(lastSavedAt)}`;
  el.classList.add('fresh');
}
async function saveNow(){
  setIndicator('saving');
  try{
    const now = new Date().toISOString();
    const payload = JSON.stringify({ list: listData, mgr: mgrData, savedAt: now });
    await storageSetWithRetry(STORAGE_KEY, payload, true);
    lastSavedAt = now; updateGlobalSavedLabel();
    setIndicator('saved');
    return true;
  }catch(e){ setIndicator('error'); return false; }
}
function scheduleSave(){
  setIndicator('saving');
  clearTimeout(saveTimer);
  saveTimer = setTimeout(saveNow, 400);
}
function setIndicator(state){
  const els = [
    [document.querySelector('#saveIndicator .save-dot'), document.querySelector('#saveIndicator span:last-child')],
    [document.querySelector('#saveIndicator2 .save-dot'), document.querySelector('#saveIndicator2 span:last-child')],
  ];
  els.forEach(([dot, label])=>{
    if(!dot) return;
    dot.classList.remove('saved','saving');
    if(state==='saving'){ dot.classList.add('saving'); label.textContent='저장 중...'; }
    else if(state==='saved'){ dot.classList.add('saved'); label.textContent='저장됨 · ' + formatSavedTime(lastSavedAt); }
    else if(state==='error'){ label.textContent='저장 실패'; }
    else { label.textContent='대기 중'; }
  });
}

// ---------- init ----------
async function init(){
  initStorageBanner();
  const saved = await loadEdits();
  if(saved && saved.list && saved.list.length){
    listData = saved.list;
    if(saved.savedAt) lastSavedAt = saved.savedAt;
    setIndicator('saved');
  } else {
    listData = JSON.parse(JSON.stringify(ORIGINAL_LIST));
  }
  // 담당자별 현황은 목록의 발주담당자 값으로부터 항상 다시 계산해서
  // 지정된 8명 외 담당자는 자동으로 '기타'로 묶고 이름순으로 정렬합니다.
  recomputeManagerSummary();
  updateGlobalSavedLabel();
  document.getElementById('dataDate').textContent = (DAMDANGJA_RAW.title || '').match(/\d{4}-\d{2}-\d{2}/)?.[0] || '2026-07-22';

  buildFilterOptions();
  renderKpis();
  renderListTable();
  renderMgrTable();
  bindGlobalEvents();
}

function buildFilterOptions(){
  const managers = [...new Set(listData.map(r=>r.manager).filter(Boolean))].sort();
  const payments = [...new Set(listData.map(r=>r.paymentBasis).filter(v=>v && v!==0))].sort();
  const mSel = document.getElementById('managerFilter');
  const prevManager = mSel.value;
  mSel.querySelectorAll('option:not(:first-child)').forEach(o=>o.remove());
  managers.forEach(m=>{ const o=document.createElement('option'); o.value=m; o.textContent=m; mSel.appendChild(o); });
  if(managers.includes(prevManager)) mSel.value = prevManager;
  const pSel = document.getElementById('paymentFilter');
  const prevPayment = pSel.value;
  pSel.querySelectorAll('option:not(:first-child)').forEach(o=>o.remove());
  payments.forEach(p=>{ const o=document.createElement('option'); o.value=p; o.textContent=p; pSel.appendChild(o); });
  if(payments.includes(prevPayment)) pSel.value = prevPayment;

  // 최종발주일 필터: 값 정렬 후 "누락"만 맨 위로 끌어올립니다.
  const lastOrderDates = [...new Set(listData.map(r=>r.lastOrderDate).filter(v=>v && v!==0))].sort((a,b)=>String(a).localeCompare(String(b)));
  const missingIdx = lastOrderDates.indexOf('누락');
  if(missingIdx > -1){ lastOrderDates.splice(missingIdx, 1); lastOrderDates.unshift('누락'); }
  const lodSel = document.getElementById('lastOrderDateFilter');
  const prevLastOrderDate = lodSel.value;
  lodSel.querySelectorAll('option:not(:first-child)').forEach(o=>o.remove());
  lastOrderDates.forEach(d=>{ const o=document.createElement('option'); o.value=d; o.textContent=d; lodSel.appendChild(o); });
  if(lastOrderDates.includes(prevLastOrderDate)) lodSel.value = prevLastOrderDate;
}

// ---------- KPI ----------
function renderKpis(){
  const soSum = listData.reduce((a,r)=>a+(Number(r.stockout)||0),0);
  const soNoOrderSum = listData.reduce((a,r)=>a+(Number(r.noOrder)||0),0);
  const soOrderedSum = soSum - soNoOrderSum;

  const expSum = listData.reduce((a,r)=>a+(Number(r.expected)||0),0);
  const expNoOrderSum = listData.reduce((a,r)=>a+(Number(r.noOrder2)||0),0);
  const expOrderedSum = expSum - expNoOrderSum;

  const soRate = soSum ? (soOrderedSum/soSum*100) : 0;
  const expRate = expSum ? (expOrderedSum/expSum*100) : 0;

  const kpis = [
    {label:'전체 품절', val: soSum.toLocaleString(), cls:'red', icon:'🔴'},
    {label:'품절예상', val: expSum.toLocaleString(), cls:'amber', icon:'🟡'},
    {label:'품절 발주수량', val: soOrderedSum.toLocaleString(), cls:'red', icon:'📮'},
    {label:'품절예상 발주수량', val: expOrderedSum.toLocaleString(), cls:'amber', icon:'📮'},
    {label:'품절발주율', val: soRate.toFixed(1)+'%', cls:'red rate', icon:'📊'},
    {label:'품절예상발주율', val: expRate.toFixed(1)+'%', cls:'amber rate', icon:'📊'},
  ];
  document.getElementById('kpiRow').innerHTML = kpis.map(k=>`
    <div class="kpi ${k.cls}">
      <div class="icon">${k.icon}</div>
      <div class="label">${k.label}</div>
      <div class="val">${k.val}</div>
    </div>`).join('');
}

function escapeAttr(s){
  return String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;');
}
// 업로드한 엑셀/CSV 원본 값처럼, 우리가 직접 만든 게 아닌 외부 데이터를 화면(innerHTML)에 그대로
// 표시할 때 씁니다. <script>나 <img onerror=...> 같은 태그가 문자 그대로 보이게만 하고 실행되지
//않도록 막아줘요. (표에 보이는 값만 바뀌고, 실제 수정 로직은 td.textContent를 읽기 때문에
// 여기서 이스케이프해도 값 자체는 그대로 정확히 저장됩니다.)
function escapeHtml(v){
  if(v === null || v === undefined) return '';
  return String(v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}
function buildClientTip(r){
  const n = v => (v===null||v===undefined) ? null : Number(v).toLocaleString();
  const lines = [
    `담당자: ${r.manager || '-'}`,
    `배송지: ${r.region || '-'}`,
    `결제기준일: ${r.paymentBasis || '-'} · 회전: ${r.turn || '-'}`,
    `최종발주일: ${r.lastOrderDate || '-'}`,
    `취급품목수: ${n(r.itemCount) ?? '-'}`,
    `품절 ${n(r.stockout) ?? 0} (미발주 ${n(r.noOrder) ?? 0}) · 품절예상 ${n(r.expected) ?? 0} (미발주 ${n(r.noOrder2) ?? 0})`,
    `상태: ${r.status || '-'}`,
  ];
  return escapeAttr(lines.join('\n'));
}

function sortArrow(tableKey, colKey){
  const s = sortState[tableKey];
  if(s.key !== colKey) return '';
  return `<span class="arrow">${s.dir===1?'▲':'▼'}</span>`;
}

// ---------- list table ----------
function renderListTable(){
  const head = document.getElementById('listHead');
  head.innerHTML = LIST_HEADERS.map(h=>{
    let arrow = '';
    if(sortState.list.key === h.key) arrow = `<span class="arrow">${sortState.list.dir===1?'▲':'▼'}</span>`;
    return `<th data-key="${h.key}">${h.label}${arrow}</th>`;
  }).join('');
  head.querySelectorAll('th').forEach(th=>{
    th.addEventListener('click', ()=>{
      const key = th.dataset.key;
      if(sortState.list.key === key) sortState.list.dir *= -1;
      else { sortState.list.key = key; sortState.list.dir = 1; }
      renderListTable();
    });
  });

  const q = document.getElementById('searchInput').value.trim().toLowerCase();
  const mgrF = document.getElementById('managerFilter').value;
  const stF = document.getElementById('statusFilter').value;
  const payF = document.getElementById('paymentFilter').value;
  const lodF = document.getElementById('lastOrderDateFilter').value;
  const msF = document.getElementById('monthStartFilter').value;

  let rows = listData.map((r, idx)=>({r, idx})).filter(({r})=>{
    if(q && !(String(r.code).toLowerCase().includes(q) || String(r.client||'').toLowerCase().includes(q))) return false;
    if(mgrF && r.manager !== mgrF) return false;
    if(stF && r.status !== stF) return false;
    if(payF && r.paymentBasis !== payF) return false;
    if(lodF && r.lastOrderDate !== lodF) return false;
    if(msF === '누락'){ if(r.monthStart) return false; }
    else if(msF && (r.monthStart||'') !== msF) return false;
    return true;
  });

  if(sortState.list.key){
    const k = sortState.list.key, d = sortState.list.dir;
    rows.sort((a,b)=>{
      let av = a.r[k], bv = b.r[k];
      if(typeof av === 'number' && typeof bv === 'number') return (av-bv)*d;
      av = String(av ?? ''); bv = String(bv ?? '');
      return av.localeCompare(bv, 'ko') * d;
    });
  }

  document.getElementById('listCount').textContent = `${rows.length.toLocaleString()} / ${listData.length.toLocaleString()}건`;

  const body = document.getElementById('listBody');
  body.innerHTML = rows.map(({r, idx})=>{
    return '<tr data-idx="'+idx+'">' + LIST_HEADERS.map(h=>{
      if(h.isStatus){
        const v = r.status || '';
        return `<td>
          <select class="status-select" data-idx="${idx}" data-key="status">
            <option value="품절" ${v==='품절'?'selected':''}>품절</option>
            <option value="품절없음" ${v==='품절없음'?'selected':''}>품절없음</option>
          </select>
        </td>`;
      }
      if(h.isMonthStart){
        const v = r.monthStart || '';
        return `<td>
          <select class="monthstart-select" data-idx="${idx}" data-key="monthStart">
            <option value="" ${v===''?'selected':''}>-</option>
            <option value="준비" ${v==='준비'?'selected':''}>준비</option>
            <option value="완료" ${v==='완료'?'selected':''}>완료</option>
          </select>
        </td>`;
      }
      if(h.key === 'client'){
        const tip = buildClientTip(r);
        const val = r.client ?? '';
        return `<td class="editable" contenteditable="true" data-idx="${idx}" data-key="client"><span class="client-tip" data-tip="${tip}">${escapeHtml(val)}</span></td>`;
      }
      const val = r[h.key];
      const display = (val===null || val===undefined || val==='') ? '' : (h.num && typeof val==='number' ? val.toLocaleString() : val);
      const cls = (h.num ? 'num ' : '') + (h.editable ? 'editable' : '');
      const editAttr = h.editable ? `contenteditable="true" data-idx="${idx}" data-key="${h.key}"` : '';
      return `<td class="${cls}" ${editAttr}>${display}</td>`;
    }).join('') + '</tr>';
  }).join('');

  body.querySelectorAll('td[contenteditable]').forEach(td=>{
    td.addEventListener('blur', onListCellEdit);
    td.addEventListener('keydown', (e)=>{ if(e.key==='Enter'){ e.preventDefault(); td.blur(); } });
  });
  body.querySelectorAll('select.status-select').forEach(sel=>{
    sel.addEventListener('change', ()=>{
      const idx = Number(sel.dataset.idx);
      listData[idx].status = sel.value;
      renderKpis();
      scheduleSave();
    });
  });
  body.querySelectorAll('select.monthstart-select').forEach(sel=>{
    sel.addEventListener('change', ()=>{
      const idx = Number(sel.dataset.idx);
      listData[idx].monthStart = sel.value;
      scheduleSave();
    });
  });
}

function onListCellEdit(e){
  const td = e.target;
  const idx = Number(td.dataset.idx);
  const key = td.dataset.key;
  const headerDef = LIST_HEADERS.find(h=>h.key===key);
  let val = td.textContent.trim();
  if(headerDef && headerDef.num){
    const n = Number(val.replace(/,/g,''));
    val = isNaN(n) ? 0 : n;
  }
  const changed = listData[idx][key] !== val;
  listData[idx][key] = val;
  if(changed){
    td.classList.add('edited');
    renderKpis();
    scheduleSave();
  }
}

// ---------- manager table ----------
function renderMgrTable(){
  const head = document.getElementById('mgrHead');
  // build group row: consecutive headers sharing the same `group` get colspan'd together;
  // ungrouped headers (담당자/취급품목수/거래처수) span both header rows via rowspan.
  const groupRowCells = [];
  const subRowCells = [];
  let i = 0;
  while(i < MGR_HEADERS.length){
    const h = MGR_HEADERS[i];
    if(!h.group){
      groupRowCells.push(`<th rowspan="2" data-key="${h.key}">${h.label}${sortArrow('mgr', h.key)}</th>`);
      i++;
    } else {
      let span = 0;
      const groupName = h.group;
      while(i+span < MGR_HEADERS.length && MGR_HEADERS[i+span].group === groupName) span++;
      const cls = groupName.includes('예상') ? 'grp-amber' : 'grp-red';
      groupRowCells.push(`<th colspan="${span}" class="grp-head ${cls}">${groupName}</th>`);
      for(let j=i; j<i+span; j++){
        const gh = MGR_HEADERS[j];
        subRowCells.push(`<th data-key="${gh.key}" class="${cls}">${gh.label}${sortArrow('mgr', gh.key)}</th>`);
      }
      i += span;
    }
  }
  head.innerHTML = `<tr>${groupRowCells.join('')}</tr><tr>${subRowCells.join('')}</tr>`;
  head.querySelectorAll('th[data-key]').forEach(th=>{
    th.addEventListener('click', ()=>{
      const key = th.dataset.key;
      if(sortState.mgr.key === key) sortState.mgr.dir *= -1;
      else { sortState.mgr.key = key; sortState.mgr.dir = 1; }
      renderMgrTable();
    });
  });


  let rows = mgrData.map((r, idx)=>({r, idx}));
  if(sortState.mgr.key){
    const k = sortState.mgr.key, d = sortState.mgr.dir;
    rows.sort((a,b)=>{
      let av = a.r[k], bv = b.r[k];
      if(typeof av === 'number' && typeof bv === 'number') return (av-bv)*d;
      av = String(av ?? ''); bv = String(bv ?? '');
      return av.localeCompare(bv, 'ko') * d;
    });
  }

  const body = document.getElementById('mgrBody');
  body.innerHTML = rows.map(({r, idx})=>{
    const isTotal = r.manager === '전체';
    return `<tr class="${isTotal?'total-row':''}" data-idx="${idx}">` + MGR_HEADERS.map(h=>{
      const val = r[h.key];
      const groupCls = h.group ? (h.group.includes('예상') ? 'grp-amber' : 'grp-red') : '';
      if(h.key==='manager'){
        const name = String(val ?? '');
        if(isTotal) return `<td>${name}</td>`;
        return `<td>${name}</td>`;
      }
      if(h.pct){
        const pctVal = (Number(val)||0)*100;
        if(h.bar){
          return `<td class="${groupCls}"><div class="bar-cell">
            <div class="bar-track"><div class="bar-fill ${h.bar}" style="width:${Math.min(pctVal,100)}%"></div></div>
            <span class="bar-num">${pctVal.toFixed(1)}%</span>
          </div></td>`;
        }
        return `<td class="num editable ${groupCls}" contenteditable="true" data-idx="${idx}" data-key="${h.key}" data-pct="1">${val===null||val===undefined?'':pctVal.toFixed(1)+'%'}</td>`;
      }
      const cls = 'num' + (isTotal? '' : ' editable') + (groupCls ? ' '+groupCls : '');
      const editAttr = isTotal ? '' : `contenteditable="true" data-idx="${idx}" data-key="${h.key}"`;
      const display = (val===null||val===undefined) ? '' : (typeof val==='number' ? val.toLocaleString() : val);
      return `<td class="${cls}" ${editAttr}>${display}</td>`;
    }).join('') + '</tr>';
  }).join('');

  body.querySelectorAll('td[contenteditable]').forEach(td=>{
    td.addEventListener('blur', onMgrCellEdit);
    td.addEventListener('keydown', (e)=>{ if(e.key==='Enter'){ e.preventDefault(); td.blur(); } });
  });
}

function onMgrCellEdit(e){
  const td = e.target;
  const idx = Number(td.dataset.idx);
  const key = td.dataset.key;
  let raw = td.textContent.trim().replace('%','');
  let n = Number(raw.replace(/,/g,''));
  if(isNaN(n)) n = 0;
  if(td.dataset.pct) n = n/100;
  mgrData[idx][key] = n;
  td.classList.add('edited');
  scheduleSave();
}

// ---------- global events ----------
function bindGlobalEvents(){
  document.querySelectorAll('.tab').forEach(tab=>{
    tab.addEventListener('click', ()=>{
      document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
      document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
      tab.classList.add('active');
      const activePanel = document.getElementById('panel-' + tab.dataset.tab);
      activePanel.classList.add('active');
      if(tab.dataset.tab === 'checklist') renderChecklist();
      if(tab.dataset.tab === 'pricehistory') renderPriceHistoryList();
      if(tab.dataset.tab === 'summary') renderSummaryDashboard();
      if(tab.dataset.tab === 'baljuform'){ populateBaljuManagerOptions(); populateBaljuVendorOptions(); }
      // 좁은 화면(모바일)에서는 사이드바(탭 목록)가 위에 길게 있어서, 탭을 눌러도 실제 내용을
      // 보려면 매번 손으로 한참 내려야 했어요. 탭을 누르면 그 내용이 있는 자리로 자동으로 스크롤해줘요.
      if(window.innerWidth <= 900){
        setTimeout(()=> activePanel.scrollIntoView({ behavior:'smooth', block:'start' }), 50);
      }
    });
  });

  ['searchInput','managerFilter','statusFilter','paymentFilter','lastOrderDateFilter','monthStartFilter'].forEach(id=>{
    document.getElementById(id).addEventListener('input', renderListTable);
    document.getElementById(id).addEventListener('change', renderListTable);
  });

  document.getElementById('saveBtn').addEventListener('click', async ()=>{
    const btn = document.getElementById('saveBtn');
    const original = btn.textContent;
    btn.disabled = true;
    btn.textContent = '저장 중...';
    clearTimeout(saveTimer);
    const ok = await saveNow();
    // 업로드된 원본 시트(품절data/최종발주일/3개월사용품목/발주담당자)도 함께 최신 상태로 다시 저장해 유실을 방지합니다.
    try{ await Promise.all(Object.keys(uploadState).map(id => saveUpload(id))); }catch(e){ console.error('전체 업로드 일괄 저장 실패:', e); }
    btn.textContent = ok ? '✓ 저장 완료' : '⚠ 저장 실패';
    setTimeout(()=>{ btn.textContent = original; btn.disabled = false; }, 1500);
  });

  document.getElementById('resetBtn').addEventListener('click', async ()=>{
    if(!confirm('수정한 내용을 모두 지우고 원본 데이터로 되돌릴까요?')) return;
    listData = JSON.parse(JSON.stringify(ORIGINAL_LIST));
    recomputeManagerSummary();
    try{ await window.storage.delete(STORAGE_KEY, true); }catch(e){ console.error('품절 현황 목록 초기화 중 삭제 실패:', e); }
    lastSavedAt = null;
    updateGlobalSavedLabel();
    setIndicator('idle');
    renderKpis(); renderListTable(); renderMgrTable();
  });

  document.getElementById('exportBtn').addEventListener('click', exportListToXlsx);
  document.getElementById('exportListBtn').addEventListener('click', exportListToXlsx);
  document.getElementById('exportStockBtn').addEventListener('click', exportStockToXlsx);
  document.getElementById('exportVendorMasterBtn').addEventListener('click', exportVendorMasterToXlsx);

}

// 엑셀로 내려받을 때 헤더 색상·테두리·틀고정·자동필터·상태별 강조색까지 입혀서
// 화면 표를 그대로 옮겨온 것처럼 보이도록 ExcelJS로 스타일을 적용합니다.
// (SheetJS 무료버전은 셀 서식을 지원하지 않아, 서식 적용을 위해 ExcelJS를 함께 사용합니다.)
async function downloadStyledXlsx({ sheetName, fileName, columns, rows, statusKey, preambleRows, totalRow }){
  const wb = new ExcelJS.Workbook();
  const ws = wb.addWorksheet(sheetName);

  // preambleRows: 발주서의 제목·연락처·배송지처럼, 표 위에 그냥 텍스트로 몇 줄 먼저 넣고 싶을 때 씁니다.
  (preambleRows || []).forEach(text=>{
    const row = ws.addRow([text]);
    if(text) row.font = { bold: text === (preambleRows[0]||''), size: text === (preambleRows[0]||'') ? 14 : 11 };
  });
  if(preambleRows && preambleRows.length) ws.addRow([]); // 표 시작 전 한 줄 띄우기

  const tableHeaderRowIdx = ws.rowCount + 1;
  const headerRow = ws.addRow(columns.map(c=>c.label));
  columns.forEach((c,i)=>{ ws.getColumn(i+1).width = c.width || 14; });
  ws.views = [{ state:'frozen', ySplit: tableHeaderRowIdx }];

  const THIN_LIGHT = { style:'thin', color:{ argb:'FFE3E7EF' } };
  const THIN_HEAD  = { style:'thin', color:{ argb:'FFB9C2D6' } };

  headerRow.height = 22;
  headerRow.eachCell(cell=>{
    cell.font = { bold:true, size:11, color:{ argb:'FFFFFFFF' } };
    cell.fill = { type:'pattern', pattern:'solid', fgColor:{ argb:'FF2F5FD6' } };
    cell.alignment = { vertical:'middle', horizontal:'center' };
    cell.border = { top:THIN_HEAD, left:THIN_HEAD, bottom:THIN_HEAD, right:THIN_HEAD };
  });

  rows.forEach((r, i)=>{
    const row = ws.addRow(columns.map(c => r[c.key]));
    const banded = i % 2 === 1;
    row.eachCell((cell, colNumber)=>{
      const def = columns[colNumber - 1];
      cell.border = { top:THIN_LIGHT, left:THIN_LIGHT, bottom:THIN_LIGHT, right:THIN_LIGHT };
      cell.alignment = { vertical:'middle', horizontal: def && (def.numFmt || def.center) ? 'center' : 'left' };
      if(def && def.numFmt) cell.numFmt = def.numFmt;
      if(banded) cell.fill = { type:'pattern', pattern:'solid', fgColor:{ argb:'FFF4F6FB' } };
      if(statusKey && def && def.key === statusKey){
        const v = String(cell.value || '');
        if(v.includes('없음')){
          cell.font = { color:{ argb:'FF4C5A72' } };
        } else if(v.includes('품절')){
          cell.font = { bold:true, color:{ argb:'FF9C352E' } };
          cell.fill = { type:'pattern', pattern:'solid', fgColor:{ argb:'FFF6C9C6' } };
        }
      }
    });
  });

  // totalRow: 발주서의 "발주 합계액" 같은 합계 줄을 표 맨 아래에 굵게 넣고 싶을 때 씁니다.
  if(totalRow){
    const tRow = ws.addRow(columns.map(c => totalRow[c.key] !== undefined ? totalRow[c.key] : ''));
    tRow.eachCell(cell=>{ cell.font = { bold:true, size:12 }; });
  }

  ws.autoFilter = { from:{ row:tableHeaderRowIdx, column:1 }, to:{ row:tableHeaderRowIdx, column: columns.length } };

  const buf = await wb.xlsx.writeBuffer();
  const blob = new Blob([buf], { type:'application/octet-stream' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = fileName;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

async function exportListToXlsx(){
  const columns = LIST_HEADERS.map(h=>({
    key: h.key, label: h.label,
    width: h.key==='client' ? 16 : ((h.isStatus||h.isMonthStart) ? 12 : (h.num ? 11 : 12)),
    numFmt: h.num ? '#,##0' : undefined,
    center: h.num || h.isStatus || h.isMonthStart
  }));
  const rows = listData.map(r=>{
    const o = {};
    LIST_HEADERS.forEach(h=>{ o[h.key] = (r[h.key]===null || r[h.key]===undefined) ? '' : r[h.key]; });
    return o;
  });
  await downloadStyledXlsx({
    sheetName: '품절품목_현황',
    fileName: '품절품목_현황_' + new Date().toISOString().slice(0,10) + '.xlsx',
    columns, rows, statusKey: 'status'
  });
}

async function exportVendorMasterToXlsx(){
  const st = uploadState['vendorMaster'];
  if(!st || !st.rows.length){ alert('내려받을 거래처정보마스터DB 데이터가 없어요.'); return; }
  const columns = st.headers.map(h => ({ key: h, label: h, width: 14 }));
  const rows = st.rows.map(r=>{
    const o = {};
    st.headers.forEach((h, i)=>{ o[h] = (r[i]===null||r[i]===undefined) ? '' : r[i]; });
    return o;
  });
  await downloadStyledXlsx({
    sheetName: '거래처정보마스터DB',
    fileName: '거래처정보마스터DB_' + new Date().toISOString().slice(0,10) + '.xlsx',
    columns, rows
  });
}

async function exportStockToXlsx(){
  const columns = [
    { key:'code', label:'코드', width:10, center:true },
    { key:'client', label:'거래처', width:18 },
    { key:'returnManager', label:'반품담당자', width:12, center:true },
    { key:'orderManager', label:'발주담당자', width:12, center:true },
    ...STOCK_SUMMARY_METRICS.map(m=>({
      key: m.key, label: m.label, width:16,
      numFmt: m.ratio ? '0.00"%"' : '#,##0'
    }))
  ];
  const rows = getActiveStockTableData().map(r=>{
    const o = { code:r.code, client:r.client||'', returnManager:r.returnManager||'', orderManager:r.orderManager||'' };
    STOCK_SUMMARY_METRICS.forEach(m=>{
      let v = r[m.key];
      if(v===null || v===undefined || v==='' || isNaN(Number(v))){ o[m.key] = ''; return; }
      o[m.key] = m.ratio ? Number(v)*100 : Number(v);
    });
    return o;
  });
  await downloadStyledXlsx({
    sheetName: '재고_및_파손재고현황',
    fileName: '재고_및_파손재고현황_' + new Date().toISOString().slice(0,10) + '.xlsx',
    columns, rows
  });
}

// ---------- generic upload-driven tables (품절data / 최종발주일) ----------
// 발주서작성 매출수량(R~T열)·재고수량(Z열)을 나중에 확실하게 다시 찾기 위한 보이지 않는(zero-width) 태그예요.
// 화면엔 안 보이지만(글자 폭이 없음) 각 열마다 다른 개수라 서로 구분돼요 — computeBaljuRowsForLocation에서도 씁니다.
const BALJU_USAGE_TAGS = { r: '\u200b', s: '\u200b\u200b', t: '\u200b\u200b\u200b', z: '\u200b\u200b\u200b\u200b' };
const UPLOAD_CONFIGS = {
  pumjeoldata: { sheetNames: ['품절data','품절 data','품절 Data'], storageKey: 'stockout_dashboard_upload_pumjeoldata_v1', label: '품절data' },
  finalorder:  { sheetNames: ['최종발주일'], storageKey: 'stockout_dashboard_upload_finalorder_v1', label: '최종발주일' },
  usage3m:     { sheetNames: ['3개월사용품목'], storageKey: 'stockout_dashboard_upload_usage3m_v1', label: '3개월사용품목-광주DB',
                 // recomputeFromUsage3m only ever reads the client column and the 純매출/純매입/가용 columns —
                 // 발주서 작성 기능에서 코드·상품명·규격·표준코드·최종매입가(AL열, 단가 출처)도 같이 필요해져서
                 // extraNames로 추가 보존해요.
                 // extraPositions: 발주서작성 매출수량(R~T열)·재고수량(Z열)은 원래 화면 표시(원본 헤더 이름 그대로)는
                 // 안 건드리고, 값만 확실히 이 위치(0-based: R=17,S=18,T=19,Z=25)에서 가져오려는 용도예요 — 이름 매칭이 아니라
                 // 열 위치로 뽑고, 화면엔 안 보이는 태그를 붙여서 발주서작성 쪽에서 그 태그로 정확히 다시 찾아 씁니다.
                 essentialColumns: { clientCandidates: ['우선처'], usageKeywords: ['純매출','純매입','가용'], extraNames: ['코드','제약사','상품명','규격','표준코드','최종매입가'],
                   extraPositions: [ { idx:17, tag:BALJU_USAGE_TAGS.r }, { idx:18, tag:BALJU_USAGE_TAGS.s }, { idx:19, tag:BALJU_USAGE_TAGS.t }, { idx:25, tag:BALJU_USAGE_TAGS.z } ] } },
  // 의정부용 3개월사용품목은 usage3m(광주)과 똑같은 구조지만, 기존 품절현황 계산(recomputeFromUsage3m)과는
  // 무관하게 오직 발주서 작성 기능(의정부 선택 시)에서만 쓰여요. 그래서 별도 업로드로 분리했어요.
  usage3mUj:   { sheetNames: ['3개월사용품목'], storageKey: 'stockout_dashboard_upload_usage3mUj_v1', label: '3개월사용품목-의정부DB',
                 essentialColumns: { clientCandidates: ['우선처'], usageKeywords: ['純매출','純매입','가용'], extraNames: ['코드','제약사','상품명','규격','표준코드','최종매입가'],
                   extraPositions: [ { idx:17, tag:BALJU_USAGE_TAGS.r }, { idx:18, tag:BALJU_USAGE_TAGS.s }, { idx:19, tag:BALJU_USAGE_TAGS.t }, { idx:25, tag:BALJU_USAGE_TAGS.z } ] } },
  // 발주서 작성 기능의 단가 출처예요. 원본에 "단가"라는 이름의 열이 여러 개(이월/매입/매출/재고단가) 나오므로
  // 이름으로는 어떤 걸 가리키는지 구분이 안 돼서, 열 위치(0-based) 기준으로 정확히 매입단가만 뽑아요.
  stockGj2:    { sheetNames: ['재고현황','광주재고'], storageKey: 'stockout_dashboard_upload_stockGj2_v1', label: '광주재고DB',
                 // 재고수량(M열=index12)은 제품기타코드(다미스코드, index23) 기준으로 매칭해요.
                 essentialColumns: { colIndexes: [1,2,7,12,20,22,23], labels: ['제품명','규격','매입단가','재고수량','코드','표준코드','제품기타코드'] } },
  stockUj2:    { sheetNames: ['재고현황','의정부재고'], storageKey: 'stockout_dashboard_upload_stockUj2_v1', label: '의정부재고DB',
                 essentialColumns: { colIndexes: [1,2,7,12,20,22,23], labels: ['제품명','규격','매입단가','재고수량','코드','표준코드','제품기타코드'] } },
  ordermgr:    { sheetNames: ['발주담당자'], storageKey: 'stockout_dashboard_upload_ordermgr_v1', label: '발주담당자', headerHint: '매입처명' },
