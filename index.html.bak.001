<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.4.0/exceljs.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-check-compat.js"></script>
<script>
/* =======================================================================
   FIREBASE 저장소 연동 (Claude.ai 밖 — 예: GitHub Pages — 에서 열었을 때만 사용됨)
   -----------------------------------------------------------------------
   ⬇⬇⬇ 아래 FIREBASE_CONFIG 값을 본인 Firebase 프로젝트 설정으로 바꿔주세요 ⬇⬇⬇
   1) https://console.firebase.google.com 에서 프로젝트 생성
   2) 프로젝트 설정 → 일반 → "웹 앱 추가" → 아래 형태의 설정 객체를 복사해서 붙여넣기
   3) 왼쪽 메뉴 "Firestore Database" 만들기 (프로덕션 모드로 시작해도 OK, 아래 규칙 참고)
   4) Firestore "규칙" 탭에 아래 규칙을 붙여넣기 (사내 전용 링크로만 공유한다는 전제,
      완전히 공개된 페이지라면 Firebase Authentication을 추가해서 read/write를 제한하는 걸 권장합니다):

        rules_version = '2';
        service cloud.firestore {
          match /databases/{database}/documents {
            match /stockout_dashboard/{docId} {
              allow read, write: if true;
            }
          }
        }
   ======================================================================= */
const FIREBASE_CONFIG = {
  apiKey: "AIzaSyBwiXvIitbLNQYbfnoKS_bJ6aGQTYTO4As",
  authDomain: "ccccgc-57a14.firebaseapp.com",
  projectId: "ccccgc-57a14",
  storageBucket: "ccccgc-57a14.firebasestorage.app",
  messagingSenderId: "865064688661",
  appId: "1:865064688661:web:ec888a861172074716821c"
};
const FIREBASE_COLLECTION = 'stockout_dashboard';

// App Check: 이 사이트(dongwonhc.pages.dev)에서 온 요청인지 파이어베이스가 검증하도록 하는 값이에요.
// Firebase 콘솔 > App Check > 대시보드(웹 앱) > reCAPTCHA v3에서 발급받은 사이트 키입니다.
// 콘솔에서 Firestore의 "적용(Enforce)"을 켜기 전까지는 이 값이 있어도 아직 강제되지 않아요.
const APP_CHECK_SITE_KEY = '6LcO73stAAAAAI9oYoHC3lu8E_yu5rg9oHkpfZWq';

function isFirebaseConfigured(){
  return FIREBASE_CONFIG.apiKey && !/YOUR_/.test(FIREBASE_CONFIG.apiKey) && !/YOUR_/.test(FIREBASE_CONFIG.projectId || '');
}

let _fbDB = null;
let _appCheckReadyPromise = null; // App Check 토큰이 준비될 때까지, 저장소 요청들이 기다릴 수 있게 해요.
function getFirestore(){
  if(_fbDB) return _fbDB;
  if(typeof firebase === 'undefined') throw new Error('Firebase SDK가 로드되지 않았어요');
  if(!isFirebaseConfigured()) throw new Error('FIREBASE_CONFIG가 아직 설정되지 않았어요');
  if(!firebase.apps.length) firebase.initializeApp(FIREBASE_CONFIG);
  if(APP_CHECK_SITE_KEY && !/YOUR_/.test(APP_CHECK_SITE_KEY)){
    if(typeof firebase.appCheck !== 'function'){
      // App Check SDK 스크립트 자체가 안 불러와진 경우예요(광고차단기, 네트워크 차단, CDN 문제 등).
      // 이러면 이 조건에 걸리지도 않고 그냥 조용히 넘어가버려서, 일부러 눈에 보이게 만들었어요.
      showFirestoreErrorBanner(new Error('App Check SDK가 로드되지 않았어요 — firebase-app-check-compat.js 스크립트가 차단됐거나 못 불러와진 것 같아요. 광고 차단기·보안 확장 프로그램을 꺼보시거나 다른 브라우저로 시도해보세요.'));
    } else {
      try{
        firebase.appCheck().activate(APP_CHECK_SITE_KEY, true);
        // 활성화 자체는 성공해도, 실제로 reCAPTCHA 토큰을 발급받는 데 시간이 걸리거나 실패할 수 있어요.
        // 이 토큰을 실제로 다 받을 때까지 기다리는 약속(Promise)을 만들어서, 아래 저장소 요청들이
        // 이 약속이 끝날 때까지 기다렸다가 나가게 해요 — 그래야 "토큰 준비 전에 먼저 나간 요청만
        // 권한 거부당하는" 문제가 안 생겨요.
        _appCheckReadyPromise = firebase.appCheck().getToken()
          .then(res=>{
            const tokenPreview = (res && res.token) ? (res.token.slice(0,12) + '...') : '(토큰 없음)';
            console.log('App Check 토큰 발급 성공:', tokenPreview);
            showAppCheckStatusBanner(true, `App Check 토큰을 정상적으로 받았어요 (${tokenPreview})`);
          })
          .catch(tokenErr=>{
            showAppCheckStatusBanner(false, 'App Check 토큰 발급 실패: ' + ((tokenErr && tokenErr.message) || tokenErr));
            // 토큰을 못 받아도 여기서 영원히 멈추지 않고, 그냥 다음으로 넘어가게 해요
            // (Firestore 규칙이 어차피 거부할 테니, 그 실패는 아래 permission-denied로 이어져요).
          });
      }catch(e){ console.warn('App Check 활성화에 실패했어요:', e); showFirestoreErrorBanner(e); }
    }
  }
  _fbDB = firebase.firestore();
  return _fbDB;
}

// window.storage와 동일한 인터페이스(get/set/delete/list)를 Firestore로 구현합니다.
// Claude.ai 아티팩트 안에서 열렸다면 window.storage가 이미 존재하므로 이 shim은 쓰이지 않습니다.
// 파이어베이스 관련 상태(성공/실패)를 화면 맨 위에 배너로 보여줘요. 개발자도구 없이도 정확히
// 뭐가 문제인지(또는 정상인지) 바로 보여서, "그냥 안 보인다"가 아니라 진짜 원인을 알 수 있게 해요.
function getFbBannerStack(){
  let stack = document.getElementById('fbBannerStack');
  if(!stack){
    stack = document.createElement('div');
    stack.id = 'fbBannerStack';
    stack.style.cssText = 'position:fixed; top:0; left:0; right:0; z-index:9999; display:flex; flex-direction:column;';
    document.body.prepend(stack);
  }
  return stack;
}

let _fbErrorBannerShown = false;
function showFirestoreErrorBanner(err){
  if(_fbErrorBannerShown) return; // 같은 세션에서 계속 반복해서 뜨지 않게, 처음 한 번만 보여줘요.
  _fbErrorBannerShown = true;
  const msg = (err && err.message) || String(err);
  const code = (err && err.code) ? ` (코드: ${err.code})` : '';
  const div = document.createElement('div');
  div.style.cssText = 'background:#5c1a1a; color:#fff; padding:12px 16px; font-size:13px; line-height:1.6; box-shadow:0 2px 8px rgba(0,0,0,0.3);';
  div.innerHTML = `⚠️ <b>파이어베이스 요청이 실패했어요${code}</b><br>${msg}<br><span style="opacity:0.85;">이 메시지를 그대로 캡처해서 보내주시면 원인을 정확히 찾을 수 있어요.</span>
    <button onclick="this.parentElement.remove()" style="float:right; background:transparent; border:1px solid #fff; color:#fff; border-radius:6px; padding:2px 10px; cursor:pointer;">닫기</button>`;
  getFbBannerStack().appendChild(div);
}

// App Check 토큰이 성공했는지 실패했는지를 개발자도구 없이 화면에서 바로 볼 수 있게 보여줘요.
// 지금은 App Check 관련 작업을 잠시 쉬고 있어서 배너를 꺼뒀어요 — 나중에 그 작업을 다시 할 때
// 이 값을 true로 바꾸면 그대로 다시 켜져요(코드 자체는 그대로 남겨뒀어요).
const APP_CHECK_BANNER_ENABLED = false;
let _appCheckStatusBannerShown = false;
function showAppCheckStatusBanner(success, msg){
  if(!APP_CHECK_BANNER_ENABLED) return;
  if(_appCheckStatusBannerShown) return;
  _appCheckStatusBannerShown = true;
  const div = document.createElement('div');
  const bg = success ? '#1a4d2e' : '#5c1a1a';
  div.style.cssText = `background:${bg}; color:#fff; padding:10px 16px; font-size:13px; line-height:1.6; box-shadow:0 2px 8px rgba(0,0,0,0.3);`;
  div.innerHTML = `${success ? '✅' : '⚠️'} <b>App Check 상태</b>: ${msg}
    <button onclick="this.parentElement.remove()" style="float:right; background:transparent; border:1px solid #fff; color:#fff; border-radius:6px; padding:2px 10px; cursor:pointer;">닫기</button>`;
  getFbBannerStack().appendChild(div);
}

// getFirestore()가 만들어둔 "토큰 준비" 약속이 끝날 때까지 기다립니다. App Check을 안 쓰는 경우
// (Claude.ai 안에서 열렸거나 App Check 설정이 없는 경우)엔 이 약속 자체가 없으니 그냥 바로 지나가요.
async function ensureAppCheckReady(){
  if(_appCheckReadyPromise) await _appCheckReadyPromise;
}

const firebaseStorageShim = {
  async get(key, shared){
    try{
      const db = getFirestore();
      await ensureAppCheckReady();
      const snap = await db.collection(FIREBASE_COLLECTION).doc(key).get();
      if(!snap.exists) return null;
      const data = snap.data();
      return { key, value: data.value, shared: !!shared };
    }catch(err){ showFirestoreErrorBanner(err); throw err; }
  },
  async set(key, value, shared){
    try{
      const db = getFirestore();
      await ensureAppCheckReady();
      await db.collection(FIREBASE_COLLECTION).doc(key).set({ value, updatedAt: new Date().toISOString() });
      return { key, value, shared: !!shared };
    }catch(err){ showFirestoreErrorBanner(err); throw err; }
  },
  async delete(key, shared){
    try{
      const db = getFirestore();
      await ensureAppCheckReady();
      await db.collection(FIREBASE_COLLECTION).doc(key).delete();
      return { key, deleted: true, shared: !!shared };
    }catch(err){ showFirestoreErrorBanner(err); throw err; }
  },
  async list(prefix, shared){
    try{
      const db = getFirestore();
      await ensureAppCheckReady();
      const snap = await db.collection(FIREBASE_COLLECTION).get();
      const keys = [];
      snap.forEach(doc => { if(!prefix || doc.id.startsWith(prefix)) keys.push(doc.id); });
      return { keys, prefix, shared: !!shared };
    }catch(err){ showFirestoreErrorBanner(err); throw err; }
  }
};

let usingFirebaseShim = false;
if(typeof window.storage === 'undefined'){
  window.storage = firebaseStorageShim;
  usingFirebaseShim = true;
}

function initStorageBanner(){
  const banner = document.getElementById('fbBanner');
  if(usingFirebaseShim && !isFirebaseConfigured()){
    banner.classList.add('show');
  } else {
    banner.classList.remove('show');
  }
  const badgeHost = document.querySelector('.head .sub');
  if(badgeHost){
    const badge = document.createElement('span');
    if(!usingFirebaseShim){
      badge.className = 'storage-badge ok';
      badge.textContent = 'Claude.ai 저장소 연결됨';
    } else if(isFirebaseConfigured()){
      badge.className = 'storage-badge ok';
      badge.textContent = 'Firebase 저장소 연결됨';
    } else {
      badge.className = 'storage-badge warn';
      badge.textContent = 'Firebase 설정 필요';
    }
    badgeHost.appendChild(badge);
  }
}
</script>
<script>

