            <span class="count-badge" id="count-usage3m"></span>
            <div class="spacer"></div>
            <div class="pager" id="pager-usage3m"></div>
          </div>
          <div class="table-scroll" id="scroll-usage3m" style="display:none;">
            <table id="table-usage3m">
              <thead><tr id="head-usage3m"></tr></thead>
              <tbody id="body-usage3m"></tbody>
            </table>
          </div>

          <div class="sub-section-title" style="margin-top:16px;">3개월사용품목-의정부DB</div>
          <div class="upload-bar" id="upload-usage3mUj-bar">
