  // 관리합니다. 명세서상의 미매칭 품목은 이 표에 표준코드 빈 채로 자동 추가되고, 표 안에서 바로 수기 수정할 수 있어요.
  pharminfo_hk:      { sheetNames: ['Sheet1','제약사상품정보','상품정보'], storageKey: 'stockout_dashboard_pharminfo_hk_v1', label: '제약사상품정보(에이치케이이노엔)', headerHint: '상품명', noPagination: true },
  pharminfo_ildong:  { sheetNames: ['Sheet1','제약사상품정보','상품정보'], storageKey: 'stockout_dashboard_pharminfo_ildong_v1', label: '제약사상품정보(일동제약)', headerHint: '상품명', noPagination: true },
  pharminfo_newshin: { sheetNames: ['Sheet1','제약사상품정보','상품정보','코드표'], storageKey: 'stockout_dashboard_pharminfo_newshin_v1', label: '제약사상품정보(뉴신팜)', headerHint: '표준코드', noPagination: true },
