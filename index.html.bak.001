  pharminfo_tr:      { sheetNames: ['Sheet1','제약사상품정보','상품정보','코드표'], storageKey: 'stockout_dashboard_pharminfo_tr_v1', label: '제약사상품정보(티알엔)', headerHint: '표준코드', noPagination: true },
};

// 재고 및 파손재고현황 표에서 쓰는 창고(시트) 목록 — 전월/당월 구분 없이 창고별 최신 자료 하나만 보관하고,
// '어느 달을 당월/전월로 볼지'는 조회 시점에 연도·월 선택으로 결정합니다.
const STOCK_WAREHOUSES = [
  { id:'stockGJ', label:'광주' },
  { id:'stockEJ', label:'의정부' },
];
// 재고 및 파손재고현황 표에는 광주·의정부를 합산한 값만 표시합니다 (창고별 세부값은 위 4개 업로드에만 보관).
// "전체 현황" 그룹 — 엑셀 통합 시트의 실제 수식을 그대로 재현해 위 4개 시트 업로드만으로 계산합니다.
//   매출액합계        = 당월(광주).純매출금액 + 당월(의정부).純매출금액
//   채무총액          = 당월(광주).잔고 + 당월(의정부).잔고
//   전월재고          = 전월(광주).재고액합계 + 전월(의정부).재고액합계
//   당월재고합계      = 당월(광주).재고액합계 + 당월(의정부).재고액합계
//   재고증감비율      = 당월재고합계 / 전월재고 (엑셀 헤더는 "매출액대비재고비율"이지만 실제 수식은 당월재고/전월재고입니다)
//   외상대비재고비율  = 당월재고합계 / 채무총액
//   전월파손재고      = 전월(광주).파손재고금액 + 전월(의정부).파손재고금액
//   당월파손재고      = 당월(광주).파손재고금액 + 당월(의정부).파손재고금액
//   파손재고감소율    = 1 - (전월파손재고 / 당월파손재고)
// 모든 금액은 엑셀 원본과 동일하게 원 단위로 표시합니다.
const STOCK_SUMMARY_METRICS = [
  { key:'salesTotal', label:'매출액합계(원)' },
  { key:'debtTotal', label:'채무총액(원)' },
  { key:'prevStock', label:'전월재고(원)' },
  { key:'curStockTotal', label:'당월재고합계(원)' },
  { key:'salesRatio', label:'재고증감비율(%)', ratio:true },
  { key:'unpaidRatio', label:'외상대비재고비율(%)', ratio:true },
  { key:'prevDamaged', label:'전월파손재고(원)' },
  { key:'curDamaged', label:'당월파손재고(원)' },
  { key:'damagedChangeRate', label:'파손재고감소율(%)', ratio:true },
];
// 재고 추이 그래프용 월별 스냅샷(업로드 시점마다 쌓입니다)
const STOCK_HISTORY_KEY = 'stockout_dashboard_stock_history_v1';
let stockHistory = [];

let stockData = [];
const uploadState = {}; // id -> { headers, rows, page, pageSize, sort:{key,dir}, filtered }

// ---------- background parsing worker ----------
// XLSX.read()/sheet_to_json() on a large workbook (tens of thousands of rows) is a long,
// fully synchronous operation. Running it on the main thread freezes the whole page with
// no visual feedback until it finishes, which looks exactly like a broken/failed upload.
// Moving the parse into a Web Worker keeps the tab responsive and lets us show a
// "처리 중" indicator that actually renders while the work happens.
const PARSE_WORKER_SRC = `
importScripts('https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js');

function detectHeaderRow(aoa, headerHint){
  if(headerHint){
    for(let i=0; i<Math.min(20, aoa.length); i++){
      if(aoa[i].some(v => v!==null && String(v).includes(headerHint))){
        return { headerIdx: i, dataStart: i+1 };
      }
    }
  }
  if(aoa.length < 2) return { headerIdx: 0, dataStart: 1 };
  const row0Filled = aoa[0].filter(v=>v!==null && v!=='' && v!==undefined).length;
  const row1Filled = aoa[1].filter(v=>v!==null && v!=='' && v!==undefined).length;
  if(row1Filled > row0Filled * 1.3) return { headerIdx: 1, dataStart: 2 };
  return { headerIdx: 0, dataStart: 1 };
}

function pickEssentialColumns(headers, rows, essentialColumns){
  if(!essentialColumns) return { headers, rows, trimmed: false };
  if(essentialColumns.names){
    // 열 이름으로 찾습니다 — 원본 파일의 열 순서가 달라져도(또는 이미 일부만 담긴 파일이어도) 안전해요.
    const keepIdx = essentialColumns.names.map(n => headers.indexOf(n)).filter(i => i !== -1);
    if(keepIdx.length === 0) return { headers, rows, trimmed: false };
    return {
      headers: keepIdx.map(i => headers[i]),
      rows: rows.map(r => keepIdx.map(i => r[i])),
      trimmed: true,
      originalColumnCount: headers.length,
      keptColumnCount: keepIdx.length
    };
  }
  if(essentialColumns.colIndexes){
    // 열 이름이 아니라 엑셀 열 위치(0-based) 기준으로 뽑습니다 — 예: 우선처별 재고 및 매입실적 시트는
    // '%' 헤더가 두 번 나와서 이름 매칭으로는 어떤 '%'인지 구분할 수 없기 때문입니다.
    const keepIdx = essentialColumns.colIndexes.filter(i => i < headers.length);
    if(keepIdx.length === 0) return { headers, rows, trimmed: false };
    return {
      headers: essentialColumns.labels || keepIdx.map(i => headers[i]),
      rows: rows.map(r => keepIdx.map(i => r[i])),
      trimmed: true,
      originalColumnCount: headers.length,
      keptColumnCount: keepIdx.length
    };
  }
  const norm = s => String(s == null ? '' : s).replace(/\s+/g,'');
  const { clientCandidates, usageKeywords, extraNames, extraPositions } = essentialColumns;

  let clientIdx = headers.indexOf(clientCandidates.find(c => headers.includes(c)));
  if(clientIdx === -1){
    const target = norm(clientCandidates[0]);
    clientIdx = headers.findIndex(h => norm(h).includes(target));
  }
  const usageIdx = headers
    .map((h,i)=>({h:norm(h), i}))
    .filter(({h}) => usageKeywords.some(k => h.includes(k)))
    .map(({i}) => i);
  // extraNames: 純매출/純매입처럼 매달 열 이름이 바뀌는 것과 달리, 이름이 고정된 열(코드·상품명 등)을
  // 그대로 이름으로 찾아서 같이 보존해요.
  const extraIdx = (extraNames || []).map(n => headers.indexOf(n)).filter(i => i !== -1);

  const keepIdx = [...new Set([clientIdx !== -1 ? clientIdx : null, ...usageIdx, ...extraIdx].filter(i => i !== null && i !== -1))];
  const keepHeaders = keepIdx.map(i => headers[i]);
  const keepRows = rows.map(r => keepIdx.map(i => r[i]));

  // extraPositions: 이름이 아니라 정확한 열 위치(0-based)로 지정한 열을 별도로 더 보존해요 — 라벨은
  // 원본 헤더 텍스트 뒤에 화면엔 안 보이는 태그 문자(tag, zero-width space 조합)를 붙여서, 화면 표시(양식)는
  // 안 건드리면서도 나중에 그 태그로 정확히 다시 찾을 수 있게 해요. (재업로드 전 옛날 데이터엔 이 태그가
  // 없어서, 엉뚱한 열을 잘못 집어오는 대신 안전하게 '못 찾음'으로 처리돼요.)
  const posEntries = (extraPositions || []).filter(p => p.idx < headers.length);

  if(keepIdx.length === 0 && posEntries.length === 0) return { headers, rows, trimmed: false };

  return {
    headers: [...keepHeaders, ...posEntries.map(p => headers[p.idx] + (p.tag || ''))],
    rows: rows.map((r,ri) => [...keepRows[ri], ...posEntries.map(p => r[p.idx])]),
    trimmed: true,
    originalColumnCount: headers.length,
    keptColumnCount: keepIdx.length + posEntries.length
  };
}

self.onmessage = function(e){
  const { buf, filename, sheetNames, headerHint, essentialColumns, sheetKeyword } = e.data;
  try{
    let aoa;
    if(/\.csv$/i.test(filename || '')){
      // CSV는 파일 안에 인코딩 정보가 없어요. UTF-8로 읽어서 한글이 깨진 것 같으면(정부 공공데이터에
      // 흔한 EUC-KR/CP949 저장) EUC-KR로 다시 읽어요.
      let text = new TextDecoder('utf-8').decode(buf);
      const sample = text.slice(0, 2000);
      const badCount = (sample.match(/[\uFFFD\u00C0-\u00FF]/g) || []).length;
      if(sample && badCount > sample.length * 0.05){
        try{ text = new TextDecoder('euc-kr').decode(buf); }catch(err){ /* 지원 안 하면 utf-8 결과라도 씁니다 */ }
      }
      const wbCsv = XLSX.read(text, { type:'string' });
      const wsCsv = wbCsv.Sheets[wbCsv.SheetNames[0]];
      aoa = XLSX.utils.sheet_to_json(wsCsv, { header:1, raw:true, defval:null });
      var sheetName = wbCsv.SheetNames[0];
    } else {
      const wb = XLSX.read(buf, { type:'array', cellDates:false });
      sheetName = sheetNames.find(n => wb.SheetNames.includes(n))
        || (sheetKeyword && wb.SheetNames.find(n => n.includes(sheetKeyword)))
        || wb.SheetNames[0];
      const ws = wb.Sheets[sheetName];
      aoa = XLSX.utils.sheet_to_json(ws, { header:1, raw:true, defval:null });
    }
    const { headerIdx, dataStart } = detectHeaderRow(aoa, headerHint);
    const rawHeaders = aoa[headerIdx].map((h,i)=> (h===null||h==='') ? ('열'+(i+1)) : String(h));
    const rawRows = aoa.slice(dataStart).filter(r => r.some(v => v!==null && v!==''));
    const picked = pickEssentialColumns(rawHeaders, rawRows, essentialColumns);
    self.postMessage({
      ok: true, sheetName, headers: picked.headers, rows: picked.rows, trimmed: picked.trimmed,
      originalColumnCount: picked.originalColumnCount, keptColumnCount: picked.keptColumnCount
    });
  }catch(err){
    self.postMessage({ ok: false, error: String((err && err.message) || err) });
  }
};
`;

let parseWorker = null;
function getParseWorker(){
  if(!parseWorker){
    const blob = new Blob([PARSE_WORKER_SRC], { type: 'application/javascript' });
    parseWorker = new Worker(URL.createObjectURL(blob));
  }
  return parseWorker;
}

function parseFileInWorker(buf, cfg, filename){
  return new Promise((resolve, reject)=>{
    const worker = getParseWorker();
    const handleMessage = (e)=>{
      worker.removeEventListener('message', handleMessage);
      worker.removeEventListener('error', handleError);
      if(e.data && e.data.ok) resolve(e.data);
      else reject(new Error((e.data && e.data.error) || '파일 처리 중 알 수 없는 오류가 발생했어요.'));
    };
    const handleError = (err)=>{
      worker.removeEventListener('message', handleMessage);
      worker.removeEventListener('error', handleError);
      reject(err);
    };
    worker.addEventListener('message', handleMessage);
    worker.addEventListener('error', handleError);
    worker.postMessage({ buf, filename, sheetNames: cfg.sheetNames, headerHint: cfg.headerHint, essentialColumns: cfg.essentialColumns, sheetKeyword: cfg.sheetKeyword }, [buf]);
  });
}

// 파일명에서 연도와 월을 함께 인식해 { year, month }로 반환합니다. 아래 형식을 순서대로 시도합니다:
//   1) "2026-07", "2026.07", "2026_07", "2026/07" 처럼 연도-월이 붙어 있는 형식 (연/월 모두 명확히 인식)
//   2) "202607" 처럼 구분자 없이 6자리 숫자로 붙어 있는 형식
//   3) "2026년 7월", "26년7월"처럼 "년"·"월" 표기가 함께 있는 형식
//   4) "7월"처럼 월만 있는 형식 — 이 경우 연도 표기가 없으면 업로드 시점의 연도를 사용합니다
// 위 형식을 모두 찾지 못하면(=월을 특정할 수 없으면) null을 반환하고, 업로드 시점의 연/월로 대체합니다.
function extractYearMonthFromFileName(fileName){
  if(!fileName) return null;

  // 1) YYYY-MM / YYYY.MM / YYYY_MM / YYYY/MM
  const ymSep = fileName.match(/(20\d{2})\s*[-._/]\s*(\d{1,2})(?!\d)/);
  if(ymSep){
    const year = Number(ymSep[1]), month = Number(ymSep[2]);
    if(month >= 1 && month <= 12) return { year, month };
  }

  // 2) YYYYMM (구분자 없음, 6자리)
  const ymPacked = fileName.match(/(20\d{2})(0[1-9]|1[0-2])(?!\d)/);
  if(ymPacked){
    return { year: Number(ymPacked[1]), month: Number(ymPacked[2]) };
  }

  // 3)/4) "N월" 표기 — 있으면 근처의 "YYYY년"·"YY년"·"YYYY"에서 연도를, 없으면 업로드 시점 연도를 사용
  const monthMatch = fileName.match(/(\d{1,2})\s*월/);
  if(!monthMatch) return null;
  const month = Number(monthMatch[1]);
  if(!(month >= 1 && month <= 12)) return null;
  let year = null;
  const y4 = fileName.match(/(20\d{2})/);
  const y2 = fileName.match(/(\d{2})\s*년/);
  if(y4) year = Number(y4[1]);
  else if(y2) year = 2000 + Number(y2[1]);
  if(!year) year = new Date().getFullYear();
  return { year, month };
}
function fileMonthKeyOf(fileName){
  const ym = extractYearMonthFromFileName(fileName);
  return ym ? (ym.year + '-' + String(ym.month).padStart(2,'0')) : null;
}

function setUploadProcessing(id, isProcessing, fileName){
  const meta = document.getElementById('meta-' + id);
  const dropLabel = document.querySelector(`label[for="file-${id}"]`);
  const fileInput = document.getElementById('file-' + id);
  if(isProcessing){
    if(dropLabel) dropLabel.classList.add('processing');
    if(fileInput) fileInput.disabled = true;
    const bigFileNote = id === 'productMaster'
      ? ' (다미스제품코드마스터DB는 데이터가 많아 읽는 데만 20~30초, 저장까지 합치면 1분 가까이 걸릴 수 있어요 — 창을 닫지 말고 기다려주세요)'
      : ' (페이지는 멈추지 않으니 다른 작업을 하며 기다리셔도 됩니다)';
    if(meta) meta.innerHTML = `⏳ <b>${fileName}</b> 처리 중이에요… 대용량 파일은 다소 시간이 걸릴 수 있어요${bigFileNote}`;
  } else {
    if(dropLabel) dropLabel.classList.remove('processing');
    if(fileInput) fileInput.disabled = false;
  }
}

async function handleFile(id, file){
  const cfg = UPLOAD_CONFIGS[id];
  setUploadProcessing(id, true, file.name);
  try{
    const buf = await file.arrayBuffer();
    const result = await parseFileInWorker(buf, cfg, file.name);
    await finishUploadProcessing(id, {
      headers: result.headers, rows: result.rows, sheetUsed: result.sheetName, fileName: file.name,
      trimmedColumns: result.trimmed ? { original: result.originalColumnCount, kept: result.keptColumnCount } : null
    });
  }catch(err){
    console.error('업로드 처리 실패:', err);
    setUploadProcessing(id, false);
    updateUploadMeta(id);
    alert('파일을 읽는 중 문제가 발생했어요: ' + (err && err.message ? err.message : err));
    return;
  }
  setUploadProcessing(id, false);
}

// 다미스제품코드마스터DB 전용: 대표코드와 표준코드가 같은 품목은 소분 품목으로 간주해 소분열을 'Y'로 자동 보정합니다.
// (매입전표입력 소분제외 로직, 반품신청서 소분 조회 등 소분열을 읽는 모든 기능에 그대로 반영됩니다.)
function autoMarkSplitByRepCode(entry){
  if(!entry || !entry.headers || !entry.rows) return;
  const idxRep = entry.headers.indexOf('대표코드');
  const idxStd = entry.headers.indexOf('표준코드');
  const idxSplit = entry.headers.indexOf('소분');
  if(idxRep === -1 || idxStd === -1 || idxSplit === -1) return;
  entry.rows.forEach(r=>{
    const rep = r[idxRep]!==null && r[idxRep]!==undefined ? String(r[idxRep]).trim() : '';
    const std = r[idxStd]!==null && r[idxStd]!==undefined ? String(r[idxStd]).trim() : '';
    if(rep && std && rep === std) r[idxSplit] = 'Y';
  });
}

// 파일 업로드든 붙여넣기든, 최종적으로 {headers, rows}가 준비되면 이 뒷정리(저장·화면갱신·재계산)는 똑같이 거칩니다.
async function finishUploadProcessing(id, parsed){
  uploadState[id] = {
    headers: parsed.headers, rows: parsed.rows, page: 0, pageSize: 50,
    sort: { key:null, dir:1 }, sheetUsed: parsed.sheetUsed || '붙여넣기', uploadedAt: new Date().toISOString(), fileName: parsed.fileName || '(붙여넣은 데이터)',
    trimmedColumns: parsed.trimmedColumns || null,
    fileMonth: STOCK_WAREHOUSES.some(p=>p.id===id) ? fileMonthKeyOf(parsed.fileName || '') : null
  };
  if(id === 'productMaster') autoMarkSplitByRepCode(uploadState[id]);
  await saveUpload(id);
  if(STOCK_WAREHOUSES.some(p=>p.id===id)){
    const monthKey = uploadState[id].fileMonth || new Date().toISOString().slice(0,7);
    await saveMonthlyStockSnapshot(id, monthKey, uploadState[id]);
  }
  renderUploadTable(id);
  updateUploadMeta(id);
  if(id === 'pumjeoldata') recomputeFromPumjeoldata();
  if(id === 'finalorder') recomputeFromFinalOrder();
  if(id === 'usage3m') recomputeFromUsage3m();
  if(id === 'ordermgr') { await syncOrdermgrToVendorMaster(); recomputeFromManager(); refreshStockViews(); }
  if(id === 'returnmgr') { await syncReturnmgrToVendorMaster(); refreshStockViews(); }
  if(id === 'vendorMaster') { if(ensureVendorMasterReturnNoteColumn()){ renderUploadTable('vendorMaster'); await saveUpload('vendorMaster'); } recomputeFromManager(); refreshStockViews(); }
  if((id === 'pharminfo_hk' || id === 'pharminfo_ildong') && typeof pharmregRawRows !== 'undefined' && pharmregRawRows.length){
    computePharmregResults(); renderPharmregModeInfo(); renderPharmregTable();
  }
  if(STOCK_WAREHOUSES.some(p=>p.id===id)) { refreshStockViews(); }
  if(id === 'productMaster' && typeof renderReturnCycleTable === 'function') renderReturnCycleTable();
  if(id === 'productMaster' && typeof computeProductInfoResults === 'function'){ computeProductInfoResults(); renderProductInfoTable(); }
  if(id === 'productMaster' && typeof buildProductSearch2FilterOptions === 'function'){ buildProductSearch2FilterOptions(); renderProductSearch2Table(); }
}

// 붙여넣은 텍스트(탭 또는 콤마 구분, 첫 줄=헤더)를 {headers, rows}로 바꿉니다. essentialColumns.colIndexes가
// 설정된 항목(우선처별 재고 및 매입실적 등)은 그 열 위치만 뽑아서 라벨을 새 헤더로 씁니다.
function parseUploadPasteText(id, text){
  const cfg = UPLOAD_CONFIGS[id];
  const lines = text.split(/\r\n|\r|\n/).map(l=>l.replace(/\r+$/,'')).filter(l=>l.length>0);
  if(!lines.length) return { headers:[], rows:[] };
  const useTab = text.includes('\t');
  const splitLine = line => useTab ? line.split('\t').map(v=>v.trim()) : line.split(',').map(v=>v.trim());
  let allRows = lines.map(splitLine);
  let headers = allRows[0];
  let dataRows = allRows.slice(1);
  if(cfg && cfg.essentialColumns && cfg.essentialColumns.colIndexes){
    const { colIndexes, labels } = cfg.essentialColumns;
    headers = labels;
    dataRows = dataRows.map(r => colIndexes.map(ci => r[ci] !== undefined ? r[ci] : ''));
  }
  return { headers, rows: dataRows };
}

async function handleUploadPaste(id, text){
  const parsed = parseUploadPasteText(id, text);
  if(!parsed.headers.length || !parsed.rows.length){ alert('붙여넣은 데이터를 읽지 못했어요. 헤더 줄을 포함해서 다시 붙여넣어주세요.'); return; }
  await finishUploadProcessing(id, { headers: parsed.headers, rows: parsed.rows, sheetUsed: '붙여넣기', fileName: '' });
}


function setUploadSaveState(id, state, errMsg){
  const indicator = document.getElementById('saveState-' + id);
  if(!indicator) return;
  const dot = indicator.querySelector('.save-dot');
  const label = indicator.querySelector('span:last-child');
  dot.classList.remove('saved','saving');
  indicator.title = '';
  indicator.style.cursor = '';
  if(state==='saving'){ dot.classList.add('saving'); label.textContent = errMsg ? errMsg : '저장 중...'; }
  else if(state==='saved'){ dot.classList.add('saved'); label.textContent='저장됨 · ' + formatSavedTime(uploadState[id] && uploadState[id].savedAt); }
  else if(state==='error'){
    label.textContent = '⚠ 저장 실패 (클릭해서 재시도)';
    indicator.title = errMsg ? ('오류 내용: ' + errMsg) : '';
    indicator.style.cursor = 'pointer';
  }
  else { label.textContent='대기 중'; }
}

// ---------- chunked storage helpers ----------
// window.storage caps each key's value at 5MB. Large source sheets (e.g. "3개월사용품목",
// which can be tens of thousands of rows) easily exceed that in a single JSON blob, which
// made the save silently fail. To fix this, rows are split across multiple keys
// (`${storageKey}_chunk_0`, `_chunk_1`, ...) whenever the serialized rows would be too big,
// and reassembled on load. Small uploads are still saved as a single key, unchanged.
const MAX_VALUE_BYTES = 900 * 1024; // Firestore 문서 하나의 실제 한도는 1,048,576바이트(1MB)예요.
// 예전 값(1.2MB)은 그 한도보다 커서 실제로 "invalid-argument: value longer than 1048487 bytes" 오류가
// 났었어요 — 이제 한도보다 확실히 낮게 잡아서(900KB) 문서 하나가 절대 한도를 넘지 않게 해요.
                                            // since saves of datasets in the low single-MB range have been failing in practice

function byteLengthOf(value){
  return new TextEncoder().encode(JSON.stringify(value)).length;
}

// window.storage 저장은 일시적으로 실패할 수 있어(공식 안내상 "always use try-catch"),
// 실패 시 짧게 대기했다가 몇 번 더 시도합니다. 마지막에도 실패하면 에러를 그대로 던집니다.
async function storageSetWithRetry(key, value, shared, retries){
  retries = retries === undefined ? 5 : retries;
  let lastErr = null;
  for(let attempt=0; attempt<=retries; attempt++){
    try{
      const res = await window.storage.set(key, value, shared);
      if(res) return res;
      lastErr = new Error('저장소가 빈 응답을 반환했어요');
    }catch(e){
      lastErr = e;
    }
    if(attempt < retries) await new Promise(r=>setTimeout(r, 600 + attempt*700));
  }
  throw lastErr || new Error('알 수 없는 저장 오류');
}

// window.storage.get()도 저장(set)과 마찬가지로 가끔 응답이 안 올 수 있어요. 특히 여러 조각으로
// 나눠 저장한 데이터는 조각 하나만 못 불러와도 그만큼 행이 통째로 빠진 채로 보여서 "데이터가
// 지워졌다"처럼 보일 수 있어서, 저장할 때와 똑같이 재시도하게 만들었어요.
async function storageGetWithRetry(key, shared, retries){
  retries = retries === undefined ? 3 : retries;
  let lastErr = null;
  for(let attempt=0; attempt<=retries; attempt++){
    try{
      return await window.storage.get(key, shared);
    }catch(e){
      lastErr = e;
    }
    if(attempt < retries) await new Promise(r=>setTimeout(r, 500 + attempt*600));
  }
  throw lastErr || new Error('알 수 없는 조회 오류');
}

function splitRowsIntoChunks(rows, maxBytes){
  if(rows.length === 0) return [[]];
  const totalBytes = byteLengthOf(rows);
  if(totalBytes <= maxBytes) return [rows];
  // 행 크기가 들쭉날쭉해도 어떤 조각도 절대 한도를 넘지 않도록, 한 줄씩 실제로 더해보면서
  // 한도를 넘기 직전까지만 채우고 다음 조각으로 넘어가는 방식으로 나눠요(추정치 기반 균등분할이
  // 아니라서, 유난히 큰 행이 몰려있어도 안전해요).
  const chunks = [];
  let current = [];
  let currentBytes = 2; // 빈 배열 "[]"의 바이트 수
  for(let i=0; i<rows.length; i++){
    const rowBytes = byteLengthOf([rows[i]]) - 2; // 그 행 하나만의 순수 바이트 수(대괄호 제외)
    const addedBytes = rowBytes + (current.length > 0 ? 1 : 0); // 쉼표 1바이트(첫 행이면 없음)
    if(current.length > 0 && currentBytes + addedBytes > maxBytes){
      chunks.push(current);
      current = [rows[i]];
      currentBytes = 2 + rowBytes;
    } else {
      current.push(rows[i]);
      currentBytes += addedBytes;
    }
  }
  if(current.length > 0) chunks.push(current);
  return chunks.length ? chunks : [[]];
}

async function saveUpload(id){
  const cfg = UPLOAD_CONFIGS[id];
  const st = uploadState[id];
  setUploadSaveState(id, 'saving');
  try{
    const now = new Date().toISOString();
    const chunks = splitRowsIntoChunks(st.rows, MAX_VALUE_BYTES);
    const isChunked = chunks.length > 1;
    const prevChunkVersion = st.chunkVersion || null;
    // 매번 새 버전표(타임스탬프+임의값)를 붙여서, 새 조각을 예전 조각 자리에 덮어쓰지 않고 항상
    // 새 이름으로 저장해요. 이러면 저장 도중 일부만 성공하고 실패해도, 예전 조각은 하나도
    // 손대지 않은 채로 온전히 남아있어서 "일부는 새 데이터, 일부는 예전 데이터" 식으로 섞이는
    // 문제(예전 방식의 진짜 위험 지점이었어요)가 안 생겨요.
    const newVersion = Date.now().toString(36) + Math.random().toString(36).slice(2, 6);

    // 1) 새 조각을 전부 "새 버전" 이름으로 저장합니다. 예전 조각은 이 단계에서 전혀 안 건드려요.
    if(isChunked){
      for(let i=0; i<chunks.length; i++){
        setUploadSaveState(id, 'saving', `저장 중... (${i+1}/${chunks.length})`);
        await storageSetWithRetry(cfg.storageKey + '_v' + newVersion + '_chunk_' + i, JSON.stringify(chunks[i]), true);
      }
    }

    const metaPayload = {
      headers: st.headers, sheetUsed: st.sheetUsed, uploadedAt: st.uploadedAt, fileName: st.fileName, savedAt: now,
      chunked: isChunked, chunkCount: chunks.length, chunkVersion: isChunked ? newVersion : null,
      trimmedColumns: st.trimmedColumns || null, fileMonth: st.fileMonth || null
    };
    if(!isChunked) metaPayload.rows = chunks[0];

    // 2) 메타데이터를 새 버전표로 갱신합니다 — 이 한 번의 쓰기가 성공해야 "새 데이터로 완전히
    //    바뀌었다"고 확정돼요. 여기서 실패해도 예전 메타데이터가 예전 버전의 조각들을 그대로
    //    가리키고 있어서 안전해요(새로 쓴 조각들은 그냥 안 쓰는 채로 남을 뿐이에요).
    await storageSetWithRetry(cfg.storageKey, JSON.stringify(metaPayload), true);

    // 3) 이제 메타데이터가 새 버전을 가리키니, 예전 버전의 조각들은 더 이상 안 쓰여요 — 정리합니다.
    //    이 정리가 실패해도(그냥 안 쓰는 조각이 남는 것뿐) 이미 새 데이터로 안전하게 넘어간 뒤라 문제없어요.
    if(prevChunkVersion){
      const prevChunkCount = st.chunkCount || 0;
      for(let i=0; i<prevChunkCount; i++){
        try{ await window.storage.delete(cfg.storageKey + '_v' + prevChunkVersion + '_chunk_' + i, true); }catch(e){}
      }
    } else if(st.chunkCount){
      // 예전 버전 표시 없이 저장된(이전 방식으로 저장된) 데이터가 있으면, 옛 이름 규칙으로도 정리해줍니다.
      for(let i=0; i<st.chunkCount; i++){
        try{ await window.storage.delete(cfg.storageKey + '_chunk_' + i, true); }catch(e){}
      }
    }

    st.savedAt = now;
    st.chunkCount = chunks.length;
    st.chunkVersion = isChunked ? newVersion : null;
    lastSavedAt = now;
    updateGlobalSavedLabel();
    updateUploadMeta(id);
    setUploadSaveState(id, 'saved');
  }catch(e){
    setUploadSaveState(id, 'error', (e && e.message) || String(e));
  }
}

async function loadUploadFromStorage(id){
  const cfg = UPLOAD_CONFIGS[id];
  try{
    const res = await window.storage.get(cfg.storageKey, true);
    if(res && res.value){
      const parsed = JSON.parse(res.value);
      let rows = parsed.rows || [];
      let missingChunks = 0;
      if(parsed.chunked){
        const chunkKeyPrefix = parsed.chunkVersion
          ? cfg.storageKey + '_v' + parsed.chunkVersion + '_chunk_'
          : cfg.storageKey + '_chunk_'; // 이 버전 표시(chunkVersion) 도입 전에 저장된 예전 데이터 호환용
        const chunkResults = await Promise.all(
          Array.from({length: parsed.chunkCount}, (_, i) =>
            storageGetWithRetry(chunkKeyPrefix + i, true).catch(()=>null)
          )
        );
        rows = [];
        chunkResults.forEach(r=>{
          if(r && r.value) rows = rows.concat(JSON.parse(r.value));
          else missingChunks++;
        });
        if(missingChunks > 0){
          console.error(`${cfg.label || id}: 저장된 ${parsed.chunkCount}개 조각 중 ${missingChunks}개를 못 불러왔어요 — 일부 행이 빠진 채로 표시될 수 있어요. 새로고침해서 다시 시도해보시거나, 계속되면 다시 업로드해주세요.`);
        }
      }
      uploadState[id] = {
        headers: parsed.headers, rows, page:0, pageSize:50,
        sort:{key:null,dir:1}, sheetUsed: parsed.sheetUsed, uploadedAt: parsed.uploadedAt, fileName: parsed.fileName,
        savedAt: parsed.savedAt || parsed.uploadedAt, chunkCount: parsed.chunked ? parsed.chunkCount : 0,
        chunkVersion: parsed.chunked ? (parsed.chunkVersion || null) : null,
        trimmedColumns: parsed.trimmedColumns || null,
        missingChunks: missingChunks || 0,
        fileMonth: parsed.fileMonth || (STOCK_WAREHOUSES.some(p=>p.id===id) ? fileMonthKeyOf(parsed.fileName) : null)
      };
      if(id === 'productMaster') autoMarkSplitByRepCode(uploadState[id]);
      if(parsed.savedAt && (!lastSavedAt || parsed.savedAt > lastSavedAt)){ lastSavedAt = parsed.savedAt; updateGlobalSavedLabel(); }
      renderUploadTable(id);
      updateUploadMeta(id);
      if(id === 'pumjeoldata') recomputeFromPumjeoldata();
      if(id === 'finalorder') recomputeFromFinalOrder();
      if(id === 'usage3m') recomputeFromUsage3m();
      if(id === 'vendorMaster') { if(ensureVendorMasterReturnNoteColumn()){ renderUploadTable('vendorMaster'); await saveUpload('vendorMaster'); } recomputeFromManager(); refreshStockViews(); }
      if(STOCK_WAREHOUSES.some(p=>p.id===id)) { refreshStockViews(); }
    }
  }catch(e){ /* nothing saved yet */ }
}

// 지금 저장돼있는 데이터를 그대로 엑셀 파일로 다시 내려받을 수 있게 해줘요 — 백업용으로 쓰거나,
// 대시보드 없이 PC 엑셀에서 따로 작업하고 싶을 때 원본 대신 이 파일을 쓰시면 돼요.
function downloadUploadedData(id){
  const st = uploadState[id];
  if(!st || !st.rows || !st.rows.length){ alert('다운로드할 데이터가 아직 없어요.'); return; }
  const cfg = UPLOAD_CONFIGS[id] || {};
  const aoa = [st.headers, ...st.rows];
  const ws = XLSX.utils.aoa_to_sheet(aoa);
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, 'Sheet1');
  const safeName = (cfg.label || id).replace(/[\\/:*?"<>|]/g, '_');
  XLSX.writeFile(wb, `${safeName}_${todayKey()}.xlsx`, { bookType:'xlsx' });
}

// 업로드 항목마다 있는 "초기화/데이터 지우기" 버튼 바로 앞에, 다운로드 버튼을 자동으로 하나씩 추가해요.
// 업로드 종류가 많아서(마스터DB·재고·품절 등) HTML을 하나하나 다 고치는 대신, 있는 버튼을 기준으로
// 한 번에 붙여넣어요 — 새 업로드 항목이 추가돼도 자동으로 같이 생겨요.
function addDownloadButtonsForUploads(){
  Object.keys(UPLOAD_CONFIGS).forEach(id=>{
    const clearBtn = document.getElementById('clear-' + id);
    if(!clearBtn || document.getElementById('download-' + id)) return;
    const btn = document.createElement('button');
    btn.className = 'btn';
    btn.id = 'download-' + id;
    btn.textContent = '⬇ 저장된 자료 다운로드';
    btn.style.display = 'none';
    btn.addEventListener('click', ()=> downloadUploadedData(id));
    clearBtn.parentNode.insertBefore(btn, clearBtn);
  });
}

function updateUploadMeta(id){
  const st = uploadState[id];
  const meta = document.getElementById('meta-' + id);
  const clearBtn = document.getElementById('clear-' + id);
  const downloadBtn = document.getElementById('download-' + id);
  const saveBtn = document.getElementById('save-' + id);
  const saveState = document.getElementById('saveState-' + id);
  const toolbar = document.getElementById('toolbar-' + id);
  const scroll = document.getElementById('scroll-' + id);
  if(!st){
    meta.textContent = '아직 업로드된 데이터가 없어요';
    clearBtn.style.display = 'none';
    if(downloadBtn) downloadBtn.style.display = 'none';
    if(saveBtn) saveBtn.style.display = 'none';
    if(saveState) saveState.style.display = 'none';
    toolbar.style.display = 'none';
    scroll.style.display = 'none';
    return;
  }
  const dt = new Date(st.uploadedAt);
  const savedPart = st.savedAt ? ` · <span style="color:var(--teal-ink); font-weight:700;">최종 저장 ${formatSavedTime(st.savedAt)}</span>` : '';
  const trimPart = st.trimmedColumns
    ? ` · <span style="color:var(--ink-dim);">필요한 컬럼만 저장됨 (원본 ${st.trimmedColumns.original}개 → ${st.trimmedColumns.kept}개)</span>`
    : '';
  const missingPart = st.missingChunks
    ? ` · <span style="color:var(--red); font-weight:800;">⚠ 일부 데이터를 못 불러왔어요(${st.missingChunks}개 조각 실패) — 새로고침해서 다시 시도해보시거나, 계속되면 다시 업로드해주세요</span>`
    : '';
  meta.innerHTML = `${dt.toLocaleString('ko-KR')} 업로드${savedPart}${trimPart}${missingPart}`;
  meta.title = meta.textContent;
  clearBtn.style.display = 'inline-flex';
  if(downloadBtn) downloadBtn.style.display = 'inline-flex';
  if(saveBtn) saveBtn.style.display = 'inline-flex';
  if(saveState){ saveState.style.display = 'flex'; setUploadSaveState(id, st.savedAt ? 'saved' : 'idle'); }
  toolbar.style.display = 'flex';
  scroll.style.display = 'block';
}

function renderUploadTable(id){
  const st = uploadState[id];
  if(!st) return;
  const cfg = UPLOAD_CONFIGS[id] || {};
  const head = document.getElementById('head-' + id);
  head.innerHTML = st.headers.map((h,i)=>{
    let arrow = '';
    if(st.sort.key === i) arrow = `<span class="arrow">${st.sort.dir===1?'▲':'▼'}</span>`;
    return `<th data-col="${i}">${escapeHtml(h)}${arrow}</th>`;
  }).join('');
  head.querySelectorAll('th').forEach(th=>{
    th.addEventListener('click', ()=>{
      const col = Number(th.dataset.col);
      if(st.sort.key === col) st.sort.dir *= -1;
      else { st.sort.key = col; st.sort.dir = 1; }
      st.page = 0;
      renderUploadTable(id);
    });
  });

  const q = (document.getElementById('search-' + id).value || '').trim().toLowerCase();
  let rows = st.rows.map((r, idx)=>({r, idx}));
  if(q){
    rows = rows.filter(({r}) => r.some(v => v!==null && String(v).toLowerCase().includes(q)));
  }
  if(st.sort.key !== null){
    const k = st.sort.key, d = st.sort.dir;
    rows.sort((a,b)=>{
      let av = a.r[k], bv = b.r[k];
      if(typeof av === 'number' && typeof bv === 'number') return (av-bv)*d;
      av = String(av ?? ''); bv = String(bv ?? '');
      return av.localeCompare(bv, 'ko') * d;
    });
  }

  document.getElementById('count-' + id).textContent = `${rows.length.toLocaleString()} / ${st.rows.length.toLocaleString()}건`;

  const totalPages = cfg.noPagination ? 1 : Math.max(1, Math.ceil(rows.length / st.pageSize));
  if(!cfg.noPagination && st.page >= totalPages) st.page = totalPages - 1;
  const start = cfg.noPagination ? 0 : st.page * st.pageSize;
  const pageRows = cfg.noPagination ? rows : rows.slice(start, start + st.pageSize);

  const body = document.getElementById('body-' + id);
  if(cfg.readOnly){
    body.innerHTML = pageRows.map(({r})=>{
      return '<tr>' + r.map((v)=>{
        const display = (v===null||v===undefined) ? '' : v;
        const cls = typeof v === 'number' ? 'num' : '';
        return `<td class="${cls}">${escapeHtml(display)}</td>`;
      }).join('') + '</tr>';
    }).join('');
  } else {
    body.innerHTML = pageRows.map(({r, idx})=>{
      return '<tr>' + r.map((v, colIdx)=>{
        const display = (v===null||v===undefined) ? '' : v;
        const cls = typeof v === 'number' ? 'num editable' : 'editable';
        return `<td class="${cls}" contenteditable="true" data-idx="${idx}" data-col="${colIdx}">${escapeHtml(display)}</td>`;
      }).join('') + '</tr>';
    }).join('');

    body.querySelectorAll('td[contenteditable]').forEach(td=>{
      td.addEventListener('blur', (e)=>{
        const idx = Number(td.dataset.idx);
        const col = Number(td.dataset.col);
        let val = td.textContent.trim();
        const orig = st.rows[idx][col];
        if(typeof orig === 'number'){
          const n = Number(val.replace(/,/g,''));
          val = isNaN(n) ? val : n;
        }
        st.rows[idx][col] = val;
        td.classList.add('edited');
        saveUpload(id);
        if(id === 'vendorMaster'){ recomputeFromManager(); refreshStockViews(); }
      });
      td.addEventListener('keydown', (e)=>{ if(e.key==='Enter'){ e.preventDefault(); td.blur(); } });
    });
  }

  if(cfg.noPagination){
    const pagerEl = document.getElementById('pager-' + id);
    if(pagerEl) pagerEl.innerHTML = '';
  } else {
    renderPager(id, totalPages);
  }
}

function renderPager(id, totalPages){
  const st = uploadState[id];
  const pager = document.getElementById('pager-' + id);
  pager.innerHTML = `
    <button data-act="first" ${st.page===0?'disabled':''}>≪</button>
    <button data-act="prev" ${st.page===0?'disabled':''}>‹ 이전</button>
    <span>${st.page+1} / ${totalPages} 페이지</span>
    <button data-act="next" ${st.page>=totalPages-1?'disabled':''}>다음 ›</button>
    <button data-act="last" ${st.page>=totalPages-1?'disabled':''}>≫</button>
  `;
  pager.querySelectorAll('button').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      if(btn.dataset.act === 'first') st.page = 0;
      else if(btn.dataset.act === 'prev') st.page = Math.max(0, st.page-1);
      else if(btn.dataset.act === 'next') st.page = st.page+1;
      else if(btn.dataset.act === 'last') st.page = totalPages-1;
      renderUploadTable(id);
    });
  });
}

function bindUploadTab(id){
  const fileInput = document.getElementById('file-' + id);
  const dropLabel = document.querySelector(`label[for="file-${id}"]`);
  fileInput.addEventListener('change', (e)=>{
    if(e.target.files && e.target.files[0]) handleFile(id, e.target.files[0]);
  });
  ['dragover','dragenter'].forEach(ev=> dropLabel.addEventListener(ev, (e)=>{ e.preventDefault(); dropLabel.classList.add('dragover'); }));
  ['dragleave','drop'].forEach(ev=> dropLabel.addEventListener(ev, (e)=>{ e.preventDefault(); dropLabel.classList.remove('dragover'); }));
  dropLabel.addEventListener('drop', (e)=>{
    const f = e.dataTransfer.files && e.dataTransfer.files[0];
    if(f) handleFile(id, f);
  });
  document.getElementById('search-' + id).addEventListener('input', ()=>{ uploadState[id] && (uploadState[id].page = 0); renderUploadTable(id); });
  const saveBtnEl = document.getElementById('save-' + id);
  if(saveBtnEl){
    saveBtnEl.addEventListener('click', ()=>{ if(uploadState[id]) saveUpload(id); });
  }
  const saveStateEl = document.getElementById('saveState-' + id);
  if(saveStateEl){
    saveStateEl.addEventListener('click', ()=>{ if(uploadState[id]) saveUpload(id); });
  }
  document.getElementById('clear-' + id).addEventListener('click', async ()=>{
    const isMasterDb = (id === 'productMaster' || id === 'vendorMaster');
    const confirmMsg = isMasterDb
      ? (UPLOAD_CONFIGS[id].label + ' 데이터를 모두 지울까요? 이 작업은 되돌릴 수 없습니다.')
      : (UPLOAD_CONFIGS[id].label + ' 업로드 데이터를 지울까요? 목록/담당자별 현황도 원본 값으로 되돌아갑니다.');
    if(!confirm(confirmMsg)) return;
    // clean up chunked rows too; if we don't know the exact chunk count (e.g. saved in another
    // session), try a generous upper bound — deleting a non-existent key is harmless here.
    const knownChunkCount = (uploadState[id] && uploadState[id].chunkCount) || 0;
    const chunkDeleteAttempts = Math.max(knownChunkCount, 40);
    delete uploadState[id];
    try{ await window.storage.delete(UPLOAD_CONFIGS[id].storageKey, true); }catch(e){ console.error(`마스터DB(${id}) 삭제 실패:`, e); }
    for(let i=0; i<chunkDeleteAttempts; i++){
      try{ await window.storage.delete(UPLOAD_CONFIGS[id].storageKey + '_chunk_' + i, true); }catch(e){ console.error(`마스터DB(${id}) 청크 삭제 실패:`, e); }
    }
    updateUploadMeta(id);
    if(id === 'pumjeoldata'){
      listData.forEach((row, i)=>{
        const o = ORIGINAL_LIST[i];
        if(!o) return; // 원본 목록엔 없던 신규 거래처(다른 업로드로 나중에 추가된 행)는 되돌릴 원본값이 없어서 건드리지 않아요.
        row.stockout = o.stockout; row.noOrder = o.noOrder; row.expected = o.expected;
        row.noOrder2 = o.noOrder2; row.totalNoOrder = o.totalNoOrder; row.status = o.status;
      });
      recomputeManagerSummary();
      renderKpis(); renderListTable(); renderMgrTable(); scheduleSave();
    }
    if(id === 'finalorder'){
      listData.forEach((row, i)=>{ const o = ORIGINAL_LIST[i]; if(o) row.lastOrderDate = o.lastOrderDate; });
      renderKpis(); renderListTable(); scheduleSave();
    }
    if(id === 'usage3m'){
      listData.forEach((row, i)=>{ const o = ORIGINAL_LIST[i]; if(o) row.itemCount = o.itemCount; });
      recomputeManagerSummary();
      renderKpis(); renderListTable(); renderMgrTable(); scheduleSave();
    }
    if(id === 'ordermgr'){
      // 이 업로드는 거래처정보마스터DB를 갱신하는 보조 파일일 뿐이므로, 지워도 이미 반영된
      // 거래처정보마스터DB 값은 그대로 유지하고 목록을 그 값 기준으로 다시 맞춥니다.
      recomputeFromManager();
      refreshStockViews();
    }
    if(id === 'returnmgr' || STOCK_WAREHOUSES.some(p=>p.id===id)){
      refreshStockViews();
    }
    if(id === 'vendorMaster'){
      listData.forEach((row, i)=>{
        const o = ORIGINAL_LIST[i];
        if(!o) return; // 원본 목록엔 없던 신규 거래처는 되돌릴 원본값이 없어서 건드리지 않아요.
        row.managerPrev = o.managerPrev; row.manager = o.manager;
        row.paymentBasis = o.paymentBasis; row.turn = o.turn; row.region = o.region;
      });
      recomputeManagerSummary();
      buildFilterOptions();
      renderKpis(); renderListTable(); renderMgrTable(); scheduleSave();
      refreshStockViews();
    }
  });
}

// 다미스제품코드마스터DB와 거래처정보마스터DB는 서로 다른 종류의 코드 체계를 쓰고
// (제품코드가 거래처코드와 우연히 겹칠 수 있음) 자동으로 섞이면 안 되므로,
// 두 마스터DB는 완전히 독립적으로 관리합니다 — 자동으로 새 행을 만들지 않습니다.
// 다만 발주담당자/반품담당자 업로드는 거래처정보마스터DB에 '이미 있는' 행을 찾아
// 해당 컬럼 값만 갱신해줍니다 (새 거래처를 추가하지는 않음).
function applyToVendorMaster(sourceId, fieldMappings){
  const src = uploadState[sourceId];
  const vm = uploadState['vendorMaster'];
  if(!src || !vm) return 0;
  const srcHeaders = src.headers;
  const idxSrcCode = findHeaderIndex(srcHeaders, '다미스코드', '코드');
  const idxSrcClient = findHeaderIndex(srcHeaders, '매입처명', '거래처명', '거래처');
  const vmHeaders = vm.headers;
  const idxVmCode = findHeaderIndex(vmHeaders, '다미스코드', '코드');
  const idxVmClient = findHeaderIndex(vmHeaders, '매입처명', '거래처명', '거래처');
  if(idxVmCode === -1 && idxVmClient === -1) return 0;

  const resolved = fieldMappings.map(fm=>{
    const idx = findHeaderIndex(srcHeaders, ...fm.sourceCandidates);
    const vmIdx = vmHeaders.indexOf(fm.target);
    return { idx, vmIdx };
  }).filter(x => x.idx !== -1 && x.vmIdx !== -1);
  if(resolved.length === 0) return 0;

  const byCode = new Map(), byClient = new Map();
  src.rows.forEach(r=>{
    if(idxSrcCode !== -1 && r[idxSrcCode]) byCode.set(String(r[idxSrcCode]).trim(), r);
    if(idxSrcClient !== -1 && r[idxSrcClient]) byClient.set(String(r[idxSrcClient]).trim(), r);
  });

  let matched = 0;
  vm.rows.forEach(row=>{
    const code = idxVmCode !== -1 ? String(row[idxVmCode]||'').trim() : '';
    const client = idxVmClient !== -1 ? String(row[idxVmClient]||'').trim() : '';
    const r = (code && byCode.get(code)) || (client && byClient.get(client));
    if(!r) return;
    let touched = false;
    resolved.forEach(({idx, vmIdx})=>{
      const v = r[idx];
      if(v !== undefined && v !== null && v !== ''){ row[vmIdx] = v; touched = true; }
    });
    if(touched) matched++;
  });
  return matched;
}

async function syncOrdermgrToVendorMaster(){
  if(!uploadState['vendorMaster']) return;
  const matched = applyToVendorMaster('ordermgr', [
    { target: '발주담당자', sourceCandidates: ['발주담당\n(변경후)', '발주담당(변경후)', '발주담당변경후', '발주담당'] },
    { target: '결제기준일', sourceCandidates: ['결제기준일'] },
    { target: '회전', sourceCandidates: ['회전'] },
    { target: '배송지', sourceCandidates: ['배송지'] }
  ]);
  if(matched > 0){
    renderUploadTable('vendorMaster');
    updateUploadMeta('vendorMaster');
    await saveUpload('vendorMaster');
  }
}

async function syncReturnmgrToVendorMaster(){
  if(!uploadState['vendorMaster']) return;
  const matched = applyToVendorMaster('returnmgr', [
    { target: '반품담당자', sourceCandidates: ['반품담당자'] }
  ]);
  if(matched > 0){
    renderUploadTable('vendorMaster');
    updateUploadMeta('vendorMaster');
    await saveUpload('vendorMaster');
  }
}

async function initUploadTabs(){
  Object.keys(UPLOAD_CONFIGS).forEach(bindUploadTab);
  addDownloadButtonsForUploads();
  // 예전엔 for...await로 하나씩 순서대로 불러와서(17개), 느린 항목 하나가 전체를 지연시켰어요.
  // 각 항목은 서로 다른 storageKey를 쓰는 독립적인 조회라 순서 자체는 상관없지만, 품절현황/담당자별
  // 현황 계산(pumjeoldata→finalorder→usage3m→vendorMaster 순으로 서로의 결과에 얹혀요)은 예전 순차 로딩이
  // 우연히 이 순서를 보장해줬던 거라, 병렬로 바꾸면 그 보장이 깨져요. 그래서 다 불러온 뒤 이 체인만
  // 정확한 순서로 한 번 더 확정 재계산해서, 어느 게 먼저 끝나든 항상 같은(맞는) 결과가 나오게 했어요.
  await Promise.all(Object.keys(UPLOAD_CONFIGS).map(id => loadUploadFromStorage(id)));
  recomputeFromPumjeoldata();
  recomputeFromFinalOrder();
  recomputeFromUsage3m();
  recomputeFromManager();
  buildFilterOptions();
  renderKpis();
  renderListTable();
  renderMgrTable();
  ['ordermgr','returnmgr'].forEach(addUploadPasteUI);
}

// 드래그 업로드 칸 밑에 "붙여넣기로 대신하기" 토글을 추가합니다. 열면 텍스트칸+적용 버튼이 나오고,
// 엑셀에서 복사한 데이터(헤더 포함)를 붙여넣으면 파일 업로드와 똑같은 처리를 거칩니다.
function addUploadPasteUI(id){
  const bar = document.getElementById('upload-' + id + '-bar');
  if(!bar) return;
  bar.style.display = 'none'; // 화면에는 붙여넣기만 보이게 하고, 파일 업로드 요소는 남겨둡니다(기존 로직이 참조해서).
  const wrap = document.createElement('div');
  wrap.innerHTML = `
    <div id="pasteBox-${id}">
      <textarea id="pasteText-${id}" placeholder="엑셀에서 복사한 데이터를 헤더 포함해서 붙여넣으세요 (Ctrl+V)" style="width:100%; min-height:100px; font-family:var(--mono); font-size:12px; padding:8px; border:1px solid var(--line); border-radius:8px; box-sizing:border-box;"></textarea>
      <div class="foot-row" style="justify-content:flex-end; margin-top:6px;">
        <button class="btn primary" id="pasteApply-${id}" style="font-size:12px;">💾 붙여넣은 데이터 적용</button>
      </div>
    </div>`;
  bar.insertAdjacentElement('afterend', wrap);
  document.getElementById(`pasteApply-${id}`).addEventListener('click', async ()=>{
    const text = document.getElementById(`pasteText-${id}`).value;
    if(!text.trim()){ alert('붙여넣을 데이터가 없어요.'); return; }
    await handleUploadPaste(id, text);
  });
}

// ---------- recompute 목록 / 담당자별 현황 from uploaded raw sheets ----------
// Mirrors the original workbook's own formulas:
//   품절(D)      = COUNTIFS(품절data!우선처=거래처, 품절data!재고상태="품절")
//   미발주(E)    = D - COUNTIFS(품절data!<2번째 열> = 거래처+"품절")   (그 열은 "이미 처리됨" 표시가 섞여있는 원본의 보조열)
//   품절예상(F)  = COUNTIFS(우선처=거래처, 재고상태="예상")
//   미발주2(G)   = F - COUNTIFS(<2번째 열> = 거래처+"예상")
//   최종발주일   = 최종발주일 업로드에서 해당 거래처(발주처)로 처음 매칭되는 발주일자
//                 (원본처럼 최신순 정렬을 가정합니다)
// 취급품목수·발주담당자·결제기준일·회전은 '3개월사용품목'/'발주담당자' 시트가 있어야 계산되므로
// 이 대시보드에서는 건드리지 않고 기존 값을 유지합니다.
// 업로드된 원본(품절data, 3개월사용품목 등)에 있는 거래처가 아직 품절 현황 목록에 없으면
// 새 행을 자동으로 만들어 추가합니다. 코드가 있으면 코드로, 없으면 거래처명으로 기존 행을 찾습니다.
function findOrCreateListRow(client, code){
  const c = code ? String(code).trim() : '';
  let row = null;
  if(c) row = listData.find(r => String(r.code || '').trim() === c);
  if(!row && client) row = listData.find(r => r.client === client);
  if(!row){
    row = {
      code: c || '', client: client || '', itemCount: 0, stockout: 0, noOrder: 0,
      expected: 0, noOrder2: 0, totalNoOrder: 0, lastOrderDate: '', region: '',
      manager: '', paymentBasis: '', turn: '', status: '품절없음', monthStart: ''
    };
    listData.push(row);
  }
  return row;
}

function recomputeFromPumjeoldata(){
  const up = uploadState['pumjeoldata'];
  const banner = document.getElementById('meta-pumjeoldata');
  if(!up) return;
  const headers = up.headers;
  const idxV = headers.indexOf('재고상태');
  const idxAB = headers.indexOf('우선처');
  const idxBalju = headers.indexOf('발주미입');
  if(idxV === -1 || idxAB === -1){
    banner.innerHTML += ' <span style="color:var(--red)">⚠ "재고상태"/"우선처" 컬럼을 찾지 못해 목록/담당자별 현황을 갱신하지 못했어요.</span>';
    return;
  }
  // 미발주 = 재고상태가 품절/예상이면서 '발주미입' 수량이 없는(=0 또는 공백) 건.
  // '발주미입'에 수량이 있으면 이미 발주가 들어간 것으로 보고 미발주에서 제외.
  const hasBaljuCol = idxBalju !== -1;
  const isUnordered = (v)=> v===null || v===undefined || v==='' || Number(v)===0;
  // 코드 컬럼이 있으면 신규 거래처 생성 시 코드도 함께 채웁니다.
  const idxCode = findHeaderIndex(headers, '다미스코드', '코드', '거래처코드');

  const soCount = {}, soUnordered = {}, expCount = {}, expUnordered = {}, clientToCode = {};
  up.rows.forEach(r=>{
    const client = r[idxAB];
    const status = r[idxV];
    const balju = hasBaljuCol ? r[idxBalju] : null;
    if(!client) return;
    if(idxCode !== -1 && r[idxCode] && !clientToCode[client]) clientToCode[client] = r[idxCode];
    if(status === '품절'){
      soCount[client] = (soCount[client]||0) + 1;
      if(hasBaljuCol && isUnordered(balju)) soUnordered[client] = (soUnordered[client]||0) + 1;
    } else if(status === '예상'){
      expCount[client] = (expCount[client]||0) + 1;
      if(hasBaljuCol && isUnordered(balju)) expUnordered[client] = (expUnordered[client]||0) + 1;
    }
  });

  // 목록에 없는 거래처는 새 행으로 자동 생성합니다.
  const newClients = new Set([...Object.keys(soCount), ...Object.keys(expCount)]);
  let createdCount = 0;
  newClients.forEach(c=>{
    const existed = listData.some(r=>r.client===c);
    findOrCreateListRow(c, clientToCode[c]);
    if(!existed) createdCount++;
  });

  listData.forEach(row=>{
    const c = row.client;
    const D = soCount[c] || 0;
    const F = expCount[c] || 0;
    row.stockout = D;
    row.expected = F;
    if(hasBaljuCol){
      const E = soUnordered[c] || 0;
      const G = expUnordered[c] || 0;
      row.noOrder = E;
      row.noOrder2 = G;
      row.totalNoOrder = E + G;
    }
    row.status = (D + F) > 0 ? '품절' : '품절없음';
  });

  recomputeManagerSummary();
  renderKpis(); renderListTable(); renderMgrTable();
  buildFilterOptions();
  scheduleSave();
  const createdNote = createdCount ? ` · 목록에 없던 거래처 ${createdCount.toLocaleString()}곳을 새로 추가했어요` : '';
  if(hasBaljuCol){
    banner.innerHTML += ` <span style="color:var(--teal)">✓ 품절 현황 목록·담당자별 현황에 반영됨${createdNote}</span>`;
  } else {
    banner.innerHTML += ` <span style="color:var(--amber)">✓ 품절/품절예상 수는 갱신됨. 다만 "발주미입" 컬럼을 찾지 못해 미발주 수치는 이전 값을 그대로 유지했어요${createdNote}.</span>`;
  }
}

function recomputeFromFinalOrder(){
  const up = uploadState['finalorder'];
  const banner = document.getElementById('meta-finalorder');
  if(!up) return;
  const headers = up.headers;
  const idxClient = headers.indexOf('발주처');
  const idxDate = headers.indexOf('발주일자');
  if(idxClient === -1 || idxDate === -1){
    banner.innerHTML += ' <span style="color:var(--red)">⚠ "발주처"/"발주일자" 컬럼을 찾지 못해 최종발주일을 갱신하지 못했어요.</span>';
    return;
  }
  const firstMatch = {};
  up.rows.forEach(r=>{
    const c = r[idxClient];
    if(c && !(c in firstMatch)) firstMatch[c] = r[idxDate];
  });

  listData.forEach(row=>{
    row.lastOrderDate = (row.client in firstMatch) ? firstMatch[row.client] : '누락';
  });

  renderKpis(); renderListTable();
  scheduleSave();
  banner.innerHTML += ' <span style="color:var(--teal)">✓ 품절 현황 목록의 최종발주일에 반영됨</span>';
}

const MANAGER_WHITELIST = ['이상연','서호진','최형욱','김은경','전송이','유아름','예상화','김동재'];

function recomputeManagerSummary(){
  const groups = {};
  // 지정된 담당자는 현재 담당 거래처가 없어도(예: 예상화) 항상 표에 표시합니다.
  MANAGER_WHITELIST.forEach(m=>{ groups[m] = { itemCount:0, clients:new Set(), soCount:0, soOrdered:0, expCount:0, expOrdered:0 }; });
  listData.forEach(row=>{
    const raw = row.manager || '기타';
    const m = MANAGER_WHITELIST.includes(raw) ? raw : '기타';
    if(!groups[m]) groups[m] = { itemCount:0, clients:new Set(), soCount:0, soOrdered:0, expCount:0, expOrdered:0 };
    const g = groups[m];
    g.itemCount += Number(row.itemCount) || 0;
    g.clients.add(row.client);
    const D = Number(row.stockout) || 0;
    const E = Number(row.noOrder) || 0;
    const F = Number(row.expected) || 0;
    const G = Number(row.noOrder2) || 0;
    g.soCount += D;
    g.soOrdered += (D - E);
    g.expCount += F;
    g.expOrdered += (F - G);
  });

  const managers = Object.keys(groups);
  const totalItem = managers.reduce((a,m)=>a+groups[m].itemCount, 0);
  const totalSo = managers.reduce((a,m)=>a+groups[m].soCount, 0);
  const totalExp = managers.reduce((a,m)=>a+groups[m].expCount, 0);

  const div = (a,b)=> b ? a/b : 0;

  const namedManagers = managers.filter(m=>m!=='기타').sort((a,b)=>a.localeCompare(b,'ko'));
  const orderedManagers = managers.includes('기타') ? namedManagers.concat(['기타']) : namedManagers;

  mgrData = orderedManagers.map(m=>{
    const g = groups[m];
    const soNoOrder = g.soCount - g.soOrdered;
    const expNoOrder = g.expCount - g.expOrdered;
    return {
      manager: m,
      itemCount: g.itemCount,
      clientCount: g.clients.size,
      soCount: g.soCount,
      soRate: div(g.soCount, totalSo),
      soOrdered: g.soOrdered,
      soOrderRate: div(g.soOrdered, g.soCount),
      soNoOrder: soNoOrder,
      soNoOrderRate: div(soNoOrder, g.itemCount),
      expCount: g.expCount,
      expRate: div(g.expCount, totalExp),
      expOrdered: g.expOrdered,
      expOrderRate: div(g.expOrdered, g.expCount),
      expNoOrder: expNoOrder,
      expNoOrderRate: div(expNoOrder, g.itemCount),
      itemShare: div(g.itemCount, totalItem),
      soShare: div(g.soCount, totalItem),
    };
  });

  mgrData.push({
    manager: '전체',
    itemCount: totalItem,
    clientCount: managers.reduce((a,m)=>a+groups[m].clients.size, 0),
    soCount: totalSo,
    soRate: div(totalSo, totalItem),
    soOrdered: managers.reduce((a,m)=>a+groups[m].soOrdered,0),
    soOrderRate: div(managers.reduce((a,m)=>a+groups[m].soOrdered,0), totalSo),
    soNoOrder: totalSo - managers.reduce((a,m)=>a+groups[m].soOrdered,0),
    soNoOrderRate: div(totalSo - managers.reduce((a,m)=>a+groups[m].soOrdered,0), totalItem),
    expCount: totalExp,
    expRate: div(totalExp, totalItem),
    expOrdered: managers.reduce((a,m)=>a+groups[m].expOrdered,0),
    expOrderRate: div(managers.reduce((a,m)=>a+groups[m].expOrdered,0), totalExp),
    expNoOrder: totalExp - managers.reduce((a,m)=>a+groups[m].expOrdered,0),
    expNoOrderRate: div(totalExp - managers.reduce((a,m)=>a+groups[m].expOrdered,0), totalItem),
    itemShare: 1,
    soShare: div(totalSo, totalItem),
  });
}

function recomputeFromUsage3m(){
  const up = uploadState['usage3m'];
  const banner = document.getElementById('meta-usage3m');
  if(!up) return;
  const headers = up.headers;

  // 거래처 식별: '우선처' 컬럼 기준으로 사용품목수를 집계합니다.
  const idxClient = findHeaderIndex(headers, '우선처');
  if(idxClient === -1){
    banner.innerHTML += ' <span style="color:var(--red)">⚠ "우선처" 컬럼을 찾지 못해 취급품목수를 갱신하지 못했어요.</span>';
    return;
  }

  // 사용여부 판정: 헤더에 "매출", "매입", "가용"이라는 단어가 들어간 컬럼(純매출/純매입 계열, 現가용)을 모두 찾아
  // 그 값의 합이 양수인 행만 "사용 품목"으로 보고 우선처별 개수를 집계합니다.
  // (날짜/가격/비율 컬럼 오매칭을 피하기 위해 "純매출"·"純매입"·"가용" 패턴으로 매칭합니다 — 예: 05純매출, 06純매출, 07純매입, 現가용 등)
  const norm = s => String(s ?? '').replace(/\s+/g,'');
  const findCols = (...keywords) => headers
    .map((h,i)=>({h:norm(h), i}))
    .filter(({h}) => keywords.some(k => h.includes(k)))
    .map(({i}) => i);
  const idxUsage = findCols('純매출','純매입','가용');
  const usageColLabels = idxUsage.map(i=>headers[i]);
  const hasUsageCols = idxUsage.length > 0;

  const toNum = v => { const n = Number(String(v ?? '').replace(/,/g,'')); return isNaN(n) ? 0 : n; };
  const rowQualifies = r => {
    if(idxUsage.length === 0) return true; // 기준 컬럼을 하나도 못 찾으면 필터링 없이 전체 행 반영
    const sum = idxUsage.reduce((a,i)=>a+toNum(r[i]),0);
    return sum > 0;
  };

  const itemCount = {};
  let totalRows = 0, qualifiedRows = 0;
  up.rows.forEach(r=>{
    const client = r[idxClient];
    if(!client) return;
    totalRows++;
    if(!rowQualifies(r)) return;
    qualifiedRows++;
    itemCount[client] = (itemCount[client]||0) + 1;
  });

  // 목록에 없는 거래처는 새 행으로 자동 생성합니다 (3개월사용품목 essential-column 추출 특성상 코드는 없이 거래처명만 채워집니다).
  let createdCount = 0;
  Object.keys(itemCount).forEach(c=>{
    const existed = listData.some(r=>r.client===c);
    findOrCreateListRow(c, null);
    if(!existed) createdCount++;
  });

  listData.forEach(row=>{ row.itemCount = itemCount[row.client] || 0; });
  recomputeManagerSummary();
  renderKpis(); renderListTable(); renderMgrTable();
  buildFilterOptions();
  scheduleSave();

  let msg = ' <span style="color:var(--teal)">✓ 취급품목수(우선처 기준)가 목록·담당자별 현황에 반영됨';
  if(createdCount) msg += ` · 목록에 없던 거래처 ${createdCount.toLocaleString()}곳을 새로 추가했어요`;
  if(hasUsageCols){
    msg += ` · "${usageColLabels.join(', ')}" 합이 양수인 ${qualifiedRows.toLocaleString()}행만 반영 (업로드 전체 ${totalRows.toLocaleString()}행 중)`;
  } else {
    msg += ' · ⚠ "매출"/"매입"/"가용" 관련 컬럼을 찾지 못해 필터링 없이 전체 행을 반영했어요';
  }
  msg += '</span>';
  banner.innerHTML += msg;
}

function findHeaderIndex(headers, ...candidates){
  for(const c of candidates){
    const i = headers.indexOf(c);
    if(i !== -1) return i;
  }
  // fallback: normalize whitespace/newlines and try substring containment
  const norm = s => String(s).replace(/\s+/g,'');
  for(const c of candidates){
    const target = norm(c);
    const i = headers.findIndex(h => norm(h).includes(target) || target.includes(norm(h)));
    if(i !== -1) return i;
  }
  return -1;
}

// ---------- 품절 현황 목록: 발주담당자/배송지구분/결제기준일/회전은 마스터DB > 거래처정보마스터DB 값을 그대로 가져와 씁니다 ----------
// (발주담당자 갱신 업로드는 거래처정보마스터DB의 해당 컬럼만 갱신하고, 목록은 항상 거래처정보마스터DB를 기준으로 다시 계산합니다.)
// 거래처정보마스터DB에 '반품특이사항' 컬럼이 없으면(예전에 올린 파일이거나, 원본 파일에 그 컬럼이
// 없는 경우) 매입특이사항 바로 뒤에 빈 값으로 자동 추가합니다. 한 번 추가되면 저장돼서 이후에는
// 그대로 유지돼요.
function ensureVendorMasterReturnNoteColumn(){
  const st = uploadState['vendorMaster'];
  if(!st || !st.headers) return false;
  if(st.headers.includes('반품특이사항')) return false;
  const idxPurchaseNote = st.headers.indexOf('매입특이사항');
  const insertAt = idxPurchaseNote !== -1 ? idxPurchaseNote + 1 : st.headers.length;
  st.headers.splice(insertAt, 0, '반품특이사항');
  st.rows.forEach(r => r.splice(insertAt, 0, ''));
  return true;
}

function recomputeFromManager(){
  const up = uploadState['vendorMaster'];
  if(!up) return;
  const headers = up.headers;
  const idxCode = findHeaderIndex(headers, '다미스코드', '코드', '거래처코드');
  const idxClient = findHeaderIndex(headers, '매입처명', '거래처명', '거래처');
  const idxManager = findHeaderIndex(headers, '발주담당자');
  const idxPay = findHeaderIndex(headers, '결제기준일');
  const idxTurn = findHeaderIndex(headers, '회전');
  const idxRegion = findHeaderIndex(headers, '배송지');
  if(idxClient === -1 && idxCode === -1) return;

  const byCode = {}, byClient = {};
  up.rows.forEach(r=>{
    if(idxCode !== -1 && r[idxCode]) byCode[String(r[idxCode]).trim()] = r;
    if(idxClient !== -1 && r[idxClient]) byClient[r[idxClient]] = r;
  });
  listData.forEach(row=>{
    const r = (idxCode !== -1 && byCode[String(row.code).trim()]) || byClient[row.client];
    if(!r) return;
    if(idxManager !== -1 && r[idxManager] !== undefined && r[idxManager] !== null && r[idxManager] !== '') row.manager = r[idxManager];
    if(idxPay !== -1 && r[idxPay] !== undefined && r[idxPay] !== null && r[idxPay] !== '') row.paymentBasis = r[idxPay];
    if(idxTurn !== -1 && r[idxTurn] !== undefined && r[idxTurn] !== null && r[idxTurn] !== '') row.turn = r[idxTurn];
    if(idxRegion !== -1 && r[idxRegion] !== undefined && r[idxRegion] !== null && r[idxRegion] !== '') row.region = r[idxRegion];
    // 코드가 비어있는 매입처는 거래처정보마스터DB의 코드(다미스코드)로 채워줍니다.
    if((!row.code || String(row.code).trim() === '') && idxCode !== -1 && r[idxCode]) row.code = r[idxCode];
  });
  recomputeManagerSummary();
  renderKpis(); renderListTable(); renderMgrTable();
  buildFilterOptions();
  scheduleSave();
}

// ---------- 재고 및 파손재고현황 (재고 및 반품) ----------
// 발주담당자는 마스터DB > 거래처정보마스터DB의 발주담당자 컬럼을 코드/거래처명 기준으로 그대로 가져와 씁니다.
function buildOrderManagerMap(){
  const map = new Map();
  const up = uploadState['vendorMaster'];
  if(up){
    const headers = up.headers;
    const idxCode = findHeaderIndex(headers, '다미스코드', '코드', '거래처코드');
    const idxClient = findHeaderIndex(headers, '매입처명', '거래처명', '거래처');
    const idxManager = findHeaderIndex(headers, '발주담당자');
    if(idxManager !== -1){
      up.rows.forEach(r=>{
        const code = idxCode !== -1 ? String(r[idxCode] ?? '').trim() : '';
        const client = idxClient !== -1 ? r[idxClient] : '';
        const mgr = r[idxManager];
        if(code) map.set(code, mgr);
        if(client) map.set('client:' + client, mgr);
      });
      return map;
    }
  }
  // 거래처정보마스터DB가 아직 없거나 발주담당자 컬럼을 찾지 못하면 목록에 이미 반영된 값을 그대로 사용
  listData.forEach(row=>{
    if(row.code) map.set(String(row.code).trim(), row.manager);
    if(row.client) map.set('client:' + row.client, row.manager);
  });
  return map;
}

// 창고별(광주/의정부) 업로드는 이제 전월/당월 구분 없이 1개씩만 받고, '당월로 볼 달'과 '전월로 볼 달'은
// 조회 시점에 정합니다. getCurData(warehouseId)/getPrevData(warehouseId)만 바꿔주면
// 재고 및 파손재고현황 계산 로직(엑셀 '통합' 시트 수식 재현)을 그대로 재사용할 수 있도록 분리했습니다.
function buildStockDataFrom(getCurData, getPrevData){
  const codeMap = new Map(); // code -> row

  STOCK_WAREHOUSES.forEach(w=>{
    const cur = getCurData(w.id);
    if(cur){
      cur.rows.forEach(r=>{
        const code = String(r[0] ?? '').trim();
        if(!code) return;
        if(!codeMap.has(code)) codeMap.set(code, { code, client: r[1] || '' });
        const entry = codeMap.get(code);
        if(!entry.client && r[1]) entry.client = r[1];
        entry['cur_' + w.id] = {
          salesAmt: r[2], stockAmt: r[3], avail: r[4], damaged: r[5],
          balance: r[6], balancePct: r[7], compensation: r[8],
          unarrived: r[9], fifoIn: r[10], fifoOut: r[11]
        };
      });
    }
    const prev = getPrevData ? getPrevData(w.id) : null;
    if(prev){
      prev.rows.forEach(r=>{
        const code = String(r[0] ?? '').trim();
        if(!code) return;
        if(!codeMap.has(code)) codeMap.set(code, { code, client: r[1] || '' });
        const entry = codeMap.get(code);
        if(!entry.client && r[1]) entry.client = r[1];
        entry['prev_' + w.id] = {
          salesAmt: r[2], stockAmt: r[3], avail: r[4], damaged: r[5],
          balance: r[6], balancePct: r[7], compensation: r[8],
          unarrived: r[9], fifoIn: r[10], fifoOut: r[11]
        };
      });
    }
  });

  const returnMap = new Map();
  const vm = uploadState['vendorMaster'];
  if(vm){
    const headers = vm.headers;
    const idxCode = findHeaderIndex(headers, '다미스코드', '코드', '거래처코드');
    const idxClient = findHeaderIndex(headers, '매입처명', '거래처명', '거래처');
    const idxMgr = findHeaderIndex(headers, '반품담당자');
    if(idxMgr !== -1){
      vm.rows.forEach(r=>{
        const code = idxCode !== -1 ? String(r[idxCode] ?? '').trim() : '';
        const client = idxClient !== -1 ? r[idxClient] : '';
        const mgr = r[idxMgr];
        if(code) returnMap.set(code, mgr);
        if(client) returnMap.set('client:' + client, mgr);
      });
    }
  }

  const orderMap = buildOrderManagerMap();

  const result = Array.from(codeMap.values()).map(entry=>{
    entry.returnManager = returnMap.get(entry.code) || returnMap.get('client:' + entry.client) || '';
    entry.orderManager = orderMap.get(entry.code) || orderMap.get('client:' + entry.client) || '';

    // 엑셀 '통합' 시트의 실제 수식을 그대로 재현합니다 (엑셀 원본 데이터가 이미 원 단위이므로 그대로 원 단위를 씁니다).
    const pg = entry.prev_stockGJ || {}, pe = entry.prev_stockEJ || {};
    const cg = entry.cur_stockGJ || {}, ce = entry.cur_stockEJ || {};
    const div = (a,b) => b ? a/b : 0;

    entry.salesTotal = (Number(cg.salesAmt)||0) + (Number(ce.salesAmt)||0);
    entry.debtTotal = (Number(cg.balance)||0) + (Number(ce.balance)||0);
    entry.prevStock = (Number(pg.stockAmt)||0) + (Number(pe.stockAmt)||0);
    const curStockGJ = Number(cg.stockAmt)||0;
    const curStockEJ = Number(ce.stockAmt)||0;
    entry.curStockTotal = curStockGJ + curStockEJ;
    entry.salesRatio = div(entry.curStockTotal, entry.prevStock);
    entry.unpaidRatio = div(entry.curStockTotal, entry.debtTotal);
    entry.prevDamaged = (Number(pg.damaged)||0) + (Number(pe.damaged)||0);
    entry.curDamaged = (Number(cg.damaged)||0) + (Number(ce.damaged)||0);
    entry.damagedChangeRate = entry.curDamaged ? (1 - div(entry.prevDamaged, entry.curDamaged)) : 0;

    // 재고 및 파손재고현황 표에는 광주+의정부를 합산한 값만 보여줍니다.
    const combine = (a, b) => {
      const stockAmt = (Number(a.stockAmt)||0) + (Number(b.stockAmt)||0);
      const damaged = (Number(a.damaged)||0) + (Number(b.damaged)||0);
      const balance = (Number(a.balance)||0) + (Number(b.balance)||0);
      return {
        stockAmt, damaged, balance,
        balancePct: balance ? (damaged/balance*100) : 0,
        compensation: (Number(a.compensation)||0) + (Number(b.compensation)||0),
        unarrived: (Number(a.unarrived)||0) + (Number(b.unarrived)||0),
        fifoIn: (Number(a.fifoIn)||0) + (Number(b.fifoIn)||0),
        fifoOut: (Number(a.fifoOut)||0) + (Number(b.fifoOut)||0),
      };
    };
    entry.prevCombined = combine(pg, pe);
    entry.curCombined = combine(cg, ce);

    delete entry.cur_stockGJ; delete entry.cur_stockEJ;
    delete entry.prev_stockGJ; delete entry.prev_stockEJ;
    return entry;
  });
  result.sort((a,b)=> String(a.client||'').localeCompare(String(b.client||''), 'ko'));
  return result;
}

// ---------- 재고 및 파손재고현황 연도·월 조회(창고별로 쌓인 과거 업로드분 보관) ----------
// 광주·의정부 시트를 업로드할 때마다, 파일명에서 뽑은 연/월(fileMonth) 기준으로 원본 rows를 별도 보관해서,
// 나중에 특정 연도·월을 고르면 그 달을 당월로, 바로 전달을 전월로 삼아 표를 다시 계산해 보여줍니다.
const STOCK_MONTHLY_INDEX_KEY = 'stockout_dashboard_stock_monthly_index_v1';
let stockMonthlyIndex = {}; // { 'YYYY-MM': ['stockGJ','stockEJ'] }
let monthlyStockData = {}; // { 'YYYY-MM': { stockGJ: {headers, rows, fileName, uploadedAt}, stockEJ: {...} } }
let stockQueryMonthKey = ''; // '' = 최신(자동), 그 외에는 사용자가 고른 'YYYY-MM'(당월 기준)
let stockTableMonthData = null; // 조회 월이 선택됐을 때 계산해 캐시해 두는 표 데이터
let stockTableMonthDataKey = null;

// 'YYYY-MM'을 delta개월만큼 이동한 'YYYY-MM'을 반환합니다 (예: shiftMonthKey('2026-01', -1) === '2025-12').
function shiftMonthKey(monthKey, delta){
  const [y, m] = monthKey.split('-').map(Number);
  const d = new Date(y, (m - 1) + delta, 1);
  return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
}
function monthOnlyLabel(monthKey){ return monthKey ? (Number(monthKey.slice(5, 7)) + '월') : ''; }
// 창고 자료(stockGJ/stockEJ)가 하나라도 보관된 월들만, 최신순으로 반환합니다.
function getArchivedStockMonths(){
  return Object.keys(monthlyStockData)
    .filter(m => monthlyStockData[m] && (monthlyStockData[m].stockGJ || monthlyStockData[m].stockEJ))
    .sort((a, b) => b.localeCompare(a));
}
function getLatestArchivedStockMonth(){
  const months = getArchivedStockMonths();
  return months.length ? months[0] : null;
}
// 사용자가 조회 월을 고르지 않았으면 가장 최근에 업로드된 달을 당월 기준으로 씁니다.
function resolveActiveStockMonthKey(){
  return stockQueryMonthKey || getLatestArchivedStockMonth() || new Date().toISOString().slice(0, 7);
}

function stockMonthlyStorageKey(id, monthKey){ return 'stockout_dashboard_upload_' + id + '_m_' + monthKey; }

async function saveMonthlyStockSnapshot(id, monthKey, state){
  try{
    const key = stockMonthlyStorageKey(id, monthKey);
    const chunks = splitRowsIntoChunks(state.rows, MAX_VALUE_BYTES);
    const isChunked = chunks.length > 1;
    if(isChunked){
      for(let i=0; i<chunks.length; i++){
        await storageSetWithRetry(key + '_chunk_' + i, JSON.stringify(chunks[i]), true);
      }
    }
    const meta = { headers: state.headers, fileName: state.fileName, uploadedAt: state.uploadedAt, chunked: isChunked, chunkCount: chunks.length };
    if(!isChunked) meta.rows = chunks[0];
    await storageSetWithRetry(key, JSON.stringify(meta), true);

    monthlyStockData[monthKey] = monthlyStockData[monthKey] || {};
    monthlyStockData[monthKey][id] = { headers: state.headers, rows: state.rows, fileName: state.fileName, uploadedAt: state.uploadedAt };
    stockMonthlyIndex[monthKey] = stockMonthlyIndex[monthKey] || [];
    if(!stockMonthlyIndex[monthKey].includes(id)) stockMonthlyIndex[monthKey].push(id);
    await storageSetWithRetry(STOCK_MONTHLY_INDEX_KEY, JSON.stringify(stockMonthlyIndex), true);
    renderStockQuerySelectors();
    renderDamageViewMonthSelector(); renderDamageView();
    renderStockDamageByManagerChart();
  }catch(e){ console.error('월별 재고 스냅샷 저장 실패:', e); }
}

async function loadMonthlyStockArchive(){
  try{
    const res = await window.storage.get(STOCK_MONTHLY_INDEX_KEY, true);
    if(res && res.value) stockMonthlyIndex = JSON.parse(res.value);
  }catch(e){ stockMonthlyIndex = {}; }
  const months = Object.keys(stockMonthlyIndex);
  for(const month of months){
    const roles = stockMonthlyIndex[month] || [];
    for(const id of roles){
      try{
        const key = stockMonthlyStorageKey(id, month);
        const res = await window.storage.get(key, true);
        if(!(res && res.value)) continue;
        const parsed = JSON.parse(res.value);
        let rows = parsed.rows || [];
        if(parsed.chunked){
          const chunkResults = await Promise.all(
            Array.from({length: parsed.chunkCount}, (_, i) =>
              window.storage.get(key + '_chunk_' + i, true).catch(()=>null)
            )
          );
          rows = [];
          chunkResults.forEach(r=>{ if(r && r.value) rows = rows.concat(JSON.parse(r.value)); });
        }
        monthlyStockData[month] = monthlyStockData[month] || {};
        monthlyStockData[month][id] = { headers: parsed.headers, rows, fileName: parsed.fileName, uploadedAt: parsed.uploadedAt };
      }catch(e){ /* 해당 월/창고 스냅샷을 불러오지 못했어요 */ }
    }
  }
  renderStockQuerySelectors();
  renderDamageViewMonthSelector(); renderDamageView();
  renderStockDamageByManagerChart();
}

// curKey를 당월로, 바로 전달(curKey - 1개월, 또는 명시적으로 넘긴 prevKey)을 전월로 삼아 표 데이터를 계산합니다.
function buildStockDataForPeriod(curKey, prevKey){
  prevKey = prevKey || shiftMonthKey(curKey, -1);
  const curSrc = monthlyStockData[curKey] || {};
  const prevSrc = monthlyStockData[prevKey] || {};
  return buildStockDataFrom(id => curSrc[id], id => prevSrc[id]);
}
function computeStockDataForMonth(monthKey){
  return buildStockDataForPeriod(monthKey);
}
// 사이드바 KPI·재고 추이 스냅샷 등 "현재" 값은 항상 가장 최근에 업로드된 달을 당월로, 그 전달을 전월로 삼습니다.
function rebuildStockData(){
  const latest = getLatestArchivedStockMonth();
  stockData = latest ? computeStockDataForMonth(latest) : buildStockDataFrom(id => uploadState[id], () => null);
  stockTableMonthData = null; stockTableMonthDataKey = null;
}

// 재고 및 파손재고현황 표 상단의 연도·월 드롭다운을 채웁니다 (보관된 월들 기준).
function renderStockQuerySelectors(){
  const yearSel = document.getElementById('stockQueryYear');
  const monthSel = document.getElementById('stockQueryMonth');
  const label = document.getElementById('stockQueryLabel');
  if(!yearSel || !monthSel) return;
  const months = getArchivedStockMonths();
  if(!months.length){
    yearSel.innerHTML = '<option value="">연도</option>';
    monthSel.innerHTML = '<option value="">월</option>';
    if(label) label.textContent = '업로드된 자료가 없어요';
    return;
  }
  const activeKey = resolveActiveStockMonthKey();
  const [activeYear, activeMonth] = activeKey.split('-');

  const years = Array.from(new Set(months.map(m => m.slice(0, 4)))).sort((a, b) => b.localeCompare(a));
  const wantYear = yearSel.value || activeYear;
  yearSel.innerHTML = years.map(y => `<option value="${y}">${y}년</option>`).join('');
  yearSel.value = years.includes(wantYear) ? wantYear : years[0];

  const selYear = yearSel.value;
  const monthsInYear = Array.from(new Set(months.filter(m => m.slice(0, 4) === selYear).map(m => Number(m.slice(5, 7))))).sort((a, b) => b - a);
  const wantMonth = monthSel.value || (selYear === activeYear ? String(Number(activeMonth)) : '');
  monthSel.innerHTML = monthsInYear.map(m => `<option value="${m}">${m}월</option>`).join('');
  monthSel.value = monthsInYear.map(String).includes(wantMonth) ? wantMonth : String(monthsInYear[0]);

  const curKey = selYear + '-' + String(monthSel.value).padStart(2, '0');
  const prevKey = shiftMonthKey(curKey, -1);
  if(label) label.textContent = `전월(${monthOnlyLabel(prevKey)}) · 당월(${monthOnlyLabel(curKey)})`;
}
// 연도·월 드롭다운에서 선택이 바뀌면 조회 기준월을 갱신하고 표를 다시 계산합니다.
function applyStockQuerySelection(){
  const yearSel = document.getElementById('stockQueryYear');
  const monthSel = document.getElementById('stockQueryMonth');
  if(!yearSel || !monthSel || !yearSel.value || !monthSel.value) return;
  stockQueryMonthKey = yearSel.value + '-' + String(monthSel.value).padStart(2, '0');
  stockTableMonthData = null; stockTableMonthDataKey = null;
  renderStockQuerySelectors();
  buildStockFilterOptions();
  renderStockTable();
}

function getActiveStockTableData(){
  const key = resolveActiveStockMonthKey();
  const latest = getLatestArchivedStockMonth();
  if(!stockQueryMonthKey || key === latest) return stockData;
  if(stockTableMonthDataKey !== key){
    stockTableMonthData = computeStockDataForMonth(key);
    stockTableMonthDataKey = key;
  }
  return stockTableMonthData;
}

// 재고 및 파손재고현황: 반품담당자/발주담당자 드롭다운 필터 옵션을 현재 선택된 데이터(최신 또는 특정 월) 기준으로 채웁니다.
function buildStockFilterOptions(){
  const rSel = document.getElementById('returnMgrFilter-stock');
  const oSel = document.getElementById('orderMgrFilter-stock');
  if(!rSel || !oSel) return;
  const activeData = getActiveStockTableData();
  const returnMgrs = [...new Set(activeData.map(r=>r.returnManager).filter(Boolean))].sort((a,b)=>String(a).localeCompare(String(b),'ko'));
  const orderMgrs = [...new Set(activeData.map(r=>r.orderManager).filter(Boolean))].sort((a,b)=>String(a).localeCompare(String(b),'ko'));

  const prevR = rSel.value;
  rSel.querySelectorAll('option:not(:first-child)').forEach(o=>o.remove());
  returnMgrs.forEach(m=>{ const o=document.createElement('option'); o.value=m; o.textContent=m; rSel.appendChild(o); });
  if(returnMgrs.includes(prevR)) rSel.value = prevR;

  const prevO = oSel.value;
  oSel.querySelectorAll('option:not(:first-child)').forEach(o=>o.remove());
  orderMgrs.forEach(m=>{ const o=document.createElement('option'); o.value=m; o.textContent=m; oSel.appendChild(o); });
  if(orderMgrs.includes(prevO)) oSel.value = prevO;
}

// 숫자로 변환 가능한 값끼리는 숫자 정렬, 아니면 한글 문자열 정렬을 씁니다 (코드·거래처·담당자 포함 전 항목 공용).
function stockSortCompare(a, b, key, dir){
  let av = a[key], bv = b[key];
  const an = Number(av), bn = Number(bv);
  if(av!==null && av!==undefined && av!=='' && bv!==null && bv!==undefined && bv!=='' && !isNaN(an) && !isNaN(bn)){
    return (an - bn) * dir;
  }
  av = String(av ?? ''); bv = String(bv ?? '');
  return av.localeCompare(bv, 'ko') * dir;
}

function renderStockTable(){
  const head = document.getElementById('stockHead');
  if(!head) return;
  const activeData = getActiveStockTableData();

  const fixedDefs = [
    { key:'code', label:'코드' }, { key:'client', label:'거래처' },
    { key:'returnManager', label:'반품담당자' }, { key:'orderManager', label:'발주담당자' }
  ];
  const groupRow = fixedDefs.map(d=>`<th rowspan="2" data-key="${d.key}">${d.label}${sortArrow('stock', d.key)}</th>`);
  groupRow.push(`<th colspan="${STOCK_SUMMARY_METRICS.length}" class="grp-head grp-stock1">전체 현황</th>`);
  const subRow = STOCK_SUMMARY_METRICS.map(m=>`<th class="grp-stock1" data-key="${m.key}">${m.label}${sortArrow('stock', m.key)}</th>`);
  head.innerHTML = `<tr>${groupRow.join('')}</tr><tr>${subRow.join('')}</tr>`;
  head.querySelectorAll('th[data-key]').forEach(th=>{
    th.addEventListener('click', ()=>{
      const key = th.dataset.key;
      if(sortState.stock.key === key) sortState.stock.dir *= -1;
      else { sortState.stock.key = key; sortState.stock.dir = 1; }
      renderStockTable();
    });
  });

  const q = (document.getElementById('search-stock').value || '').trim().toLowerCase();
  const rFilter = document.getElementById('returnMgrFilter-stock').value;
  const oFilter = document.getElementById('orderMgrFilter-stock').value;
  let rows = activeData.filter(r=>{
    if(rFilter && r.returnManager !== rFilter) return false;
    if(oFilter && r.orderManager !== oFilter) return false;
    if(!q) return true;
    return String(r.code).toLowerCase().includes(q) ||
           String(r.client||'').toLowerCase().includes(q) ||
           String(r.returnManager||'').toLowerCase().includes(q) ||
           String(r.orderManager||'').toLowerCase().includes(q);
  });

  if(sortState.stock.key){
    const k = sortState.stock.key, d = sortState.stock.dir;
    rows = rows.slice().sort((a,b)=> stockSortCompare(a, b, k, d));
  }

  document.getElementById('count-stock').textContent = `${rows.length.toLocaleString()} / ${activeData.length.toLocaleString()}건`;

  const fmt = v => (v===null || v===undefined || v==='') ? '' : (typeof v==='number' ? v.toLocaleString(undefined,{maximumFractionDigits:1}) : v);
  // ratio 필드는 0.087 같은 소수 비율로 계산돼 있으므로 100을 곱해 %로 표시합니다.
  const fmtRatio = v => (v===null || v===undefined || v==='' || isNaN(Number(v))) ? '' : (Number(v)*100).toFixed(2)+'%';
  const body = document.getElementById('stockBody');
  body.innerHTML = rows.map(r=>{
    let tds = `<td>${r.code}</td><td>${escapeHtml(r.client||'')}</td><td>${escapeHtml(r.returnManager||'')}</td><td>${escapeHtml(r.orderManager||'')}</td>`;
    STOCK_SUMMARY_METRICS.forEach(m=>{
      const v = r[m.key];
      tds += `<td class="num">${m.ratio ? fmtRatio(v) : fmt(v)}</td>`;
    });
    return `<tr>${tds}</tr>`;
  }).join('');
}

// ================= 제약사별 반품 처리 현황(재고 및 파손재고현황 탭) =================
// 다미스제품코드마스터DB의 '제약사' 열에서 회사 목록을 뽑고, 회사별로 반품 접수·발송·완료 체크와
// 체크한 날짜, 반품주기(자유 입력)를 저장합니다. 모든 사람이 같이 보는 공유 데이터예요.
const RETURN_CYCLE_STORAGE_KEY = 'shared_return_cycle_tracker_v1';
let returnCycleTracker = {}; // { [제약사]: { received:{checked,date}, sent:{checked,date}, complete:{checked,date}, cycle:'' } }

async function loadReturnCycleTracker(){
  try{
    const res = await window.storage.get(RETURN_CYCLE_STORAGE_KEY, true);
    if(res && res.value) returnCycleTracker = JSON.parse(res.value) || {};
  }catch(e){ returnCycleTracker = {}; }
}
async function saveReturnCycleTracker(){
  try{ await window.storage.set(RETURN_CYCLE_STORAGE_KEY, JSON.stringify(returnCycleTracker), true); }catch(e){ console.error('반품 주기 저장 실패:', e); }
}
function ensureReturnCycleEntry(company){
  if(!returnCycleTracker[company]){
    returnCycleTracker[company] = { received:{checked:false,date:''}, sent:{checked:false,date:''}, complete:{checked:false,date:''}, cycle:'' };
  }
  return returnCycleTracker[company];
}
function returnCycleManufacturerList(){
  const pm = uploadState['productMaster'];
  if(!pm || !pm.headers || !pm.rows) return [];
  const idx = pm.headers.indexOf('제약사');
  if(idx === -1) return [];
  const set = new Set();
  pm.rows.forEach(r=>{ const v = String(r[idx]||'').trim(); if(v) set.add(v); });
  return Array.from(set).sort((a,b)=> a.localeCompare(b,'ko'));
}

function renderReturnCycleTable(){
  const body = document.getElementById('body-returnCycle');
  if(!body) return;
  const q = (document.getElementById('search-returnCycle').value||'').trim().toLowerCase();
  let list = returnCycleManufacturerList();
  if(!list.length){
    document.getElementById('count-returnCycle').textContent = '';
    body.innerHTML = `<tr><td colspan="5" class="foot-note" style="text-align:left;">마스터DB &gt; 다미스제품코드마스터DB에 '제약사' 열이 있는 데이터를 올리면 여기에 회사 목록이 나와요.</td></tr>`;
    return;
  }
  if(q) list = list.filter(c=> c.toLowerCase().includes(q));
  document.getElementById('count-returnCycle').textContent = `${list.length.toLocaleString()}개사`;

  const stepCell = (company, key) => {
    const e = ensureReturnCycleEntry(company)[key];
    const dateTxt = e.checked && e.date ? `<div style="font-size:11px; color:var(--ink-faint); margin-top:2px;">${e.date}</div>` : '';
    return `<td style="text-align:center;">
      <input type="checkbox" class="returnCycleCheck" data-company="${escapeAttr(company)}" data-key="${key}" ${e.checked?'checked':''}>
      ${dateTxt}
    </td>`;
  };

  body.innerHTML = list.map(company=>{
    const entry = ensureReturnCycleEntry(company);
    return `<tr>
      <td>${escapeHtml(company)}</td>
      ${stepCell(company,'received')}
      ${stepCell(company,'sent')}
      ${stepCell(company,'complete')}
      <td class="editable" contenteditable="true" data-company="${escapeAttr(company)}" data-cycle="1">${entry.cycle||''}</td>
    </tr>`;
  }).join('');

  body.querySelectorAll('.returnCycleCheck').forEach(cb=>{
    cb.addEventListener('change', async ()=>{
      const company = cb.dataset.company, key = cb.dataset.key;
      const entry = ensureReturnCycleEntry(company);
      entry[key].checked = cb.checked;
      entry[key].date = cb.checked ? todayKey() : '';
      await saveReturnCycleTracker();
      renderReturnCycleTable();
    });
  });
  body.querySelectorAll('td[data-cycle]').forEach(td=>{
    td.addEventListener('blur', async ()=>{
      const company = td.dataset.company;
      ensureReturnCycleEntry(company).cycle = td.textContent.trim();
      await saveReturnCycleTracker();
    });
  });
}

async function initReturnCycleTracker(){
  await loadReturnCycleTracker();
  document.getElementById('search-returnCycle').addEventListener('input', renderReturnCycleTable);
  renderReturnCycleTable();
}


// ---------- 재고현황 KPI 카드 (전체재고액 / 매출액 / 파손재고액) ----------
function renderStockKpis(){
  const el = document.getElementById('kpiRow2');
  if(!el) return;
  const totalStock = stockData.reduce((a,r)=>a+(Number(r.curStockTotal)||0),0);
  const totalSales = stockData.reduce((a,r)=>a+(Number(r.salesTotal)||0),0);
  const totalDamaged = stockData.reduce((a,r)=>a+(Number(r.curDamaged)||0),0);
  // 카드 표시는 천원 단위로 보기 좋게 나눠 보여줍니다 (내부 계산·그래프는 원 단위 그대로 유지).
  const kpis = [
    { label:'전체재고액', val: Math.round(totalStock/1000).toLocaleString(), cls:'teal' },
    { label:'매출액', val: Math.round(totalSales/1000).toLocaleString(), cls:'teal' },
    { label:'파손재고액', val: Math.round(totalDamaged/1000).toLocaleString(), cls:'red' },
  ];
  el.innerHTML = kpis.map(k=>`
    <div class="kpi ${k.cls}">
      <div class="label">${k.label}</div>
      <div class="val">${k.val}<small>천원</small></div>
    </div>`).join('');
}

// ---------- 재고 추이(월별 스냅샷) ----------
async function loadStockHistory(){
  try{
    const res = await window.storage.get(STOCK_HISTORY_KEY, true);
    if(res && res.value) stockHistory = JSON.parse(res.value);
  }catch(e){ /* 저장된 이력 없음 */ }
}
async function saveStockHistory(){
  try{ await window.storage.set(STOCK_HISTORY_KEY, JSON.stringify(stockHistory), true); }catch(e){ console.error('재고 이력 저장 실패:', e); }
}
function upsertStockHistorySnapshot(){
  // 광주·의정부 시트가 하나도 업로드/보관돼 있지 않으면 의미 있는 당월 재고/파손재고 값을 계산할 수 없어 건너뜁니다.
  const month = getLatestArchivedStockMonth();
  if(!month) return;
  const totalStock = stockData.reduce((a,r)=>a+(Number(r.curStockTotal)||0),0);
  const totalDamaged = stockData.reduce((a,r)=>a+(Number(r.curDamaged)||0),0);
  const totalSales = stockData.reduce((a,r)=>a+(Number(r.salesTotal)||0),0);
  const entry = { month, totalStock, totalDamaged, totalSales, updatedAt: new Date().toISOString() };
  const idx = stockHistory.findIndex(h=>h.month===month);
  if(idx >= 0) stockHistory[idx] = entry; else stockHistory.push(entry);
  stockHistory.sort((a,b)=> a.month.localeCompare(b.month));
  saveStockHistory();
  renderStockHistoryYearFilter();
  renderStockChart();
  renderStockHistoryDamageYearFilter();
  renderStockDamageChart();
  renderStockDamageByManagerChart();
}

// 예전 버전에서는 재고 계산에 실수로 ÷1000이 들어가 있던 시절이 있어서, 그때 저장된 월별 스냅샷은
// 실제 원 단위 금액보다 1000배 작게 남아있을 수 있습니다. 보관된 창고별 원본(우선처별 재고 및 매입실적)
// 데이터가 있는 모든 달을 지금의(수정된, ÷1000 없는) 계산식으로 다시 돌려서 정확한 원 단위로 맞춥니다.
function rebuildStockHistoryFromArchive(){
  const months = getArchivedStockMonths();
  if(!months.length) return;
  let changed = false;
  months.forEach(month=>{
    const data = computeStockDataForMonth(month);
    const totalStock = data.reduce((a,r)=>a+(Number(r.curStockTotal)||0),0);
    const totalDamaged = data.reduce((a,r)=>a+(Number(r.curDamaged)||0),0);
    const totalSales = data.reduce((a,r)=>a+(Number(r.salesTotal)||0),0);
    const idx = stockHistory.findIndex(h=>h.month===month);
    const prev = idx >= 0 ? stockHistory[idx] : null;
    // 값이 실제로 달라졌을 때만 갱신합니다 (불필요한 저장 방지).
    if(!prev || prev.totalStock !== totalStock || prev.totalDamaged !== totalDamaged || prev.totalSales !== totalSales){
      const entry = { month, totalStock, totalDamaged, totalSales, updatedAt: new Date().toISOString() };
      if(idx >= 0) stockHistory[idx] = entry; else stockHistory.push(entry);
      changed = true;
    }
  });
  if(changed){
    stockHistory.sort((a,b)=> a.month.localeCompare(b.month));
    saveStockHistory();
  }
  return changed;
}

// stockHistory 안의 월(YYYY-MM)에서 연도(YYYY) 목록을 뽑아 연도 필터 드롭다운을 채웁니다.
function renderStockHistoryYearFilter(){
  const sel = document.getElementById('stockHistoryYearFilter');
  if(!sel) return;
  const years = Array.from(new Set(stockHistory.map(h=>h.month.slice(0,4)))).sort((a,b)=>b.localeCompare(a));
  const prevVal = sel.value;
  sel.innerHTML = '<option value="">전체 연도</option>' + years.map(y=>`<option value="${y}">${y}년</option>`).join('');
  sel.value = years.includes(prevVal) ? prevVal : '';
  const countEl = document.getElementById('count-stockHistoryYear');
  if(countEl) countEl.textContent = years.length ? `${years.length}개 연도 · ${stockHistory.length}개월 데이터` : '';
}

// ---------- 막대 그래프 공용 호버 툴팁 ----------
// containerEl 안의 svg .chart-bar 요소에 data-tt-month/data-tt-label/data-tt-color/data-tt-val 속성을 채워두면
// 마우스를 올렸을 때 그 정보를 담은 툴팁을 컨테이너 위에 띄워줍니다. 같은 컨테이너에는 한 번만 연결하면 됩니다.
function attachChartTooltip(containerEl){
  if(!containerEl || containerEl.dataset.ttBound) return;
  containerEl.dataset.ttBound = '1';
  const tip = document.createElement('div');
  tip.className = 'chart-tooltip';
  containerEl.appendChild(tip);
  const show = (bar, evt)=>{
    const month = bar.getAttribute('data-tt-month') || '';
    const label = bar.getAttribute('data-tt-label') || '';
    const color = bar.getAttribute('data-tt-color') || '#2f5fd6';
    const val = bar.getAttribute('data-tt-val') || '';
    tip.innerHTML = `<div class="tt-month">${month}</div><div class="tt-row"><span class="tt-dot" style="background:${color}"></span><span class="tt-label">${label}</span><span class="tt-val">${val}</span></div>`;
    tip.classList.add('show');
    move(evt);
  };
  const move = (evt)=>{
    const rect = containerEl.getBoundingClientRect();
    let x = evt.clientX - rect.left;
    let y = evt.clientY - rect.top - 10;
    tip.style.left = x + 'px';
    tip.style.top = y + 'px';
  };
  const hide = ()=>{ tip.classList.remove('show'); };
  containerEl.addEventListener('mouseover', (e)=>{
    const bar = e.target.closest('.chart-bar');
    if(bar) show(bar, e);
  });
  containerEl.addEventListener('mousemove', (e)=>{
    const bar = e.target.closest('.chart-bar');
    if(bar) move(e);
  });
  containerEl.addEventListener('mouseout', (e)=>{
    const bar = e.target.closest('.chart-bar');
    if(bar && !bar.contains(e.relatedTarget)) hide();
  });
}

function renderStockChart(){
  const el = document.getElementById('stockChartContainer');
  if(!el) return;
  if(!stockHistory.length){
    el.innerHTML = "<div class=\"foot-note\">아직 저장된 월별 스냅샷이 없어요. 재고 및 반품 &gt; DB업데이트에서 우선처별 재고 및 매입실적 시트를 업로드하면(파일명에 'N월' 표기가 있으면 그 달 기준으로) 매출액·재고액·파손재고액이 이 그래프에 자동으로 쌓여요.</div>";
    return;
  }
  // 증감율은 '바로 전달' 데이터가 있어야 계산되므로, 연도 필터와 무관하게 전체 이력에서 먼저 계산한 뒤
  // 화면에는 선택된 연도(또는 전체)에 해당하는 구간만 잘라서 보여줍니다.
  const series = [
    { key:'totalSales', color:'#2f5fd6', label:'매출액' },
    { key:'totalStock', color:'#16a34a', label:'재고액' },
    { key:'totalDamaged', color:'#d1483f', label:'파손재고액' },
  ];
  const all = stockHistory.slice().sort((a,b)=>a.month.localeCompare(b.month));
  const enriched = all.map((entry, idx)=>{
    const out = { month: entry.month };
    series.forEach(s=>{
      const cur = Number(entry[s.key]) || 0;
      let rate = null;
      if(idx > 0){
        const prev = Number(all[idx-1][s.key]) || 0;
        rate = prev === 0 ? (cur===0 ? 0 : 100) : ((cur-prev)/Math.abs(prev))*100;
      }
      out[s.key] = cur;
      out[s.key + '_rate'] = rate;
    });
    return out;
  });
  const sel = document.getElementById('stockHistoryYearFilter');
  const year = sel ? sel.value : '';
  const data = year ? enriched.filter(x=>x.month.slice(0,4)===year) : enriched;
  if(!data.length){
    el.innerHTML = '<div class="foot-note">선택한 연도에는 저장된 월별 스냅샷이 없어요.</div>';
    return;
  }
  const w = 820, h = 372, padL = 78, padR = 20, padT = 20, padB = 78;
  const chartW = w - padL - padR, chartH = h - padT - padB;
  const maxVal = Math.max(1, ...data.map(x=>Math.max(x.totalStock||0, x.totalDamaged||0, x.totalSales||0)));
  const groupW = chartW / data.length;
  const barW = Math.max(7, Math.min(22, groupW/3 - 6));

  let grid = '';
  for(let i=0; i<=4; i++){
    const y = padT + chartH - (chartH*i/4);
    const val = Math.round(maxVal*i/4);
    grid += `<line x1="${padL}" y1="${y}" x2="${w-padR}" y2="${y}" stroke="var(--line)" stroke-width="1"></line>`;
    grid += `<text x="${padL-8}" y="${y+4}" text-anchor="end" font-size="10" fill="var(--ink-faint)">${val.toLocaleString()}</text>`;
  }

  const fmtRate = r => r === null ? '—' : ((r>=0?'+':'') + r.toFixed(1) + '%');
  let bars = '';
  data.forEach((entry, i)=>{
    const xBase = padL + i*groupW + groupW/2;
    const startX = xBase - (barW*3 + 8)/2;
    series.forEach((s, si)=>{
      const val = Number(entry[s.key]) || 0;
      const barH = (val/maxVal)*chartH;
      const x = startX + si*(barW+4);
      const valTxt = Math.round(val).toLocaleString() + ' 원';
      const rate = entry[s.key + '_rate'];
      const detailTxt = rate === null ? valTxt : `${valTxt} · 전월대비 ${fmtRate(rate)}`;
      bars += `<rect class="chart-bar" data-tt-month="${entry.month}" data-tt-label="${s.label}" data-tt-color="${s.color}" data-tt-val="${detailTxt}" x="${x.toFixed(1)}" y="${(padT+chartH-barH).toFixed(1)}" width="${barW.toFixed(1)}" height="${barH.toFixed(1)}" fill="${s.color}" rx="3"></rect>`;
    });
    bars += `<text x="${xBase.toFixed(1)}" y="${padT+chartH+18}" text-anchor="middle" font-size="11" fill="var(--ink-dim)">${entry.month}</text>`;
    // 월 라벨 아래, 계열별 전월 대비 증감율을 각 계열 색으로 한 줄씩 표기
    series.forEach((s, si)=>{
      const rate = entry[s.key + '_rate'];
      bars += `<text x="${xBase.toFixed(1)}" y="${padT+chartH+33+si*13}" text-anchor="middle" font-size="9.5" font-weight="700" fill="${s.color}">${fmtRate(rate)}</text>`;
    });
  });

  el.innerHTML = `
    <svg viewBox="0 0 ${w} ${h}" style="width:100%; height:auto; max-width:1400px; display:block;">
      ${grid}
      ${bars}
    </svg>
    <div class="chart-legend">
      ${series.map(s=>`<span><span class="sw" style="background:${s.color};"></span>${s.label}(원) · 색칠된 %는 전월 대비 증감율</span>`).join('')}
    </div>`;
  attachChartTooltip(el);
}

// ---------- 파손재고현황(월별 파손재고 전월 대비 증감율) ----------
function renderStockHistoryDamageYearFilter(){
  const sel = document.getElementById('stockDamageYearFilter');
  if(!sel) return;
  const years = Array.from(new Set(stockHistory.map(h=>h.month.slice(0,4)))).sort((a,b)=>b.localeCompare(a));
  const prevVal = sel.value;
  sel.innerHTML = '<option value="">전체 연도</option>' + years.map(y=>`<option value="${y}">${y}년</option>`).join('');
  sel.value = years.includes(prevVal) ? prevVal : '';
  const countEl = document.getElementById('count-stockDamageYear');
  if(countEl) countEl.textContent = years.length ? `${years.length}개 연도 · ${stockHistory.length}개월 데이터` : '';
}

function renderStockDamageChart(){
  const el = document.getElementById('stockDamageChartContainer');
  if(!el) return;
  if(!stockHistory.length){
    el.innerHTML = "<div class=\"foot-note\">아직 저장된 월별 스냅샷이 없어요. 재고 및 반품 &gt; DB업데이트에서 우선처별 재고 및 매입실적 시트를 업로드하면 파손재고액이 이 그래프에 자동으로 쌓여요.</div>";
    return;
  }
  // 증감율은 '바로 전달' 데이터가 있어야 계산되므로, 연도 필터와 무관하게 전체 이력에서 먼저 계산한 뒤
  // 화면에는 선택된 연도(또는 전체)에 해당하는 구간만 잘라서 보여줍니다.
  const all = stockHistory.slice().sort((a,b)=>a.month.localeCompare(b.month));
  const enriched = all.map((entry, idx)=>{
    const cur = Number(entry.totalDamaged) || 0;
    let rate = null;
    if(idx > 0){
      const prev = Number(all[idx-1].totalDamaged) || 0;
      rate = prev === 0 ? (cur===0 ? 0 : 100) : ((cur-prev)/Math.abs(prev))*100;
    }
    return { month: entry.month, damaged: cur, rate };
  });
  const sel = document.getElementById('stockDamageYearFilter');
  const year = sel ? sel.value : '';
  const data = year ? enriched.filter(x=>x.month.slice(0,4)===year) : enriched;

  if(!data.length){
    el.innerHTML = '<div class="foot-note">선택한 연도에는 저장된 월별 스냅샷이 없어요.</div>';
    return;
  }

  // 값들의 차이가 전체 금액에 비해 작을 때도 눈에 띄게 보이도록, y축을 0부터 시작하지 않고
  // 실제 데이터 범위에 맞춰 확대해서 보여줍니다(값 자체는 원 단위 그대로 정확하게 사용, 표시만 천원 단위).
  const BAR_COLOR = '#eab308'; // 막대 색: 노란색
  const INC_COLOR = '#c1791b', DEC_COLOR = '#16a34a'; // 증가/감소 표시용 색 (주황/초록)은 그대로 유지
  const w = 820, h = 360, padL = 20, padR = 20, padT = 46, padB = 42;
  const chartW = w - padL - padR, chartH = h - padT - padB;
  const rawVals = data.map(x=>x.damaged||0);
  const rawMin = Math.min(...rawVals), rawMax = Math.max(...rawVals);
  let axisMin, axisMax;
  if(rawMax === rawMin){
    const pad = Math.max(1, rawMax*0.05);
    axisMin = rawMax - pad; axisMax = rawMax + pad;
  } else {
    const pad = (rawMax - rawMin) * 0.35;
    axisMin = Math.max(0, rawMin - pad);
    axisMax = rawMax + pad;
  }
  const range = axisMax - axisMin;
  const groupW = chartW / data.length;
  const barW = Math.max(14, Math.min(46, groupW*0.55));
  const valToY = v => padT + chartH - ((v - axisMin) / range) * chartH;

  let grid = '';
  for(let i=0; i<=4; i++){
    const val = axisMin + range*i/4;
    const y = valToY(val);
    grid += `<line x1="${padL}" y1="${y.toFixed(1)}" x2="${w-padR}" y2="${y.toFixed(1)}" stroke="var(--line)" stroke-width="1"></line>`;
  }

  let bars = '';
  const baseY = padT + chartH;
  data.forEach((entry, i)=>{
    const xBase = padL + i*groupW + groupW/2;
    const x = xBase - barW/2;
    const y = valToY(entry.damaged);
    const barH = Math.max(1, baseY - y);
    const rateTxt = entry.rate === null ? '—' : ((entry.rate>=0?'+':'') + entry.rate.toFixed(1) + '%');
    const rateColor = entry.rate === null ? 'var(--ink-faint)' : (entry.rate >= 0 ? INC_COLOR : DEC_COLOR);
    const valTxt = Math.round(entry.damaged).toLocaleString() + ' 원';
    const detailTxt = entry.rate === null ? valTxt : `${valTxt} · 전월대비 ${rateTxt}`;
    const kwonTxt = Math.round(entry.damaged/1000).toLocaleString() + '천원';
    bars += `<rect class="chart-bar" data-tt-month="${entry.month}" data-tt-label="파손재고액" data-tt-color="${BAR_COLOR}" data-tt-val="${detailTxt}" x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${barW.toFixed(1)}" height="${barH.toFixed(1)}" fill="${BAR_COLOR}" rx="3"></rect>`;
    // 막대 위: 금액(천원) + 전월 대비 증감율, 막대 아래: 월 라벨만
    bars += `<text x="${xBase.toFixed(1)}" y="${(y-20).toFixed(1)}" text-anchor="middle" font-size="10.5" fill="var(--ink)">${kwonTxt}</text>`;
    bars += `<text x="${xBase.toFixed(1)}" y="${(y-7).toFixed(1)}" text-anchor="middle" font-size="11" font-weight="800" fill="${rateColor}">${rateTxt}</text>`;
    bars += `<text x="${xBase.toFixed(1)}" y="${padT+chartH+18}" text-anchor="middle" font-size="11" fill="var(--ink-dim)">${entry.month}</text>`;
  });

  el.innerHTML = `
    <svg viewBox="0 0 ${w} ${h}" style="width:100%; height:auto; max-width:1400px; display:block;">
      ${grid}
      ${bars}
    </svg>
    <div class="chart-legend">
      <span><span class="sw" style="background:${BAR_COLOR};"></span>파손재고액</span>
      <span><span class="sw" style="background:${INC_COLOR};border-radius:50%;width:8px;height:8px;"></span>증가</span>
      <span><span class="sw" style="background:${DEC_COLOR};border-radius:50%;width:8px;height:8px;"></span>감소</span>
    </div>`;
  attachChartTooltip(el);
}

// 반품담당자별 파손증감율(가장 최근 저장된 달 기준, 전월 대비): 담당 거래처들의 전월/당월 파손재고를
// 합산해서 담당자 단위로 증감율을 계산해 막대그래프로 보여줍니다.
const STOCK_DAMAGE_NAMED_MANAGERS = ['이상연','김은경','서호진','최형욱','전송이','유아름','예상화','김동재'];

function renderStockDamageByManagerChart(){
  const el = document.getElementById('stockDamageByManagerChartContainer');
  if(!el) return;
  const monthKey = getLatestArchivedStockMonth();
  if(!monthKey){
    el.innerHTML = '<div class="foot-note">아직 저장된 월별 스냅샷이 없어요.</div>';
    return;
  }
  const rows = computeStockDataForMonth(monthKey);
  const map = new Map();
  STOCK_DAMAGE_NAMED_MANAGERS.forEach(name => map.set(name, { manager: name, prev: 0, cur: 0 }));
  map.set('기타', { manager: '기타', prev: 0, cur: 0 });
  rows.forEach(r=>{
    const mgrRaw = r.returnManager || '';
    const mgr = STOCK_DAMAGE_NAMED_MANAGERS.includes(mgrRaw) ? mgrRaw : '기타';
    const e = map.get(mgr);
    e.prev += Number(r.prevDamaged) || 0;
    e.cur += Number(r.curDamaged) || 0;
  });
  const data = Array.from(map.values()).map(e=>{
    const rate = e.cur ? (1 - (e.prev / e.cur)) * 100 : 0;
    return { manager: e.manager, prev: e.prev, cur: e.cur, rate };
  });
  // 지정된 담당자 순서 그대로, 기타는 맨 끝에
  const order = [...STOCK_DAMAGE_NAMED_MANAGERS, '기타'];
  data.sort((a,b)=> order.indexOf(a.manager) - order.indexOf(b.manager));

  const PREV_COLOR = '#9fb3d9', CUR_COLOR = '#2f5fd6';
  const INC_COLOR = '#c1791b', DEC_COLOR = '#16a34a';
  const w = 820, h = 360, padL = 56, padR = 20, padT = 46, padB = 42;
  const chartW = w - padL - padR, chartH = h - padT - padB;
  const rawVals = data.flatMap(x=>[x.prev, x.cur]);
  const rawMax = Math.max(1, ...rawVals);
  const axisMax = rawMax * 1.15;

  const n = data.length;
  const slot = chartW / n;
  const pairW = Math.min(70, slot * 0.62);
  const barW = pairW / 2;

  let grid = '';
  const gridLines = 4;
  for(let i=0; i<=gridLines; i++){
    const val = axisMax * i/gridLines;
    const y = padT + chartH * (1 - i/gridLines);
    grid += `<line x1="${padL}" y1="${y.toFixed(1)}" x2="${w-padR}" y2="${y.toFixed(1)}" stroke="var(--line)" stroke-width="1"></line>`;
    grid += `<text x="${padL-8}" y="${(y+4).toFixed(1)}" text-anchor="end" font-size="10" fill="var(--ink-faint)">${Math.round(val/1000).toLocaleString()}천원</text>`;
  }

  let bars = '', labels = '';
  data.forEach((d, i)=>{
    const groupX = padL + slot*i + (slot-pairW)/2;
    const prevH = Math.max(0, chartH * (d.prev/axisMax));
    const curH = Math.max(0, chartH * (d.cur/axisMax));
    const prevY = padT + chartH - prevH;
    const curY = padT + chartH - curH;
    bars += `<rect class="chart-bar" data-tt-month="${d.manager}" data-tt-label="전월파손재고" data-tt-color="${PREV_COLOR}" data-tt-val="${Math.round(d.prev).toLocaleString()}원" x="${groupX.toFixed(1)}" y="${prevY.toFixed(1)}" width="${barW.toFixed(1)}" height="${prevH.toFixed(1)}" fill="${PREV_COLOR}" rx="2"></rect>`;
    bars += `<rect class="chart-bar" data-tt-month="${d.manager}" data-tt-label="당월파손재고" data-tt-color="${CUR_COLOR}" data-tt-val="${Math.round(d.cur).toLocaleString()}원" x="${(groupX+barW).toFixed(1)}" y="${curY.toFixed(1)}" width="${barW.toFixed(1)}" height="${curH.toFixed(1)}" fill="${CUR_COLOR}" rx="2"></rect>`;
    const rateColor = d.rate >= 0 ? INC_COLOR : DEC_COLOR;
    const topY = Math.min(prevY, curY);
    const kwonTxt = Math.round(d.cur/1000).toLocaleString() + '천원';
    labels += `<text x="${(groupX+pairW/2).toFixed(1)}" y="${(topY-21).toFixed(1)}" text-anchor="middle" font-size="10.5" fill="var(--ink)">${kwonTxt}</text>`;
    labels += `<text x="${(groupX+pairW/2).toFixed(1)}" y="${(topY-8).toFixed(1)}" text-anchor="middle" font-size="11" font-weight="800" fill="${rateColor}">${d.rate>=0?'+':''}${d.rate.toFixed(1)}%</text>`;
    const labelX = padL + slot*i + slot/2;
    labels += `<text x="${labelX.toFixed(1)}" y="${(h-padB+20).toFixed(1)}" text-anchor="middle" font-size="11.5" fill="var(--ink)">${d.manager}</text>`;
  });

  el.innerHTML = `
    <svg viewBox="0 0 ${w} ${h}" style="width:100%; height:auto; max-width:1400px; display:block;">
      ${grid}
      ${bars}
      ${labels}
    </svg>
    <div class="chart-legend" style="margin-top:6px;">
      <span><span class="sw" style="background:${PREV_COLOR};"></span>전월 파손재고(원)</span>
      <span><span class="sw" style="background:${CUR_COLOR};"></span>당월 파손재고(원)</span>
      <span><span class="sw" style="background:${INC_COLOR};border-radius:50%;width:8px;height:8px;"></span>증감율 증가</span>
      <span><span class="sw" style="background:${DEC_COLOR};border-radius:50%;width:8px;height:8px;"></span>증감율 감소</span>
    </div>`;
  attachChartTooltip(el);
}


// 재고 및 파손재고현황과 같은 buildStockDataFrom 계산 로직을 그대로 재사용해서, 고른 달의
// 거래처별 당월/전월 파손재고를 반품담당자별로 묶거나 거래처별로 나열해 보여줍니다.
function renderDamageViewMonthSelector(){
  const sel = document.getElementById('damageViewMonth');
  if(!sel) return;
  const prevVal = sel.value;
  const months = getArchivedStockMonths(); // 최신순
  sel.innerHTML = months.map(m => `<option value="${m}">${m} (당월 기준)</option>`).join('');
  if(months.includes(prevVal)) sel.value = prevVal;
}

function buildVendorReturnNoteMap(){
  const map = new Map();
  const vm = uploadState['vendorMaster'];
  if(!vm) return map;
  const headers = vm.headers;
  const idxName = findHeaderIndex(headers, '매입처명', '거래처명', '거래처');
  const idxNote = headers.indexOf('반품특이사항');
  if(idxName === -1 || idxNote === -1) return map;
  vm.rows.forEach(r=>{
    const name = r[idxName];
    if(name && !map.has(name)) map.set(name, r[idxNote] || '');
  });
  return map;
}

function renderDamageViewManagerFilterOptions(rows){
  const filterEl = document.getElementById('damageViewManagerFilter');
  if(!filterEl) return;
  const prevVal = filterEl.value;
  const names = Array.from(new Set(rows.map(r => r.returnManager || '(미지정)'))).sort((a,b)=> a.localeCompare(b, 'ko'));
  filterEl.innerHTML = '<option value="">전체 담당자</option>' + names.map(n => `<option value="${n}">${n}</option>`).join('');
  if(names.includes(prevVal)) filterEl.value = prevVal;
}

function openDamageManagerDetail(manager, monthKey, rowsForMonth){
  const rows = rowsForMonth || computeStockDataForMonth(monthKey);
  const clientRows = rows.filter(r => (r.returnManager || '(미지정)') === manager)
    .map(r => ({ client: r.client || r.code, damaged: Number(r.curDamaged) || 0 }))
    .sort((a,b)=> b.damaged - a.damaged);
  document.getElementById('damageManagerModalTitle').textContent = `${manager} 담당 거래처 (${monthKey}, ${clientRows.length.toLocaleString()}곳)`;
  document.getElementById('damageManagerModalBody').innerHTML = clientRows.map(c=>`<tr><td>${c.client}</td><td class="num">${Math.round(c.damaged).toLocaleString()}</td></tr>`).join('');
  document.getElementById('damageManagerModalOverlay').style.display = 'flex';
}

function bindDamageManagerModal(){
  const overlay = document.getElementById('damageManagerModalOverlay');
  const closeBtn = document.getElementById('damageManagerModalCloseBtn');
  if(closeBtn) closeBtn.addEventListener('click', ()=>{ overlay.style.display = 'none'; });
  if(overlay) overlay.addEventListener('click', (e)=>{ if(e.target === overlay) overlay.style.display = 'none'; });
}

function renderDamageView(){
  const modeEl = document.getElementById('damageViewMode');
  const monthEl = document.getElementById('damageViewMonth');
  const filterEl = document.getElementById('damageViewManagerFilter');
  const head = document.getElementById('head-damageView');
  const body = document.getElementById('body-damageView');
  const countEl = document.getElementById('count-damageView');
  if(!modeEl || !monthEl || !head || !body) return;

  const monthKey = monthEl.value || getLatestArchivedStockMonth();
  if(!monthKey){
    head.innerHTML = ''; body.innerHTML = '';
    countEl.textContent = '';
    return;
  }
  const rows = computeStockDataForMonth(monthKey);
  renderDamageViewManagerFilterOptions(rows);
  const mode = modeEl.value;
  const q = filterEl ? filterEl.value : '';

  if(mode === 'manager'){
    head.innerHTML = '<th>반품담당자</th><th>담당거래처수</th><th>당월파손재고금액</th>';
    const map = new Map();
    rows.forEach(r=>{
      const mgr = r.returnManager || '(미지정)';
      if(!map.has(mgr)) map.set(mgr, { manager: mgr, clientSet: new Set(), damaged: 0 });
      const e = map.get(mgr);
      e.clientSet.add(r.client || r.code);
      e.damaged += Number(r.curDamaged) || 0;
    });
    let result = Array.from(map.values())
      .map(e => ({ manager: e.manager, clientCount: e.clientSet.size, damaged: e.damaged }))
      .sort((a,b)=> b.damaged - a.damaged);
    if(q) result = result.filter(e => e.manager === q);
    body.innerHTML = result.map(e => `<tr class="dbl-drill" data-manager="${escapeAttr(e.manager)}" style="cursor:pointer;" title="더블클릭하면 담당 거래처 목록을 볼 수 있어요">
      <td>${escapeHtml(e.manager)}</td>
      <td class="num">${e.clientCount.toLocaleString()}</td>
      <td class="num">${Math.round(e.damaged).toLocaleString()}</td>
    </tr>`).join('');
    countEl.textContent = `${result.length.toLocaleString()}명`;
    body.querySelectorAll('tr.dbl-drill').forEach(tr=>{
      tr.addEventListener('dblclick', ()=> openDamageManagerDetail(tr.dataset.manager, monthKey, rows));
    });
  } else {
    head.innerHTML = '<th>거래처</th><th>반품담당자</th><th>전월파손재고</th><th>당월파손재고</th><th>증감액</th><th>증감율</th><th>비고</th>';
    const noteMap = buildVendorReturnNoteMap();
    let result = rows.map(r=>{
      const prevD = Number(r.prevDamaged) || 0;
      const curD = Number(r.curDamaged) || 0;
      const clientName = r.client || r.code;
      return {
        client: clientName, manager: r.returnManager || '(미지정)',
        prevDamaged: prevD, curDamaged: curD, change: curD - prevD, changeRate: r.damagedChangeRate,
        note: noteMap.get(clientName) || ''
      };
    }).sort((a,b)=> Math.abs(b.change) - Math.abs(a.change));
    if(q) result = result.filter(e => e.manager === q);
    body.innerHTML = result.map(e=>{
      const changeStyle = e.change > 0 ? ' style="color:var(--red);"' : (e.change < 0 ? ' style="color:var(--teal-ink);"' : '');
      return `<tr>
        <td>${e.client}</td>
        <td>${e.manager}</td>
        <td class="num">${Math.round(e.prevDamaged).toLocaleString()}</td>
        <td class="num">${Math.round(e.curDamaged).toLocaleString()}</td>
        <td class="num"${changeStyle}>${e.change > 0 ? '+' : ''}${Math.round(e.change).toLocaleString()}</td>
        <td class="num"${changeStyle}>${(Math.round((e.changeRate||0)*1000)/10).toLocaleString()}%</td>
        <td>${e.note}</td>
      </tr>`;
    }).join('');
    countEl.textContent = `${result.length.toLocaleString()}건`;
  }
}

async function exportDamageView(){
  const modeEl = document.getElementById('damageViewMode');
  const monthEl = document.getElementById('damageViewMonth');
  const filterEl = document.getElementById('damageViewManagerFilter');
  const monthKey = monthEl.value || getLatestArchivedStockMonth();
  if(!monthKey){ alert('조회할 월별 스냅샷이 없어요.'); return; }
  const rows = computeStockDataForMonth(monthKey);
  const mode = modeEl.value;
  const q = filterEl ? filterEl.value : '';

  if(mode === 'manager'){
    const map = new Map();
    rows.forEach(r=>{
      const mgr = r.returnManager || '(미지정)';
      if(!map.has(mgr)) map.set(mgr, { manager: mgr, clientSet: new Set(), damaged: 0 });
      const e = map.get(mgr);
      e.clientSet.add(r.client || r.code);
      e.damaged += Number(r.curDamaged) || 0;
    });
    let result = Array.from(map.values())
      .map(e => ({ manager: e.manager, clientCount: e.clientSet.size, damaged: Math.round(e.damaged) }))
      .sort((a,b)=> b.damaged - a.damaged);
    if(q) result = result.filter(e => e.manager === q);
    await downloadStyledXlsx({
      sheetName: '반품담당자별_파손현황',
      fileName: `반품담당자별_파손현황_${monthKey}.xlsx`,
      columns: [
        { key:'manager', label:'반품담당자', width:16 },
        { key:'clientCount', label:'담당거래처수', width:14, numFmt:'#,##0', center:true },
        { key:'damaged', label:'당월파손재고금액', width:18, numFmt:'#,##0', center:true },
      ],
      rows: result
    });
  } else {
    const noteMap = buildVendorReturnNoteMap();
    let result = rows.map(r=>{
      const prevD = Math.round(Number(r.prevDamaged) || 0);
      const curD = Math.round(Number(r.curDamaged) || 0);
      const clientName = r.client || r.code;
      return {
        client: clientName, manager: r.returnManager || '(미지정)',
        prevDamaged: prevD, curDamaged: curD, change: curD - prevD,
        changeRate: Math.round((r.damagedChangeRate||0)*1000)/10,
        note: noteMap.get(clientName) || ''
      };
    }).sort((a,b)=> Math.abs(b.change) - Math.abs(a.change));
    if(q) result = result.filter(e => e.manager === q);
    await downloadStyledXlsx({
      sheetName: '거래처별_파손금액증감',
      fileName: `거래처별_파손금액증감_${monthKey}.xlsx`,
      columns: [
        { key:'client', label:'거래처', width:18 },
        { key:'manager', label:'반품담당자', width:14 },
        { key:'prevDamaged', label:'전월파손재고', width:16, numFmt:'#,##0', center:true },
        { key:'curDamaged', label:'당월파손재고', width:16, numFmt:'#,##0', center:true },
        { key:'change', label:'증감액', width:14, numFmt:'#,##0', center:true },
        { key:'changeRate', label:'증감율(%)', width:12, numFmt:'0.0"%"', center:true },
        { key:'note', label:'비고', width:20 },
      ],
      rows: result
    });
  }
}

function bindDamageView(){
  const modeEl = document.getElementById('damageViewMode');
  const monthEl = document.getElementById('damageViewMonth');
  const filterEl = document.getElementById('damageViewManagerFilter');
  const exportBtn = document.getElementById('damageViewExportBtn');
  if(modeEl) modeEl.addEventListener('change', renderDamageView);
  if(monthEl) monthEl.addEventListener('change', renderDamageView);
  if(filterEl) filterEl.addEventListener('change', renderDamageView);
  if(exportBtn) exportBtn.addEventListener('click', exportDamageView);
}

// 재고 관련 업로드가 바뀔 때마다 표·KPI·그래프를 한 번에 갱신합니다.
function refreshStockViews(){
  rebuildStockData(); // 내부에서 stockTableMonthData 캐시도 초기화합니다
  renderStockQuerySelectors();
  renderDamageViewMonthSelector(); renderDamageView();
  renderStockDamageByManagerChart();
  buildStockFilterOptions();
  renderStockTable();
  renderStockKpis();
  upsertStockHistorySnapshot();
}

// ================= 공급내역신고 (포함/별도 자동 판별 계산) =================
// 원본 '공급내역신고자료' 시트는 헤더 없이 A~V(22개 열)로 구성됩니다. 필요한 열만 씁니다:
//   B(1)=거래처 사업자번호, J(9)=상품명, K(10)=표준코드(바코드), M(12)=수량,
//   O(14)=실금액(총액), P(15)=단가(원본), S(18)=제조번호, T(19)=사용기한(뒤 6자리)
// 엑셀 '포함'/'별도-*' 6개 시트의 실제 수식을 그대로 재현합니다 (매입엑셀작업파일.xlsx 확인).
// 거래처정보마스터DB의 매입전표부가세가 '포함'이면 포함 방식을 그대로 쓰고, '별도'(또는 불명확)면
// 계산기(간이 계산기)에 입력한 공급가 합계와 가장 가까운 별도 6가지 중 하나를 자동으로 골라줍니다.
const SUPPLY_STORAGE_KEY = 'stockout_dashboard_supply_raw_v1';
const SUPPLY_MODES = [
  { id:'포함', label:'포함' },
  { id:'별도-합계액(내림)', label:'별도-합계액(내림)', base:'amt', round:'floor' },
  { id:'별도-합계액(반올림)', label:'별도-합계액(반올림)', base:'amt', round:'round' },
  { id:'별도-합계액(올림)', label:'별도-합계액(올림)', base:'amt', round:'ceil' },
  { id:'별도-단가(내림)', label:'별도-단가(내림)', base:'unit', round:'floor' },
  { id:'별도-단가(반올림)', label:'별도-단가(반올림)', base:'unit', round:'round' },
  { id:'별도-단가(올림)', label:'별도-단가(올림)', base:'unit', round:'ceil' },
];
const SUPPLY_COLUMNS = [
  { key:'productCode', label:'제품코드', width:68 },
  { key:'barcode', label:'상품코드', width:140 },
  { key:'dealType', label:'거래유형', hideOnScreen:true },
  { key:'damageType', label:'파손유무', hideOnScreen:true },
  { key:'qty', label:'수량', num:true, width:56 },
  { key:'unit', label:'매입단가', num:true, editable:true, width:88 },
  { key:'amt', label:'실금액', num:true, editable:true, width:100 },
  { key:'discount', label:'할인금액', width:76, hideOnScreen:true },
  { key:'lotNo', label:'제조번호', width:94, textEditable:true },
  { key:'expiry', label:'사용기한', width:84, textEditable:true },
  { key:'margin', label:'마진', pct:true, width:70 },
  { key:'productName', label:'표준상품명', width:160 },
  { key:'maker', label:'다미스코드명', width:160 },
  { key:'note', label:'구매비고', width:192 },
  { key:'longout', label:'장기품절등록', width:84, hideOnScreen:true },
];

let supplyRawRows = [];      // 파싱된 원본 22열 행들
let supplyComputed = [];     // 매칭 + 7가지 모드 계산까지 끝난 행들 (모드 선택 전)
let supplyFinalRows = [];    // 자동 판별된 모드로 확정된, 화면에 보여주고 수정 가능한 행들
let supplySelectedVendor = null;   // {name, vat} — 배치의 대표 거래처 (첫 매칭 성공 행 기준)
let supplyDecision = null;   // { mode, reason, diff }
let supplyEditsMap = new Map(); // key: `${idx}:${field}` -> {productCode,barcode,field,before,after}

// ---------- 매입전표 합계액 (합계액 우선 입력시 자동분할, 공급가부터 입력시 부가세 수기입력+10%대비 10%p 이상 벗어나면 거부, 음수 허용, 7줄+총합계) ----------
const SUPPLY_CALC_ROWS = 7;
let supplyCalcData = Array.from({length: SUPPLY_CALC_ROWS}, ()=>({ supply:null, vat:null, total:null }));

function fmtCalcNum(v){
  return (v===null || v===undefined || isNaN(v)) ? '' : Math.round(v).toLocaleString();
}

// 합계액을 기준으로 공급가·부가세를 자동 계산합니다(÷1.1). 공급가나 부가세를 직접 고치면(세부조정),
// 합계액이 이미 있으면 그 합계액을 고정한 채 나머지 한 쪽을 다시 맞추고, 합계액이 아직 없으면
// 예전처럼 10% 부가세로 계산해서 합계액을 새로 만듭니다.
// 합계액이 이미 있으면(세부조정 모드) 합계액을 고정한 채 나머지 한 쪽을 맞추고,
// 합계액이 없으면(공급가 입력 모드) 공급가·부가세를 각각 그대로 받아들이되(자동 10% 계산 없음),
// 둘 다 채워지면 부가세율이 표준 10%에서 10%p 이상 벗어날 경우 그 입력을 거부합니다(음수도 허용).
function recalcSupplyCalcRow(i, field, value){
  const row = supplyCalcData[i];
  if(field === 'total'){
    row.total = value;
    if(value === null){ row.supply = null; row.vat = null; }
    else{ row.supply = Math.round(value / 1.1); row.vat = value - row.supply; }
    return { ok:true };
  }
  if(row.total !== null){
    if(field === 'supply'){ row.supply = value; row.vat = (value===null) ? null : row.total - value; }
    else { row.vat = value; row.supply = (value===null) ? null : row.total - value; }
    return { ok:true };
  }
  const prevSupply = row.supply, prevVat = row.vat;
  if(field === 'supply') row.supply = value; else row.vat = value;
  if(row.supply !== null && row.vat !== null && row.supply !== 0){
    const ratio = row.vat / row.supply;
    if(ratio < 0 || ratio >= 0.20){
      row.supply = prevSupply; row.vat = prevVat;
      row.total = (row.supply!==null && row.vat!==null) ? row.supply + row.vat : null;
      return { ok:false, message:`부가세율이 표준 10%에서 10%p 이상 벗어나서(${(ratio*100).toFixed(1)}%) 반영하지 않았어요 — 공급가·부가세 값을 확인해주세요.` };
    }
  }
  row.total = (row.supply!==null && row.vat!==null) ? row.supply + row.vat : null;
  return { ok:true };
}

function supplyCalcReferenceTotal(){
  let sum = 0, any = false;
  supplyCalcData.forEach(r=>{ if(r.supply!==null){ sum += r.supply; any = true; } });
  return any ? sum : null;
}

function supplyCalcReferenceGrandTotal(){
  let sum = 0, any = false;
  supplyCalcData.forEach(r=>{ if(r.total!==null){ sum += r.total; any = true; } });
  return any ? sum : null;
}

function renderSupplyCalcTotals(){
  let sSum=0, vSum=0, tSum=0, any=false;
  supplyCalcData.forEach(r=>{
    if(r.supply!==null || r.vat!==null){
      sSum += r.supply||0; vSum += r.vat||0; tSum += (r.total!==null ? r.total : ((r.supply||0)+(r.vat||0)));
      any = true;
    }
  });
  const row = document.getElementById('supplyCalcTotalRow');
  if(row){
    row.children[1].textContent = any ? fmtCalcNum(sSum) : '-';
    row.children[2].textContent = any ? fmtCalcNum(vSum) : '-';
    row.children[3].textContent = any ? fmtCalcNum(tSum) : '-';
  }
  // 부가세가 공급가의 10%를 초과하는 줄이 있으면 경고를 띄웁니다.
  const warnEl = document.getElementById('supplyCalcWarning');
  if(warnEl){
    const flagged = [];
    supplyCalcData.forEach((r,i)=>{
      if(r.supply && r.vat!==null && r.supply > 0){
        const ratio = r.vat / r.supply;
        if(ratio > 0.101) flagged.push(`${i+1}행(${(ratio*100).toFixed(1)}%)`);
      }
    });
    if(flagged.length){
      warnEl.style.display = 'block';
      warnEl.textContent = `⚠ 부가세가 공급가의 10%를 초과하는 줄이 있어요: ${flagged.join(', ')} — 값을 확인해주세요.`;
    } else {
      warnEl.style.display = 'none';
    }
  }
}

function renderSupplyCalcTable(){
  const body = document.getElementById('supplyCalcBody');
  const inputStyle = 'width:100%; border:1px solid #b9cdf0; border-radius:4px; text-align:right; font:inherit; background:var(--teal-bg, #eef4ff); padding:2px 4px; box-sizing:border-box;';
  const totalInputStyle = 'width:100%; border:2px solid var(--red); border-radius:4px; text-align:right; font:inherit; font-weight:800; background:var(--red-bg, #fff3f0); padding:2px 4px; box-sizing:border-box;';
  let html = '';
  for(let i=0; i<SUPPLY_CALC_ROWS; i++){
    const r = supplyCalcData[i];
    html += `<tr>
      <td class="num">${i+1}</td>
      <td class="num"><input type="text" class="calc-input" data-i="${i}" data-field="supply" value="${r.supply!==null?fmtCalcNum(r.supply):''}" style="${inputStyle}"></td>
      <td class="num"><input type="text" class="calc-input" data-i="${i}" data-field="vat" value="${r.vat!==null?fmtCalcNum(r.vat):''}" style="${inputStyle}"></td>
      <td class="num"><input type="text" class="calc-input" data-i="${i}" data-field="total" value="${r.total!==null?fmtCalcNum(r.total):''}" style="${totalInputStyle}"></td>
    </tr>`;
  }
  html += `<tr class="total-row" id="supplyCalcTotalRow"><td>총합계</td><td class="num">-</td><td class="num">-</td><td class="num">-</td></tr>`;
  body.innerHTML = html;

  body.querySelectorAll('input.calc-input').forEach(inp=>{
    inp.addEventListener('input', ()=>{
      const i = Number(inp.dataset.i);
      const field = inp.dataset.field;
      const raw = String(inp.value).replace(/,/g,'').trim();
      // 음수를 입력하려고 '-'만 친 상태(아직 숫자가 안 붙음)라면, 표를 다시 그리지 않고 그대로
      // 둡니다 — 다시 그리면 아직 유효한 숫자가 아니라서 방금 입력한 '-'가 지워져 버려요.
      if(raw === '-') return;
      const n = Number(raw);
      const val = (raw === '' || isNaN(n)) ? null : n;
      const result = recalcSupplyCalcRow(i, field, val);
      renderSupplyCalcTable();
      renderInboundCalcTable();
      if(!result.ok){
        const warnEl = document.getElementById('supplyCalcWarning');
        if(warnEl){ warnEl.style.display = 'block'; warnEl.textContent = `⚠ ${result.message}`; }
        const warnEl2 = document.getElementById('inboundCalcWarning');
        if(warnEl2){ warnEl2.style.display = 'block'; warnEl2.textContent = `⚠ ${result.message}`; }
      }
      // 방금 입력하던 칸에 포커스를 되돌려줍니다 (이 표 안에서만 찾아서, 다른 탭의 표로 포커스가 튀지 않게 합니다).
      const again = body.querySelector(`input.calc-input[data-i="${i}"][data-field="${field}"]`);
      if(again){ again.focus(); const len = again.value.length; again.setSelectionRange(len, len); }
    });
  });
  renderSupplyCalcTotals();
  // 계산기 값이 바뀌면 이미 계산된 결과가 있을 경우 자동 판별 모드를 다시 계산합니다.
  if(supplyComputed.length) finalizeSupplyMode();
}

// 공급내역신고(건별)·입고현황조회(전체)는 supplyCalcData를 공유하므로, 리셋 버튼은 어느 쪽을
// 눌러도 두 표를 동시에 비웁니다.
function resetSupplyCalc(){
  supplyCalcData = Array.from({length: SUPPLY_CALC_ROWS}, ()=>({ supply:null, vat:null, total:null }));
  const w1 = document.getElementById('supplyCalcWarning');
  if(w1){ w1.style.display = 'none'; w1.textContent = ''; }
  const w2 = document.getElementById('inboundCalcWarning');
  if(w2){ w2.style.display = 'none'; w2.textContent = ''; }
  renderSupplyCalcTable();
  renderInboundCalcTable();
}

function roundBy(kind, v){
  if(kind === 'floor') return Math.floor(v);
  if(kind === 'ceil') return Math.ceil(v);
  if(kind === 'none') return v; // 반올림 없이 그대로(소수점까지 전부 유지)
  return Math.round(v);
}

// 붙여넣은 텍스트를 22열 행 배열로 분해합니다. 엑셀에서 복사하거나 파일을 올리면 항상 탭으로
// 구분돼요(파일 업로드는 readWorkbookAsTsv가 탭으로 바꿔줍니다) — 콤마는 금액의 천 단위 구분(예: "712,890")과
// 헷갈릴 수 있어서 구분자로 쓰지 않아요.
function parseSupplyPasteText(text){
  const lines = text.split(/\r\n|\r|\n/).map(l=>l.replace(/\r+$/,'')).filter(l=>l.length>0);
  return lines.map(line => line.split('\t').map(v=>v.trim()));
}

// 엑셀에서 표준코드(바코드)가 숫자 형식이면 셀 너비/일반서식 때문에 "8.80675E+12" 처럼
// 유효자리만 남기고 지수표기로 잘려서 복사되는 경우가 있습니다. 정확히 일치하는 코드가 없으면,
// 같은 유효자리수로 반올림한 값끼리 비교해서 찾아주는 보조 색인(bySig)을 함께 만듭니다.
function roundToSigFigs(num, sig){
  if(!num) return 0;
  const d = Math.ceil(Math.log10(Math.abs(num)));
  const power = sig - d;
  const magnitude = Math.pow(10, power);
  return Math.round(num * magnitude) / magnitude;
}
// "8.80675E+12" 같은 지수표기 문자열에서 유효자리수(가수 자릿수)를 세어줍니다.
function sciNotationSigFigs(str){
  const m = String(str).trim().match(/^-?\d(?:\.\d+)?[eE]\+?-?\d+$/);
  if(!m) return null;
  return m[0].split(/[eE]/)[0].replace(/[.\-]/g,'').length;
}

// 방어적 파싱 유틸 — null/undefined/공백/NaN/콤마 섞인 문자열 등 무엇이 들어와도 예외 없이
// 안전한 기본값을 돌려줍니다. 화면에 "NaN"이나 "Invalid Date" 같은 값이 그대로 노출되는 걸 막아요.
function parseNumberSafe(v, fallback){
  if(fallback === undefined) fallback = 0;
  if(v === null || v === undefined || v === '') return fallback;
  const n = Number(String(v).replace(/,/g,'').trim());
  return isNaN(n) ? fallback : n;
}
function formatDateSafe(v, fallback){
  if(fallback === undefined) fallback = '';
  if(v === null || v === undefined || v === '') return fallback;
  const s = parseFlexibleDateToYYYYMMDD(v); // 아래(약가등재 섹션)에 정의된, 여러 날짜 형식을 알아보는 함수를 그대로 재사용해요.
  if(!s || !/^\d{8}$/.test(s)) return fallback;
  return `${s.slice(0,4)}-${s.slice(4,6)}-${s.slice(6,8)}`;
}

// 원본 붙여넣은 행들(rows) 중 colIdx 열에 값이 있는 첫 행을 찾아 YYYY-MM-DD로 반환합니다.
// 못 찾거나 날짜로 못 읽으면 빈 문자열('') — 파일명 등에서 오늘 날짜로 대체할지는 호출한 쪽이 정합니다.
function rawRowsDateStr(rows, colIdx){
  const row = rows.find(r => String(r[colIdx] || '').trim() !== '');
  return row ? formatDateSafe(row[colIdx], '') : '';
}

function buildProductBarcodeMap(opts){
  const includeExcluded = !!(opts && opts.includeExcluded);
  const map = new Map();       // 정확히 일치하는 코드 → info
  const bySig = new Map();     // 유효자리 반올림값(문자열) → info (지수표기로 잘린 코드 보정용)
  const byCode = new Map();    // 제품코드(다미스 코드) 자체 → info (표준코드로 안 찾아질 때 마지막 보조 수단)
  const pm = uploadState['productMaster'];
  if(!pm) return { map, bySig };
  const headers = pm.headers;
  const idxCode = findHeaderIndex(headers, '코드'); // 헤더가 '코드'와 정확히 안 맞아도(공백/줄바꿈 차이 등) 찾아내요.
  const idxMasterName = headers.indexOf('상품명');
  const idxLongout = headers.indexOf('퇴장방지');
  const idxNote = headers.indexOf('구매비고');
  const idxPrice = headers.indexOf('일반가');
  const idxStd = headers.indexOf('표준코드');
  const idxSplit = headers.indexOf('소분');
  const idxBanDate = headers.indexOf('구매금지일');
  const idxDiscontinued = headers.indexOf('생산중지일');
  const barcodeCols = ['표준코드','바코드1','바코드2','바코드3','바코드4','바코드5']
    .map(name => headers.indexOf(name)).filter(i => i !== -1);
  pm.rows.forEach(r=>{
    // 소분(M열)이 'Y'이거나 구매금지일(Y열)에 값이 있거나 생산중지일에 값이 있는 품목은
    // 공급내역신고/입고현황조회/제약사사이트 자료 전부의 제품코드 조회 대상에서 제외합니다
    // (표준코드/바코드로 찾아도 매칭되지 않게 함 — buildProductBarcodeMap을 모든 매입전표입력(엑셀)-다미스
    // 모드가 공용으로 쓰기 때문에 여기 한 곳만 고치면 전부 적용됩니다).
    const isSplit = idxSplit !== -1 && String(r[idxSplit] || '').trim().toUpperCase() === 'Y';
    const isBanned = idxBanDate !== -1 && String(r[idxBanDate] || '').trim() !== '';
    const isDiscontinued = idxDiscontinued !== -1 && String(r[idxDiscontinued] || '').trim() !== '';
    if((isSplit || isBanned || isDiscontinued) && !includeExcluded) return;

    const canonicalBarcode = idxStd!==-1 && r[idxStd] ? String(r[idxStd]).trim()
      : (barcodeCols.map(ci=>r[ci]).find(v=>v!==null && v!==undefined && String(v).trim()!=='') || '');
    const info = {
      code: idxCode!==-1 ? r[idxCode] : '',
      barcode: canonicalBarcode,
      maker: idxMasterName!==-1 ? r[idxMasterName] : '',
      longout: idxLongout!==-1 ? r[idxLongout] : '',
      note: idxNote!==-1 ? r[idxNote] : '',
      price: idxPrice!==-1 ? parseNumberSafe(r[idxPrice]) : 0
    };
    if(idxCode!==-1){
      const codeKey = String(r[idxCode]||'').trim();
      if(codeKey && !byCode.has(codeKey)) byCode.set(codeKey, info);
    }
    barcodeCols.forEach(ci=>{
      const v = r[ci];
      if(v !== null && v !== undefined && String(v).trim() !== ''){
        const key = String(v).trim();
        if(!map.has(key)) map.set(key, info);
        const num = Number(key);
        if(!isNaN(num) && key.length >= 8){
          [6,7].forEach(sig=>{
            const sigKey = sig + ':' + roundToSigFigs(num, sig);
            if(!bySig.has(sigKey)) bySig.set(sigKey, []);
            const arr = bySig.get(sigKey);
            if(!arr.includes(info)) arr.push(info);
          });
        }
      }
    });
  });
  return { map, bySig, byCode };
}


// 상품명 표기가 소스마다 달라도(밀리그램/mg, 괄호 속 성분명 등) 비교할 수 있도록 정규화합니다.
function normalizeProductName(s){
  if(!s) return '';
  let t = String(s).trim().split('(')[0];
  t = t.replace(/밀리그램/g,'mg').replace(/마이크로그램/g,'mcg').replace(/그램/g,'g')
       .replace(/밀리리터/g,'mL').replace(/리터/g,'L');
  return t.replace(/\s+/g,'').toLowerCase();
}

function lookupProductByBarcode(barcode, productIndex, nameHint){
  if(!barcode) return null;
  let prod = productIndex.map.get(barcode) || null;
  if(prod) return prod;
  const byCodeFallback = ()=> (productIndex.byCode && productIndex.byCode.has(String(barcode).trim())) ? productIndex.byCode.get(String(barcode).trim()) : null;
  // 지수표기로 잘린 코드(예: "8.80675E+12")이거나, 유효자리만 남고 뒷자리가 0으로 채워진 숫자로
  // 보이면 같은 유효자리수로 반올림해서 다시 찾아봅니다. 여러 제품이 같은 값으로 뭉치면(진짜 정밀도
  // 손실이라 구분 불가) 상품명으로 한 번 더 좁혀보고, 그래도 안 되면 잘못 고르느니 매칭 안 된 것으로 남깁니다.
  const num = Number(barcode);
  if(isNaN(num)) return byCodeFallback(); // 숫자가 아니면 지수표기 보정은 의미가 없으니, 제품코드 자체와만 마지막으로 대조해요.
  const sciSig = sciNotationSigFigs(barcode);
  const candidates = sciSig ? [sciSig] : [6,7];
  const normHint = normalizeProductName(nameHint);
  for(const sig of candidates){
    const key = sig + ':' + roundToSigFigs(num, sig);
    const arr = productIndex.bySig.get(key);
    if(!arr || !arr.length) continue;
    if(arr.length === 1) return arr[0];
    if(normHint){
      const nameMatches = arr.filter(info=>{
        const normMaster = normalizeProductName(info.maker);
        return normMaster && (normMaster === normHint || normMaster.includes(normHint) || normHint.includes(normMaster));
      });
      if(nameMatches.length === 1) return nameMatches[0];
    }
  }
  // 표준코드로 끝내 못 찾으면, 마지막으로 이 값을 제품코드(다미스 코드) 자체로 보고 한 번 더 찾아봐요.
  return byCodeFallback();
}

function buildVendorTaxMap(){
  const map = new Map();
  const vm = uploadState['vendorMaster'];
  if(!vm) return map;
  const headers = vm.headers;
  const idxTax = findHeaderIndex(headers, '사업자번호');
  const idxName = findHeaderIndex(headers, '매입처명', '거래처명', '거래처');
  const idxVat = findHeaderIndex(headers, '매입전표부가세');
  if(idxTax === -1) return map;
  vm.rows.forEach(r=>{
    const digits = String(r[idxTax] || '').replace(/\D/g,'');
    if(!digits) return;
    if(!map.has(digits)) map.set(digits, { name: idxName!==-1 ? r[idxName] : '', vat: idxVat!==-1 ? r[idxVat] : '' });
  });
  return map;
}

// 사용기한('YYYYMMDD')이 오늘로부터 몇 개월 남았는지 계산합니다 (달력 기준, 음수면 이미 지남).
function monthsUntilExpiry(expiryStr){
  if(!expiryStr || expiryStr.length < 8) return null;
  const y = Number(expiryStr.slice(0,4)), m = Number(expiryStr.slice(4,6)), d = Number(expiryStr.slice(6,8));
  if(!y || !m || !d) return null;
  const exp = new Date(y, m-1, d);
  const now = new Date();
  let months = (exp.getFullYear()-now.getFullYear())*12 + (exp.getMonth()-now.getMonth());
  if(exp.getDate() < now.getDate()) months -= 1;
  return months;
}

function computeSupplyResults(){
  const productIndex = buildProductBarcodeMap();
  const vendorMap = buildVendorTaxMap();
  supplySelectedVendor = null;

  // 엑셀에서 복사할 때 뒤쪽 빈 줄까지 같이 선택되는 경우가 많아서, 셀이 전부 빈 줄은 결과에서 빼요.
  supplyComputed = supplyRawRows.filter(f => f.some(v => String(v||'').trim() !== '')).map(f=>{
    const get = i => (f[i] !== undefined ? f[i] : '');
    const vendorTaxNo = String(get(1) || '').replace(/\D/g,'');
    const barcodeRaw = String(get(10) || '').trim();
    const qty = parseNumberSafe(get(12));
    const rawAmt = parseNumberSafe(get(14));
    const rawUnit = parseNumberSafe(get(15));
    const lotNoRaw = String(get(18) || '').trim();
    const expiryRaw = String(get(19) || '').trim();
    const lotNo = lotNoRaw ? lotNoRaw : '';
    const expiry = expiryRaw ? ('20' + expiryRaw.padStart(6,'0')) : '';

    const prod = lookupProductByBarcode(barcodeRaw, productIndex, get(9));
    // 매칭에 성공했으면 (지수표기로 잘렸던 코드라도) 다미스제품코드마스터DB의 정확한 표준코드로 바꿔서 보여줍니다.
    const barcode = prod && prod.barcode ? prod.barcode : barcodeRaw;
    const vend = vendorMap.get(vendorTaxNo) || null;
    if(vend && !supplySelectedVendor) supplySelectedVendor = vend;
    const generalPrice = prod ? Number(prod.price)||0 : 0;

    const modes = {};
    SUPPLY_MODES.forEach(m=>{
      let amt, unit;
      if(m.id === '포함'){
        amt = rawAmt;
        unit = qty ? amt / qty : 0;
      } else if(m.base === 'amt'){
        amt = roundBy(m.round, rawAmt / 1.1);
        unit = qty ? amt / qty : 0;
      } else {
        unit = roundBy(m.round, rawUnit / 1.1);
        amt = unit * qty;
      }
      const compareBase = m.id === '포함' ? generalPrice : (generalPrice ? generalPrice/1.1 : 0);
      const margin = compareBase ? ((compareBase - unit) / compareBase) : null;
      modes[m.id] = { amt, unit, margin };
    });

    return {
      productCode: prod ? prod.code : '',
      barcode, dealType: 1, damageType: 1, qty, discount: '',
      lotNo, expiry,
      productName: get(9),
      maker: prod ? prod.maker : '',
      note: prod ? prod.note : '', longout: prod ? prod.longout : '',
      generalPrice, modes
    };
  });

  finalizeSupplyMode();
  checkManagedItemsForFinalRows(supplyFinalRows);
}

// 거래처의 매입전표부가세(포함/별도)와 계산기의 공급가 합계를 참고해 7가지 중 하나를 자동으로 고릅니다.
function decideSupplyMode(){
  const refTotal = supplyCalcReferenceTotal();
  const vendorVatRaw = String((supplySelectedVendor && supplySelectedVendor.vat) || '').trim();

  if(vendorVatRaw !== '별도'){
    const reason = vendorVatRaw === '포함'
      ? `거래처정보마스터DB의 매입전표부가세 값이 '포함'이라 포함 방식을 그대로 사용했어요.`
      : `거래처정보마스터DB의 매입전표부가세 값이 '포함'/'별도'가 아니거나 비어있어서, 기본값인 포함 방식으로 계산했어요.`;
    return { mode:'포함', diff:0, reason };
  }

  const separateModes = SUPPLY_MODES.filter(m=>m.id!=='포함');
  if(refTotal === null){
    return {
      mode:'별도-합계액(반올림)', diff:null,
      reason:'별도 방식 6가지 중 하나를 고르려면 왼쪽 간이 계산기에 세금계산서 공급가를 입력해주세요 — 아직 입력이 없어서 기본값인 별도-합계액(반올림)을 사용했어요.'
    };
  }
  let best = null;
  separateModes.forEach(m=>{
    const sum = supplyComputed.reduce((s,r)=> s + (r.modes[m.id] ? r.modes[m.id].amt : 0), 0);
    const diff = Math.abs(sum - refTotal);
    if(!best || diff < best.diff) best = { mode:m.id, diff, sum };
  });
  const vendorNote = `거래처정보마스터DB의 매입전표부가세가 '별도'라 별도 6가지 중`;
  let matchNote;
  if(best.diff === 0) matchNote = '계산기 공급가 합계와 정확히 일치하는 방식을 찾았어요.';
  else if(best.diff <= 50) matchNote = `계산기 공급가 합계와 ${best.diff.toLocaleString()}원 차이로 거의 일치하는 방식을 찾았어요.`;
  else matchNote = `계산기 공급가 합계와 가장 가까운 방식을 찾았어요 (차이 ${best.diff.toLocaleString()}원 — 정확히 일치하는 방식은 없었어요).`;
  return { mode: best.mode, diff: best.diff, reason: `${vendorNote} ${matchNote}` };
}

function finalizeSupplyMode(){
  if(!supplyComputed.length){ supplyFinalRows = []; supplyDecision = null; renderSupplyModeInfo(); renderSupplyTable(); renderSupplyEditsList(); return; }
  supplyDecision = decideSupplyMode();
  supplyEditsMap = new Map();
  supplyFinalRows = supplyComputed.map((r, idx)=>{
    const m = r.modes[supplyDecision.mode] || { amt:0, unit:0, margin:null };
    return { ...r, unit:m.unit, amt:m.amt, margin:m.margin, _idx: idx, _orig: { unit:m.unit, amt:m.amt, lotNo:r.lotNo, expiry:r.expiry } };
  });
  reconcileSupplyTotals();
  renderSupplyModeInfo();
  renderSupplyTable();
  renderSupplyEditsList();
  recordPriceHistory('공급내역신고', supplyFinalRows);
}

// 매입전표 합계액(계산기)에 입력한 진짜 합계와 결과값 합계 사이에 반올림 등으로 몇십 원 이내
// 오차가 나면, 금액이 큰(마진 영향이 상대적으로 작은) 품목부터 실금액을 1원 단위로 보정해서
// 정확히 맞춰줍니다. 품목 하나가 흡수하는 보정액은 그 품목의 수량을 넘지 않도록 제한합니다
// (매입단가가 ±1원을 크게 벗어나지 않게 하기 위함). 보정 내역은 비고/수정 내역에 남아요.
function reconcileSupplyTotals(){
  if(!supplyFinalRows.length || !supplyDecision) return;
  const isIncluded = supplyDecision.mode === '포함';
  const target = isIncluded ? supplyCalcReferenceGrandTotal() : supplyCalcReferenceTotal();
  if(target === null) return;
  const currentSum = supplyFinalRows.reduce((s,r)=> s + (Number(r.amt)||0), 0);
  let diff = Math.round(target - currentSum);
  if(diff === 0) return;
  const sign = diff > 0 ? 1 : -1;
  let remaining = Math.abs(diff);
  const candidates = [...supplyFinalRows].sort((a,b)=> (b.amt||0) - (a.amt||0));
  for(const row of candidates){
    if(remaining <= 0) break;
    const qty = Number(row.qty) || 0;
    if(qty <= 1) continue; // 수량이 1 이하면 '수량 미만'만큼 보정할 여지가 없어요
    const maxAdj = qty - 1; // 보정액은 수량 미만이어야 함
    const adj = Math.min(maxAdj, remaining);
    if(adj <= 0) continue;
    const before = row.amt;
    row.amt = row.amt + sign*adj;
    row.unit = qty ? row.amt / qty : row.unit;
    remaining -= adj;
    supplyEditsMap.set(`${row._idx}:amt`, {
      productCode: row.productCode, barcode: row.barcode,
      field: '실금액(오차보정)', before, after: row.amt
    });
  }
}

function renderSupplyModeInfo(){
  const el = document.getElementById('supplyModeInfo');
  if(!supplyDecision){ el.style.display = 'none'; return; }
  el.style.display = 'block';
  const vendorPart = supplySelectedVendor && supplySelectedVendor.name ? `거래처: <b>${supplySelectedVendor.name}</b> · ` : '';
  const matched = supplyFinalRows.filter(r=>r.productCode).length;
  const matchPart = supplyFinalRows.length
    ? ` · 다미스제품코드마스터DB 매칭: <b>${matched}/${supplyFinalRows.length}건</b>${matched < supplyFinalRows.length ? ' (매칭 안 된 건은 표준코드·다미스코드명 칸이 비어있어요)' : ''}`
    : '';
  const reconciledCount = Array.from(supplyEditsMap.values()).filter(e=>e.field==='실금액(오차보정)').length;
  const reconcilePart = reconciledCount ? ` · 매입전표 합계액과 맞추기 위해 <b>${reconciledCount}개 품목</b>의 실금액을 자동 보정했어요 (비고란 참고)` : '';
  const diff = supplyDecision.diff;
  const isBigDiff = diff !== null && diff !== undefined && Math.abs(diff) > 1000;
  const warnPart = isBigDiff ? `<div style="color:var(--red); font-weight:800; margin-top:4px;">⚠ 매입전표 합계액과 결과값 차이가 커요 (${Math.abs(Math.round(diff)).toLocaleString()}원) — 계산기 입력값이나 붙여넣은 데이터를 다시 확인해주세요.</div>` : '';
  el.innerHTML = `${vendorPart}선택된 방식: <b>${supplyDecision.mode}</b> — ${supplyDecision.reason}${matchPart}${reconcilePart}${warnPart}`;
}

let supplyColumnWidths = {}; // 사용자가 드래그로 조절한 컬럼 너비 (key: 컬럼 key 또는 'flag'/'editNote')
const SUPPLY_COLWIDTH_KEY = 'stockout_dashboard_supply_colwidths_v1';

async function loadSupplyColumnWidths(){
  try{
    const res = await window.storage.get(SUPPLY_COLWIDTH_KEY, true);
    if(res && res.value) supplyColumnWidths = JSON.parse(res.value);
  }catch(e){ /* 저장된 값 없음 */ }
}
async function saveSupplyColumnWidths(){
  try{ await window.storage.set(SUPPLY_COLWIDTH_KEY, JSON.stringify(supplyColumnWidths), true); }catch(e){ console.error('공급내역신고(건별) 열너비 저장 실패:', e); }
}

function supplyEditNoteFor(idx){
  const parts = [];
  supplyEditsMap.forEach((e, key)=>{
    if(key.startsWith(idx + ':')){
      if(e.field === '제조번호' || e.field === '사용기한'){
        parts.push(`${e.field} ${e.before}→${e.after}`);
      } else {
        const delta = Math.round(e.after) - Math.round(e.before);
        const sign = delta > 0 ? '+' : '';
        parts.push(`${e.field} ${sign}${delta.toLocaleString()}원`);
      }
    }
  });
  return parts.join(', ');
}

function renderSupplyTable(){
  const screenCols = SUPPLY_COLUMNS.filter(c=>!c.hideOnScreen);
  const allCols = [
    { key:'flag', width:52 },
    ...screenCols,
    { key:'editNote', label:'비고', width:160 }
  ];
  const head = document.getElementById('head-supply');
  head.innerHTML = allCols.map(c=>{
    const w = supplyColumnWidths[c.key] || c.width;
    const label = c.key === 'productCode' ? `${c.label||''} <span style="color:var(--red); font-weight:800;">(공급내역신고-건별 주의)</span>` : (c.label||'');
    return `<th style="width:${w}px; position:relative;">${label}<span class="supply-col-resize" data-col="${c.key}" style="position:absolute; right:0; top:0; width:6px; height:100%; cursor:col-resize;"></span></th>`;
  }).join('');

  head.querySelectorAll('.supply-col-resize').forEach(handle=>{
    handle.addEventListener('mousedown', (e)=>{
      e.preventDefault();
      const th = handle.closest('th');
      const colKey = handle.dataset.col;
      const startX = e.clientX;
      const startWidth = th.getBoundingClientRect().width;
      function onMove(ev){
        const newWidth = Math.max(30, Math.round(startWidth + (ev.clientX - startX)));
        th.style.width = newWidth + 'px';
      }
      function onUp(){
        document.removeEventListener('mousemove', onMove);
        document.removeEventListener('mouseup', onUp);
        supplyColumnWidths[colKey] = parseInt(th.style.width, 10);
        saveSupplyColumnWidths();
      }
      document.addEventListener('mousemove', onMove);
      document.addEventListener('mouseup', onUp);
    });
  });

  // 마진 확인요망·사용기한 임박 여부를 행마다 한 번만 계산해서 정렬·렌더링에 그대로 재사용합니다
  // (예전에는 정렬 비교마다, 그리고 렌더링할 때 또 한 번씩 같은 계산을 반복하고 있었어요).
  const rows = supplyFinalRows.map(r=>{
    const monthsLeft = monthsUntilExpiry(r.expiry);
    const isSoon = monthsLeft !== null && monthsLeft < 9;
    const isMarginWarn = r.margin !== null && r.margin !== undefined && !isNaN(r.margin) && (r.margin <= 0.04 || r.margin >= 0.12);
    const rank = isMarginWarn ? 0 : (isSoon ? 1 : 2);
    return { r, isSoon, isMarginWarn, rank };
  }).sort((a,b)=> a.rank - b.rank);
  document.getElementById('count-supply').textContent = `${rows.length.toLocaleString()}건`;

  const sumEl = document.getElementById('supplySumInfo');
  if(supplyFinalRows.length){
    const sum = supplyFinalRows.reduce((s,r)=> s + (Number(r.amt)||0), 0);
    sumEl.style.display = 'block';
    sumEl.textContent = `결과값 합계액: ${Math.round(sum).toLocaleString()}원`;
  } else {
    sumEl.style.display = 'none';
  }

  const body = document.getElementById('body-supply');
  body.innerHTML = rows.map(({r, isSoon, isMarginWarn})=>{
    const flagLabel = isMarginWarn ? '확인요망' : (isSoon ? '임박' : '');
    const flagCell = `<td style="color:var(--red); font-weight:800; text-align:center;">${flagLabel}</td>`;
    const rowStyle = isMarginWarn ? ' style="color:var(--red);"' : '';
    const mainCells = screenCols.map(c=>{
      let v = r[c.key];
      if(c.pct){ v = (v===null || v===undefined || isNaN(v)) ? '' : (Math.round(v*10000)/100).toLocaleString() + '%'; }
      else if(c.num){ v = (v===null || v===undefined || v==='' || isNaN(v)) ? '' : Math.round(v).toLocaleString(); }
      else if(v===null || v===undefined) v = '';
      else { v = escapeHtml(v); } // 외부 데이터(제품명/제조번호/구매비고 등 텍스트 컬럼)만 여기서 이스케이프해요. 숫자/퍼센트 컬럼은 위에서 이미 별도 분기로 처리돼서 이 줄까지 안 내려옵니다.
      const isExpiryWarn = c.key === 'expiry' && isSoon;
      const cellStyle = (!isMarginWarn && isExpiryWarn) ? ' style="color:var(--red); font-weight:700;"' : '';
      if(c.editable){
        return `<td class="num editable" contenteditable="true" data-idx="${r._idx}" data-field="${c.key}"${cellStyle}>${v}</td>`;
      }
      if(c.textEditable){
        return `<td class="editable" contenteditable="true" data-idx="${r._idx}" data-field="${c.key}" data-text="1"${cellStyle}>${v}</td>`;
      }
      return `<td class="${c.num||c.pct?'num':''}"${cellStyle}>${v}</td>`;
    }).join('');
    const noteCell = `<td style="color:var(--ink-dim); font-size:12px;">${supplyEditNoteFor(r._idx)}</td>`;
    return `<tr${rowStyle}>` + flagCell + mainCells + noteCell + '</tr>';
  }).join('');

  body.querySelectorAll('td[contenteditable]').forEach(td=>{
    td.addEventListener('blur', ()=>{
      const idx = Number(td.dataset.idx);
      const field = td.dataset.field;
      const row = supplyFinalRows.find(r=>r._idx===idx);
      if(!row) return;
      const isText = td.dataset.text === '1';
      const fieldLabel = field === 'unit' ? '매입단가' : (field === 'amt' ? '실금액' : (field === 'lotNo' ? '제조번호' : '사용기한'));
      if(isText){
        const val = String(td.textContent).trim();
        row[field] = val;
        td.classList.add('edited');
        const orig = row._orig[field] || '';
        const key = `${idx}:${field}`;
        if(val === orig){ supplyEditsMap.delete(key); }
        else {
          supplyEditsMap.set(key, {
            productCode: row.productCode, barcode: row.barcode,
            field: fieldLabel, before: orig || '(공란)', after: val || '(공란)'
          });
        }
        renderSupplyEditsList();
        renderSupplyTable();
        return;
      }
      const n = Number(String(td.textContent).replace(/,/g,'').trim());
      if(isNaN(n)) { td.textContent = Math.round(row[field]).toLocaleString(); return; }
      row[field] = n;
      td.classList.add('edited');
      const orig = row._orig[field];
      const key = `${idx}:${field}`;
      if(n === orig){ supplyEditsMap.delete(key); }
      else {
        supplyEditsMap.set(key, {
          productCode: row.productCode, barcode: row.barcode,
          field: fieldLabel,
          before: orig, after: n
        });
      }
      renderSupplyEditsList();
      renderSupplyTable();
    });
    td.addEventListener('keydown', (e)=>{ if(e.key==='Enter'){ e.preventDefault(); td.blur(); } });
  });
}

function renderSupplyEditsList(){
  const section = document.getElementById('supplyEditsSection');
  const body = document.getElementById('supplyEditsBody');
  if(supplyEditsMap.size === 0){ section.style.display = 'none'; body.innerHTML = ''; return; }
  section.style.display = 'block';
  body.innerHTML = Array.from(supplyEditsMap.values()).map(e=>`
    <tr>
      <td>${e.productCode || ''}</td>
      <td>${e.barcode || ''}</td>
      <td>${e.field}</td>
      <td class="num">${Math.round(e.before).toLocaleString()}</td>
      <td class="num">${Math.round(e.after).toLocaleString()}</td>
    </tr>`).join('');
}

async function saveSupplyRaw(){
  try{ await window.storage.set(SUPPLY_STORAGE_KEY, JSON.stringify(supplyRawRows), true); }catch(e){ console.error('공급내역신고(건별) 원본 데이터 저장 실패:', e); }
}

async function loadSupplyRaw(){
  try{
    const res = await window.storage.get(SUPPLY_STORAGE_KEY, true);
    if(res && res.value){
      supplyRawRows = JSON.parse(res.value);
      document.getElementById('supplyPasteArea').value = supplyRawRows.map(r=>r.join('\t')).join('\n');
    }
  }catch(e){ /* nothing saved yet */ }
}

function updateSupplyPasteInfo(){
  const el = document.getElementById('supplyPasteInfo');
  if(!supplyRawRows.length){ el.textContent = '아직 붙여넣은 데이터가 없어요'; return; }
  let text = `${supplyRawRows.length.toLocaleString()}행 붙여넣어짐 · 계산 완료`;
  // 제약사(거래처)·금액·날짜를 덧붙입니다. 날짜는 원본 N열(index 13, 유효기간) 값을 그대로 씁니다.
  const vendorName = supplySelectedVendor && supplySelectedVendor.name;
  const total = supplyFinalRows.length ? Math.round(supplyFinalRows.reduce((s,r)=> s + (Number(r.amt)||0), 0)) : null;
  const dateFmt = rawRowsDateStr(supplyRawRows, 13);
  const parts = [];
  if(vendorName) parts.push(vendorName);
  if(total !== null) parts.push(`${total.toLocaleString()}원`);
  if(dateFmt) parts.push(dateFmt);
  if(parts.length) text += ` · ${parts.join(' / ')}`;
  el.textContent = text;
}

// 수정 내역을 표 마지막에 별도 블록으로 덧붙인, 내보내기용 행 배열(일반 객체)을 만듭니다.
// 다운로드 파일은 화면 표시 여부와 무관하게 항상 이 10개 컬럼을, 이 순서 그대로 내려줍니다.
const SUPPLY_EXPORT_KEY_ORDER = ['productCode','barcode','dealType','damageType','qty','unit','amt','discount','lotNo','expiry'];
const SUPPLY_EXPORT_COLUMNS = SUPPLY_EXPORT_KEY_ORDER.map(k => SUPPLY_COLUMNS.find(c=>c.key===k));

function buildSupplyExportRows(){
  return supplyFinalRows.map(r=>{
    const o = {};
    SUPPLY_EXPORT_COLUMNS.forEach(c=>{
      let v = r[c.key];
      if(c.pct) v = (v===null||v===undefined||isNaN(v)) ? '' : Math.round(v*10000)/100;
      else if(c.num) v = (v===null||v===undefined||v===''||isNaN(v)) ? '' : Math.round(v);
      o[c.key] = (v===null||v===undefined) ? '' : v;
    });
    return o;
  });
}

function supplyExportFileBaseName(){
  const vendorName = (supplySelectedVendor && supplySelectedVendor.name) ? supplySelectedVendor.name : '공급내역신고';
  const safeName = vendorName.replace(/[\\/*?:[\]]/g,'');
  if(!supplyFinalRows.length || !supplyDecision) return safeName;
  const total = Math.round(supplyFinalRows.reduce((s,r)=> s + (Number(r.amt)||0), 0));
  const label = supplyDecision.mode === '포함' ? '포함' : '별도';
  return `${safeName}_${label}${total.toLocaleString('ko-KR')}`;
}

// 표준코드/상품코드/제조번호처럼 숫자로만 보이는 값은, 다운로드한 파일을 나중에 엑셀에서 열어
// 셀을 다시 입력하거나 저장할 때 엑셀이 "숫자"로 잘못 인식해서 지수표기(예: 8.8E+12)로 바꾸거나
// 맨 앞자리 0을 지워버릴 수 있어요. 그걸 막기 위해 이 컬럼들의 셀 서식을 "텍스트"로 고정해둡니다.
function forceTextFormatForColumns(ws, columns, keysToForce, rowCount, dataStartRow){
  const startRow = (dataStartRow === undefined) ? 1 : dataStartRow;
  keysToForce.forEach(key=>{
    const colIdx = columns.findIndex(c => c.key === key);
    if(colIdx === -1) return;
    for(let i = 0; i < rowCount; i++){
      const r = startRow + i;
      const addr = XLSX.utils.encode_cell({ r, c: colIdx });
      const cell = ws[addr];
      if(cell && cell.v !== undefined && cell.v !== null && cell.v !== ''){
        cell.t = 's';
        cell.v = String(cell.v);
        cell.z = '@';
      }
    }
  });
}

// 다미스 엑셀업로드 양식과 동일한 열 구조로 시트를 만듭니다:
// 1행 헤더(코드/의약품표준코드/거래유형/파손유무/수량/공급단가/공급가액/할인/제조번호/유효기간)
// + 2행부터 데이터 (제목행 없이 헤더와 값만 — 제목행이 있으면 업로드 시 오류가 났어요).
// 할인 값이 비어있으면 다미스 업로드 시 "입력 문자열의 형식이 잘못되었습니다 / DcAmtI 열에
// 저장할 수 없습니다, Decimal 형식이 필요합니다" 오류가 나므로, 비어있으면 항상 0으로 채웁니다.
const DAMIS_UPLOAD_HEADERS = ['코드','의약품표준코드','거래유형','파손유무','수량','공급단가','공급가액','할인','제조번호','유효기간'];
const DAMIS_UPLOAD_DATA_START_ROW = 1; // 0-based → 엑셀 2행부터 데이터
function buildDamisUploadSheet(exportColumns, rows, forceTextKeys){
  const aoa = [ DAMIS_UPLOAD_HEADERS ];
  rows.forEach(o=>{
    aoa.push(exportColumns.map(c=>{
      let v = o[c.key];
      if(c.key === 'discount' && (v === '' || v === null || v === undefined)) v = 0;
      return v;
    }));
  });
  const ws = XLSX.utils.aoa_to_sheet(aoa);
  forceTextFormatForColumns(ws, exportColumns, forceTextKeys, rows.length, DAMIS_UPLOAD_DATA_START_ROW);
  return ws;
}

async function exportSupplyXlsx(){
  if(!supplyFinalRows.length){ alert('먼저 데이터를 붙여넣고 결과를 계산해주세요.'); return; }
  const rows = buildSupplyExportRows();
  // 다미스 엑셀업로드 양식(헤더+데이터, 할인 0 채움)과 동일한 구조로 저장합니다.
  const ws = buildDamisUploadSheet(SUPPLY_EXPORT_COLUMNS, rows, ['productCode','barcode','lotNo','expiry']);
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, (supplyDecision ? supplyDecision.mode : '공급내역신고').replace(/[\\/*?:[\]]/g,'').slice(0,31));
  XLSX.writeFile(wb, supplyExportFileBaseName() + '_' + (rawRowsDateStr(supplyRawRows, 13) || new Date().toISOString().slice(0,10)) + '.xlsx', { bookType:'xlsx' });
}

function exportSupplyXls(){
  if(!supplyFinalRows.length){ alert('먼저 데이터를 붙여넣고 결과를 계산해주세요.'); return; }
  const rows = buildSupplyExportRows();
  const ws = buildDamisUploadSheet(SUPPLY_EXPORT_COLUMNS, rows, ['productCode','barcode','lotNo','expiry']);
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, (supplyDecision ? supplyDecision.mode : '공급내역신고').replace(/[\\/*?:[\]]/g,'').slice(0,31));
  XLSX.writeFile(wb, supplyExportFileBaseName() + '_' + (rawRowsDateStr(supplyRawRows, 13) || new Date().toISOString().slice(0,10)) + '.xls', { bookType:'xls' });
}

// 엑셀에서 복사하면 일반 텍스트(clipboard 'text/plain') 말고 서식이 담긴 'text/html'도 함께 담깁니다.
// 엑셀 HTML에는 셀이 숫자일 때 화면표시(지수표기)와 별개로 실제 값을 담은 속성(x:num 등)이 남아있는
// 경우가 있어, 있으면 그 값을 우선 사용해 표준코드 같은 큰 숫자가 지수표기로 잘리는 걸 자동으로
// 막아줍니다 (엑셀 버전에 따라 없을 수도 있고, 그럴 땐 그냥 평소처럼 붙여넣기가 진행돼요).
function parseExcelHtmlTable(html){
  try{
    const doc = new DOMParser().parseFromString(html, 'text/html');
    const table = doc.querySelector('table');
    if(!table) return null;
    const rows = [];
    table.querySelectorAll('tr').forEach(tr=>{
      const cells = [];
      tr.querySelectorAll('td,th').forEach(td=>{
        const numAttr = td.getAttribute('x:num') || td.getAttribute('sdnum') || td.getAttribute('data-sheets-value');
        if(numAttr){
          const n = parseFloat(numAttr);
          if(!isNaN(n)){ cells.push(String(n)); return; }
        }
        const textVal = (td.textContent || '').replace(/[\r\n]+/g, ' ').trim();
        cells.push(textVal);
      });
      if(cells.length) rows.push(cells);
    });
    return rows.length ? rows : null;
  }catch(e){ return null; }
}

// CSV 파일은 어떤 인코딩으로 저장됐는지 파일 안에 정보가 없어요(엑셀 xlsx/xls와 다르게).
// 브라우저가 기본으로 가정하는 UTF-8이 아니라 EUC-KR/CP949로 저장된 한글 CSV(정부 공공데이터에 흔해요)를
// 그대로 읽으면 글자가 깨져요("Á¦Ç°¸í" 처럼). UTF-8로 읽은 결과에 이상한 글자가 많으면 EUC-KR로 다시 읽어요.
function looksMojibake(text){
  const sample = text.slice(0, 2000);
  if(!sample) return false;
  const bad = (sample.match(/[\uFFFD\u00C0-\u00FF]/g) || []).length;
  return bad > sample.length * 0.05;
}
function readWorkbookAoaFromBuffer(buf, filename){
  const isCsv = /\.csv$/i.test(filename || '');
  if(isCsv){
    let text = new TextDecoder('utf-8').decode(buf);
    if(looksMojibake(text)){
      try{ text = new TextDecoder('euc-kr').decode(buf); }catch(e){ /* 브라우저가 euc-kr을 지원 안 하면 utf-8 결과라도 씁니다 */ }
    }
    const wb = XLSX.read(text, { type:'string' });
    const ws = wb.Sheets[wb.SheetNames[0]];
    return XLSX.utils.sheet_to_json(ws, { header:1, raw:true, defval:'' });
  }
  const wb = XLSX.read(buf, { type:'array' });
  const ws = wb.Sheets[wb.SheetNames[0]];
  return XLSX.utils.sheet_to_json(ws, { header:1, raw:true, defval:'' });
}

// 엑셀/CSV 파일을 읽어서, 붙여넣기 칸에 그대로 넣을 수 있는 탭 구분 텍스트로 바꿔줍니다.
async function readWorkbookAsTsv(file){
  const buf = await file.arrayBuffer();
  const aoa = readWorkbookAoaFromBuffer(buf, file.name);
  return aoa.map(row => row.map(v => v===null ? '' : v).join('\t')).join('\n');
}

function bindSupplyTab(){
  document.getElementById('supplyFileInput').addEventListener('change', async (e)=>{
    const file = e.target.files[0];
    if(!file) return;
    const text = await readWorkbookAsTsv(file);
    document.getElementById('supplyPasteArea').value = text;
    document.getElementById('supplyApplyBtn').click();
    e.target.value = '';
  });
  document.getElementById('supplyPasteArea').addEventListener('paste', (e)=>{
    const html = e.clipboardData && e.clipboardData.getData('text/html');
    if(!html) return; // text/html이 없으면 평소처럼 일반 텍스트 붙여넣기가 그대로 진행됩니다.
    const rows = parseExcelHtmlTable(html);
    if(rows && rows.length){
      e.preventDefault();
      document.getElementById('supplyPasteArea').value = rows.map(r=>r.join('\t')).join('\n');
    }
  });
  document.getElementById('supplyApplyBtn').addEventListener('click', async ()=>{
    const text = document.getElementById('supplyPasteArea').value;
    // 예전엔 여기서 형식을 자동판별해서 "전체" 같으면 그쪽으로 강제로 넘겼는데, 그게 오판단할 때가
    // 있어서 계속 오류로 이어졌어요. 이제 "공급내역신고(건별)"을 직접 선택하셨으면 그대로 이 형식으로
    // 처리해요 — 자동으로 다른 형식으로 넘기지 않아요.
    supplyRawRows = parseSupplyPasteText(text);
    computeSupplyResults();
    updateSupplyPasteInfo();
  });
  document.getElementById('supplyClearBtn').addEventListener('click', async ()=>{
    if(!confirm('붙여넣은 공급내역신고 데이터를 지울까요?')) return;
    supplyRawRows = []; supplyComputed = []; supplyFinalRows = []; supplyDecision = null; supplyEditsMap = new Map();
    document.getElementById('supplyPasteArea').value = '';
    updateSupplyPasteInfo();
    renderSupplyModeInfo();
    renderSupplyTable();
    renderSupplyEditsList();
    try{ await window.storage.delete(SUPPLY_STORAGE_KEY, true); }catch(e){ console.error('매입전표입력(건별) 원본 삭제 실패:', e); }
  });
  document.getElementById('supplyExportXlsxBtn').addEventListener('click', exportSupplyXlsx);
  document.getElementById('supplyExportXlsBtn').addEventListener('click', exportSupplyXls);
  document.getElementById('supplyCalcResetBtn').addEventListener('click', ()=>{
    if(!confirm('매입전표 합계액 계산기 값을 모두 지울까요? (공급내역신고 건별·전체 화면에 함께 반영됩니다)')) return;
    resetSupplyCalc();
  });
}

async function initSupplyTab(){
  bindSupplyTab();
  renderSupplyCalcTable();
  await loadSupplyColumnWidths();
  if(supplyRawRows.length){
    computeSupplyResults();
    updateSupplyPasteInfo();
  }
}


// ================= 입고현황조회(테스트) — 공급내역신고와 완전히 동일한 기능(계산기/7모드 자동판별/확인요망·임박/편집·비고/열너비 저장/내보내기), 원본 열 위치만 다름 =================
// 헤더 있는 A~W(23개 열). 필요한 열만 씁니다 (0-based):
//   B(1)=사업자등록번호(공급업체), K(10)=표준코드명칭, L(11)=표준코드,
//   N(13)=공급수량, P(15)=공급단가, Q(16)=공급금액, S(18)=제조번호, T(19)=유효기간("YY-MM-DD")
const INBOUND_STORAGE_KEY = 'stockout_dashboard_inbound_raw_v1';
const INBOUND_MODES = [
  { id:'포함', label:'포함' },
  { id:'별도-합계액(내림)', label:'별도-합계액(내림)', base:'amt', round:'floor' },
  { id:'별도-합계액(반올림)', label:'별도-합계액(반올림)', base:'amt', round:'round' },
  { id:'별도-합계액(올림)', label:'별도-합계액(올림)', base:'amt', round:'ceil' },
  { id:'별도-단가(내림)', label:'별도-단가(내림)', base:'unit', round:'floor' },
  { id:'별도-단가(반올림)', label:'별도-단가(반올림)', base:'unit', round:'round' },
  { id:'별도-단가(올림)', label:'별도-단가(올림)', base:'unit', round:'ceil' },
];
const INBOUND_COLUMNS = [
  { key:'productCode', label:'제품코드', width:68 },
  { key:'barcode', label:'상품코드', width:140 },
  { key:'dealType', label:'거래유형', hideOnScreen:true },
  { key:'damageType', label:'파손유무', hideOnScreen:true },
  { key:'qty', label:'수량', num:true, width:56 },
  { key:'unit', label:'매입단가', num:true, editable:true, width:88 },
  { key:'amt', label:'실금액', num:true, editable:true, width:100 },
  { key:'discount', label:'할인금액', width:76, hideOnScreen:true },
  { key:'lotNo', label:'제조번호', width:94, textEditable:true },
  { key:'expiry', label:'사용기한', width:84, textEditable:true },
  { key:'margin', label:'마진', pct:true, width:70 },
  { key:'productName', label:'표준상품명', width:160 },
  { key:'maker', label:'다미스코드명', width:160 },
  { key:'note', label:'구매비고', width:192 },
  { key:'longout', label:'장기품절등록', width:84, hideOnScreen:true },
];

let inboundRawRows = [];      // 파싱된 원본 22열 행들
let inboundComputed = [];     // 매칭 + 7가지 모드 계산까지 끝난 행들 (모드 선택 전)
let inboundFinalRows = [];    // 자동 판별된 모드로 확정된, 화면에 보여주고 수정 가능한 행들
let inboundSelectedVendor = null;   // {name, vat} — 배치의 대표 거래처 (첫 매칭 성공 행 기준)
let inboundDecision = null;   // { mode, reason, diff }
let inboundEditsMap = new Map(); // key: `${idx}:${field}` -> {productCode,barcode,field,before,after}

// ---------- 매입전표 합계액: 공급내역신고 · 입고현황조회 두 메뉴가 완전히 같은 데이터(supplyCalcData)를 공유합니다 ----------
// 한쪽에 입력하면 다른 쪽 표도 즉시 함께 갱신되도록, 별도의 데이터 배열을 두지 않고
// supplyCalcData/recalcSupplyCalcRow를 그대로 재사용합니다.
function inboundCalcReferenceTotal(){ return supplyCalcReferenceTotal(); }
function inboundCalcReferenceGrandTotal(){ return supplyCalcReferenceGrandTotal(); }

function renderInboundCalcTotals(){
  let sSum=0, vSum=0, tSum=0, any=false;
  supplyCalcData.forEach(r=>{
    if(r.supply!==null || r.vat!==null){
      sSum += r.supply||0; vSum += r.vat||0; tSum += (r.total!==null ? r.total : ((r.supply||0)+(r.vat||0)));
      any = true;
    }
  });
  const row = document.getElementById('inboundCalcTotalRow');
  if(row){
    row.children[1].textContent = any ? fmtCalcNum(sSum) : '-';
    row.children[2].textContent = any ? fmtCalcNum(vSum) : '-';
    row.children[3].textContent = any ? fmtCalcNum(tSum) : '-';
  }
  const warnEl = document.getElementById('inboundCalcWarning');
  if(warnEl){
    const flagged = [];
    supplyCalcData.forEach((r,i)=>{
      if(r.supply && r.vat!==null && r.supply > 0){
        const ratio = r.vat / r.supply;
        if(ratio > 0.101) flagged.push(`${i+1}행(${(ratio*100).toFixed(1)}%)`);
      }
    });
    if(flagged.length){
      warnEl.style.display = 'block';
      warnEl.textContent = `⚠ 부가세가 공급가의 10%를 초과하는 줄이 있어요: ${flagged.join(', ')} — 값을 확인해주세요.`;
    } else {
      warnEl.style.display = 'none';
    }
  }
}

function renderInboundCalcTable(){
  const body = document.getElementById('inboundCalcBody');
  if(!body) return;
  const inputStyle = 'width:100%; border:1px solid #b9cdf0; border-radius:4px; text-align:right; font:inherit; background:var(--teal-bg, #eef4ff); padding:2px 4px; box-sizing:border-box;';
  const totalInputStyle = 'width:100%; border:2px solid var(--red); border-radius:4px; text-align:right; font:inherit; font-weight:800; background:var(--red-bg, #fff3f0); padding:2px 4px; box-sizing:border-box;';
  let html = '';
  for(let i=0; i<SUPPLY_CALC_ROWS; i++){
    const r = supplyCalcData[i];
    html += `<tr>
      <td class="num">${i+1}</td>
      <td class="num"><input type="text" class="calc-input" data-i="${i}" data-field="supply" value="${r.supply!==null?fmtCalcNum(r.supply):''}" style="${inputStyle}"></td>
      <td class="num"><input type="text" class="calc-input" data-i="${i}" data-field="vat" value="${r.vat!==null?fmtCalcNum(r.vat):''}" style="${inputStyle}"></td>
      <td class="num"><input type="text" class="calc-input" data-i="${i}" data-field="total" value="${r.total!==null?fmtCalcNum(r.total):''}" style="${totalInputStyle}"></td>
    </tr>`;
  }
  html += `<tr class="total-row" id="inboundCalcTotalRow"><td>총합계</td><td class="num">-</td><td class="num">-</td><td class="num">-</td></tr>`;
  body.innerHTML = html;

  body.querySelectorAll('input.calc-input').forEach(inp=>{
    inp.addEventListener('input', ()=>{
      const i = Number(inp.dataset.i);
      const field = inp.dataset.field;
      const raw = String(inp.value).replace(/,/g,'').trim();
      if(raw === '-') return; // 음수 입력 중('-'만 친 상태) — 다시 그리면 지워지므로 그대로 둡니다.
      const n = Number(raw);
      const val = (raw === '' || isNaN(n)) ? null : n;
      const result = recalcSupplyCalcRow(i, field, val);
      renderInboundCalcTable();
      renderSupplyCalcTable();
      if(!result.ok){
        const warnEl = document.getElementById('inboundCalcWarning');
        if(warnEl){ warnEl.style.display = 'block'; warnEl.textContent = `⚠ ${result.message}`; }
        const warnEl2 = document.getElementById('supplyCalcWarning');
        if(warnEl2){ warnEl2.style.display = 'block'; warnEl2.textContent = `⚠ ${result.message}`; }
      }
      // 방금 입력하던 칸에 포커스를 되돌려줍니다 (이 표 안에서만 찾아서, 다른 탭의 표로 포커스가 튀지 않게 합니다).
      const again = body.querySelector(`input.calc-input[data-i="${i}"][data-field="${field}"]`);
      if(again){ again.focus(); const len = again.value.length; again.setSelectionRange(len, len); }
    });
  });
  renderInboundCalcTotals();
  // 계산기 값이 바뀌면 이미 계산된 결과가 있을 경우 자동 판별 모드를 다시 계산합니다.
  if(inboundComputed.length) finalizeInboundMode();
}


// 붙여넣은 텍스트를 23열 행 배열로 분해합니다. 엑셀에서 복사하거나 파일을 올리면 항상 탭으로
// 구분돼요(파일 업로드는 readWorkbookAsTsv가 탭으로 바꿔줍니다) — 콤마는 금액의 천 단위 구분(예: "712,890")과
// 헷갈릴 수 있어서 구분자로 쓰지 않아요.
function parseInboundPasteText(text){
  const lines = text.split(/\r\n|\r|\n/).map(l=>l.replace(/\r+$/,'')).filter(l=>l.length>0);
  let rows = lines.map(line => line.split('\t').map(v=>v.trim()));
  // 헤더 줄이 있을 수도, 없을 수도 있어요. 첫 줄의 수량 칸(14번째, N열)이 숫자가 아니면
  // (헤더 텍스트로 보이면) 그 줄을 건너뜁니다. 헤더가 아예 없으면 이 조건에 안 걸려서 그대로 써요.
  // (예전에는 첫 칸이 정확히 '공급업체'라는 글자여야만 인식했는데, 그 텍스트가 조금만 달라도
  // 헤더를 못 걸러내는 문제가 있었어요.)
  if(rows.length){
    const qtyCell = String(rows[0][13] || '').trim();
    if(!qtyCell || isNaN(Number(qtyCell))) rows = rows.slice(1);
  }
  return rows;
}

// "8.80675E+12" 같은 지수표기 문자열에서 유효자리수(가수 자릿수)를 세어줍니다.





// 사용기한('YYYYMMDD')이 오늘로부터 몇 개월 남았는지 계산합니다 (달력 기준, 음수면 이미 지남).

function computeInboundResults(){
  const productIndex = buildProductBarcodeMap();
  const vendorMap = buildVendorTaxMap();
  inboundSelectedVendor = null;

  // 엑셀에서 복사할 때 뒤쪽 빈 줄까지 같이 선택되는 경우가 많아서, 셀이 전부 빈 줄은 결과에서 빼요.
  inboundComputed = inboundRawRows.filter(f => f.some(v => String(v||'').trim() !== '')).map(f=>{
    const get = i => (f[i] !== undefined ? f[i] : '');
    // 입고현황조회 형식(헤더 있는 A~W): B(1)=사업자등록번호(공급업체), K(10)=표준코드명칭, L(11)=표준코드,
    // N(13)=공급수량, P(15)=공급단가, Q(16)=공급금액, S(18)=제조번호, T(19)=유효기간("YY-MM-DD")
    const vendorTaxNo = String(get(1) || '').replace(/\D/g,'');
    const barcodeRaw = String(get(11) || '').trim();
    const qty = parseNumberSafe(get(13));
    const rawAmt = parseNumberSafe(get(16));
    const rawUnit = parseNumberSafe(get(15));
    const lotNoRaw = String(get(18) || '').trim();
    const expiryRaw = String(get(19) || '').trim().replace(/-/g,'');
    const lotNo = lotNoRaw ? lotNoRaw : '';
    const expiry = expiryRaw ? ('20' + expiryRaw.padStart(6,'0')) : '';

    const prod = lookupProductByBarcode(barcodeRaw, productIndex, get(10));
    // 매칭에 성공했으면 (지수표기로 잘렸던 코드라도) 다미스제품코드마스터DB의 정확한 표준코드로 바꿔서 보여줍니다.
    const barcode = prod && prod.barcode ? prod.barcode : barcodeRaw;
    const vend = vendorMap.get(vendorTaxNo) || null;
    if(vend && !inboundSelectedVendor) inboundSelectedVendor = vend;
    const generalPrice = prod ? Number(prod.price)||0 : 0;

    const modes = {};
    INBOUND_MODES.forEach(m=>{
      let amt, unit;
      if(m.id === '포함'){
        amt = rawAmt;
        unit = qty ? amt / qty : 0;
      } else if(m.base === 'amt'){
        amt = roundBy(m.round, rawAmt / 1.1);
        unit = qty ? amt / qty : 0;
      } else {
        unit = roundBy(m.round, rawUnit / 1.1);
        amt = unit * qty;
      }
      const compareBase = m.id === '포함' ? generalPrice : (generalPrice ? generalPrice/1.1 : 0);
      const margin = compareBase ? ((compareBase - unit) / compareBase) : null;
      modes[m.id] = { amt, unit, margin };
    });

    return {
      productCode: prod ? prod.code : '',
      barcode, dealType: 1, damageType: 1, qty, discount: '',
      lotNo, expiry, docNo: String(get(2) || '').trim(),
      productName: get(10),
      maker: prod ? prod.maker : '',
      note: prod ? prod.note : '', longout: prod ? prod.longout : '',
      generalPrice, modes
    };
  });

  filterInboundComputedByMatchingDoc();
  finalizeInboundMode();
  checkManagedItemsForFinalRows(inboundFinalRows);
}

// 붙여넣은 데이터에 접수번호(3열)가 여러 개 섞여있을 때(예: 하루치 전체 배치를 한 번에 붙여넣은 경우),
// 왼쪽 "매입전표 합계액" 계산기에 입력해둔 값과 정확히(또는 근접하게) 일치하는 접수번호만 남기고
// 나머지는 결과에서 제외해요 — "이 세금계산서가 어느 접수번호에 해당하는지" 찾아주는 용도예요.
// 접수번호가 1개뿐이면(보통의 경우) 아무것도 안 바꾸고 그대로 둡니다.
let inboundDocFilterInfo = null; // { applied, matched, allCount, mode:'exact'|'close'|'none' }
function filterInboundComputedByMatchingDoc(){
  inboundDocFilterInfo = null;
  const docSet = new Set(inboundComputed.map(r=>r.docNo).filter(v=>v));
  if(docSet.size <= 1) return; // 접수번호가 없거나 1개뿐이면 손대지 않아요.

  const vendorVatRaw = String((inboundSelectedVendor && inboundSelectedVendor.vat) || '').trim();
  const groups = new Map();
  inboundComputed.forEach(r=>{
    if(!r.docNo) return;
    if(!groups.has(r.docNo)) groups.set(r.docNo, []);
    groups.get(r.docNo).push(r);
  });

  let results;
  if(vendorVatRaw === '별도'){
    if(inboundCalcReferenceTotal() === null) return; // 계산기에 값이 아직 없으면 판단 불가 — 그대로 둡니다.
    // 새 비교 로직을 따로 만들지 않고, 지금 쓰는 decideInboundMode()를 접수번호별 부분집합에 그대로 돌려요
    // (전역 inboundComputed를 잠깐 그 접수번호의 행들로 바꿔치기했다가 끝나면 원래대로 되돌립니다).
    const savedComputed = inboundComputed;
    results = [...groups.entries()].map(([docNo, rows])=>{
      inboundComputed = rows;
      const decision = decideInboundMode();
      return { docNo, diff: decision.diff };
    });
    inboundComputed = savedComputed;
  } else {
    // '포함' 거래처는 지금 방식도 고를 방식이 하나뿐이라(rawAmt 그대로) 탐색은 필요 없지만,
    // "이 접수번호가 어느 세금계산서에 해당하는지" 찾는 건 여전히 유효해요 — 원본 포함 금액 합계를
    // 계산기의 합계액 합계와 그대로 비교합니다(계산 방식 자체는 지금과 동일, 비교 대상만 접수번호 단위로 좁힌 것).
    const refGrandTotal = inboundCalcReferenceGrandTotal();
    if(refGrandTotal === null) return;
    results = [...groups.entries()].map(([docNo, rows])=>{
      const sum = rows.reduce((s,r)=> s + (r.modes['포함'] ? r.modes['포함'].amt : 0), 0);
      return { docNo, diff: Math.abs(sum - refGrandTotal) };
    });
  }

  const exact = results.filter(r=>r.diff === 0);
  const close = results.filter(r=>r.diff !== null && r.diff > 0 && r.diff <= 50);
  const picked = exact.length ? exact : close;

  if(!picked.length){
    inboundDocFilterInfo = { applied:false, matched:[], allCount:docSet.size, mode:'none' };
    return;
  }
  const pickedDocs = new Set(picked.map(r=>r.docNo));
  inboundComputed = inboundComputed.filter(r => pickedDocs.has(r.docNo));
  inboundDocFilterInfo = { applied:true, matched:[...pickedDocs], allCount:docSet.size, mode: exact.length ? 'exact' : 'close' };
}

// 거래처의 매입전표부가세(포함/별도)와 계산기의 공급가 합계를 참고해 7가지 중 하나를 자동으로 고릅니다.
function decideInboundMode(){
  const refTotal = inboundCalcReferenceTotal();
  const vendorVatRaw = String((inboundSelectedVendor && inboundSelectedVendor.vat) || '').trim();

  if(vendorVatRaw !== '별도'){
    const reason = vendorVatRaw === '포함'
      ? `거래처정보마스터DB의 매입전표부가세 값이 '포함'이라 포함 방식을 그대로 사용했어요.`
      : `거래처정보마스터DB의 매입전표부가세 값이 '포함'/'별도'가 아니거나 비어있어서, 기본값인 포함 방식으로 계산했어요.`;
    return { mode:'포함', diff:0, reason };
  }

  const separateModes = INBOUND_MODES.filter(m=>m.id!=='포함');
  if(refTotal === null){
    return {
      mode:'별도-합계액(반올림)', diff:null,
      reason:'별도 방식 6가지 중 하나를 고르려면 왼쪽 간이 계산기에 세금계산서 공급가를 입력해주세요 — 아직 입력이 없어서 기본값인 별도-합계액(반올림)을 사용했어요.'
    };
  }
  let best = null;
  separateModes.forEach(m=>{
    const sum = inboundComputed.reduce((s,r)=> s + (r.modes[m.id] ? r.modes[m.id].amt : 0), 0);
    const diff = Math.abs(sum - refTotal);
    if(!best || diff < best.diff) best = { mode:m.id, diff, sum };
  });
  const vendorNote = `거래처정보마스터DB의 매입전표부가세가 '별도'라 별도 6가지 중`;
  let matchNote;
  if(best.diff === 0) matchNote = '계산기 공급가 합계와 정확히 일치하는 방식을 찾았어요.';
  else if(best.diff <= 50) matchNote = `계산기 공급가 합계와 ${best.diff.toLocaleString()}원 차이로 거의 일치하는 방식을 찾았어요.`;
  else matchNote = `계산기 공급가 합계와 가장 가까운 방식을 찾았어요 (차이 ${best.diff.toLocaleString()}원 — 정확히 일치하는 방식은 없었어요).`;
  return { mode: best.mode, diff: best.diff, reason: `${vendorNote} ${matchNote}` };
}

function finalizeInboundMode(){
  if(!inboundComputed.length){ inboundFinalRows = []; inboundDecision = null; renderInboundModeInfo(); renderInboundTable(); renderInboundEditsList(); return; }
  inboundDecision = decideInboundMode();
  inboundEditsMap = new Map();
  inboundFinalRows = inboundComputed.map((r, idx)=>{
    const m = r.modes[inboundDecision.mode] || { amt:0, unit:0, margin:null };
    return { ...r, unit:m.unit, amt:m.amt, margin:m.margin, _idx: idx, _orig: { unit:m.unit, amt:m.amt, lotNo:r.lotNo, expiry:r.expiry } };
  });
  reconcileInboundTotals();
  renderInboundModeInfo();
  renderInboundTable();
  renderInboundEditsList();
  recordPriceHistory('입고현황조회', inboundFinalRows);
}

// 매입전표 합계액(계산기)에 입력한 진짜 합계와 결과값 합계 사이에 반올림 등으로 몇십 원 이내
// 오차가 나면, 금액이 큰(마진 영향이 상대적으로 작은) 품목부터 실금액을 1원 단위로 보정해서
// 정확히 맞춰줍니다. 품목 하나가 흡수하는 보정액은 그 품목의 수량을 넘지 않도록 제한합니다
// (매입단가가 ±1원을 크게 벗어나지 않게 하기 위함). 보정 내역은 비고/수정 내역에 남아요.
function reconcileInboundTotals(){
  if(!inboundFinalRows.length || !inboundDecision) return;
  const isIncluded = inboundDecision.mode === '포함';
  const target = isIncluded ? inboundCalcReferenceGrandTotal() : inboundCalcReferenceTotal();
  if(target === null) return;
  const currentSum = inboundFinalRows.reduce((s,r)=> s + (Number(r.amt)||0), 0);
  let diff = Math.round(target - currentSum);
  if(diff === 0) return;
  const sign = diff > 0 ? 1 : -1;
  let remaining = Math.abs(diff);
  const candidates = [...inboundFinalRows].sort((a,b)=> (b.amt||0) - (a.amt||0));
  for(const row of candidates){
    if(remaining <= 0) break;
    const qty = Number(row.qty) || 0;
    if(qty <= 1) continue; // 수량이 1 이하면 '수량 미만'만큼 보정할 여지가 없어요
    const maxAdj = qty - 1; // 보정액은 수량 미만이어야 함
    const adj = Math.min(maxAdj, remaining);
    if(adj <= 0) continue;
    const before = row.amt;
    row.amt = row.amt + sign*adj;
    row.unit = qty ? row.amt / qty : row.unit;
    remaining -= adj;
    inboundEditsMap.set(`${row._idx}:amt`, {
      productCode: row.productCode, barcode: row.barcode,
      field: '실금액(오차보정)', before, after: row.amt
    });
  }
}

function renderInboundModeInfo(){
  const el = document.getElementById('inboundModeInfo');
  if(!inboundDecision){ el.style.display = 'none'; return; }
  el.style.display = 'block';
  const vendorPart = inboundSelectedVendor && inboundSelectedVendor.name ? `거래처: <b>${inboundSelectedVendor.name}</b> · ` : '';
  const matched = inboundFinalRows.filter(r=>r.productCode).length;
  const matchPart = inboundFinalRows.length
    ? ` · 다미스제품코드마스터DB 매칭: <b>${matched}/${inboundFinalRows.length}건</b>${matched < inboundFinalRows.length ? ' (매칭 안 된 건은 표준코드·다미스코드명 칸이 비어있어요)' : ''}`
    : '';
  const reconciledCount = Array.from(inboundEditsMap.values()).filter(e=>e.field==='실금액(오차보정)').length;
  const reconcilePart = reconciledCount ? ` · 매입전표 합계액과 맞추기 위해 <b>${reconciledCount}개 품목</b>의 실금액을 자동 보정했어요 (비고란 참고)` : '';
  const docFilterPart = (() => {
    if(!inboundDocFilterInfo) return '';
    if(inboundDocFilterInfo.applied){
      const label = inboundDocFilterInfo.mode === 'exact' ? '정확히 일치' : '근접 일치(50원 이내)';
      return ` · <b>접수번호 ${inboundDocFilterInfo.allCount}개 중 ${inboundDocFilterInfo.matched.length}개(${inboundDocFilterInfo.matched.join(', ')})</b>가 매입전표 합계액과 ${label}해서 그 데이터만 남겼어요(나머지 접수번호는 제외됨)`;
    }
    return ` · <span style="color:var(--red); font-weight:700;">⚠ 접수번호 ${inboundDocFilterInfo.allCount}개 중 매입전표 합계액과 일치하는 접수번호를 찾지 못해서, 전체 데이터를 그대로 뒀어요 — 계산기 입력값을 확인해주세요.</span>`;
  })();
  const diff = inboundDecision.diff;
  const isBigDiff = diff !== null && diff !== undefined && Math.abs(diff) > 1000;
  const warnPart = isBigDiff ? `<div style="color:var(--red); font-weight:800; margin-top:4px;">⚠ 매입전표 합계액과 결과값 차이가 커요 (${Math.abs(Math.round(diff)).toLocaleString()}원) — 계산기 입력값이나 붙여넣은 데이터를 다시 확인해주세요.</div>` : '';
  el.innerHTML = `${vendorPart}선택된 방식: <b>${inboundDecision.mode}</b> — ${inboundDecision.reason}${matchPart}${reconcilePart}${docFilterPart}${warnPart}`;
}

let inboundColumnWidths = {}; // 사용자가 드래그로 조절한 컬럼 너비 (key: 컬럼 key 또는 'flag'/'editNote')
const INBOUND_COLWIDTH_KEY = 'stockout_dashboard_inbound_colwidths_v1';

async function loadInboundColumnWidths(){
  try{
    const res = await window.storage.get(INBOUND_COLWIDTH_KEY, true);
    if(res && res.value) inboundColumnWidths = JSON.parse(res.value);
  }catch(e){ /* 저장된 값 없음 */ }
}
async function saveInboundColumnWidths(){
  try{ await window.storage.set(INBOUND_COLWIDTH_KEY, JSON.stringify(inboundColumnWidths), true); }catch(e){ console.error('공급내역신고(전체) 열너비 저장 실패:', e); }
}

function inboundEditNoteFor(idx){
  const parts = [];
  inboundEditsMap.forEach((e, key)=>{
    if(key.startsWith(idx + ':')){
      if(e.field === '제조번호' || e.field === '사용기한'){
        parts.push(`${e.field} ${e.before}→${e.after}`);
      } else {
        const delta = Math.round(e.after) - Math.round(e.before);
        const sign = delta > 0 ? '+' : '';
        parts.push(`${e.field} ${sign}${delta.toLocaleString()}원`);
      }
    }
  });
  return parts.join(', ');
}

function renderInboundTable(){
  const screenCols = INBOUND_COLUMNS.filter(c=>!c.hideOnScreen);
  const allCols = [
    { key:'flag', width:52 },
    ...screenCols,
    { key:'editNote', label:'비고', width:160 }
  ];
  const head = document.getElementById('head-inbound');
  head.innerHTML = allCols.map(c=>{
    const w = inboundColumnWidths[c.key] || c.width;
    const label = c.key === 'productCode' ? `${c.label||''} <span style="color:var(--red); font-weight:800;">(공급내역신고-전체 주의)</span>` : (c.label||'');
    return `<th style="width:${w}px; position:relative;">${label}<span class="inbound-col-resize" data-col="${c.key}" style="position:absolute; right:0; top:0; width:6px; height:100%; cursor:col-resize;"></span></th>`;
  }).join('');

  head.querySelectorAll('.inbound-col-resize').forEach(handle=>{
    handle.addEventListener('mousedown', (e)=>{
      e.preventDefault();
      const th = handle.closest('th');
      const colKey = handle.dataset.col;
      const startX = e.clientX;
      const startWidth = th.getBoundingClientRect().width;
      function onMove(ev){
        const newWidth = Math.max(30, Math.round(startWidth + (ev.clientX - startX)));
        th.style.width = newWidth + 'px';
      }
      function onUp(){
        document.removeEventListener('mousemove', onMove);
        document.removeEventListener('mouseup', onUp);
        inboundColumnWidths[colKey] = parseInt(th.style.width, 10);
        saveInboundColumnWidths();
      }
      document.addEventListener('mousemove', onMove);
      document.addEventListener('mouseup', onUp);
    });
  });

  // 마진 확인요망·사용기한 임박 여부를 행마다 한 번만 계산해서 정렬·렌더링에 그대로 재사용합니다.
  const rows = inboundFinalRows.map(r=>{
    const monthsLeft = monthsUntilExpiry(r.expiry);
    const isSoon = monthsLeft !== null && monthsLeft < 9;
    const isMarginWarn = r.margin !== null && r.margin !== undefined && !isNaN(r.margin) && (r.margin <= 0.04 || r.margin >= 0.12);
    const rank = isMarginWarn ? 0 : (isSoon ? 1 : 2);
    return { r, isSoon, isMarginWarn, rank };
  }).sort((a,b)=> a.rank - b.rank);
  document.getElementById('count-inbound').textContent = `${rows.length.toLocaleString()}건`;

  const sumEl = document.getElementById('inboundSumInfo');
  if(inboundFinalRows.length){
    const sum = inboundFinalRows.reduce((s,r)=> s + (Number(r.amt)||0), 0);
    sumEl.style.display = 'block';
    sumEl.textContent = `결과값 합계액: ${Math.round(sum).toLocaleString()}원`;
  } else {
    sumEl.style.display = 'none';
  }

  const body = document.getElementById('body-inbound');
  body.innerHTML = rows.map(({r, isSoon, isMarginWarn})=>{
    const flagLabel = isMarginWarn ? '확인요망' : (isSoon ? '임박' : '');
    const flagCell = `<td style="color:var(--red); font-weight:800; text-align:center;">${flagLabel}</td>`;
    const rowStyle = isMarginWarn ? ' style="color:var(--red);"' : '';
    const mainCells = screenCols.map(c=>{
      let v = r[c.key];
      if(c.pct){ v = (v===null || v===undefined || isNaN(v)) ? '' : (Math.round(v*10000)/100).toLocaleString() + '%'; }
      else if(c.num){ v = (v===null || v===undefined || v==='' || isNaN(v)) ? '' : Math.round(v).toLocaleString(); }
      else if(v===null || v===undefined) v = '';
      else { v = escapeHtml(v); } // 외부 데이터(제품명/제조번호/구매비고 등 텍스트 컬럼)만 여기서 이스케이프해요. 숫자/퍼센트 컬럼은 위에서 이미 별도 분기로 처리돼서 이 줄까지 안 내려옵니다.
      const isExpiryWarn = c.key === 'expiry' && isSoon;
      const cellStyle = (!isMarginWarn && isExpiryWarn) ? ' style="color:var(--red); font-weight:700;"' : '';
      if(c.editable){
        return `<td class="num editable" contenteditable="true" data-idx="${r._idx}" data-field="${c.key}"${cellStyle}>${v}</td>`;
      }
      if(c.textEditable){
        return `<td class="editable" contenteditable="true" data-idx="${r._idx}" data-field="${c.key}" data-text="1"${cellStyle}>${v}</td>`;
      }
      return `<td class="${c.num||c.pct?'num':''}"${cellStyle}>${v}</td>`;
    }).join('');
    const noteCell = `<td style="color:var(--ink-dim); font-size:12px;">${inboundEditNoteFor(r._idx)}</td>`;
    return `<tr${rowStyle}>` + flagCell + mainCells + noteCell + '</tr>';
  }).join('');

  body.querySelectorAll('td[contenteditable]').forEach(td=>{
    td.addEventListener('blur', ()=>{
      const idx = Number(td.dataset.idx);
      const field = td.dataset.field;
      const row = inboundFinalRows.find(r=>r._idx===idx);
      if(!row) return;
      const isText = td.dataset.text === '1';
      const fieldLabel = field === 'unit' ? '매입단가' : (field === 'amt' ? '실금액' : (field === 'lotNo' ? '제조번호' : '사용기한'));
      if(isText){
        const val = String(td.textContent).trim();
        row[field] = val;
        td.classList.add('edited');
        const orig = row._orig[field] || '';
        const key = `${idx}:${field}`;
        if(val === orig){ inboundEditsMap.delete(key); }
        else {
          inboundEditsMap.set(key, {
            productCode: row.productCode, barcode: row.barcode,
            field: fieldLabel, before: orig || '(공란)', after: val || '(공란)'
          });
        }
        renderInboundEditsList();
        renderInboundTable();
        return;
      }
      const n = Number(String(td.textContent).replace(/,/g,'').trim());
      if(isNaN(n)) { td.textContent = Math.round(row[field]).toLocaleString(); return; }
      row[field] = n;
      td.classList.add('edited');
      const orig = row._orig[field];
      const key = `${idx}:${field}`;
      if(n === orig){ inboundEditsMap.delete(key); }
      else {
        inboundEditsMap.set(key, {
          productCode: row.productCode, barcode: row.barcode,
          field: fieldLabel,
          before: orig, after: n
        });
      }
      renderInboundEditsList();
      renderInboundTable();
    });
    td.addEventListener('keydown', (e)=>{ if(e.key==='Enter'){ e.preventDefault(); td.blur(); } });
  });
}

function renderInboundEditsList(){
  const section = document.getElementById('inboundEditsSection');
  const body = document.getElementById('inboundEditsBody');
  if(inboundEditsMap.size === 0){ section.style.display = 'none'; body.innerHTML = ''; return; }
  section.style.display = 'block';
  body.innerHTML = Array.from(inboundEditsMap.values()).map(e=>`
    <tr>
      <td>${e.productCode || ''}</td>
      <td>${e.barcode || ''}</td>
      <td>${e.field}</td>
      <td class="num">${Math.round(e.before).toLocaleString()}</td>
      <td class="num">${Math.round(e.after).toLocaleString()}</td>
    </tr>`).join('');
}

async function saveInboundRaw(){
  try{ await window.storage.set(INBOUND_STORAGE_KEY, JSON.stringify(inboundRawRows), true); }catch(e){ console.error('공급내역신고(전체) 원본 데이터 저장 실패:', e); }
}

async function loadInboundRaw(){
  try{
    const res = await window.storage.get(INBOUND_STORAGE_KEY, true);
    if(res && res.value){
      inboundRawRows = JSON.parse(res.value);
      document.getElementById('inboundPasteArea').value = inboundRawRows.map(r=>r.join('\t')).join('\n');
    }
  }catch(e){ /* nothing saved yet */ }
}

function updateInboundPasteInfo(){
  const el = document.getElementById('inboundPasteInfo');
  if(!inboundRawRows.length){ el.textContent = '아직 붙여넣은 데이터가 없어요'; return; }
  let text = `${inboundRawRows.length.toLocaleString()}행 붙여넣어짐 · 계산 완료`;
  // 제약사(거래처)·금액·날짜를 덧붙입니다. 날짜는 원본 O열(index 14) 값을 그대로 씁니다.
  const vendorName = inboundSelectedVendor && inboundSelectedVendor.name;
  const total = inboundFinalRows.length ? Math.round(inboundFinalRows.reduce((s,r)=> s + (Number(r.amt)||0), 0)) : null;
  const dateFmt = rawRowsDateStr(inboundRawRows, 14);
  const parts = [];
  if(vendorName) parts.push(vendorName);
  if(total !== null) parts.push(`${total.toLocaleString()}원`);
  if(dateFmt) parts.push(dateFmt);
  if(parts.length) text += ` · ${parts.join(' / ')}`;
  el.textContent = text;
}

// 수정 내역을 표 마지막에 별도 블록으로 덧붙인, 내보내기용 행 배열(일반 객체)을 만듭니다.
// 다운로드 파일은 화면 표시 여부와 무관하게 항상 이 10개 컬럼을, 이 순서 그대로 내려줍니다.
const INBOUND_EXPORT_KEY_ORDER = ['productCode','barcode','dealType','damageType','qty','unit','amt','discount','lotNo','expiry'];
const INBOUND_EXPORT_COLUMNS = INBOUND_EXPORT_KEY_ORDER.map(k => INBOUND_COLUMNS.find(c=>c.key===k));

function buildInboundExportRows(){
  return inboundFinalRows.map(r=>{
    const o = {};
    INBOUND_EXPORT_COLUMNS.forEach(c=>{
      let v = r[c.key];
      if(c.pct) v = (v===null||v===undefined||isNaN(v)) ? '' : Math.round(v*10000)/100;
      else if(c.num) v = (v===null||v===undefined||v===''||isNaN(v)) ? '' : Math.round(v);
      o[c.key] = (v===null||v===undefined) ? '' : v;
    });
    return o;
  });
}

function inboundExportFileBaseName(){
  const vendorName = (inboundSelectedVendor && inboundSelectedVendor.name) ? inboundSelectedVendor.name : '공급내역신고';
  const safeName = vendorName.replace(/[\\/*?:[\]]/g,'');
  if(!inboundFinalRows.length || !inboundDecision) return safeName;
  const total = Math.round(inboundFinalRows.reduce((s,r)=> s + (Number(r.amt)||0), 0));
  const label = inboundDecision.mode === '포함' ? '포함' : '별도';
  return `${safeName}_${label}${total.toLocaleString('ko-KR')}`;
}

async function exportInboundXlsx(){
  if(!inboundFinalRows.length){ alert('먼저 데이터를 붙여넣고 결과를 계산해주세요.'); return; }
  const rows = buildInboundExportRows();
  // ExcelJS가 만드는 최신 스타일 대신, SheetJS로 더 단순하고 옛날 엑셀(2016 이전 포함)에서도
  // 잘 열리는 형태의 xlsx로 저장합니다.
  const aoa = [INBOUND_EXPORT_COLUMNS.map(c=>c.label)];
  rows.forEach(o=>{ aoa.push(INBOUND_EXPORT_COLUMNS.map(c=>o[c.key])); });
  const ws = XLSX.utils.aoa_to_sheet(aoa);
  forceTextFormatForColumns(ws, INBOUND_EXPORT_COLUMNS, ['productCode','barcode','lotNo','expiry'], rows.length);
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, (inboundDecision ? inboundDecision.mode : '공급내역신고').replace(/[\\/*?:[\]]/g,'').slice(0,31));
  XLSX.writeFile(wb, inboundExportFileBaseName() + '_' + (rawRowsDateStr(inboundRawRows, 14) || new Date().toISOString().slice(0,10)) + '.xlsx', { bookType:'xlsx' });
}

function exportInboundXls(){
  if(!inboundFinalRows.length){ alert('먼저 데이터를 붙여넣고 결과를 계산해주세요.'); return; }
  const rows = buildInboundExportRows();
  const aoa = [INBOUND_EXPORT_COLUMNS.map(c=>c.label)];
  rows.forEach(o=>{ aoa.push(INBOUND_EXPORT_COLUMNS.map(c=>o[c.key])); });
  const ws = XLSX.utils.aoa_to_sheet(aoa);
  forceTextFormatForColumns(ws, INBOUND_EXPORT_COLUMNS, ['productCode','barcode','lotNo','expiry'], rows.length);
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, (inboundDecision ? inboundDecision.mode : '공급내역신고').replace(/[\\/*?:[\]]/g,'').slice(0,31));
  XLSX.writeFile(wb, inboundExportFileBaseName() + '_' + (rawRowsDateStr(inboundRawRows, 14) || new Date().toISOString().slice(0,10)) + '.xls', { bookType:'xls' });
}

// 엑셀에서 복사하면 일반 텍스트(clipboard 'text/plain') 말고 서식이 담긴 'text/html'도 함께 담깁니다.
// 엑셀 HTML에는 셀이 숫자일 때 화면표시(지수표기)와 별개로 실제 값을 담은 속성(x:num 등)이 남아있는
// 경우가 있어, 있으면 그 값을 우선 사용해 표준코드 같은 큰 숫자가 지수표기로 잘리는 걸 자동으로
// 막아줍니다 (엑셀 버전에 따라 없을 수도 있고, 그럴 땐 그냥 평소처럼 붙여넣기가 진행돼요).

function bindInboundTab(){
  document.getElementById('inboundFileInput').addEventListener('change', async (e)=>{
    const file = e.target.files[0];
    if(!file) return;
    const text = await readWorkbookAsTsv(file);
    document.getElementById('inboundPasteArea').value = text;
    document.getElementById('inboundApplyBtn').click();
    e.target.value = '';
  });
  document.getElementById('inboundPasteArea').addEventListener('paste', (e)=>{
    const html = e.clipboardData && e.clipboardData.getData('text/html');
    if(!html) return; // text/html이 없으면 평소처럼 일반 텍스트 붙여넣기가 그대로 진행됩니다.
    const rows = parseExcelHtmlTable(html);
    if(rows && rows.length){
      e.preventDefault();
      document.getElementById('inboundPasteArea').value = rows.map(r=>r.join('\t')).join('\n');
    }
  });
  document.getElementById('inboundApplyBtn').addEventListener('click', async ()=>{
    const text = document.getElementById('inboundPasteArea').value;
    // 마찬가지로, "공급내역신고(전체)"을 직접 선택하셨으면 그대로 이 형식으로 처리해요.
    inboundRawRows = parseInboundPasteText(text);
    computeInboundResults();
    updateInboundPasteInfo();
  });
  document.getElementById('inboundClearBtn').addEventListener('click', async ()=>{
    if(!confirm('붙여넣은 공급내역신고 데이터를 지울까요?')) return;
    inboundRawRows = []; inboundComputed = []; inboundFinalRows = []; inboundDecision = null; inboundEditsMap = new Map(); inboundDocFilterInfo = null;
    document.getElementById('inboundPasteArea').value = '';
    updateInboundPasteInfo();
    renderInboundModeInfo();
    renderInboundTable();
    renderInboundEditsList();
    try{ await window.storage.delete(INBOUND_STORAGE_KEY, true); }catch(e){ console.error('매입전표입력(전체) 원본 삭제 실패:', e); }
  });
  document.getElementById('inboundExportXlsxBtn').addEventListener('click', exportInboundXlsx);
  document.getElementById('inboundExportXlsBtn').addEventListener('click', exportInboundXls);
  document.getElementById('inboundCalcResetBtn').addEventListener('click', ()=>{
    if(!confirm('매입전표 합계액 계산기 값을 모두 지울까요? (공급내역신고 건별·전체 화면에 함께 반영됩니다)')) return;
    resetSupplyCalc();
  });
}

async function initInboundTab(){
  bindInboundTab();
  renderInboundCalcTable();
  await loadInboundColumnWidths();
  if(inboundRawRows.length){
    computeInboundResults();
    updateInboundPasteInfo();
  }
}

// ================= 반품신청서(소분-테스트중) =================
// 4가지 조회 방식을 지원합니다.
//   다미스자료 기준(완제품코드): WH2060E_구매반품검사&승인결과 엑셀 업로드 → 표준코드+수량 추출
//   보험코드 기준(완제품코드)/소분코드: 코드+수량 붙여넣기(급여코드=약품코드 또는 비급여코드로 매칭)
//   합산(보험코드 기준(소분코드)제외): 위 다미스자료·보험코드(완제품코드) 결과를 같은 품목끼리 수량 합산
// 소분 처리: 완제품코드 조회에서 소분 품목이 걸리면 같은 약품코드의 소분 아닌 품목(다미스제품코드마스터DB에
// 먼저 나오는 순서)으로 자동 대체하고, 소분코드 조회는 반대로 소분 품목을 찾아줍니다.
const PLOOKUP_STORAGE_KEY = 'stockout_dashboard_plookup_raw_v1';
const PLOOKUP_DAMIS_STORAGE_KEY = 'stockout_dashboard_plookup_damis_v1';
const PLOOKUP_COLUMNS = [
  { key:'inputCode', label:'조회코드' },
  { key:'productCode', label:'제품코드' },
  { key:'productName', label:'상품명' },
  { key:'spec', label:'규격' },
  { key:'qty', label:'수량', num:true },
  { key:'maker', label:'제약사' },
  { key:'price', label:'일반가', num:true },
  { key:'stdCode', label:'표준코드' },
  { key:'insCode', label:'급여코드(약품코드)' },
  { key:'nonInsCode', label:'비급여코드' },
  { key:'note', label:'비고' },
];

let plookupInsRawRows = [];   // 보험코드 붙여넣기: [코드, 수량] 쌍
let plookupDamisRawRows = []; // 다미스자료 붙여넣기: WH2060E 원본 열 그대로(헤더 있어도/없어도 됨)
let plookupResults = [];
let plookupUnmatchedCount = 0;
let plookupSubstitutedCount = 0;

function plookupCurrentMode(){
  const el = document.querySelector('input[name="plookupMode"]:checked');
  return el ? el.value : 'damis';
}

function buildProductLookupMaps(){
  const pm = uploadState['productMaster'];
  const std = new Map(), insMap = new Map(), drugGroups = new Map();
  if(!pm) return { std, insMap, drugGroups, headers:null };
  const headers = pm.headers;
  const idxStd = headers.indexOf('표준코드');
  const idxDrug = headers.indexOf('약품코드');
  const idxNonIns = headers.indexOf('비급여코드');
  const barcodeCols = ['바코드1','바코드2','바코드3','바코드4','바코드5'].map(n=>headers.indexOf(n)).filter(i=>i!==-1);
  pm.rows.forEach(r=>{
    if(idxStd!==-1 && r[idxStd]!==null && r[idxStd]!==undefined && String(r[idxStd]).trim()!==''){
      const k = String(r[idxStd]).trim();
      if(!std.has(k)) std.set(k, r);
    }
    barcodeCols.forEach(ci=>{
      const v = r[ci];
      if(v!==null && v!==undefined && String(v).trim()!==''){
        const k = String(v).trim();
        if(!std.has(k)) std.set(k, r);
      }
    });
    if(idxDrug!==-1 && r[idxDrug]!==null && r[idxDrug]!==undefined && String(r[idxDrug]).trim()!==''){
      const k = String(r[idxDrug]).trim();
      if(!insMap.has(k)) insMap.set(k, r);
      if(!drugGroups.has(k)) drugGroups.set(k, []);
      drugGroups.get(k).push(r); // 다미스제품코드마스터DB에 나온 순서 그대로 쌓입니다(맨 앞이 '상위').
    }
    if(idxNonIns!==-1 && r[idxNonIns]!==null && r[idxNonIns]!==undefined && String(r[idxNonIns]).trim()!==''){
      const k = String(r[idxNonIns]).trim();
      if(!insMap.has(k)) insMap.set(k, r);
    }
  });
  return { std, insMap, drugGroups, headers };
}

function parsePlookupPasteText(text){
  const lines = text.split(/\r\n|\r|\n/).map(l=>l.replace(/\r+$/,'')).filter(l=>l.length>0);
  const useTab = text.includes('\t');
  return lines.map(line=>{
    if(useTab) return line.split('\t').map(v=>v.trim());
    return line.split(',').map(v=>v.trim());
  });
}

function plookupIsSplitRow(r, idxSpec, idxSplit){
  const spec = idxSpec!==-1 ? String(r[idxSpec]||'') : '';
  const splitVal = idxSplit!==-1 ? String(r[idxSplit]||'').trim().toUpperCase() : '';
  return spec.includes('소분') || splitVal === 'Y';
}

// 초기 행이 소분이면, 같은 약품코드 그룹에서 소분이 아닌 맨 위 품목으로 대체합니다(완제품코드 조회용).
function plookupResolveFromStdRow(initialRow, drugGroups, idxDrug, idxSpec, idxSplit){
  if(!plookupIsSplitRow(initialRow, idxSpec, idxSplit)) return { row: initialRow, substituted:false };
  const drugCode = idxDrug!==-1 ? String(initialRow[idxDrug]||'').trim() : '';
  const group = drugCode ? (drugGroups.get(drugCode) || []) : [];
  const alt = group.find(r => !plookupIsSplitRow(r, idxSpec, idxSplit));
  return alt ? { row: alt, substituted:true, originalRow: initialRow } : { row:null, substituted:false };
}

// 초기 행이 소분이 아니면, 같은 약품코드 그룹에서 소분인 맨 위 품목을 찾습니다(소분코드 조회용).
function plookupResolveSplitVariant(initialRow, drugGroups, idxDrug, idxSpec, idxSplit){
  if(plookupIsSplitRow(initialRow, idxSpec, idxSplit)) return { row: initialRow, substituted:false };
  const drugCode = idxDrug!==-1 ? String(initialRow[idxDrug]||'').trim() : '';
  const group = drugCode ? (drugGroups.get(drugCode) || []) : [];
  const alt = group.find(r => plookupIsSplitRow(r, idxSpec, idxSplit));
  return alt ? { row: alt, substituted:true, originalRow: initialRow } : { row:null, substituted:false };
}

// 붙여넣은 다미스자료의 첫 줄이 헤더(표준코드가 텍스트로 들어있음)인지 확인해서 열 위치를 찾고,
// 헤더가 없으면 WH2060E_구매반품검사&승인결과의 표준 열 위치(수량=13번째, 표준코드=18번째)로 처리합니다.
function detectDamisColumnIndices(rawRows){
  if(!rawRows.length) return { idxStd:17, idxQty:12, dataRows: rawRows };
  const first = rawRows[0].map(v=>String(v||'').trim());
  if(first.includes('표준코드')){
    return { idxStd: first.indexOf('표준코드'), idxQty: first.indexOf('수량'), dataRows: rawRows.slice(1) };
  }
  return { idxStd:17, idxQty:12, dataRows: rawRows };
}

// 같은 표준코드(품목)로 결과가 여러 줄 나오면 수량을 합산해서 한 줄로 합칩니다.
function mergePlookupResultsByCode(results){
  const merged = new Map();
  results.forEach(r=>{
    const key = r.stdCode || r.productCode || r.inputCode;
    if(!merged.has(key)){
      merged.set(key, { ...r, qty: Number(r.qty)||0, _inputCodes: [r.inputCode] });
    } else {
      const e = merged.get(key);
      e.qty += Number(r.qty)||0;
      if(!e._inputCodes.includes(r.inputCode)) e._inputCodes.push(r.inputCode);
    }
  });
  return Array.from(merged.values()).map(e=>{
    const inputCode = e._inputCodes.length > 1 ? e._inputCodes.join(', ') : e._inputCodes[0];
    const { _inputCodes, ...rest } = e;
    return { ...rest, inputCode };
  });
}

// 매칭 안 된 코드도 결과에 표시해서, 다미스제품코드마스터DB를 업데이트해야 하는지 바로 알 수 있게 합니다.
function plookupUnmatchedRow(inputCode, qty){
  return {
    inputCode, productCode: '', productName: '', spec: '', qty, maker: '', price: '',
    stdCode: '', insCode: '', nonInsCode: '', note: '⚠ 매칭 안 됨 (다미스제품코드마스터DB 확인 필요)'
  };
}

function computeDamisResults(){
  const { std, drugGroups, headers } = buildProductLookupMaps();
  const out = { results: [], unmatched: 0, substituted: 0 };
  if(!headers) return out;
  const idxCode = findHeaderIndex(headers, '코드');
  const idxMaker = headers.indexOf('제약사');
  const idxName = headers.indexOf('상품명');
  const idxSpec = headers.indexOf('규격');
  const idxSplit = headers.indexOf('소분');
  const idxPrice = headers.indexOf('일반가');
  const idxStd = headers.indexOf('표준코드');
  const idxDrug = headers.indexOf('약품코드');
  const idxNonIns = headers.indexOf('비급여코드');

  const { idxStd: colStd, idxQty: colQty, dataRows } = detectDamisColumnIndices(plookupDamisRawRows);
  if(colStd === -1) return out;

  dataRows.forEach(f=>{
    const inputCode = String(f[colStd] || '').trim();
    if(!inputCode) return;
    const qty = colQty!==-1 ? (Number(String(f[colQty]||'').replace(/,/g,''))||0) : 0;
    const initialRow = std.get(inputCode);
    if(!initialRow){ out.unmatched++; out.results.push(plookupUnmatchedRow(inputCode, qty)); return; }
    const resolved = plookupResolveFromStdRow(initialRow, drugGroups, idxDrug, idxSpec, idxSplit);
    if(!resolved || !resolved.row){ out.unmatched++; out.results.push(plookupUnmatchedRow(inputCode, qty)); return; }
    const r = resolved.row;
    let note = '';
    if(resolved.substituted){
      out.substituted++;
      const origStd = resolved.originalRow && idxStd!==-1 ? resolved.originalRow[idxStd] : inputCode;
      note = `소분 제외로 대체됨 (원래 표준코드: ${origStd})`;
    }
    out.results.push({
      inputCode, productCode: idxCode!==-1?r[idxCode]:'', productName: idxName!==-1?r[idxName]:'',
      spec: idxSpec!==-1?r[idxSpec]:'', qty, maker: idxMaker!==-1?r[idxMaker]:'',
      price: idxPrice!==-1?r[idxPrice]:'', stdCode: idxStd!==-1?r[idxStd]:'',
      insCode: idxDrug!==-1?r[idxDrug]:'', nonInsCode: idxNonIns!==-1?r[idxNonIns]:'', note
    });
  });
  out.results = mergePlookupResultsByCode(out.results);
  return out;
}

function computeInsResults(splitMode){
  const { insMap, drugGroups, headers } = buildProductLookupMaps();
  const out = { results: [], unmatched: 0, substituted: 0 };
  if(!headers) return out;
  const idxCode = findHeaderIndex(headers, '코드');
  const idxMaker = headers.indexOf('제약사');
  const idxName = headers.indexOf('상품명');
  const idxSpec = headers.indexOf('규격');
  const idxSplit = headers.indexOf('소분');
  const idxPrice = headers.indexOf('일반가');
  const idxStd = headers.indexOf('표준코드');
  const idxDrug = headers.indexOf('약품코드');
  const idxNonIns = headers.indexOf('비급여코드');

  plookupInsRawRows.forEach(f=>{
    const inputCode = String(f[0]||'').trim();
    const qty = f[1]!==undefined ? Number(String(f[1]).replace(/,/g,''))||0 : '';
    if(!inputCode) return;
    const initialRow = insMap.get(inputCode);
    if(!initialRow){ out.unmatched++; out.results.push(plookupUnmatchedRow(inputCode, qty)); return; }
    const resolved = splitMode
      ? plookupResolveSplitVariant(initialRow, drugGroups, idxDrug, idxSpec, idxSplit)
      : plookupResolveFromStdRow(initialRow, drugGroups, idxDrug, idxSpec, idxSplit);
    if(!resolved || !resolved.row){ out.unmatched++; out.results.push(plookupUnmatchedRow(inputCode, qty)); return; }
    const r = resolved.row;
    let note = '';
    if(resolved.substituted){
      out.substituted++;
      const origStd = resolved.originalRow && idxStd!==-1 ? resolved.originalRow[idxStd] : '';
      note = splitMode
        ? `소분코드로 대체됨 (원래 표준코드: ${origStd})`
        : `소분 제외로 대체됨 (원래 표준코드: ${origStd})`;
    }
    out.results.push({
      inputCode, productCode: idxCode!==-1?r[idxCode]:'', productName: idxName!==-1?r[idxName]:'',
      spec: idxSpec!==-1?r[idxSpec]:'', qty, maker: idxMaker!==-1?r[idxMaker]:'',
      price: idxPrice!==-1?r[idxPrice]:'', stdCode: idxStd!==-1?r[idxStd]:'',
      insCode: idxDrug!==-1?r[idxDrug]:'', nonInsCode: idxNonIns!==-1?r[idxNonIns]:'', note
    });
  });
  out.results = mergePlookupResultsByCode(out.results);
  return out;
}

function computeSumResults(){
  const damis = computeDamisResults();
  const insFull = computeInsResults(false);
  const merged = new Map();
  [...damis.results, ...insFull.results].forEach(r=>{
    const key = r.stdCode || r.productCode || r.inputCode;
    if(!merged.has(key)){
      merged.set(key, { ...r, qty: Number(r.qty)||0, inputCode: '(합산)' });
    } else {
      merged.get(key).qty += Number(r.qty)||0;
    }
  });
  return { results: Array.from(merged.values()), unmatched: damis.unmatched + insFull.unmatched, substituted: damis.substituted + insFull.substituted };
}

function computePlookupResults(){
  const mode = plookupCurrentMode();
  let out;
  if(mode === 'damis') out = computeDamisResults();
  else if(mode === 'ins_full') out = computeInsResults(false);
  else if(mode === 'ins_split') out = computeInsResults(true);
  else out = computeSumResults();
  plookupResults = out.results;
  plookupUnmatchedCount = out.unmatched;
  plookupSubstitutedCount = out.substituted;
}

function updatePlookupModeVisibility(){
  const mode = plookupCurrentMode();
  document.getElementById('plookupDamisArea').style.display = mode==='damis' ? 'block' : 'none';
  document.getElementById('plookupInsArea').style.display = (mode==='ins_full'||mode==='ins_split') ? 'block' : 'none';
  document.getElementById('plookupSumArea').style.display = mode==='sum' ? 'block' : 'none';
}

function renderPlookupInfo(){
  const el = document.getElementById('plookupInfo');
  const mode = plookupCurrentMode();
  const hasAnyInput = plookupDamisRawRows.length || plookupInsRawRows.length;
  if(!hasAnyInput){ el.style.display = 'none'; return; }
  el.style.display = 'block';
  const inputPart = mode==='sum' ? '' : `입력 <b>${(mode==='damis'?plookupDamisRawRows.length:plookupInsRawRows.length).toLocaleString()}건</b> · `;
  el.innerHTML = `${inputPart}결과 <b>${plookupResults.length.toLocaleString()}건</b> · 소분 대체 <b>${plookupSubstitutedCount.toLocaleString()}건</b> · 매칭 안 됨 <b>${plookupUnmatchedCount.toLocaleString()}건</b>`;
}

function renderPlookupTable(){
  const head = document.getElementById('head-plookup');
  head.innerHTML = PLOOKUP_COLUMNS.map(c=>`<th>${c.label}</th>`).join('');
  document.getElementById('count-plookup').textContent = `${plookupResults.length.toLocaleString()}건`;

  const body = document.getElementById('body-plookup');
  body.innerHTML = plookupResults.map(r=>{
    const isUnmatched = typeof r.note === 'string' && r.note.startsWith('⚠');
    const rowStyle = isUnmatched ? ' style="color:var(--red);"' : '';
    return `<tr${rowStyle}>` + PLOOKUP_COLUMNS.map(c=>{
      let v = r[c.key];
      if(c.num){ v = (v===null || v===undefined || v==='' || isNaN(v)) ? '' : Math.round(v).toLocaleString(); }
      else if(v===null || v===undefined) v = '';
      return `<td class="${c.num?'num':''}">${v}</td>`;
    }).join('') + '</tr>';
  }).join('');
}

async function savePlookupRaw(){
  try{ await window.storage.set(PLOOKUP_STORAGE_KEY, JSON.stringify(plookupInsRawRows), true); }catch(e){ console.error('제품조회(보험) 데이터 저장 실패:', e); }
}
async function loadPlookupRaw(){
  try{
    const res = await window.storage.get(PLOOKUP_STORAGE_KEY, true);
    if(res && res.value){
      plookupInsRawRows = JSON.parse(res.value);
      document.getElementById('plookupPasteArea').value = plookupInsRawRows.map(r=>r.join('\t')).join('\n');
    }
  }catch(e){}
}
async function savePlookupDamisRows(){
  try{ await window.storage.set(PLOOKUP_DAMIS_STORAGE_KEY, JSON.stringify(plookupDamisRawRows), true); }catch(e){ console.error('제품조회(다미스) 데이터 저장 실패:', e); }
}
async function loadPlookupDamisRows(){
  try{
    const res = await window.storage.get(PLOOKUP_DAMIS_STORAGE_KEY, true);
    if(res && res.value){
      plookupDamisRawRows = JSON.parse(res.value);
      document.getElementById('plookupDamisPasteArea').value = plookupDamisRawRows.map(r=>r.join('\t')).join('\n');
    }
  }catch(e){}
}
function updatePlookupPasteInfo(){
  const el = document.getElementById('plookupPasteInfo');
  el.textContent = plookupInsRawRows.length ? `${plookupInsRawRows.length.toLocaleString()}행 붙여넣어짐 · 계산 완료` : '아직 붙여넣은 데이터가 없어요';
}
function updatePlookupDamisInfo(){
  const el = document.getElementById('plookupDamisInfo');
  el.textContent = plookupDamisRawRows.length ? `${plookupDamisRawRows.length.toLocaleString()}행 붙여넣어짐 · 계산 완료` : '아직 붙여넣은 데이터가 없어요';
}


function buildPlookupExportRows(){
  return plookupResults.map(r=>{
    const o = {};
    PLOOKUP_COLUMNS.forEach(c=>{
      let v = r[c.key];
      if(c.num) v = (v===null||v===undefined||v===''||isNaN(v)) ? '' : Math.round(v);
      o[c.key] = (v===null||v===undefined) ? '' : v;
    });
    return o;
  });
}
async function exportPlookupXlsx(){
  if(!plookupResults.length){ alert('먼저 데이터를 넣고 결과를 계산해주세요.'); return; }
  const rows = buildPlookupExportRows();
  const columns = PLOOKUP_COLUMNS.map(c=>({ key:c.key, label:c.label, width:14, numFmt: c.num ? '#,##0' : undefined, center: c.num }));
  await downloadStyledXlsx({
    sheetName: '반품신청서_소분테스트',
    fileName: '반품신청서_소분테스트_' + new Date().toISOString().slice(0,10) + '.xlsx',
    columns, rows
  });
}
// 소분 반품리스트(대한약사회 양식용): 정확한 컬럼은 아직 확정 전이라, 우선 급여코드/비급여코드/수량만 뽑아둡니다.
// (양식이 확정되면 이 컬럼 배열에 필요한 항목만 추가하면 됩니다.)
const PLOOKUP_SPLITLIST_COLUMNS = [
  { key:'insCode', label:'급여코드(약품코드)' },
  { key:'nonInsCode', label:'비급여코드' },
  { key:'qty', label:'수량', num:true },
];
function buildPlookupSplitListExportRows(){
  return plookupResults.map(r=>{
    const o = {};
    PLOOKUP_SPLITLIST_COLUMNS.forEach(c=>{
      let v = r[c.key];
      if(c.num) v = (v===null||v===undefined||v===''||isNaN(v)) ? '' : Math.round(v);
      o[c.key] = (v===null||v===undefined) ? '' : v;
    });
    return o;
  });
}
async function exportPlookupSplitListXlsx(){
  if(!plookupResults.length){ alert('먼저 데이터를 넣고 결과를 계산해주세요.'); return; }
  const rows = buildPlookupSplitListExportRows();
  const columns = PLOOKUP_SPLITLIST_COLUMNS.map(c=>({ key:c.key, label:c.label, width:16, numFmt: c.num ? '#,##0' : undefined, center: c.num }));
  await downloadStyledXlsx({
    sheetName: '소분반품리스트',
    fileName: '소분반품리스트_' + new Date().toISOString().slice(0,10) + '.xlsx',
    columns, rows
  });
}
function exportPlookupXls(){
  if(!plookupResults.length){ alert('먼저 데이터를 넣고 결과를 계산해주세요.'); return; }
  const rows = buildPlookupExportRows();
  const aoa = [PLOOKUP_COLUMNS.map(c=>c.label)];
  rows.forEach(o=>{ aoa.push(PLOOKUP_COLUMNS.map(c=>o[c.key])); });
  const ws = XLSX.utils.aoa_to_sheet(aoa);
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, '반품신청서_소분테스트');
  XLSX.writeFile(wb, '반품신청서_소분테스트_' + new Date().toISOString().slice(0,10) + '.xls', { bookType:'xls' });
}

function bindPlookupTab(){
  document.getElementById('plookupApplyBtn').addEventListener('click', async ()=>{
    const text = document.getElementById('plookupPasteArea').value;
    plookupInsRawRows = parsePlookupPasteText(text);
    computePlookupResults();
    updatePlookupPasteInfo();
    renderPlookupInfo();
    renderPlookupTable();
    await savePlookupRaw();
  });
  document.getElementById('plookupClearBtn').addEventListener('click', async ()=>{
    if(!confirm('붙여넣은 데이터를 지울까요?')) return;
    plookupInsRawRows = [];
    document.getElementById('plookupPasteArea').value = '';
    updatePlookupPasteInfo();
    computePlookupResults();
    renderPlookupInfo();
    renderPlookupTable();
    try{ await window.storage.delete(PLOOKUP_STORAGE_KEY, true); }catch(e){}
  });
  document.getElementById('plookupDamisApplyBtn').addEventListener('click', async ()=>{
    const text = document.getElementById('plookupDamisPasteArea').value;
    plookupDamisRawRows = parsePlookupPasteText(text);
    computePlookupResults();
    updatePlookupDamisInfo();
    renderPlookupInfo();
    renderPlookupTable();
    await savePlookupDamisRows();
  });
  document.getElementById('plookupDamisClearBtn').addEventListener('click', async ()=>{
    if(!confirm('붙여넣은 다미스자료 데이터를 지울까요?')) return;
    plookupDamisRawRows = [];
    document.getElementById('plookupDamisPasteArea').value = '';
    updatePlookupDamisInfo();
    computePlookupResults();
    renderPlookupInfo();
    renderPlookupTable();
    try{ await window.storage.delete(PLOOKUP_DAMIS_STORAGE_KEY, true); }catch(e){}
  });
  document.querySelectorAll('input[name="plookupMode"]').forEach(r=>{
    r.addEventListener('change', async ()=>{
      updatePlookupModeVisibility();
      computePlookupResults();
      renderPlookupInfo();
      renderPlookupTable();
    });
  });
  document.getElementById('plookupExportXlsxBtn').addEventListener('click', exportPlookupXlsx);
  document.getElementById('plookupExportXlsBtn').addEventListener('click', exportPlookupXls);
  document.getElementById('plookupExportSplitListBtn').addEventListener('click', exportPlookupSplitListXlsx);
}

async function initPlookupTab(){
  bindPlookupTab();
  updatePlookupModeVisibility();
  await Promise.all([loadPlookupRaw(), loadPlookupDamisRows()]);
  updatePlookupPasteInfo();
  updatePlookupDamisInfo();
  computePlookupResults();
  renderPlookupInfo();
  renderPlookupTable();
}

// ================= 제품정보조회(테스트용) =================
// 새 업로드나 저장소 없이, 이미 올려둔 다미스제품코드마스터DB(약품코드/비급여코드/표준코드/대표코드/상품명)만 보고
// 보험코드로 조회합니다. 표준코드가 대표코드와 같은 행이면 '소분용'으로 표시해요.
// (붙여넣은 코드는 세션 동안만 유지되는 조회 전용 도구라 별도로 저장하지 않습니다.)
let productInfoQueryCodes = [];
let productInfoResults = [];

function computeProductInfoResults(){
  productInfoResults = [];
  const pm = uploadState['productMaster'];
  if(!pm || !pm.headers || !pm.rows) return;
  const idxDrug = pm.headers.indexOf('약품코드');
  const idxNonIns = pm.headers.indexOf('비급여코드');
  const idxStd = pm.headers.indexOf('표준코드');
  const idxRep = pm.headers.indexOf('대표코드');
  const idxName = pm.headers.indexOf('상품명');
  if(idxStd === -1 || idxRep === -1) return; // 표준코드·대표코드 열이 없으면 조회할 수 없어요.

  productInfoQueryCodes.forEach(code=>{
    const matches = pm.rows.filter(r=>{
      const drug = idxDrug!==-1 ? String(r[idxDrug]||'').trim() : '';
      const nonIns = idxNonIns!==-1 ? String(r[idxNonIns]||'').trim() : '';
      return drug === code || nonIns === code;
    });
    if(!matches.length){
      productInfoResults.push({ code, matched:false });
      return;
    }
    matches.forEach(r=>{
      const std = idxStd!==-1 ? String(r[idxStd]||'').trim() : '';
      const rep = idxRep!==-1 ? String(r[idxRep]||'').trim() : '';
      const name = idxName!==-1 ? String(r[idxName]||'') : '';
      productInfoResults.push({ code, std, rep, name, isSplit: !!std && std===rep, matched:true });
    });
  });
}

function renderProductInfoTable(){
  const body = document.getElementById('body-productInfo');
  if(!body) return;
  document.getElementById('count-productInfo').textContent = `${productInfoResults.length.toLocaleString()}건`;
  body.innerHTML = productInfoResults.map(r=>{
    if(!r.matched){
      return `<tr style="color:var(--red);"><td>${r.code}</td><td colspan="4">일치하는 다미스제품코드마스터DB 항목이 없어요</td></tr>`;
    }
    const tag = r.isSplit ? `<span style="color:#fff; background:var(--accent); padding:2px 8px; border-radius:999px; font-size:11px; font-weight:700;">소분용</span>` : '';
    return `<tr><td>${r.code}</td><td>${r.std}</td><td>${r.rep}</td><td>${r.name}</td><td>${tag}</td></tr>`;
  }).join('');
}

function updateProductInfoPasteInfo(){
  const el = document.getElementById('productInfoPasteInfo');
  el.textContent = productInfoQueryCodes.length ? `${productInfoQueryCodes.length.toLocaleString()}개 코드 붙여넣어짐` : '아직 붙여넣은 데이터가 없어요';
}

function applyProductInfoQuery(){
  const text = document.getElementById('productInfoPasteArea').value;
  productInfoQueryCodes = text.split('\n').map(s=>s.trim()).filter(Boolean);
  updateProductInfoPasteInfo();
  computeProductInfoResults();
  renderProductInfoTable();
}

function initProductInfoTab(){
  document.getElementById('productInfoApplyBtn').addEventListener('click', applyProductInfoQuery);
  document.getElementById('productInfoClearBtn').addEventListener('click', ()=>{
    document.getElementById('productInfoPasteArea').value = '';
    productInfoQueryCodes = [];
    productInfoResults = [];
    updateProductInfoPasteInfo();
    renderProductInfoTable();
  });
}

// ================= 제품정보검색2(테스트용) =================
// 제품정보조회(위)가 보험코드 하나로 콕 짚어 찾는 도구였다면, 이건 조건(제약사/소분/기타)으로 걸러서
// 여러 개를 훑어보는 도구입니다. 새 업로드 없이 기존 다미스제품코드마스터DB를 그대로 씁니다.
const PRODUCTSEARCH2_BASE_COLS = ['상품명','제약사','약품코드','비급여코드','표준코드','대표코드','소분'];
// 아직 다미스제품코드마스터DB에 없어도 되는 선택 열: 나중에 엑셀에 이 이름으로 열을 추가하면 자동으로 필터·표에 나타나요.
const PRODUCTSEARCH2_OPTIONAL_COLS = ['분류명','제형','구분','단종여부'];
let productSearch2Page = 0;
const PRODUCTSEARCH2_PAGE_SIZE = 50;

function productSearch2Setup(){
  const pm = uploadState['productMaster'];
  if(!pm || !pm.headers || !pm.rows) return null;
  const cols = PRODUCTSEARCH2_BASE_COLS.filter(c=> pm.headers.includes(c));
  const optionalCols = PRODUCTSEARCH2_OPTIONAL_COLS.filter(c=> pm.headers.includes(c));
  return { pm, cols: cols.concat(optionalCols), optionalCols };
}

function buildProductSearch2FilterOptions(){
  const setup = productSearch2Setup();
  const makerSel = document.getElementById('filterMaker-productSearch2');
  const extraWrap = document.getElementById('extraFilters-productSearch2');
  if(!setup){ makerSel.innerHTML = '<option value="">전체 제약사</option>'; extraWrap.innerHTML = ''; return; }
  const { pm, optionalCols } = setup;
  const idxMaker = pm.headers.indexOf('제약사');
  if(idxMaker !== -1){
    const makers = Array.from(new Set(pm.rows.map(r=>String(r[idxMaker]||'').trim()).filter(Boolean))).sort((a,b)=>a.localeCompare(b,'ko'));
    makerSel.innerHTML = '<option value="">전체 제약사</option>' + makers.map(m=>`<option value="${escapeAttr(m)}">${m}</option>`).join('');
  }
  extraWrap.innerHTML = optionalCols.map(col=>{
    const idx = pm.headers.indexOf(col);
    const values = Array.from(new Set(pm.rows.map(r=>String(r[idx]||'').trim()).filter(Boolean))).sort((a,b)=>a.localeCompare(b,'ko'));
    const options = values.map(v=>`<option value="${escapeAttr(v)}">${v}</option>`).join('');
    return `<select data-extra-col="${escapeAttr(col)}"><option value="">전체 ${col}</option>${options}</select>`;
  }).join('');
  extraWrap.querySelectorAll('select').forEach(sel=>{
    sel.addEventListener('change', ()=>{ productSearch2Page = 0; renderProductSearch2Table(); });
  });
}

function computeProductSearch2Rows(){
  const setup = productSearch2Setup();
  if(!setup) return { cols: [], rows: [] };
  const { pm, cols } = setup;
  const q = (document.getElementById('search-productSearch2').value||'').trim().toLowerCase();
  const makerFilter = document.getElementById('filterMaker-productSearch2').value;
  const splitFilter = document.getElementById('filterSplit-productSearch2').value;
  const idxMaker = pm.headers.indexOf('제약사');
  const idxSplit = pm.headers.indexOf('소분');
  const extraFilters = Array.from(document.querySelectorAll('#extraFilters-productSearch2 select'))
    .map(sel=>({ idx: pm.headers.indexOf(sel.dataset.extraCol), val: sel.value }))
    .filter(f=> f.idx!==-1 && f.val);

  const rows = pm.rows.filter(r=>{
    if(makerFilter && idxMaker!==-1 && String(r[idxMaker]||'').trim() !== makerFilter) return false;
    if(splitFilter){
      const v = idxSplit!==-1 ? String(r[idxSplit]||'').trim().toUpperCase() : '';
      if(splitFilter === 'Y' && v !== 'Y') return false;
      if(splitFilter === 'N' && v === 'Y') return false;
    }
    if(extraFilters.some(f=> String(r[f.idx]||'').trim() !== f.val)) return false;
    if(q && !cols.some(c=>{
      const idx = pm.headers.indexOf(c);
      return idx!==-1 && String(r[idx]||'').toLowerCase().includes(q);
    })) return false;
    return true;
  });
  return { cols, rows };
}

function renderProductSearch2Table(){
  const head = document.getElementById('head-productSearch2');
  const body = document.getElementById('body-productSearch2');
  if(!head || !body) return;
  const setup = productSearch2Setup();
  if(!setup){
    head.innerHTML = '';
    body.innerHTML = `<tr><td class="foot-note" style="text-align:left;">마스터DB &gt; 다미스제품코드마스터DB를 먼저 올려주세요.</td></tr>`;
    document.getElementById('count-productSearch2').textContent = '';
    document.getElementById('pager-productSearch2').innerHTML = '';
    return;
  }
  const { pm, cols } = setup;
  const { rows } = computeProductSearch2Rows();
  head.innerHTML = cols.map(c=>`<th>${c}</th>`).join('');
  document.getElementById('count-productSearch2').textContent = `${rows.length.toLocaleString()}건`;

  const totalPages = Math.max(1, Math.ceil(rows.length / PRODUCTSEARCH2_PAGE_SIZE));
  if(productSearch2Page >= totalPages) productSearch2Page = totalPages - 1;
  const start = productSearch2Page * PRODUCTSEARCH2_PAGE_SIZE;
  const pageRows = rows.slice(start, start + PRODUCTSEARCH2_PAGE_SIZE);

  body.innerHTML = pageRows.map(r=>{
    return '<tr>' + cols.map(c=>{
      const idx = pm.headers.indexOf(c);
      const v = idx!==-1 ? (r[idx]===null||r[idx]===undefined ? '' : r[idx]) : '';
      return `<td>${escapeHtml(v)}</td>`;
    }).join('') + '</tr>';
  }).join('');

  const pager = document.getElementById('pager-productSearch2');
  pager.innerHTML = `
    <button data-act="prev" ${productSearch2Page===0?'disabled':''}>‹ 이전</button>
    <span>${productSearch2Page+1} / ${totalPages} 페이지</span>
    <button data-act="next" ${productSearch2Page>=totalPages-1?'disabled':''}>다음 ›</button>
  `;
  pager.querySelectorAll('button').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      productSearch2Page = btn.dataset.act==='prev' ? Math.max(0, productSearch2Page-1) : Math.min(totalPages-1, productSearch2Page+1);
      renderProductSearch2Table();
    });
  });
}

function initProductSearch2Tab(){
  buildProductSearch2FilterOptions();
  document.getElementById('search-productSearch2').addEventListener('input', ()=>{ productSearch2Page = 0; renderProductSearch2Table(); });
  document.getElementById('filterMaker-productSearch2').addEventListener('change', ()=>{ productSearch2Page = 0; renderProductSearch2Table(); });
  document.getElementById('filterSplit-productSearch2').addEventListener('change', ()=>{ productSearch2Page = 0; renderProductSearch2Table(); });
  renderProductSearch2Table();
}

// ================= 매입단가 변동 이력(테스트중) =================
// 공급내역신고/입고현황조회/약가등재에서 결과가 확정될 때마다(finalizeXMode), 그 시점의 실제 매입단가를
// 제품코드별로 기록해둡니다(같은 날 같은 출처·제품코드는 최신 값으로 덮어써서 재계산해도 중복이 안 쌓여요).
// 숫자를 천단위 콤마로 표시 (반품신청서 인쇄 스크립트 안에도 같은 이름의 함수가 있지만, 그건 별도 스코프에 갇혀 있어
// 여기서는 안 보이므로 이 화면(메인 앱)에서 쓰는 용도로 똑같이 하나 더 둡니다.
function fmtNum(n){ if(n===null||n===''||n===undefined) return ''; return Number(n).toLocaleString('ko-KR'); }

const PRICE_HISTORY_STORAGE_KEY = 'shared_price_history_log_v1';
let priceHistoryLog = []; // { code, name, unit, source, date }
let priceHistorySelectedCode = null;

function todayKey(){ return new Date().toISOString().slice(0,10); }

function recordPriceHistory(source, rows){
  if(!rows || !rows.length) return;
  const date = todayKey();
  rows.forEach(r=>{
    const code = r.productCode;
    const unit = parseNumberSafe(r.unit, NaN);
    if(!code || !unit || isNaN(unit) || unit<=0) return; // 미매칭·단가없음 품목은 기록하지 않습니다.
    const i = priceHistoryLog.findIndex(h=>h.code===code && h.source===source && h.date===date);
    const entry = { code, name: r.productName||'', unit, source, date };
    if(i===-1) priceHistoryLog.push(entry); else priceHistoryLog[i] = entry;
  });
  savePriceHistoryLog();
}
async function savePriceHistoryLog(){
  try{ await window.storage.set(PRICE_HISTORY_STORAGE_KEY, JSON.stringify(priceHistoryLog), true); }catch(e){ console.error('매입단가 이력 저장 실패:', e); }
}
async function loadPriceHistoryLog(){
  try{
    const res = await window.storage.get(PRICE_HISTORY_STORAGE_KEY, true);
    if(res && res.value) priceHistoryLog = JSON.parse(res.value) || [];
  }catch(e){ priceHistoryLog = []; }
}

function priceHistoryGroups(){
  const map = new Map();
  priceHistoryLog.forEach(h=>{
    if(!map.has(h.code)) map.set(h.code, []);
    map.get(h.code).push(h);
  });
  map.forEach(list=> list.sort((a,b)=> a.date < b.date ? -1 : a.date > b.date ? 1 : 0));
  return map;
}

function renderPriceHistoryList(){
  const q = (document.getElementById('priceHistorySearch').value||'').trim().toLowerCase();
  const groups = priceHistoryGroups();
  let rows = Array.from(groups.entries()).map(([code, list])=>{
    const last = list[list.length-1];
    const first = list[0];
    const diff = last.unit - first.unit;
    return { code, name: last.name, lastUnit: last.unit, diff, count: list.length };
  });
  if(q) rows = rows.filter(r => r.code.toLowerCase().includes(q) || (r.name||'').toLowerCase().includes(q));
  rows.sort((a,b)=> Math.abs(b.diff) - Math.abs(a.diff));
  document.getElementById('priceHistoryCount').textContent = `${rows.length.toLocaleString()}품목`;
  const body = document.getElementById('body-priceHistoryList');
  body.innerHTML = rows.map(r=>{
    const diffColor = r.diff > 0 ? 'var(--red)' : (r.diff < 0 ? 'var(--teal)' : 'var(--ink-faint)');
    const diffTxt = r.diff === 0 ? '변동없음' : `${r.diff>0?'+':''}${fmtNum(r.diff)}원`;
    return `<tr data-code="${escapeAttr(r.code)}" style="cursor:pointer;">
      <td>${r.code}</td><td>${r.name}</td><td>${fmtNum(r.lastUnit)}원</td>
      <td style="color:${diffColor}; font-weight:700;">${diffTxt}</td><td>${r.count}</td>
    </tr>`;
  }).join('');
  body.querySelectorAll('tr').forEach(tr=>{
    tr.addEventListener('click', ()=>{ priceHistorySelectedCode = tr.dataset.code; renderPriceHistoryDetail(); });
  });
  if(priceHistorySelectedCode && !groups.has(priceHistorySelectedCode)){
    priceHistorySelectedCode = null;
    document.getElementById('priceHistoryDetailWrap').style.display = 'none';
  }
}

function renderPriceHistoryDetail(){
  if(!priceHistorySelectedCode) return;
  const groups = priceHistoryGroups();
  const list = groups.get(priceHistorySelectedCode) || [];
  document.getElementById('priceHistoryDetailWrap').style.display = 'block';
  document.getElementById('priceHistoryDetailTitle').textContent = `${priceHistorySelectedCode} — ${(list[0]&&list[0].name)||''} 상세 이력`;
  const body = document.getElementById('body-priceHistoryDetail');
  body.innerHTML = list.map((h, idx)=>{
    const prev = idx>0 ? list[idx-1].unit : null;
    const diff = prev===null ? null : h.unit - prev;
    const diffTxt = diff===null ? '-' : (diff===0 ? '변동없음' : `${diff>0?'+':''}${fmtNum(diff)}원`);
    const diffColor = diff>0 ? 'var(--red)' : (diff<0 ? 'var(--teal)' : 'var(--ink-faint)');
    return `<tr><td>${h.date}</td><td>${h.source}</td><td>${fmtNum(h.unit)}원</td><td style="color:${diffColor};">${diffTxt}</td></tr>`;
  }).join('');
}

function initPriceHistoryTab(){
  document.getElementById('priceHistorySearch').addEventListener('input', renderPriceHistoryList);
  renderPriceHistoryList();
}

// ================= 확인요망 통합함(테스트중) =================
// 공급내역신고/입고현황조회/약가등재 각 탭의 확정된 결과(*FinalRows)에서 마진 확인요망·사용기한 임박·미매칭만
// 뽑아 한 화면에 모아 보여줍니다(조회 전용 — 이 화면에서 직접 수정하지 않고 원래 탭에서 수정해요).
function checklistRowsFrom(source, rows, marginLow, marginHigh, checkUnmatched){
  if(!rows) return [];
  const out = [];
  rows.forEach(r=>{
    const isUnmatched = checkUnmatched && !r.productCode;
    const isMarginWarn = !isUnmatched && r.margin!==null && r.margin!==undefined && !isNaN(r.margin) && (r.margin<=marginLow || r.margin>=marginHigh);
    const monthsLeft = monthsUntilExpiry(r.expiry);
    const isSoon = !isUnmatched && monthsLeft!==null && monthsLeft<9;
    if(!isUnmatched && !isMarginWarn && !isSoon) return;
    const status = isUnmatched ? '미매칭' : (isMarginWarn ? '확인요망' : '임박');
    out.push({ source, status, code: r.productCode||'', name: r.productName||'', unit: r.unit, margin: r.margin, expiry: r.expiry });
  });
  return out;
}

function computeChecklistRows(){
  let rows = [];
  rows = rows.concat(checklistRowsFrom('공급내역신고', typeof supplyFinalRows!=='undefined'?supplyFinalRows:[], 0.04, 0.12, false));
  rows = rows.concat(checklistRowsFrom('입고현황조회', typeof inboundFinalRows!=='undefined'?inboundFinalRows:[], 0.04, 0.12, false));
  rows = rows.concat(checklistRowsFrom('약가등재', typeof pharmregFinalRows!=='undefined'?pharmregFinalRows:[], 0.04, 0.13, true));
  const statusRank = s => s==='미매칭' ? 0 : (s==='확인요망' ? 1 : 2);
  rows.sort((a,b)=> statusRank(a.status) - statusRank(b.status));
  return rows;
}

function renderChecklist(){
  const rows = computeChecklistRows();
  document.getElementById('checklistCount').textContent = `${rows.length.toLocaleString()}건`;
  const body = document.getElementById('body-checklist');
  body.innerHTML = rows.map(r=>{
    const color = r.status==='미매칭' ? 'var(--red)' : (r.status==='확인요망' ? 'var(--red)' : 'var(--amber)');
    const marginTxt = (r.margin===null||r.margin===undefined||isNaN(r.margin)) ? '' : (Math.round(r.margin*10000)/100).toLocaleString()+'%';
    return `<tr>
      <td>${r.source}</td><td style="color:${color}; font-weight:800;">${r.status}</td>
      <td>${r.code}</td><td>${r.name}</td><td>${r.unit?fmtNum(r.unit)+'원':''}</td><td>${marginTxt}</td><td>${formatDateSafe(r.expiry, r.expiry||'')}</td>
    </tr>`;
  }).join('');
}

function initChecklistTab(){
  document.getElementById('checklistRefreshBtn').addEventListener('click', renderChecklist);
  renderChecklist();
}

// ================= 발주서 작성 =================
let baljuRows = [];
let baljuColWidths = {}; // { '열이름': 픽셀너비 } — 사용자가 드래그로 조정한 열 너비를 기억해둬요

function baljuUsageId(loc){ const l = loc || document.getElementById('baljuLocation').value; return l === 'uj' ? 'usage3mUj' : 'usage3m'; }
function baljuSelectedLocations(){
  const v = document.getElementById('baljuLocation').value;
  return v === 'all' ? ['gj','uj'] : [v];
}

// 발주처(광주/의정부)를 바꾸면, 그 발주처의 3개월사용품목DB에 있는 우선처(제약사) 목록으로
// 드롭다운을 다시 채웁니다.
// 발주처(광주/의정부)를 바꾸면, 그 발주처의 3개월사용품목DB에 있는 우선처(제약사) 목록으로
// 드롭다운을 다시 채웁니다.
// 광주/의정부 발주서 상단에 들어갈 연락처·배송지 정보예요(원본 발주서 양식 그대로).
const BALJU_LOCATION_INFO = {
  gj: { name: '광주', contact: '02-440-1810~14', addr: '경기도 광주시 초월읍 경충대로 1331-11 동원헬스케어 경기도광주물류센터' },
  uj: { name: '의정부', contact: '031-850-3502', addr: '경기도 의정부시 시민로387번길 23-17' }
};

// 발주담당자별 개인 연락처예요. 인쇄물의 "연락처" 줄에는 지점 대표번호 대신, 그 거래처를 담당하는
// 사람의 전화·팩스가 나가요.
const BALJU_MANAGER_CONTACT = {
  '이상연': { tel:'02-440-1810', fax:'031-768-7027' },
  '최형욱': { tel:'02-440-1811', fax:'031-768-7027' },
  '김은경': { tel:'02-440-1813', fax:'031-768-7027' },
  '전송이': { tel:'02-440-1812', fax:'031-768-7027' },
  '예상화': { tel:'02-440-1813', fax:'031-768-7027' },
  '서호진': { tel:'031-850-3502', fax:'031-829-8208' },
  '유아름': { tel:'031-850-3505', fax:'031-829-8208' },
  '김동재': { tel:'031-850-3529', fax:'031-829-8208' }
};

// 선택한 우선처(제약사)를 거래처정보마스터DB에서 찾아 담당 발주담당자를 확인하고, 그 사람의
// 전화·팩스를 "이름 T.전화 F.팩스" 형식으로 돌려줍니다. 우선처를 "전체"로 고르셨거나, 담당자를
// 못 찾으면(매핑에 없는 사람이거나 매칭 실패) 지점 대표 연락처로 대신해요.
function baljuContactLineFor(vendor){
  if(vendor === BALJU_ALL_VENDOR) return null; // 호출부에서 지점 대표번호로 대체
  const vm = uploadState['vendorMaster'];
  if(!vm) return null;
  const idxName = findHeaderIndex(vm.headers, '매입처명');
  const idxManager = findHeaderIndex(vm.headers, '발주담당자');
  if(idxName === -1 || idxManager === -1) return null;
  const row = vm.rows.find(r => String(r[idxName]||'').trim() === vendor);
  const manager = row ? String(row[idxManager]||'').trim() : '';
  const contact = BALJU_MANAGER_CONTACT[manager];
  if(!manager || !contact) return null;
  return `${manager} T.${contact.tel} F.${contact.fax}`;
}

// 발주담당자를 고르면, 거래처정보마스터DB(매입처명↔발주담당자)를 기준으로 그 담당자가 맡은
// 우선처(제약사)만 남겨서 보여줘요. "전체"를 고르면 전부 다시 보여요.
function baljuManagerVendorSet(manager){
  if(!manager) return null; // null이면 "전체"라는 뜻이에요
  const vm = uploadState['vendorMaster'];
  if(!vm) return new Set();
  const idxName = findHeaderIndex(vm.headers, '매입처명');
  const idxManager = findHeaderIndex(vm.headers, '발주담당자');
  if(idxName === -1 || idxManager === -1) return new Set();
  const set = new Set();
  vm.rows.forEach(r=>{
    if(String(r[idxManager]||'').trim() === manager && r[idxName]) set.add(String(r[idxName]).trim());
  });
  return set;
}

function populateBaljuManagerOptions(){
  const sel = document.getElementById('baljuManager');
  const vm = uploadState['vendorMaster'];
  if(!vm){ sel.innerHTML = '<option value="">전체</option>'; return; }
  const idxManager = findHeaderIndex(vm.headers, '발주담당자');
  if(idxManager === -1){ sel.innerHTML = '<option value="">전체</option>'; return; }
  const managers = [...new Set(vm.rows.map(r=>String(r[idxManager]||'').trim()).filter(v=>v))].sort();
  sel.innerHTML = '<option value="">전체</option>' + managers.map(m=>`<option value="${m}">${m}</option>`).join('');
}

const BALJU_ALL_VENDOR = '__ALL__';
function baljuVendorLabel(vendor){ return vendor === BALJU_ALL_VENDOR ? '전체' : vendor; }

function populateBaljuVendorOptions(){
  const sel = document.getElementById('baljuVendor');
  const locs = baljuSelectedLocations();
  const ups = locs.map(loc => uploadState[baljuUsageId(loc)]).filter(Boolean);
  if(ups.length === 0){
    sel.innerHTML = '<option value="">이 발주처의 3개월사용품목DB가 아직 없어요 — 마스터DB에서 먼저 올려주세요</option>';
    return;
  }
  let vendors = new Set();
  ups.forEach(up=>{
    const idxClient = findHeaderIndex(up.headers, '우선처');
    if(idxClient === -1) return;
    up.rows.forEach(r=>{ const v = String(r[idxClient]||'').trim(); if(v) vendors.add(v); });
  });
  let vendorList = [...vendors];
  const manager = document.getElementById('baljuManager').value;
  const allowSet = baljuManagerVendorSet(manager);
  if(allowSet) vendorList = vendorList.filter(v => allowSet.has(v));
  vendorList.sort();
  const options = vendorList.map(v=>`<option value="${v}">${v}</option>`).join('');
  sel.innerHTML = options
    ? `<option value="${BALJU_ALL_VENDOR}">전체</option>${options}`
    : '<option value="">해당 담당자가 맡은 우선처가 없어요</option>';
}

// 지정한 발주처(gj/uj) 하나에 대해서만 표에 나올 행을 만듭니다. "전체"를 고르면 이 함수를
// 광주·의정부 각각 한 번씩 불러서 합쳐요 — 각 행에 loc을 표시해두면, 나중에 인쇄·엑셀에서
// 광주/의정부를 따로 뽑아낼 수 있어요. 우선처도 "전체"를 고르면(BALJU_ALL_VENDOR) 모든
// 제약사 품목을 다 가져와요.
function baljuPurchaseNoteMap(){
  const pm = uploadState['productMaster'];
  const map = new Map();
  if(!pm) return map;
  const idxCode = findHeaderIndex(pm.headers, '코드');
  const idxNote = findHeaderIndex(pm.headers, '구매비고');
  if(idxCode === -1 || idxNote === -1) return map;
  pm.rows.forEach(r=>{
    const key = String(r[idxCode]||'').trim();
    if(key) map.set(key, r[idxNote] || '');
  });
  return map;
}

// 단가는 위치(광주/의정부) 상관없이 항상 3개월사용품목-광주DB(usage3m)의 최종매입가를 그대로
// 가져와요 — 코드/표준코드로 찾아요.
function buildGwangjuUsagePriceMap(){
  const up = uploadState['usage3m'];
  const map = new Map();
  if(!up) return map;
  const idxCode = findHeaderIndex(up.headers, '코드');
  const idxStd = findHeaderIndex(up.headers, '표준코드');
  const idxFinalPrice = findHeaderIndex(up.headers, '최종매입가');
  if(idxFinalPrice === -1) return map;
  up.rows.forEach(r=>{
    const price = Number(String(r[idxFinalPrice]||'').replace(/,/g,'')) || 0;
    if(idxCode !== -1 && r[idxCode]) map.set(String(r[idxCode]).trim(), price);
    if(idxStd !== -1 && r[idxStd]) map.set(String(r[idxStd]).trim(), price);
  });
  return map;
}

function computeBaljuRowsForLocation(loc, vendor){
  const up = uploadState[baljuUsageId(loc)];
  if(!up) return [];
  const h = up.headers;
  const idxClient = findHeaderIndex(h, '우선처');
  const idxCode = findHeaderIndex(h, '코드');
  const idxMaker = findHeaderIndex(h, '제약사');
  const idxName = findHeaderIndex(h, '상품명');
  const idxSpec = findHeaderIndex(h, '규격');
  const idxStd = findHeaderIndex(h, '표준코드');
  // 매출수량(R~T열)·재고수량(Z열)은 UPLOAD_CONFIGS.usage3m/usage3mUj의 extraPositions가 붙여준 보이지 않는
  // 태그(BALJU_USAGE_TAGS)로 찾아요 — 화면 열 제목(양식)은 원본 헤더 텍스트 그대로 두면서도, 태그 덕분에
  // 항상 정확히 그 열을 찾을 수 있어요. (재업로드 전이라 태그가 없는 옛날 데이터는 못 찾음 = 빈 값으로 안전하게
  // 처리돼요 — 예전처럼 표준코드·최종매입가 같은 엉뚱한 열 값이 잘못 나오지 않아요.)
  const findByTag = tag => h.findIndex(x => String(x||'').endsWith(tag));
  const saleColIdx = [findByTag(BALJU_USAGE_TAGS.r), findByTag(BALJU_USAGE_TAGS.s), findByTag(BALJU_USAGE_TAGS.t)];
  // 태그를 못 찾아도(재업로드 전 옛날 데이터) 매출수량 칸 3개는 항상 유지해요(값만 빈 칸) — 그래야 표 헤더와
  // 줄 수가 어긋나지 않아요.
  const saleCols = saleColIdx.map(i => ({ label: i !== -1 ? h[i].replace(/\u200b+$/,'') : '', i }));
  const idxStockQty = findByTag(BALJU_USAGE_TAGS.z);

  const gwangjuPriceMap = buildGwangjuUsagePriceMap();
  const purchaseNoteMap = baljuPurchaseNoteMap();
  const wantAllVendors = vendor === BALJU_ALL_VENDOR;
  return up.rows
    .filter(r => wantAllVendors || (idxClient !== -1 && String(r[idxClient]||'').trim() === vendor))
    .map(r=>{
      const code = idxCode!==-1 ? String(r[idxCode]||'').trim() : '';
      const std = idxStd!==-1 ? String(r[idxStd]||'').trim() : '';
      // 단가: 광주 3개월사용품목DB의 최종매입가를 그대로 써요(광주·의정부 둘 다 동일한 기준).
      const price = gwangjuPriceMap.get(std) ?? gwangjuPriceMap.get(code) ?? 0;
      // 재고: 광주/의정부 각각의 3개월사용품목DB 자체의 Z열 값을 그대로 써요(재고DB·스카이젯은 쓰지 않아요).
      const stock = idxStockQty !== -1 ? (Number(String(r[idxStockQty]||'').replace(/,/g,'')) || 0) : '';
      return {
        loc, code, std,
        maker: idxMaker!==-1 ? r[idxMaker] : '',
        name: idxName!==-1 ? r[idxName] : '',
        spec: idxSpec!==-1 ? r[idxSpec] : '',
        sales: saleCols.map(c=>({ label:c.label, value: c.i !== -1 ? r[c.i] : '' })),
        stock,
        price,
        purchaseNote: purchaseNoteMap.get(code) || '',
        qty: '', note: ''
      };
    });
}

// 선택한 발주처·우선처 기준으로 표에 나올 행을 만듭니다. 코드/제약사/상품명/규격/표준코드는 그대로,
// 매출 3개월 열은 원본에 있는 純매출 계열 열 이름을 그대로 가져다 써요(달마다 열 이름이 바뀌어도
// 자동으로 맞게 나와요). 단가는 3개월사용품목-광주DB의 최종매입가, 현재고는 각 발주처 3개월사용품목DB의 Z열에서 가져오고, 발주수량·비고는 빈 칸으로 시작해서 직접 입력하시면 돼요.
// "전체"를 고르면 광주·의정부 데이터를 한 화면에 같이 보여주되(발주처 열로 구분), 인쇄·엑셀은
// 광주/의정부 각각 따로 나가요.
function computeBaljuRows(){
  const statusEl = document.getElementById('baljuStatus');
  const vendor = document.getElementById('baljuVendor').value;
  const locs = baljuSelectedLocations();
  const anyUploaded = locs.some(loc => uploadState[baljuUsageId(loc)]);
  if(!anyUploaded){ statusEl.textContent = '⚠️ 이 발주처의 3개월사용품목DB가 아직 없어요.'; baljuRows = []; renderBaljuTable(); return; }
  if(!vendor){ statusEl.textContent = '⚠️ 우선처(제약사)를 선택해주세요.'; baljuRows = []; renderBaljuTable(); return; }

  baljuRows = locs.flatMap(loc => computeBaljuRowsForLocation(loc, vendor));
  // 따로 정렬 버튼을 안 눌러도 바로 제조사 -> 제품명 -> 규격 순으로 보이게, 불러올 때 미리 정렬해둬요.
  // 머리글을 눌러 다른 기준으로 정렬하면 그게 우선돼요.
  baljuRows.sort((a,b)=>
    String(a.maker||'').localeCompare(String(b.maker||''), 'ko')
    || String(a.name||'').localeCompare(String(b.name||''), 'ko')
    || String(a.spec||'').localeCompare(String(b.spec||''), 'ko')
  );
  const locLabel = locs.length > 1 ? '광주+의정부' : (BALJU_LOCATION_INFO[locs[0]]?.name || '');
  statusEl.textContent = `${locLabel} · ${baljuVendorLabel(vendor)} 품목 ${baljuRows.length.toLocaleString()}건을 불러왔어요.`;
  baljuSort = { key: null, dir: 1 };
  renderBaljuTable();
}

// 정렬 상태: key는 'code'/'std'/'maker'/'name'/'spec'/'stock'/'price'/'qty'/'note' 중 하나거나,
// 매출 3개월처럼 매달 이름이 바뀌는 열은 {sales: 열인덱스} 형태로 저장해요.
let baljuSort = { key: null, dir: 1 };
function baljuSortValue(row, key){
  if(key && typeof key === 'object' && 'sales' in key) return Number(row.sales[key.sales]?.value) || 0;
  if(key === 'flags') return baljuRowFlags(row);
  const v = row[key];
  const n = Number(v);
  return isNaN(n) || v === '' ? String(v ?? '') : n;
}
function baljuSetSort(key){
  if(JSON.stringify(baljuSort.key) === JSON.stringify(key)) baljuSort.dir *= -1;
  else { baljuSort.key = key; baljuSort.dir = 1; }
  renderBaljuTable();
}

// 매출은 있는데(5~7월 중 하나라도) 재고가 0이면 "품절", 구매비고에 "임박"이 들어있으면 "임박"이라고
// 왼쪽 구분 칸에 보여줘요. 둘 다 해당하면 같이 보여줘요. 입력화면에서만 보이고 출력·엑셀엔 안 나가요.
function baljuRowFlags(r){
  const hadSales = r.sales.some(s => (Number(s.value)||0) > 0);
  const noStock = (Number(r.stock)||0) === 0;
  const flags = [];
  if(hadSales && noStock) flags.push('품절');
  if(String(r.purchaseNote||'').includes('임박')) flags.push('임박');
  return flags.join(', ');
}

function renderBaljuTable(){
  const headEl = document.getElementById('head-baljuform');
  const bodyEl = document.getElementById('body-baljuform');
  // 발주서작성.xlsx 헤더(구분·발주처·제약사·제품명·규격·6월매출·7월매출·8월매출·재고·발주수량·구매비고·단가·금액·비고) 그대로예요.
  // 값 출처는 그대로(computeBaljuRowsForLocation의 R·S·T·Z열 기준)이고, 여기서는 표시 라벨·열 구성만 그 엑셀에 맞췄어요.
  // (제품코드 열은 그 엑셀 헤더에 없어서 화면에서 뺐어요 — 검색에는 여전히 쓰여요. 인쇄·엑셀 다운로드는 이전과 동일합니다.)
  const colDefs = [
    { label:'구분', key:'flags' },
    { label:'발주처', key:'loc' },
    { label:'제약사', key:'maker' },
    { label:'제품명', key:'name' }, { label:'규격', key:'spec' },
    { label:'6월매출', key:{sales:0} }, { label:'7월매출', key:{sales:1} }, { label:'8월매출', key:{sales:2} },
    { label:'재고', key:'stock' }, { label:'발주수량', key:'qty' }, { label:'구매비고', key:'purchaseNote' },
    { label:'단가', key:'price' }, { label:'금액', key:null }, { label:'비고', key:'note' }
  ];
  headEl.innerHTML = colDefs.map((c,ci)=>{
    const isSorted = c.key !== null && JSON.stringify(baljuSort.key) === JSON.stringify(c.key);
    const arrow = isSorted ? (baljuSort.dir === 1 ? ' ▲' : ' ▼') : '';
    const savedWidth = baljuColWidths[c.label];
    const style = `cursor:pointer; user-select:none;${savedWidth ? ` width:${savedWidth}px;` : ''}`;
    const inner = c.key === null
      ? `<th style="${savedWidth ? `width:${savedWidth}px;` : ''}">${c.label}`
      : `<th style="${style}" data-sortkey='${JSON.stringify(c.key)}'>${c.label}${arrow}`;
    // 오른쪽 끝의 얇은 손잡이를 드래그하면 그 열 너비를 바꿀 수 있어요.
    return `${inner}<span class="balju-col-resizer" data-colidx="${ci}" style="position:absolute; right:0; top:0; bottom:0; width:6px; cursor:col-resize;"></span></th>`;
  }).join('');
  headEl.querySelectorAll('th[data-sortkey]').forEach(th=>{
    th.addEventListener('click', (e)=>{
      if(e.target.classList.contains('balju-col-resizer')) return; // 크기 조절 손잡이는 정렬 클릭과 안 겹치게
      baljuSetSort(JSON.parse(th.dataset.sortkey));
    });
  });
  headEl.querySelectorAll('.balju-col-resizer').forEach(handle=>{
    handle.addEventListener('mousedown', (e)=>{
      e.preventDefault();
      e.stopPropagation();
      const th = handle.parentElement;
      const label = colDefs[Number(handle.dataset.colidx)].label;
      const startX = e.clientX;
      const startWidth = th.offsetWidth;
      const onMove = (ev)=>{
        const newWidth = Math.max(40, startWidth + (ev.clientX - startX));
        th.style.width = newWidth + 'px';
        baljuColWidths[label] = newWidth;
      };
      const onUp = ()=>{
        document.removeEventListener('mousemove', onMove);
        document.removeEventListener('mouseup', onUp);
      };
      document.addEventListener('mousemove', onMove);
      document.addEventListener('mouseup', onUp);
    });
  });

  if(baljuSort.key !== null){
    const dir = baljuSort.dir;
    baljuRows.sort((a,b)=>{
      const va = baljuSortValue(a, baljuSort.key), vb = baljuSortValue(b, baljuSort.key);
      if(typeof va === 'number' && typeof vb === 'number') return (va - vb) * dir;
      return String(va).localeCompare(String(vb), 'ko') * dir;
    });
  }

  // 검색창 글자 + 구분 드롭다운을 같이 적용해서 화면에 뭘 보여줄지만 걸러내요(baljuRows 자체는
  // 안 바꿔요). 발주수량 입력 칸의 data-idx는 계속 baljuRows의 진짜 순번을 가리켜서, 걸러진
  // 상태에서 입력해도 엉뚱한 행이 바뀌지 않아요.
  const searchInput = document.getElementById('baljuSearchInput');
  const query = searchInput ? searchInput.value.trim().toLowerCase() : '';
  const flagFilter = (document.getElementById('baljuFlagFilter') || {}).value || '';
  const indexedRows = baljuRows.map((r, idx)=>({ r, idx }));
  const visibleRows = indexedRows.filter(({r})=>{
    if(flagFilter && !baljuRowFlags(r).includes(flagFilter)) return false;
    if(!query) return true;
    const haystack = [r.code, r.maker, r.name, r.spec, r.purchaseNote, r.note, baljuRowFlags(r), ...r.sales.map(s=>s.value)]
      .map(v=>String(v??'').toLowerCase()).join(' ');
    return haystack.includes(query);
  });

  bodyEl.innerHTML = visibleRows.map(({r, idx})=>{
    const amt = (Number(r.qty)||0) * (Number(r.price)||0);
    const flags = baljuRowFlags(r);
    return `<tr>
      <td>${flags}</td>
      <td>${BALJU_LOCATION_INFO[r.loc]?.name || r.loc}</td>
      <td>${r.maker}</td><td>${r.name}</td><td>${r.spec}</td>
      ${r.sales.map(s=>`<td class="num">${fmtNum(s.value)}</td>`).join('')}
      <td class="num">${fmtNum(r.stock)}</td>
      <td class="editable num" data-idx="${idx}" data-field="qty" contenteditable="true">${r.qty}</td>
      <td>${r.purchaseNote || ''}</td>
      <td class="num">${fmtNum(r.price)}</td>
      <td class="num balju-amt" data-idx="${idx}">${amt ? fmtNum(amt) : ''}</td>
      <td class="editable" data-idx="${idx}" data-field="note" contenteditable="true">${r.note}</td>
    </tr>`;
  }).join('');

  // 발주수량 칸에서 위/아래 화살표나 엔터로 다음·이전 행 발주수량 칸으로 바로 넘어갈 수 있어요
  // (엑셀처럼 쭉 입력할 수 있게요). blur마다 표 전체를 다시 그리면 품목이 많을 때 느려지니,
  // 값 저장 후에는 그 행의 금액 칸과 합계액만 직접 갱신하고, 표 전체는 다시 그리지 않아요.
  const moveQtyFocus = (idx, dir)=>{
    const targetIdx = idx + dir;
    const targetTd = bodyEl.querySelector(`td.editable[data-field="qty"][data-idx="${targetIdx}"]`);
    if(targetTd){
      targetTd.focus();
      const range = document.createRange();
      range.selectNodeContents(targetTd);
      const sel = window.getSelection();
      if(sel){ sel.removeAllRanges(); sel.addRange(range); }
    }
  };

  bodyEl.querySelectorAll('td.editable').forEach(td=>{
    const idx = Number(td.dataset.idx);
    const field = td.dataset.field;
    td.addEventListener('blur', ()=>{
      baljuRows[idx][field] = td.textContent.trim();
      if(field === 'qty'){
        const r = baljuRows[idx];
        const amt = (Number(r.qty)||0) * (Number(r.price)||0);
        const amtTd = bodyEl.querySelector(`td.balju-amt[data-idx="${idx}"]`);
        if(amtTd) amtTd.textContent = amt ? fmtNum(amt) : '';
        const total = baljuRows.reduce((sum,rr)=> sum + (Number(rr.qty)||0)*(Number(rr.price)||0), 0);
        document.getElementById('baljuTotal').textContent = baljuRows.length ? `발주 합계액: ${fmtNum(total)}원` : '';
      }
    });
    td.addEventListener('keydown', (e)=>{
      if(field === 'qty' && (e.key === 'Enter' || e.key === 'ArrowUp' || e.key === 'ArrowDown')){
        e.preventDefault();
        baljuRows[idx][field] = td.textContent.trim();
        td.blur();
        moveQtyFocus(idx, e.key === 'ArrowUp' ? -1 : 1);
        return;
      }
      if(e.key==='Enter'){ e.preventDefault(); td.blur(); }
    });
  });

  const total = baljuRows.reduce((sum,r)=> sum + (Number(r.qty)||0)*(Number(r.price)||0), 0);
  document.getElementById('baljuTotal').textContent = baljuRows.length ? `발주 합계액: ${fmtNum(total)}원` : '';
}

// 인쇄와 엑셀 다운로드 둘 다 여기서 같은 기준(발주수량 입력된 행만)으로 뽑아 씁니다.
// loc을 주면 그 발주처(광주/의정부) 행만 걸러줘요 — "전체" 모드에서 광주/의정부를 각각 따로
// 출력·저장할 때 씁니다.
function baljuRowsForOutput(loc){
  return baljuRows.filter(r => (Number(r.qty)||0) > 0 && (!loc || r.loc === loc));
}

// 화면에 있는 모든 정보(매출·재고 등) 대신, 요청하신 대로 표준코드·제약사·제품명·규격·발주수량·단가·
// 금액·비고와 합계액만 뽑아서 인쇄용 페이지를 만들어요. 발주수량이 있는 행만 인쇄해요(0건/빈 칸 제외).
// 원본 발주서 양식처럼 제목 밑에 연락처·배송지도 같이 나와요.
// 표준코드·제약사·제품명·규격·발주수량·단가·금액·비고와 합계액만 담은 인쇄용 페이지(.print-page) 하나를
// 만들어요. 원본 발주서 양식처럼 제목 밑에 연락처·배송지도 같이 나와요.
function buildBaljuPrintPage(loc, vendor, rows){
  const info = BALJU_LOCATION_INFO[loc];
  // 규격 -> 제품명 순으로 자동 정렬해서 인쇄해요(화면 정렬 상태와는 별개예요).
  const sortedRows = [...rows].sort((a,b)=>
    String(a.maker||'').localeCompare(String(b.maker||''), 'ko') || String(a.name||'').localeCompare(String(b.name||''), 'ko') || String(a.spec||'').localeCompare(String(b.spec||''), 'ko')
  );
  const total = sortedRows.reduce((sum,r)=> sum + (Number(r.qty)||0)*(Number(r.price)||0), 0);
  const contactLine = baljuContactLineFor(vendor) || info.contact;
  const page = document.createElement('div');
  page.className = 'print-page';
  // 연한 회색 테두리(#999)는 브라우저 "배경 그래픽" 인쇄 설정이 꺼져있으면 거의 안 보이거나
  // 흐릿하게 나올 수 있어서, 훨씬 진한 색(#000)과 굵은 선으로 바꿨어요. print-color-adjust로
  // 머리글 배경색도 설정과 상관없이 그대로 인쇄되게 했어요.
  // 표 안의 td/th는 background/color에 !important를 붙였어요 — 이 대시보드가 다크 모드일 때
  // 짝수 줄에 어두운 배경을 입히는 전역 스타일이 있어서, 그게 인쇄 표에도 새어 들어와 글자가
  // 안 보이던 문제가 있었어요. !important로 항상 흰 배경 + 검정 글씨가 되도록 확실히 고정했어요.
  page.style.cssText = 'width:100%; min-height:0; padding:0; background:#fff !important; color:#000; font-family:var(--sans); -webkit-print-color-adjust:exact; print-color-adjust:exact;';
  page.innerHTML = `
    <div class="rt-p-title" style="text-align:center; font-size:20px; font-weight:800; margin-bottom:14px; color:#000;">동원헬스케어-${info.name}물류센터 발주서(${baljuVendorLabel(vendor)})</div>
    <div style="margin-bottom:4px; font-size:13px; color:#000; white-space:nowrap;">연락처 : ${contactLine}</div>
    <div style="margin-bottom:14px; font-size:13px; color:#000; white-space:nowrap;">배송지 : ${info.addr}</div>
    <table style="width:100%; border-collapse:collapse; font-size:12px; color:#000; background:#fff !important; border:2px solid #000;">
      <thead>
        <tr style="background:#ddd !important; -webkit-print-color-adjust:exact; print-color-adjust:exact;">
          <th style="border:1.5px solid #000; padding:6px; background:#ddd !important; color:#000 !important;">표준코드</th>
          <th style="border:1.5px solid #000; padding:6px; background:#ddd !important; color:#000 !important;">제약사</th>
          <th style="border:1.5px solid #000; padding:6px; background:#ddd !important; color:#000 !important;">제품명</th>
          <th style="border:1.5px solid #000; padding:6px; background:#ddd !important; color:#000 !important;">규격</th>
          <th style="border:1.5px solid #000; padding:6px; background:#ddd !important; color:#000 !important;">발주수량</th>
          <th style="border:1.5px solid #000; padding:6px; background:#ddd !important; color:#000 !important;">단가</th>
          <th style="border:1.5px solid #000; padding:6px; background:#ddd !important; color:#000 !important;">금액</th>
          <th style="border:1.5px solid #000; padding:6px; background:#ddd !important; color:#000 !important;">비고</th>
        </tr>
      </thead>
      <tbody>
        ${sortedRows.map(r=>{
          const amt = (Number(r.qty)||0) * (Number(r.price)||0);
          const cellStyle = 'border:1px solid #000; padding:5px; background:#fff !important; color:#000 !important;';
          return `<tr>
            <td style="${cellStyle}">${r.std}</td>
            <td style="${cellStyle}">${r.maker}</td>
            <td style="${cellStyle}">${r.name}</td>
            <td style="${cellStyle}">${r.spec}</td>
            <td style="${cellStyle} text-align:right;">${fmtNum(r.qty)}</td>
            <td style="${cellStyle} text-align:right;">${fmtNum(r.price)}</td>
            <td style="${cellStyle} text-align:right;">${fmtNum(amt)}</td>
            <td style="${cellStyle}">${r.note}</td>
          </tr>`;
        }).join('')}
      </tbody>
    </table>
    <div style="text-align:right; font-size:15px; font-weight:800; margin-top:14px; color:#000;">발주 합계액: ${fmtNum(total)}원</div>
  `;
  return page;
}

// "전체"를 골랐어도 광주·의정부를 한 인쇄물에 섞지 않고, 각각 따로 페이지를 만들어서 같은 인쇄
// 작업 안에 순서대로 넣어요(광주 발주서 종이, 의정부 발주서 종이가 따로따로 나와요).
function printBaljuForm(){
  const vendor = document.getElementById('baljuVendor').value;
  const locs = baljuSelectedLocations();
  const pages = locs.map(loc => ({ loc, rows: baljuRowsForOutput(loc) })).filter(p => p.rows.length > 0);
  if(pages.length === 0){ alert('발주수량을 입력한 품목이 없어요.'); return; }

  const printArea = document.getElementById('printArea');
  printArea.innerHTML = '';
  pages.forEach(p => printArea.appendChild(buildBaljuPrintPage(p.loc, vendor, p.rows)));

  // 품목이 많아서 한 발주처가 물리적으로 여러 장에 걸치면, 앱 전체에 걸린 "@page margin:0" 규칙
  // 때문에 각 .print-page 안쪽 padding이 페이지가 넘어갈 때마다 다시 적용이 안 돼서 여백이 사라지는
  // 문제가 있었어요. "0 여백 + 표 안쪽 padding" 조합은 인쇄기/PDF 엔진마다 좌우가 다르게 나올 수
  // 있어서, 아예 위·아래·좌·우 네 방향 다 브라우저가 페이지마다 똑같이 넣어주도록 바꿨어요.
  // 인쇄하는 동안만 이 규칙을 임시로 넣었다가, 끝나면 없애서 다른 인쇄 기능(반품신청서 등)에는
  // 영향이 안 가게 했어요.
  const marginStyle = document.createElement('style');
  marginStyle.id = 'baljuPrintMarginFix';
  marginStyle.textContent = '@media print { @page { margin: 16mm; } }';
  document.head.appendChild(marginStyle);

  // "PDF로 저장"을 누르면 브라우저가 이 페이지 제목을 파일명으로 제안해요 — 엑셀 다운로드와
  // 같은 규칙(우선처_발주처_날짜)으로 맞춰두고, 인쇄가 끝나면 원래 제목으로 되돌려요.
  const locLabel = pages.length > 1 ? '전체' : BALJU_LOCATION_INFO[pages[0].loc].name;
  const originalTitle = document.title;
  document.title = `${baljuVendorLabel(vendor)}_${locLabel}_${todayKey()}`;
  window.print();
  document.title = originalTitle;
  marginStyle.remove();
}

// 인쇄와 똑같은 기준(발주수량 입력된 행만, 같은 8개 열+합계액)으로 엑셀 파일을 만들어요.
// "전체"를 골랐으면 광주·의정부를 한 파일에 섞지 않고, 파일을 따로따로(최대 2개) 내려받아요.
async function exportBaljuExcel(){
  const vendor = document.getElementById('baljuVendor').value;
  const locs = baljuSelectedLocations();
  const toExport = locs.map(loc => ({ loc, rows: baljuRowsForOutput(loc) })).filter(p => p.rows.length > 0);
  if(toExport.length === 0){ alert('발주수량을 입력한 품목이 없어요.'); return; }

  const columns = [
    { key:'maker', label:'제약사', width:12 },
    { key:'name', label:'제품명', width:26 },
    { key:'spec', label:'규격', width:16, center:true },
    { key:'std', label:'표준코드', width:15 },
    { key:'qty', label:'발주수량', width:10, numFmt:'#,##0' },
    { key:'price', label:'단가', width:10, numFmt:'#,##0' },
    { key:'amt', label:'금액', width:12, numFmt:'#,##0' },
    { key:'note', label:'비고', width:14 }
  ];

  for(const {loc, rows} of toExport){
    const info = BALJU_LOCATION_INFO[loc];
    // 화면 정렬과 별개로, 인쇄와 똑같이 규격 -> 제품명 순으로 자동 정렬해서 내려요.
    const sortedRows = [...rows].sort((a,b)=>
      String(a.maker||'').localeCompare(String(b.maker||''), 'ko') || String(a.name||'').localeCompare(String(b.name||''), 'ko') || String(a.spec||'').localeCompare(String(b.spec||''), 'ko')
    );
    const total = sortedRows.reduce((sum,r)=> sum + (Number(r.qty)||0)*(Number(r.price)||0), 0);
    const contactLine = baljuContactLineFor(vendor) || info.contact;
    const rowsForXlsx = sortedRows.map(r=>{
      const amt = (Number(r.qty)||0) * (Number(r.price)||0);
      return { std:r.std, maker:r.maker, name:r.name, spec:r.spec, qty:Number(r.qty)||0, price:r.price, amt, note:r.note };
    });
    // 품절현황목록 엑셀 다운로드와 같은 서식(파란 헤더·테두리·줄무늬 배경·틀고정)으로 내려요.
    await downloadStyledXlsx({
      sheetName: 'Sheet1',
      fileName: `${baljuVendorLabel(vendor)}_${info.name}_${todayKey()}.xlsx`,
      columns, rows: rowsForXlsx,
      preambleRows: [
        `동원헬스케어-${info.name}물류센터 발주서(${baljuVendorLabel(vendor)})`,
        `연락처 : ${contactLine}`,
        `배송지 : ${info.addr}`
      ],
      totalRow: { price:'발주 합계액', amt: total }
    });
  }
}

function initBaljuFormTab(){
  document.getElementById('baljuLocation').addEventListener('change', ()=>{
    populateBaljuVendorOptions();
    baljuRows = []; renderBaljuTable();
    document.getElementById('baljuStatus').textContent = '';
  });
  document.getElementById('baljuManager').addEventListener('change', populateBaljuVendorOptions);
  document.getElementById('baljuLoadBtn').addEventListener('click', computeBaljuRows);
  document.getElementById('baljuPrintBtn').addEventListener('click', printBaljuForm);
  document.getElementById('baljuExcelBtn').addEventListener('click', exportBaljuExcel);
  document.getElementById('baljuSearchInput').addEventListener('input', renderBaljuTable);
  document.getElementById('baljuFlagFilter').addEventListener('change', renderBaljuTable);
  populateBaljuManagerOptions();
  populateBaljuVendorOptions();
  renderBaljuTable();
}


// ================= 메인화면 =================
// 품절현황(listData)·재고현황(stockData)·확인요망 통합함(computeChecklistRows)에서 이미 계산된 값들을
// 그대로 다시 읽어와 한 화면에 모아 보여줍니다(별도 계산 로직을 새로 만들지 않고 재사용해요).
function renderSummaryDashboard(){
  const el1 = document.getElementById('summaryKpiRow1');
  const el2 = document.getElementById('summaryKpiRow2');
  if(!el1 || !el2) return;

  const soSum = listData.reduce((a,r)=>a+(Number(r.stockout)||0),0);
  const soNoOrderSum = listData.reduce((a,r)=>a+(Number(r.noOrder)||0),0);
  const soOrderedSum = soSum - soNoOrderSum;
  const soRate = soSum ? (soOrderedSum/soSum*100) : 0;

  const totalStock = stockData.reduce((a,r)=>a+(Number(r.curStockTotal)||0),0);
  const totalSales = stockData.reduce((a,r)=>a+(Number(r.salesTotal)||0),0);
  const totalDamaged = stockData.reduce((a,r)=>a+(Number(r.curDamaged)||0),0);
  const damageRate = totalStock ? (totalDamaged/totalStock*100) : 0;

  const checklistRows = computeChecklistRows();
  const warnCount = checklistRows.filter(r=>r.status==='확인요망').length;
  const soonCount = checklistRows.filter(r=>r.status==='임박').length;
  const unmatchedCount = checklistRows.filter(r=>r.status==='미매칭').length;

  const kpis1 = [
    { label:'전체 품절', val: soSum.toLocaleString(), cls:'red', icon:'🔴' },
    { label:'품절발주율', val: soRate.toFixed(1)+'%', cls:'red rate', icon:'📊' },
    { label:'확인요망(마진)', val: warnCount.toLocaleString()+'건', cls:'red', icon:'⚠️' },
    { label:'사용기한 임박', val: soonCount.toLocaleString()+'건', cls:'amber', icon:'⏰' },
  ];
  el1.innerHTML = kpis1.map(k=>`
    <div class="kpi ${k.cls}">
      <div class="icon">${k.icon}</div>
      <div class="label">${k.label}</div>
      <div class="val">${k.val}</div>
    </div>`).join('');

  const kpis2 = [
    { label:'전체재고액', val: Math.round(totalStock/1000).toLocaleString(), cls:'teal' },
    { label:'매출액', val: Math.round(totalSales/1000).toLocaleString(), cls:'teal' },
    { label:'파손재고액', val: Math.round(totalDamaged/1000).toLocaleString(), cls:'red' },
  ];
  el2.innerHTML = kpis2.map(k=>`
    <div class="kpi ${k.cls}">
      <div class="label">${k.label}</div>
      <div class="val">${k.val}<small>천원</small></div>
    </div>`).join('');

  document.getElementById('summaryChecklistBreakdown').innerHTML =
    `미매칭 <b style="color:var(--red);">${unmatchedCount}건</b> · 확인요망(마진) <b style="color:var(--red);">${warnCount}건</b> · 사용기한 임박 <b style="color:var(--amber);">${soonCount}건</b> · 파손비율 <b>${damageRate.toFixed(1)}%</b>`;
}

// ---------- 전체 앱 라이트/다크/테스트 테마 전환 (헤더의 항상 보이는 드롭다운) ----------
const APP_THEME_KEY = 'app_theme_pref_v1';
const APP_THEME_ORDER = ['light','dark','navy','matte','charcoal'];
const APP_THEME_LABELS = { light:'☀️ 라이트 모드', dark:'🌙 다크 모드', navy:'🌌 딥 네이비', matte:'⚫ 매트 블랙', charcoal:'🌫️ 차콜 그레이' };
function applyAppTheme(theme){
  document.documentElement.setAttribute('data-theme', theme);
  const sel = document.getElementById('themeSelect');
  if(sel) sel.value = theme; // 드롭다운에는 항상 지금 적용된 색상이 선택되어 보여요(다음 색상이 아니라).
  try{ window.storage.set(APP_THEME_KEY, theme, false); }catch(e){}
}
async function initAppTheme(){
  const sel = document.getElementById('themeSelect');
  sel.innerHTML = APP_THEME_ORDER.map(t => `<option value="${t}">${APP_THEME_LABELS[t]}</option>`).join('');
  let theme = 'light';
  try{
    const res = await window.storage.get(APP_THEME_KEY, false);
    if(res && res.value) theme = res.value;
    if(theme === 'test') theme = 'navy'; // 예전 이름('테스트모드')으로 저장된 선택을 새 이름으로 옮겨줘요.
  }catch(e){ /* 저장된 선택 없음 — 라이트로 시작 */ }
  applyAppTheme(theme);
  sel.addEventListener('change', ()=>{ applyAppTheme(sel.value); });
}

const PHARMREG_STORAGE_KEY = 'stockout_dashboard_pharmreg_raw_v1';
const PHARMREG_MODES = [
  { id:'포함', label:'포함' },
  { id:'별도-합계액(내림)', label:'별도-합계액(내림)', base:'amt', round:'floor' },
  { id:'별도-합계액(반올림)', label:'별도-합계액(반올림)', base:'amt', round:'round' },
  { id:'별도-합계액(올림)', label:'별도-합계액(올림)', base:'amt', round:'ceil' },
  { id:'별도-단가(내림)', label:'별도-단가(내림)', base:'unit', round:'floor' },
  { id:'별도-단가(반올림)', label:'별도-단가(반올림)', base:'unit', round:'round' },
  { id:'별도-단가(올림)', label:'별도-단가(올림)', base:'unit', round:'ceil' },
];
const PHARMREG_COLUMNS = [
  { key:'productCode', label:'제품코드', width:68 },
  { key:'barcode', label:'상품코드', width:140 },
  { key:'dealType', label:'거래유형', hideOnScreen:true },
  { key:'damageType', label:'파손유무', hideOnScreen:true },
  { key:'qty', label:'수량', num:true, width:56 },
  { key:'unit', label:'매입단가', num:true, editable:true, width:88 },
  { key:'amt', label:'실금액', num:true, editable:true, width:100 },
  { key:'discount', label:'할인금액', width:76, hideOnScreen:true },
  { key:'lotNo', label:'제조번호', width:94, textEditable:true },
  { key:'expiry', label:'사용기한', width:84, textEditable:true },
  { key:'margin', label:'마진', pct:true, width:70 },
  { key:'productName', label:'표준상품명', width:160 },
  { key:'maker', label:'다미스코드명', width:160 },
  { key:'note', label:'구매비고', width:192 },
  { key:'longout', label:'장기품절등록', width:84, hideOnScreen:true },
];

let pharmregRawRows = [];      // 파싱된 원본 22열 행들
let pharmregComputed = [];     // 매칭 + 7가지 모드 계산까지 끝난 행들 (모드 선택 전)
let pharmregFinalRows = [];    // 자동 판별된 모드로 확정된, 화면에 보여주고 수정 가능한 행들
let pharmregSelectedVendor = null;   // {name, vat} — 배치의 대표 거래처 (첫 매칭 성공 행 기준)
let pharmregDecision = null;   // { mode, reason, diff }
let pharmregEditsMap = new Map(); // key: `${idx}:${field}` -> {productCode,barcode,field,before,after}

// ---------- 매입전표 합계액 (합계액 우선 입력시 자동분할, 공급가부터 입력시 부가세 수기입력+10%대비 10%p 이상 벗어나면 거부, 음수 허용, 7줄+총합계) ----------
const PHARMREG_CALC_ROWS = 7;
let pharmregCalcData = Array.from({length: PHARMREG_CALC_ROWS}, ()=>({ pharmreg:null, vat:null, total:null }));


// 합계액을 기준으로 공급가·부가세를 자동 계산합니다(÷1.1). 공급가나 부가세를 직접 고치면(세부조정),
// 합계액이 이미 있으면 그 합계액을 고정한 채 나머지 한 쪽을 다시 맞추고, 합계액이 아직 없으면
// 예전처럼 10% 부가세로 계산해서 합계액을 새로 만듭니다.
function recalcPharmregCalcRow(i, field, value){
  const row = pharmregCalcData[i];
  if(field === 'total'){
    row.total = value;
    if(value === null){ row.pharmreg = null; row.vat = null; }
    else{ row.pharmreg = Math.round(value / 1.1); row.vat = value - row.pharmreg; }
    return { ok:true };
  }
  if(row.total !== null){
    if(field === 'pharmreg'){ row.pharmreg = value; row.vat = (value===null) ? null : row.total - value; }
    else { row.vat = value; row.pharmreg = (value===null) ? null : row.total - value; }
    return { ok:true };
  }
  const prevSupply = row.pharmreg, prevVat = row.vat;
  if(field === 'pharmreg') row.pharmreg = value; else row.vat = value;
  if(row.pharmreg !== null && row.vat !== null && row.pharmreg !== 0){
    const ratio = row.vat / row.pharmreg;
    if(ratio < 0 || ratio >= 0.20){
      row.pharmreg = prevSupply; row.vat = prevVat;
      row.total = (row.pharmreg!==null && row.vat!==null) ? row.pharmreg + row.vat : null;
      return { ok:false, message:`부가세율이 표준 10%에서 10%p 이상 벗어나서(${(ratio*100).toFixed(1)}%) 반영하지 않았어요 — 공급가·부가세 값을 확인해주세요.` };
    }
  }
  row.total = (row.pharmreg!==null && row.vat!==null) ? row.pharmreg + row.vat : null;
  return { ok:true };
}

function pharmregCalcReferenceTotal(){
  let sum = 0, any = false;
  pharmregCalcData.forEach(r=>{ if(r.pharmreg!==null){ sum += r.pharmreg; any = true; } });
  return any ? sum : null;
}

function pharmregCalcReferenceGrandTotal(){
  let sum = 0, any = false;
  pharmregCalcData.forEach(r=>{ if(r.total!==null){ sum += r.total; any = true; } });
  return any ? sum : null;
}

function renderPharmregCalcTotals(){
  let sSum=0, vSum=0, tSum=0, any=false;
  pharmregCalcData.forEach(r=>{
    if(r.pharmreg!==null || r.vat!==null){
      sSum += r.pharmreg||0; vSum += r.vat||0; tSum += (r.total!==null ? r.total : ((r.pharmreg||0)+(r.vat||0)));
      any = true;
    }
  });
  const row = document.getElementById('pharmregCalcTotalRow');
  if(row){
    row.children[1].textContent = any ? fmtCalcNum(sSum) : '-';
    row.children[2].textContent = any ? fmtCalcNum(vSum) : '-';
    row.children[3].textContent = any ? fmtCalcNum(tSum) : '-';
  }
  // 부가세가 공급가의 10%를 초과하는 줄이 있으면 경고를 띄웁니다.
  const warnEl = document.getElementById('pharmregCalcWarning');
  if(warnEl){
    const flagged = [];
    pharmregCalcData.forEach((r,i)=>{
      if(r.pharmreg && r.vat!==null && r.pharmreg > 0){
        const ratio = r.vat / r.pharmreg;
        if(ratio > 0.101) flagged.push(`${i+1}행(${(ratio*100).toFixed(1)}%)`);
      }
    });
    if(flagged.length){
      warnEl.style.display = 'block';
      warnEl.textContent = `⚠ 부가세가 공급가의 10%를 초과하는 줄이 있어요: ${flagged.join(', ')} — 값을 확인해주세요.`;
    } else {
      warnEl.style.display = 'none';
    }
  }
}

function renderPharmregCalcTable(){
  const body = document.getElementById('pharmregCalcBody');
  const inputStyle = 'width:100%; border:1px solid #b9cdf0; border-radius:4px; text-align:right; font:inherit; background:var(--teal-bg, #eef4ff); padding:2px 4px; box-sizing:border-box;';
  const totalInputStyle = 'width:100%; border:2px solid var(--red); border-radius:4px; text-align:right; font:inherit; font-weight:800; background:var(--red-bg, #fff3f0); padding:2px 4px; box-sizing:border-box;';
  let html = '';
  for(let i=0; i<PHARMREG_CALC_ROWS; i++){
    const r = pharmregCalcData[i];
    html += `<tr>
      <td class="num">${i+1}</td>
      <td class="num"><input type="text" class="calc-input" data-i="${i}" data-field="pharmreg" value="${r.pharmreg!==null?fmtCalcNum(r.pharmreg):''}" style="${inputStyle}"></td>
      <td class="num"><input type="text" class="calc-input" data-i="${i}" data-field="vat" value="${r.vat!==null?fmtCalcNum(r.vat):''}" style="${inputStyle}"></td>
      <td class="num"><input type="text" class="calc-input" data-i="${i}" data-field="total" value="${r.total!==null?fmtCalcNum(r.total):''}" style="${totalInputStyle}"></td>
    </tr>`;
  }
  html += `<tr class="total-row" id="pharmregCalcTotalRow"><td>총합계</td><td class="num">-</td><td class="num">-</td><td class="num">-</td></tr>`;
  body.innerHTML = html;

  body.querySelectorAll('input.calc-input').forEach(inp=>{
    inp.addEventListener('input', ()=>{
      const i = Number(inp.dataset.i);
      const field = inp.dataset.field;
      const raw = String(inp.value).replace(/,/g,'').trim();
      if(raw === '-') return; // 음수 입력 중('-'만 친 상태) — 다시 그리면 지워지므로 그대로 둡니다.
      const n = Number(raw);
      const val = (raw === '' || isNaN(n)) ? null : n;
      const result = recalcPharmregCalcRow(i, field, val);
      renderPharmregCalcTable();
      if(!result.ok){
        const warnEl = document.getElementById('pharmregCalcWarning');
        if(warnEl){ warnEl.style.display = 'block'; warnEl.textContent = `⚠ ${result.message}`; }
      }
      // 방금 입력하던 칸에 포커스를 되돌려줍니다 (이 표 안에서만 찾아서, 다른 탭의 표로 포커스가 튀지 않게 합니다).
      const again = body.querySelector(`input.calc-input[data-i="${i}"][data-field="${field}"]`);
      if(again){ again.focus(); const len = again.value.length; again.setSelectionRange(len, len); }
    });
  });
  renderPharmregCalcTotals();
  // 계산기 값이 바뀌면 이미 계산된 결과가 있을 경우 자동 판별 모드를 다시 계산합니다.
  if(pharmregComputed.length) finalizePharmregMode();
}

function resetPharmregCalc(){
  pharmregCalcData = Array.from({length: PHARMREG_CALC_ROWS}, ()=>({ pharmreg:null, vat:null, total:null }));
  const w = document.getElementById('pharmregCalcWarning');
  if(w){ w.style.display = 'none'; w.textContent = ''; }
  renderPharmregCalcTable();
}


// 붙여넣은 텍스트를 22열 행 배열로 분해합니다. 엑셀에서 복사하면 탭으로 구분되고,
// CSV를 그대로 붙여넣으면 콤마(+따옴표)로 구분되므로 둘 다 처리합니다.
// 붙여넣은 텍스트를 행 배열로 분해합니다. 엑셀에서 복사하거나 파일을 올리면 항상 탭으로 구분돼요
// (파일 업로드는 readWorkbookAsTsv가 탭으로 바꿔줍니다) — 콤마는 금액의 천 단위 구분(예: "712,890")과
// 헷갈릴 수 있어서 구분자로 쓰지 않아요. 탭이 없으면(채팅창·문서에서 표를 복사해 공백으로만 구분된 경우)
// 공백 기반으로 알아서 인식합니다.
function parsePharmregPasteText(text){
  const lines = text.split(/\r\n|\r|\n/).map(l=>l.replace(/\r+$/,'')).filter(l=>l.length>0);
  if(!lines.length) return [];
  const useTab = text.includes('\t');
  if(useTab){
    return lines.map(line => line.split('\t').map(v=>v.trim()));
  }
  // 탭이 없으면(예: 채팅창·문서에서 표를 복사해 공백으로만 구분된 경우) 우선
  // "순번(숫자) 품명(공백이 섞여도 됨) 규격(공백없는 한 덩어리) 수량(숫자) 금액(숫자,콤마) 비고" 패턴을 시도합니다.
  // 품명에 공백이 섞여 있어도(예: "잘티진액 500mL") 규격·수량·금액이 뚜렷한 패턴이라 정확히 나눠져요.
  const smartRe = /^\s*(\d+)\s+(.+?)\s+(\S+)\s+(\d+)\s+([\d,]+(?:\.\d+)?)\s+(.+?)\s*$/;
  const smartRows = lines.map(line=>{
    const m = line.match(smartRe);
    if(m) return [m[1], m[2], m[3], m[4], m[5], m[6]];
    const twoSpace = line.split(/\s{2,}/).map(v=>v.trim());
    return twoSpace.length > 1 ? twoSpace : line.split(/\s+/).map(v=>v.trim());
  });
  const sixColHits = smartRows.filter(r=>r.length===6).length;
  if(sixColHits >= Math.max(1, lines.length - 1)) return smartRows;
  // 공백 2칸 이상을 구분자로 시도하고, 그래도 한 칸짜리면 공백 1칸까지 구분자로 씁니다.
  const multiSpaceRows = lines.map(line => line.split(/\s{2,}/).map(v=>v.trim()));
  if(multiSpaceRows[0].length > 1) return multiSpaceRows;
  return lines.map(line => line.split(/\s+/).map(v=>v.trim()));
}

function pharmregNormCell(v){
  return String(v||'').replace(/[\s\u00a0]+/g,'').trim();
}

// ---------- 회사별 정확한 컬럼 위치(하드코딩) ----------
// 매입엑셀파일-제약사사이트기준.xlsx의 실제 수식을 하나하나 확인해서 만든 표입니다(추측 아님).
// idx는 0-based 열 번호(A=0,B=1,...), headerRows는 실제 데이터가 시작되기 전 건너뛸 줄 수예요.
// unit 또는 amount 중 하나가 null이면 수량으로 서로 계산해서 채워요.
// codeTable: 'priceByStd'(표준코드→단가 보완) 또는 'stdByName'(제품명→표준코드 보완)
const PHARMREG_PROFILES = {
  '유한양행': { headerRows: 1, idx: { stdCode:7, qty:12, unit:13, amount:14, lotNo:10, expiry:11, itemName:8 },
    forceVatMode: '별도', rawAlreadyExclusive: true,
    note:'이 회사 단가·실금액은 항상 부가세 별도 금액이라(추정 아님), 1.1로 나누는 계산 없이 그대로 쓰고, 다미스제품코드마스터DB 일반가(부가세 포함)와 비교할 때만 일반가를 1.1로 나눠서 마진을 계산해요.' },
  '뉴신팜': { dynamicHeader: { need: ['표준코드','수량','제조번호'], map: { stdCode:'표준코드', itemName:'제품명', qty:'수량', lotNo:'제조번호', expiry:'유효기간' } }, codeTable:'priceByStd', codeTableUploadId: 'pharminfo_newshin',
    note:'이 회사 자료엔 단가가 없어서, 저장해둔 제약사상품정보(표준코드→단가)에서 단가를 가져와요.' },
  '티알엔': { dynamicHeader: { need: ['표준코드','수량','제조번호'], map: { stdCode:'표준코드', itemName:'제품명', qty:'수량', lotNo:'제조번호', expiry:'유효기간' } }, codeTable:'priceByStd', codeTableUploadId: 'pharminfo_tr',
    note:'이 회사 자료엔 단가가 없어서, 저장해둔 제약사상품정보(표준코드→단가)에서 단가를 가져와요.' },
  '일동제약': { dynamicHeader: { need: ['상품명','수량','단가'], map: { itemName:'상품명', itemSpec:'포장단위', qty:'수량', unit:'단가', amount:'공급가액', lotNo:'제조번호', expiry:'유통기한' } },
    codeTable:'stdByName', codeTableUploadId: 'pharminfo_ildong', autoAddUnmatchedToCodeTable: true, forceVatMode: '별도', rawAlreadyExclusive: true,
    note:'이 회사 자료엔 표준코드가 없어서, 저장해둔 제약사상품정보에서 상품명으로 표준코드를 찾아요. 명세서에 있는데 제약사상품정보에 없는 품목은 표준코드가 빈 채로 자동 추가돼요. 단가·공급가액은 항상 부가세 별도 금액이라(추정 아님), 1.1로 나누는 계산 없이 그대로 쓰고, 다미스제품코드마스터DB 일반가(부가세 포함)와 비교할 때만 일반가를 1.1로 나눠서 마진을 계산해요.' },
  '에이치케이이노엔': { dynamicHeader: { need: ['품목','규격','수량'], map: { itemName:'품목', itemSpec:'규격', lotNo:'Lot.NO', expiry:'유효기간', qty:'수량', unit:'단가', amount:'공급가액' } },
    codeTable:'stdByName', codeTableUploadId: 'pharminfo_hk', autoAddUnmatchedToCodeTable: true, forceVatMode: '별도', rawAlreadyExclusive: true, computeAmtFromUnitQty: true,
    note:'이 회사 자료엔 표준코드가 없어서, 저장해둔 제약사상품정보(상품명/제품코드/표준코드)에서 제품명(품목)으로 표준코드를 찾아요. 명세서에 있는데 제약사상품정보에 없는 품목은 표준코드가 빈 채로 자동 추가되니, 나중에 제품코드·표준코드만 채워주시면 돼요. 이 회사 단가·공급가액은 항상 부가세 별도 금액이라(추정 아님), 1.1로 나누는 계산 없이 그대로 쓰고, 다미스제품코드마스터DB 일반가(부가세 포함)와 비교할 때만 일반가를 1.1로 나눠서 마진을 계산해요 · 금액은 명세서 원본 공급가액 대신 항상 단가×수량으로 다시 계산해요(원본 공급가액이 실제 단가×수량과 안 맞는 경우가 있어서요).' },
  '한독': { dynamicHeader: { need: ['의약품표준코드','판매수량','단가'], map: { stdCode:'의약품표준코드', itemName:'제품명', lotNo:'배치', expiry:'유효기간', qty:'판매수량', unit:'단가', amount:'판매가격' } },
    forceVatMode: '별도', rawAlreadyExclusive: true,
    note:'의약품표준코드로 판매수량·단가·판매가격을 매칭해요. 이 회사 단가·판매가격은 이미 부가세 별도 금액이라(추정 아님), 1.1로 나누는 계산 없이 그대로 쓰고, 다미스제품코드마스터DB 일반가(부가세 포함)와 비교할 때만 일반가를 1.1로 나눠서 마진을 계산해요.' },
  '온라인팜': { dynamicHeader: { need: ['의약품표준코드','수량','제조번호'], map: { stdCode:'의약품표준코드', itemName:'제품명', qty:'수량', lotNo:'제조번호', expiry:'유효기간', amount:'공급가액' } } },
  '종근당': { headerRows: 1, idx: { stdCode:4, qty:6, unit:8, amount:null, lotNo:11, expiry:12, itemName:5 },
    forceVatMode: '별도', rawAlreadyExclusive: true, computeAmtFromUnitQty: true,
    note:'이 회사는 표준코드 컬럼이 따로 없어서, 품목코드를 표준코드로 그대로 사용해요(원본 수식과 동일). 이 회사 단가는 이미 부가세 별도 금액이라 1.1로 나누지 않고 그대로 쓰고(공급가액은 수량×단가로 계산), 다미스제품코드마스터DB 일반가(부가세 포함)와 비교할 때만 일반가를 1.1로 나눠서 마진을 계산해요.' },
  '휴온스': { dynamicHeader: { need: ['표준코드','수량','단가'], map: { stdCode:'표준코드', itemName:'제품명', lotNo:'제조번호', expiry:'유효일자', qty:'수량', amount:'단가' } },
    forceVatMode: '포함',
    note:'이 회사 원본 엑셀은 "단가"라는 헤더 밑에 실제로는 실금액(수량×단가)이 들어있어서, 그 열을 실금액으로 보고 매입단가는 실금액÷수량으로 자동 계산해요. 금액은 항상 부가세 포함 방식으로 계산해요(거래처정보마스터DB 설정과 무관하게).' },
  '팜베이': { headerRows: 1, idx: { stdCode:10, qty:6, unit:5, amount:7, lotNo:8, expiry:9, itemName:3 }, autoDetectHeaderByStdCode: true,
    note:'헤더 줄이 있든 없든 같은 값이 나오도록, 첫 줄의 표준코드 자리가 숫자(바코드)면 헤더가 없는 것으로 보고 그 줄부터 바로 데이터로 읽어요.' },
  '태준제약': { headerRows: 1, idx: { stdCode:1, qty:4, unit:5, amount:6, lotNo:7, expiry:8, itemName:2 },
    forceVatMode: '별도', rawAlreadyExclusive: true, computeAmtFromUnitQty: true,
    note:'이 회사 단가는 이미 부가세 별도 금액이라(추정 아님) 1.1로 나누지 않고 그대로 쓰고, 실금액은 항상 수량×단가로 계산해요. 다미스제품코드마스터DB 일반가(부가세 포함)와 비교할 때만 일반가를 1.1로 나눠서 마진을 계산해요(단가×1.1을 일반가와 직접 비교하는 것과 수학적으로 같은 결과예요).' },
  '유나이티드': { dynamicHeader: { need: ['표준코드','수량','단가'], map: { stdCode:'표준코드', itemName:'품명', qty:'수량', amount:'금액', lotNo:'제조번호', expiry:'유효기간' } } },
  '메디카코리아': { headerRows: 1, idx: { itemName:1, itemSpec:2, qty:3, amount:4, note:5 }, autoDetectHeaderByFirstCol: true,
    codeTableMatch: 'nameSpecConcat', noteSplitLotExpiry: true, codeTableUploadId: 'pharminfo_medica', autoAddUnmatchedToCodeTable: true,
    note:'이 회사 명세서 헤더("품    명"처럼 글자 사이에 공백이 들어가있음)는 내용을 안 보고 위치로만 읽어요(순번/품명/규격/수량/금액/비고 순). 첫 줄의 순번 자리가 숫자면 헤더가 없는 것으로 보고 안 건너뛰고, 글자("순번")면 건너뛰어서 헤더가 있든 없든 같은 값이 나와요. 저장해둔 제약사상품정보(제품명/포장단위/의약품표준코드)의 제품명+포장단위를 이 명세서의 품명+규격과 맞춰서 표준코드를 찾아요. 비고칸은 "제조번호/사용기한" 형식으로 자동 나눠요. 명세서에 있는데 제약사상품정보에 없는 품명은 표준코드가 빈 채로 자동 추가돼요.' },
  '동아에스티': { dynamicHeader: { need: ['표준코드','수량','단가'], map: { stdCode:'표준코드', qty:'수량', unit:'단가', amount:'총금액', itemName:'품명' } }, needsSupplyCross: true,
    note:'이 회사는 거래명세서에 제조번호·사용기한이 없어서, 위쪽 "공급내역신고자료" 칸에 저장해둔 자료에서 표준코드로 찾아와요.' },
};

// "2028-03-03"/"2028/03/03"/"20280303"/엑셀 시리얼값 등을 YYYYMMDD로 정리합니다.
function parseFlexibleDateToYYYYMMDD(v){
  if(v === null || v === undefined || v === '') return '';
  if(v instanceof Date){
    if(isNaN(v.getTime())) return '';
    return `${v.getFullYear()}${String(v.getMonth()+1).padStart(2,'0')}${String(v.getDate()).padStart(2,'0')}`;
  }
  const s = String(v).trim();
  if(!s) return '';
  if(/^\d{8}$/.test(s)) return s; // 이미 YYYYMMDD
  const m = s.match(/^(\d{4})[-./](\d{1,2})[-./](\d{1,2})/); // YYYY-MM-DD, YYYY/MM/DD, YYYY.MM.DD
  if(m) return m[1] + m[2].padStart(2,'0') + m[3].padStart(2,'0');
  // 엑셀 날짜 시리얼값(숫자) — 1899-12-30 기준. 2000~2035년 정도의 상식적인 범위로만 인정해서
  // 다른 숫자(코드·수량 등)를 날짜로 잘못 해석하지 않게 해요.
  const num = Number(s);
  if(!isNaN(num) && /^\d+(\.\d+)?$/.test(s) && num >= 20000 && num <= 60000){
    const dt = new Date(Date.UTC(1899, 11, 30) + Math.floor(num) * 86400000);
    return `${dt.getUTCFullYear()}${String(dt.getUTCMonth()+1).padStart(2,'0')}${String(dt.getUTCDate()).padStart(2,'0')}`;
  }
  return '';
}

// 코드표(회사별로 저장된 표준코드/제품명/단가 참고표)를 이용한 보조 매칭: 표준코드가 없는 회사는
// 제품명으로 표준코드를 찾고, 단가가 없는 회사는 표준코드로 단가를 채웁니다.
function buildPharmregCodeTableMaps(company, profile){
  const nameToStd = new Map(), stdToPrice = new Map(), nameSpecToStd = new Map(), knownNames = new Set();
  let raw = null;
  let uploadId = null;
  if(profile && profile.codeTableUploadId){
    uploadId = profile.codeTableUploadId;
    const us = uploadState[uploadId];
    if(us && us.headers && us.rows) raw = [us.headers, ...us.rows];
  }
  if(!raw) raw = pharmregCodeTables[company];
  const empty = { nameToStd, stdToPrice, nameSpecToStd, knownNames, layout:null };
  if(!raw || !raw.length) return empty;
  let header = null, dataStart = 0;
  for(let i=0; i<Math.min(5, raw.length); i++){
    const norm = raw[i].map(pharmregNormCell);
    if(findHeaderIndex(norm, '표준코드','의약품표준코드') !== -1){ header = norm; dataStart = i+1; break; }
  }
  if(!header) return empty;
  const idxStd = findHeaderIndex(header, '표준코드','의약품표준코드');
  const idxName = header.findIndex(v=>v.includes('제품명')||v.includes('상품명')||v==='품명'||v==='품목');
  const idxSpec = header.findIndex(v=>v.includes('포장단위')||v.includes('규격'));
  const idxPrice = header.findIndex(v=>v.includes('단가'));
  const idxCode = header.findIndex(v=>v.includes('전산코드')||v.includes('자사코드')||v.includes('제품코드'));
  for(let i=dataStart; i<raw.length; i++){
    const row = raw[i];
    if(!row) continue;
    const std = idxStd!==-1 ? String(row[idxStd]||'').trim() : '';
    if(idxName!==-1){
      const name = pharmregNormCell(row[idxName]);
      if(name) knownNames.add(name);
      if(name && std && !nameToStd.has(name)) nameToStd.set(name, std);
      if(name && std && idxSpec!==-1){
        const nameLoose = normalizeProductName(row[idxName]);
        const spec = normalizeProductName(row[idxSpec]);
        const key = nameLoose + '|' + spec;
        if(!nameSpecToStd.has(key)) nameSpecToStd.set(key, std);
      }
    }
    if(std && idxPrice!==-1){
      const price = Number(String(row[idxPrice]||'').replace(/,/g,''));
      if(!isNaN(price) && !stdToPrice.has(std)) stdToPrice.set(std, price);
    }
  }
  return { nameToStd, stdToPrice, nameSpecToStd, knownNames, layout: { rawHeaderRowIdx: dataStart-1, colCount: raw[dataStart-1].length, idxName, idxStd, idxCode, idxSpec, uploadId } };
}

// 사업자번호 대신 거래처정보마스터DB의 매입처명으로 거래처를 찾습니다(제약사 선택 드롭다운과 매칭).
function buildPharmregVendorNameMap(){
  const map = new Map();
  const vm = uploadState['vendorMaster'];
  if(!vm) return map;
  const headers = vm.headers;
  const idxName = findHeaderIndex(headers, '매입처명', '거래처명', '거래처');
  const idxVat = headers.indexOf('매입전표부가세');
  if(idxName === -1) return map;
  vm.rows.forEach(r=>{
    const name = String(r[idxName]||'').trim();
    if(!name) return;
    if(!map.has(name)) map.set(name, { name, vat: idxVat!==-1 ? r[idxVat] : '' });
  });
  return map;
}

function renderPharmregProfileInfo(company, profile){
  const el = document.getElementById('pharmregProfileInfo');
  if(!el) return;
  if(!company){ el.style.display = 'none'; return; }
  el.style.display = 'block';
  if(!profile){
    el.innerHTML = `<span style="color:var(--red); font-weight:700;">⚠ "${company}"은(는) 아직 정확한 형식이 등록되지 않았어요. 결과를 계산해드릴 수 없으니, 이 회사 형식을 다음에 추가해드릴게요.</span>`;
    return;
  }
  const noteHtml = profile.note ? `<div style="margin-top:4px; ${profile.lowConfidence?'color:var(--red); font-weight:700;':'color:var(--ink-dim);'}">${profile.note}</div>` : '';
  if(profile.dynamicHeader){
    el.innerHTML = `<b>"${company}"</b> 형식으로 인식했어요 — 붙여넣은 데이터에서 표준코드·수량·단가가 있는 줄을 찾아 그 줄부터 읽어요.${noteHtml}`;
    return;
  }
  const i = profile.idx;
  const col = n => n===null||n===undefined ? '(없음)' : String.fromCharCode(65 + (n % 26)) + (n>=26?Math.floor(n/26):'') + '열';
  el.innerHTML = `<b>"${company}"</b> 형식으로 인식했어요 — 표준코드:${col(i.stdCode)} · 수량:${col(i.qty)} · 단가:${col(i.unit)} · 금액:${col(i.amount)} · 제조번호:${col(i.lotNo)} · 사용기한:${col(i.expiry)} · 제품명:${col(i.itemName)}${noteHtml}`;
}

function computePharmregResults(){
  const productIndex = buildProductBarcodeMap();
  const vendorNameMap = buildPharmregVendorNameMap();
  pharmregSelectedVendor = null;
  pharmregComputed = [];

  const company = (document.getElementById('pharmregCompany')||{}).value || '';
  const profile = PHARMREG_PROFILES[company];
  renderPharmregProfileInfo(company, profile);
  if(!profile || !pharmregRawRows.length) return;

  if(company){
    for(const [name, v] of vendorNameMap){
      if(name.includes(company) || company.includes(name)){ pharmregSelectedVendor = v; break; }
    }
  }
  const codeTableMaps = buildPharmregCodeTableMaps(company, profile);
  const dongaSupplyMap = profile.needsSupplyCross ? buildPharmregDongaSupplyMap() : null;

  let i = profile.idx;
  let dataRows;
  if(profile.dynamicHeader){
    // 헤더가 실제로 몇 번째 줄에 있는지 몰라서(회사마다 앞부분 안내문 줄 수가 다를 수 있어서),
    // 필요한 이름들이 모두 나오는 줄을 찾아서 그 줄을 기준으로 열 위치를 정합니다.
    const dh = profile.dynamicHeader;
    let headerIdx = -1, norm = null;
    for(let r=0; r<Math.min(30, pharmregRawRows.length); r++){
      const rowNorm = pharmregRawRows[r].map(pharmregNormCell);
      if(dh.need.every(k => rowNorm.includes(pharmregNormCell(k)))){ headerIdx = r; norm = rowNorm; break; }
    }
    if(headerIdx === -1){
      const el = document.getElementById('pharmregProfileInfo');
      if(el){
        el.style.display = 'block';
        el.innerHTML = `<span style="color:var(--red); font-weight:700;">⚠ 붙여넣은 데이터에서 "${dh.need.join('/')}"가 모두 있는 줄을 못 찾았어요 — 거래명세서의 표 부분(품명/표준코드/수량... 헤더가 있는 줄부터)이 포함되도록 다시 붙여넣어주세요.</span>`;
      }
      return;
    }
    i = {};
    Object.entries(dh.map).forEach(([field, label])=>{
      const idx = norm.indexOf(pharmregNormCell(label));
      i[field] = idx === -1 ? null : idx;
    });
    if(i.lotNo === undefined) i.lotNo = null;
    if(i.expiry === undefined) i.expiry = null;
    dataRows = pharmregRawRows.slice(headerIdx + 1);
  } else {
    let skipRows = profile.headerRows || 0;
    // 팜베이처럼 헤더 줄이 있을 수도 없을 수도 있는 회사는, 첫 줄의 표준코드 자리를 봐서 판단해요 —
    // 그 자리가 이미 숫자(바코드)면 헤더가 없는 것이라 건너뛰지 않고, 글자(헤더 이름)면 건너뛰어요.
    if(profile.autoDetectHeaderByStdCode && skipRows > 0 && pharmregRawRows.length){
      const firstCell = String((pharmregRawRows[0] || [])[profile.idx.stdCode] ?? '').trim();
      if(firstCell && /^\d+$/.test(firstCell)) skipRows = 0;
    }
    // 메디카코리아처럼 표준코드 열이 아예 없는 회사는 맨 첫 칸(순번)을 봐서 판단해요 —
    // 그 자리가 이미 숫자(순번)면 헤더가 없는 것이라 건너뛰지 않고, 글자("순번" 같은 헤더 이름)면 건너뛰어요.
    if(profile.autoDetectHeaderByFirstCol && skipRows > 0 && pharmregRawRows.length){
      const firstCell = String((pharmregRawRows[0] || [])[0] ?? '').trim();
      if(firstCell && /^\d+$/.test(firstCell)) skipRows = 0;
    }
    dataRows = pharmregRawRows.slice(skipRows);
  }

  const autoAddNames = [];
  const autoAddSeen = new Set();

  dataRows.forEach(f=>{
    if(!f || !f.some(v=>v!==null && v!==undefined && String(v).trim()!=='')) return;
    let stdCode = i.stdCode!==null && i.stdCode!==undefined ? String(f[i.stdCode]||'').trim() : '';
    const itemName = i.itemName!==null && i.itemName!==undefined ? String(f[i.itemName]||'').trim() : '';
    const itemSpec = i.itemSpec!==null && i.itemSpec!==undefined ? String(f[i.itemSpec]||'').trim() : '';
    if(!stdCode && itemName){
      if(profile.codeTableMatch === 'nameSpecConcat'){
        const key = normalizeProductName(itemName) + '|' + normalizeProductName(itemSpec);
        const byNameSpec = codeTableMaps.nameSpecToStd.get(key);
        if(byNameSpec) stdCode = byNameSpec;
      } else {
        const byName = codeTableMaps.nameToStd.get(pharmregNormCell(itemName));
        if(byName) stdCode = byName;
      }
    }
    if(!stdCode && itemName && profile.autoAddUnmatchedToCodeTable){
      const normName = pharmregNormCell(itemName);
      if(!codeTableMaps.knownNames.has(normName) && !autoAddSeen.has(normName)){
        autoAddSeen.add(normName);
        autoAddNames.push({ name: itemName, spec: itemSpec });
      }
    }
    if(!stdCode) return;
    const qty = i.qty!==null && i.qty!==undefined ? (Number(String(f[i.qty]||'').replace(/,/g,''))||0) : 0;
    let rawUnit = (i.unit!==null && i.unit!==undefined) ? (Number(String(f[i.unit]||'').replace(/,/g,''))||0) : 0;
    let rawAmt = (i.amount!==null && i.amount!==undefined) ? (Number(String(f[i.amount]||'').replace(/,/g,''))||0) : 0;
    if(!rawUnit && codeTableMaps.stdToPrice.has(stdCode)) rawUnit = codeTableMaps.stdToPrice.get(stdCode);
    if(!rawUnit && rawAmt && qty) rawUnit = Math.round(rawAmt / qty);
    if(!rawAmt && rawUnit && qty) rawAmt = rawUnit * qty;
    let lotNo = (i.lotNo!==null && i.lotNo!==undefined) ? String(f[i.lotNo]||'').trim() : '';
    let expiry = (i.expiry!==null && i.expiry!==undefined) ? parseFlexibleDateToYYYYMMDD(f[i.expiry]) : '';
    if(profile.noteSplitLotExpiry && i.note!==null && i.note!==undefined){
      const noteVal = String(f[i.note]||'').trim();
      if(noteVal.includes('/')){
        const parts = noteVal.split('/');
        lotNo = lotNo || parts[0].trim();
        expiry = expiry || parseFlexibleDateToYYYYMMDD(parts[1] ? parts[1].trim() : '');
      }
    }
    if(dongaSupplyMap && (!lotNo || !expiry)){
      const cross = dongaSupplyMap.get(stdCode);
      if(cross){
        if(!lotNo) lotNo = cross.lotNo;
        if(!expiry) expiry = cross.expiry;
      }
    }

    const prod = lookupProductByBarcode(stdCode, productIndex, itemName);
    const barcode = prod && prod.barcode ? prod.barcode : stdCode;
    const generalPrice = prod ? Number(prod.price)||0 : 0;

    const modes = {};
    if(profile.rawAlreadyExclusive){
      // 이 회사는 명세서의 단가·금액이 이미 부가세 별도 금액이라 확실해서(추정 아님),
      // 1.1로 나누는 계산 없이 그대로 쓰고, 일반가(부가세 포함)와 비교할 때만 1.1로 나눠 마진을 냅니다.
      const compareBase = generalPrice ? generalPrice/1.1 : 0;
      const margin = compareBase ? ((compareBase - rawUnit) / compareBase) : null;
      const finalAmt = profile.computeAmtFromUnitQty ? rawUnit * qty : rawAmt;
      PHARMREG_MODES.forEach(m=>{ modes[m.id] = { amt: finalAmt, unit: rawUnit, margin }; });
    } else {
    PHARMREG_MODES.forEach(m=>{
      let amt, unit;
      if(m.id === '포함'){
        amt = rawAmt;
        unit = qty ? amt / qty : 0;
      } else if(m.base === 'amt'){
        amt = roundBy(m.round, rawAmt / 1.1);
        unit = qty ? amt / qty : 0;
      } else {
        unit = roundBy(m.round, rawUnit / 1.1);
        amt = unit * qty;
      }
      const compareBase = m.id === '포함' ? generalPrice : (generalPrice ? generalPrice/1.1 : 0);
      const margin = compareBase ? ((compareBase - unit) / compareBase) : null;
      modes[m.id] = { amt, unit, margin };
    });
    }

    pharmregComputed.push({
      productCode: prod ? prod.code : '',
      barcode, dealType: 1, damageType: 1, qty, discount: '',
      lotNo, expiry,
      productName: itemName,
      maker: prod ? prod.maker : '',
      note: prod ? prod.note : '', longout: prod ? prod.longout : '',
      generalPrice, modes
    });
  });

  if(autoAddNames.length && codeTableMaps.layout){
    const lay = codeTableMaps.layout;
    if(lay.uploadId){
      const us = uploadState[lay.uploadId];
      if(us){
        autoAddNames.forEach(({name, spec})=>{
          const newRow = new Array(lay.colCount).fill('');
          newRow[lay.idxName] = name;
          if(lay.idxSpec !== -1 && lay.idxSpec !== undefined) newRow[lay.idxSpec] = spec;
          us.rows.push(newRow);
        });
        renderUploadTable(lay.uploadId);
        updateUploadMeta(lay.uploadId);
        saveUpload(lay.uploadId);
      }
    } else {
      const raw = pharmregCodeTables[company];
      autoAddNames.forEach(({name, spec})=>{
        const newRow = new Array(lay.colCount).fill('');
        newRow[lay.idxName] = name;
        if(lay.idxSpec !== -1 && lay.idxSpec !== undefined) newRow[lay.idxSpec] = spec;
        raw.push(newRow);
      });
      savePharmregCodeTables();
      if((document.getElementById('pharmregCompany')||{}).value === company){
        document.getElementById('pharmregCodeTablePasteArea').value = raw.map(r=>r.join('\t')).join('\n');
        renderPharmregCodeTableInfo(company);
      }
    }
  }

  finalizePharmregMode();
  checkManagedItemsForFinalRows(pharmregFinalRows);
}
function decidePharmregMode(){
  const refTotal = pharmregCalcReferenceTotal();
  const vendorVatRaw = String((pharmregSelectedVendor && pharmregSelectedVendor.vat) || '').trim();
  const company = (document.getElementById('pharmregCompany')||{}).value || '';
  const profile = PHARMREG_PROFILES[company];
  const forcedVat = profile && profile.forceVatMode;

  if(forcedVat === '포함'){
    return { mode:'포함', diff:0, reason:`이 제약사는 항상 부가세 포함 금액으로 계산하도록 설정돼있어서(거래처정보마스터DB 설정과 무관하게), 포함 방식을 그대로 사용했어요.` };
  }

  if(forcedVat !== '별도' && vendorVatRaw !== '별도'){
    const reason = vendorVatRaw === '포함'
      ? `거래처정보마스터DB의 매입전표부가세 값이 '포함'이라 포함 방식을 그대로 사용했어요.`
      : `거래처정보마스터DB의 매입전표부가세 값이 '포함'/'별도'가 아니거나 비어있어서, 기본값인 포함 방식으로 계산했어요.`;
    return { mode:'포함', diff:0, reason };
  }

  const separateModes = PHARMREG_MODES.filter(m=>m.id!=='포함');
  if(refTotal === null){
    return {
      mode:'별도-합계액(반올림)', diff:null,
      reason:'별도 방식 6가지 중 하나를 고르려면 왼쪽 간이 계산기에 세금계산서 공급가를 입력해주세요 — 아직 입력이 없어서 기본값인 별도-합계액(반올림)을 사용했어요.'
    };
  }
  let best = null;
  separateModes.forEach(m=>{
    const sum = pharmregComputed.reduce((s,r)=> s + (r.modes[m.id] ? r.modes[m.id].amt : 0), 0);
    const diff = Math.abs(sum - refTotal);
    if(!best || diff < best.diff) best = { mode:m.id, diff, sum };
  });
  const vendorNote = (forcedVat === '별도' && vendorVatRaw !== '별도')
    ? `이 제약사는 항상 부가세 별도 자료라서 별도 6가지 중`
    : `거래처정보마스터DB의 매입전표부가세가 '별도'라 별도 6가지 중`;
  let matchNote;
  if(best.diff === 0) matchNote = '계산기 공급가 합계와 정확히 일치하는 방식을 찾았어요.';
  else if(best.diff <= 50) matchNote = `계산기 공급가 합계와 ${best.diff.toLocaleString()}원 차이로 거의 일치하는 방식을 찾았어요.`;
  else matchNote = `계산기 공급가 합계와 가장 가까운 방식을 찾았어요 (차이 ${best.diff.toLocaleString()}원 — 정확히 일치하는 방식은 없었어요).`;
  return { mode: best.mode, diff: best.diff, reason: `${vendorNote} ${matchNote}` };
}

function finalizePharmregMode(){
  if(!pharmregComputed.length){ pharmregFinalRows = []; pharmregDecision = null; renderPharmregModeInfo(); renderPharmregTable(); renderPharmregEditsList(); return; }
  pharmregDecision = decidePharmregMode();
  pharmregEditsMap = new Map();
  pharmregFinalRows = pharmregComputed.map((r, idx)=>{
    const m = r.modes[pharmregDecision.mode] || { amt:0, unit:0, margin:null };
    return { ...r, unit:m.unit, amt:m.amt, margin:m.margin, _idx: idx, _orig: { unit:m.unit, amt:m.amt, lotNo:r.lotNo, expiry:r.expiry } };
  });
  reconcilePharmregTotals();
  renderPharmregModeInfo();
  renderPharmregTable();
  renderPharmregEditsList();
  recordPriceHistory('약가등재', pharmregFinalRows);
}

// 매입전표 합계액(계산기)에 입력한 진짜 합계와 결과값 합계 사이에 반올림 등으로 몇십 원 이내
// 오차가 나면, 금액이 큰(마진 영향이 상대적으로 작은) 품목부터 실금액을 1원 단위로 보정해서
// 정확히 맞춰줍니다. 품목 하나가 흡수하는 보정액은 그 품목의 수량을 넘지 않도록 제한합니다
// (매입단가가 ±1원을 크게 벗어나지 않게 하기 위함). 보정 내역은 비고/수정 내역에 남아요.
function reconcilePharmregTotals(){
  if(!pharmregFinalRows.length || !pharmregDecision) return;
  const isIncluded = pharmregDecision.mode === '포함';
  const target = isIncluded ? pharmregCalcReferenceGrandTotal() : pharmregCalcReferenceTotal();
  if(target === null) return;
  const currentSum = pharmregFinalRows.reduce((s,r)=> s + (Number(r.amt)||0), 0);
  let diff = Math.round(target - currentSum);
  if(diff === 0) return;
  const sign = diff > 0 ? 1 : -1;
  let remaining = Math.abs(diff);
  const candidates = [...pharmregFinalRows].sort((a,b)=> (b.amt||0) - (a.amt||0));
  for(const row of candidates){
    if(remaining <= 0) break;
    const qty = Number(row.qty) || 0;
    if(qty <= 1) continue; // 수량이 1 이하면 '수량 미만'만큼 보정할 여지가 없어요
    const maxAdj = qty - 1; // 보정액은 수량 미만이어야 함
    const adj = Math.min(maxAdj, remaining);
    if(adj <= 0) continue;
    const before = row.amt;
    row.amt = row.amt + sign*adj;
    row.unit = qty ? row.amt / qty : row.unit;
    remaining -= adj;
    pharmregEditsMap.set(`${row._idx}:amt`, {
      productCode: row.productCode, barcode: row.barcode,
      field: '실금액(오차보정)', before, after: row.amt
    });
  }
}

function renderPharmregModeInfo(){
  const el = document.getElementById('pharmregModeInfo');
  if(!pharmregDecision){ el.style.display = 'none'; return; }
  el.style.display = 'block';
  const vendorPart = pharmregSelectedVendor && pharmregSelectedVendor.name ? `거래처: <b>${pharmregSelectedVendor.name}</b> · ` : '';
  const matched = pharmregFinalRows.filter(r=>r.productCode).length;
  const matchPart = pharmregFinalRows.length
    ? ` · 다미스제품코드마스터DB 매칭: <b>${matched}/${pharmregFinalRows.length}건</b>${matched < pharmregFinalRows.length ? ' (매칭 안 된 건은 표준코드·다미스코드명 칸이 비어있어요)' : ''}`
    : '';
  const reconciledCount = Array.from(pharmregEditsMap.values()).filter(e=>e.field==='실금액(오차보정)').length;
  const reconcilePart = reconciledCount ? ` · 매입전표 합계액과 맞추기 위해 <b>${reconciledCount}개 품목</b>의 실금액을 자동 보정했어요 (비고란 참고)` : '';
  const diff = pharmregDecision.diff;
  const isBigDiff = diff !== null && diff !== undefined && Math.abs(diff) > 1000;
  const warnPart = isBigDiff ? `<div style="color:var(--red); font-weight:800; margin-top:4px;">⚠ 매입전표 합계액과 결과값 차이가 커요 (${Math.abs(Math.round(diff)).toLocaleString()}원) — 계산기 입력값이나 붙여넣은 데이터를 다시 확인해주세요.</div>` : '';
  el.innerHTML = `${vendorPart}선택된 방식: <b>${pharmregDecision.mode}</b> — ${pharmregDecision.reason}${matchPart}${reconcilePart}${warnPart}`;
}

let pharmregColumnWidths = {}; // 사용자가 드래그로 조절한 컬럼 너비 (key: 컬럼 key 또는 'flag'/'editNote')
const PHARMREG_COLWIDTH_KEY = 'stockout_dashboard_pharmreg_colwidths_v1';

async function loadPharmregColumnWidths(){
  try{
    const res = await window.storage.get(PHARMREG_COLWIDTH_KEY, true);
    if(res && res.value) pharmregColumnWidths = JSON.parse(res.value);
  }catch(e){ /* 저장된 값 없음 */ }
}
async function savePharmregColumnWidths(){
  try{ await window.storage.set(PHARMREG_COLWIDTH_KEY, JSON.stringify(pharmregColumnWidths), true); }catch(e){ console.error('제약사사이트 자료 열너비 저장 실패:', e); }
}

function pharmregEditNoteFor(idx){
  const parts = [];
  pharmregEditsMap.forEach((e, key)=>{
    if(key.startsWith(idx + ':')){
      if(e.field === '제조번호' || e.field === '사용기한'){
        parts.push(`${e.field} ${e.before}→${e.after}`);
      } else {
        const delta = Math.round(e.after) - Math.round(e.before);
        const sign = delta > 0 ? '+' : '';
        parts.push(`${e.field} ${sign}${delta.toLocaleString()}원`);
      }
    }
  });
  return parts.join(', ');
}

function renderPharmregTable(){
  const screenCols = PHARMREG_COLUMNS.filter(c=>!c.hideOnScreen);
  const allCols = [
    { key:'flag', width:52 },
    ...screenCols,
    { key:'editNote', label:'비고', width:160 }
  ];
  const head = document.getElementById('head-pharmreg');
  head.innerHTML = allCols.map(c=>{
    const w = pharmregColumnWidths[c.key] || c.width;
    const label = c.key === 'productCode' ? `${c.label||''} <span style="color:var(--red); font-weight:800;">(공급내역신고 주의)</span>` : (c.label||'');
    return `<th style="width:${w}px; position:relative;">${label}<span class="pharmreg-col-resize" data-col="${c.key}" style="position:absolute; right:0; top:0; width:6px; height:100%; cursor:col-resize;"></span></th>`;
  }).join('');

  head.querySelectorAll('.pharmreg-col-resize').forEach(handle=>{
    handle.addEventListener('mousedown', (e)=>{
      e.preventDefault();
      const th = handle.closest('th');
      const colKey = handle.dataset.col;
      const startX = e.clientX;
      const startWidth = th.getBoundingClientRect().width;
      function onMove(ev){
        const newWidth = Math.max(30, Math.round(startWidth + (ev.clientX - startX)));
        th.style.width = newWidth + 'px';
      }
      function onUp(){
        document.removeEventListener('mousemove', onMove);
        document.removeEventListener('mouseup', onUp);
        pharmregColumnWidths[colKey] = parseInt(th.style.width, 10);
        savePharmregColumnWidths();
      }
      document.addEventListener('mousemove', onMove);
      document.addEventListener('mouseup', onUp);
    });
  });

  // 미매칭·마진 확인요망·사용기한 임박 여부를 행마다 한 번만 계산해서 정렬·렌더링에 그대로 재사용합니다.
  const rows = pharmregFinalRows.map(r=>{
    const isUnmatched = !r.productCode;
    const monthsLeft = monthsUntilExpiry(r.expiry);
    const isSoon = monthsLeft !== null && monthsLeft < 9;
    const isMarginWarn = !isUnmatched && r.margin !== null && r.margin !== undefined && !isNaN(r.margin) && (r.margin <= 0.04 || r.margin >= 0.13);
    const rank = isUnmatched ? 0 : (isMarginWarn ? 1 : (isSoon ? 2 : 3));
    return { r, isSoon, isUnmatched, isMarginWarn, rank };
  }).sort((a,b)=> a.rank - b.rank);
  document.getElementById('count-pharmreg').textContent = `${rows.length.toLocaleString()}건`;

  const sumEl = document.getElementById('pharmregSumInfo');
  if(pharmregFinalRows.length){
    const sum = pharmregFinalRows.reduce((s,r)=> s + (Number(r.amt)||0), 0);
    sumEl.style.display = 'block';
    sumEl.textContent = `결과값 합계액: ${Math.round(sum).toLocaleString()}원`;
  } else {
    sumEl.style.display = 'none';
  }

  const body = document.getElementById('body-pharmreg');
  body.innerHTML = rows.map(({r, isSoon, isUnmatched, isMarginWarn})=>{
    const flagLabel = isUnmatched ? '미매칭' : (isMarginWarn ? '확인요망' : (isSoon ? '임박' : ''));
    const flagCell = `<td style="color:var(--red); font-weight:800; text-align:center;">${flagLabel}</td>`;
    const rowStyle = (isUnmatched || isMarginWarn) ? ' style="color:var(--red);"' : '';
    const mainCells = screenCols.map(c=>{
      let v = r[c.key];
      if(c.pct){ v = (v===null || v===undefined || isNaN(v)) ? '' : (Math.round(v*10000)/100).toLocaleString() + '%'; }
      else if(c.num){ v = (v===null || v===undefined || v==='' || isNaN(v)) ? '' : Math.round(v).toLocaleString(); }
      else if(v===null || v===undefined) v = '';
      else { v = escapeHtml(v); } // 외부 데이터(제품명/제조번호/구매비고 등 텍스트 컬럼)만 여기서 이스케이프해요. 숫자/퍼센트 컬럼은 위에서 이미 별도 분기로 처리돼서 이 줄까지 안 내려옵니다.
      const isExpiryWarn = c.key === 'expiry' && isSoon;
      const cellStyle = (!isMarginWarn && isExpiryWarn) ? ' style="color:var(--red); font-weight:700;"' : '';
      if(c.editable){
        return `<td class="num editable" contenteditable="true" data-idx="${r._idx}" data-field="${c.key}"${cellStyle}>${v}</td>`;
      }
      if(c.textEditable){
        return `<td class="editable" contenteditable="true" data-idx="${r._idx}" data-field="${c.key}" data-text="1"${cellStyle}>${v}</td>`;
      }
      return `<td class="${c.num||c.pct?'num':''}"${cellStyle}>${v}</td>`;
    }).join('');
    const noteCell = `<td style="color:var(--ink-dim); font-size:12px;">${pharmregEditNoteFor(r._idx)}</td>`;
    return `<tr${rowStyle}>` + flagCell + mainCells + noteCell + '</tr>';
  }).join('');

  body.querySelectorAll('td[contenteditable]').forEach(td=>{
    td.addEventListener('blur', ()=>{
      const idx = Number(td.dataset.idx);
      const field = td.dataset.field;
      const row = pharmregFinalRows.find(r=>r._idx===idx);
      if(!row) return;
      const isText = td.dataset.text === '1';
      const fieldLabel = field === 'unit' ? '매입단가' : (field === 'amt' ? '실금액' : (field === 'lotNo' ? '제조번호' : '사용기한'));
      if(isText){
        const val = String(td.textContent).trim();
        row[field] = val;
        td.classList.add('edited');
        const orig = row._orig[field] || '';
        const key = `${idx}:${field}`;
        if(val === orig){ pharmregEditsMap.delete(key); }
        else {
          pharmregEditsMap.set(key, {
            productCode: row.productCode, barcode: row.barcode,
            field: fieldLabel, before: orig || '(공란)', after: val || '(공란)'
          });
        }
        renderPharmregEditsList();
        renderPharmregTable();
        return;
      }
      const n = Number(String(td.textContent).replace(/,/g,'').trim());
      if(isNaN(n)) { td.textContent = Math.round(row[field]).toLocaleString(); return; }
      row[field] = n;
      td.classList.add('edited');
      const orig = row._orig[field];
      const key = `${idx}:${field}`;
      if(n === orig){ pharmregEditsMap.delete(key); }
      else {
        pharmregEditsMap.set(key, {
          productCode: row.productCode, barcode: row.barcode,
          field: fieldLabel,
          before: orig, after: n
        });
      }
      renderPharmregEditsList();
      renderPharmregTable();
    });
    td.addEventListener('keydown', (e)=>{ if(e.key==='Enter'){ e.preventDefault(); td.blur(); } });
  });
}

function renderPharmregEditsList(){
  const section = document.getElementById('pharmregEditsSection');
  const body = document.getElementById('pharmregEditsBody');
  if(pharmregEditsMap.size === 0){ section.style.display = 'none'; body.innerHTML = ''; return; }
  section.style.display = 'block';
  body.innerHTML = Array.from(pharmregEditsMap.values()).map(e=>`
    <tr>
      <td>${e.productCode || ''}</td>
      <td>${e.barcode || ''}</td>
      <td>${e.field}</td>
      <td class="num">${Math.round(e.before).toLocaleString()}</td>
      <td class="num">${Math.round(e.after).toLocaleString()}</td>
    </tr>`).join('');
}

async function savePharmregRaw(){
  try{ await window.storage.set(PHARMREG_STORAGE_KEY, JSON.stringify(pharmregRawRows), true); }catch(e){ console.error('제약사사이트 자료 원본 데이터 저장 실패:', e); }
}

async function loadPharmregRaw(){
  try{
    const res = await window.storage.get(PHARMREG_STORAGE_KEY, true);
    if(res && res.value){
      pharmregRawRows = JSON.parse(res.value);
      document.getElementById('pharmregPasteArea').value = pharmregRawRows.map(r=>r.join('\t')).join('\n');
    }
  }catch(e){ /* nothing saved yet */ }
}

function updatePharmregPasteInfo(){
  const el = document.getElementById('pharmregPasteInfo');
  el.textContent = pharmregRawRows.length ? `${pharmregRawRows.length.toLocaleString()}행 붙여넣어짐 · 계산 완료` : '아직 붙여넣은 데이터가 없어요';
}

// 수정 내역을 표 마지막에 별도 블록으로 덧붙인, 내보내기용 행 배열(일반 객체)을 만듭니다.
// 다운로드 파일은 화면 표시 여부와 무관하게 항상 이 10개 컬럼을, 이 순서 그대로 내려줍니다.
const PHARMREG_EXPORT_KEY_ORDER = ['productCode','barcode','dealType','damageType','qty','unit','amt','discount','lotNo','expiry'];
const PHARMREG_EXPORT_COLUMNS = PHARMREG_EXPORT_KEY_ORDER.map(k => PHARMREG_COLUMNS.find(c=>c.key===k));

function buildPharmregExportRows(){
  return pharmregFinalRows.map(r=>{
    const o = {};
    PHARMREG_EXPORT_COLUMNS.forEach(c=>{
      let v = r[c.key];
      if(c.pct) v = (v===null||v===undefined||isNaN(v)) ? '' : Math.round(v*10000)/100;
      else if(c.num) v = (v===null||v===undefined||v===''||isNaN(v)) ? '' : Math.round(v);
      o[c.key] = (v===null||v===undefined) ? '' : v;
    });
    return o;
  });
}

function pharmregExportFileBaseName(){
  const vendorName = (pharmregSelectedVendor && pharmregSelectedVendor.name) ? pharmregSelectedVendor.name : '공급내역신고';
  return vendorName.replace(/[\\/*?:[\]]/g,'');
}

async function exportPharmregXlsx(){
  if(!pharmregFinalRows.length){ alert('먼저 데이터를 붙여넣고 결과를 계산해주세요.'); return; }
  const rows = buildPharmregExportRows();
  // 다미스 엑셀업로드 양식(헤더+데이터, 할인 0 채움)과 동일한 구조로 저장합니다.
  const ws = buildDamisUploadSheet(PHARMREG_EXPORT_COLUMNS, rows, ['productCode','barcode','lotNo','expiry']);
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, (pharmregDecision ? pharmregDecision.mode : '공급내역신고').replace(/[\\/*?:[\]]/g,'').slice(0,31));
  XLSX.writeFile(wb, pharmregExportFileBaseName() + '_' + new Date().toISOString().slice(0,10) + '.xlsx', { bookType:'xlsx' });
}

function exportPharmregXls(){
  if(!pharmregFinalRows.length){ alert('먼저 데이터를 붙여넣고 결과를 계산해주세요.'); return; }
  const rows = buildPharmregExportRows();
  const ws = buildDamisUploadSheet(PHARMREG_EXPORT_COLUMNS, rows, ['productCode','barcode','lotNo','expiry']);
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, (pharmregDecision ? pharmregDecision.mode : '공급내역신고').replace(/[\\/*?:[\]]/g,'').slice(0,31));
  XLSX.writeFile(wb, pharmregExportFileBaseName() + '_' + new Date().toISOString().slice(0,10) + '.xls', { bookType:'xls' });
}

// 엑셀에서 복사하면 일반 텍스트(clipboard 'text/plain') 말고 서식이 담긴 'text/html'도 함께 담깁니다.
// 엑셀 HTML에는 셀이 숫자일 때 화면표시(지수표기)와 별개로 실제 값을 담은 속성(x:num 등)이 남아있는
// 경우가 있어, 있으면 그 값을 우선 사용해 표준코드 같은 큰 숫자가 지수표기로 잘리는 걸 자동으로
// 막아줍니다 (엑셀 버전에 따라 없을 수도 있고, 그럴 땐 그냥 평소처럼 붙여넣기가 진행돼요).

let pharmregCodeTables = {};
let pharmregCodeTableUpdatedAt = {};
const PHARMREG_CODETABLE_COMPANIES = [];
const PHARMREG_UPLOADTABLE_COMPANIES = { '뉴신팜':'pharminfo_newshin', '메디카코리아':'pharminfo_medica', '에이치케이이노엔':'pharminfo_hk', '일동제약':'pharminfo_ildong', '티알엔':'pharminfo_tr' };
const PHARMREG_CODETABLE_STORAGE_KEY = 'stockout_dashboard_pharmreg_codetables_v1';

async function savePharmregCodeTables(){
  try{ await window.storage.set(PHARMREG_CODETABLE_STORAGE_KEY, JSON.stringify({ tables: pharmregCodeTables, updatedAt: pharmregCodeTableUpdatedAt }), true); }catch(e){ console.error('제약사상품정보 코드표 저장 실패:', e); }
}
async function loadPharmregCodeTables(){
  try{
    const res = await window.storage.get(PHARMREG_CODETABLE_STORAGE_KEY, true);
    if(res && res.value){
      const parsed = JSON.parse(res.value);
      pharmregCodeTables = parsed.tables || {};
      pharmregCodeTableUpdatedAt = parsed.updatedAt || {};
    }
  }catch(e){}
}
// 제약사상품정보 표에서, 제품코드가 채워져 있는데 표준코드가 비어있는 줄을 찾아서
// 다미스제품코드마스터DB의 '코드' 컬럼과 매칭해 표준코드를 자동으로 채워줍니다.
async function fillPharmregStdCodeFromProductCode(uploadId){
  const us = uploadState[uploadId];
  if(!us || !us.rows || !us.rows.length){ alert('먼저 제약사상품정보 데이터를 올려주세요.'); return; }
  const pm = uploadState['productMaster'];
  if(!pm){ alert('다미스제품코드마스터DB가 아직 없어요.'); return; }
  const pmIdxCode = findHeaderIndex(pm.headers, '코드');
  const pmIdxStd = pm.headers.indexOf('표준코드');
  if(pmIdxCode === -1 || pmIdxStd === -1){ alert('다미스제품코드마스터DB에서 코드/표준코드 컬럼을 찾지 못했어요.'); return; }
  const codeToStd = new Map();
  pm.rows.forEach(r=>{
    const code = String(r[pmIdxCode]||'').trim();
    if(code && !codeToStd.has(code)) codeToStd.set(code, String(r[pmIdxStd]||'').trim());
  });

  const norm = us.headers.map(pharmregNormCell);
  const idxCode = norm.findIndex(v=>v.includes('제품코드')||v.includes('전산코드')||v.includes('자사코드'));
  const idxStd = norm.findIndex(v=>v==='표준코드'||v==='의약품표준코드');
  if(idxCode === -1 || idxStd === -1){ alert('이 표에서 제품코드/표준코드 컬럼을 찾지 못했어요.'); return; }

  let filled = 0;
  us.rows.forEach(row=>{
    const code = String(row[idxCode]||'').trim();
    const curStd = String(row[idxStd]||'').trim();
    if(code && !curStd && codeToStd.has(code)){
      const std = codeToStd.get(code);
      if(std){ row[idxStd] = std; filled++; }
    }
  });
  renderUploadTable(uploadId);
  updateUploadMeta(uploadId);
  await saveUpload(uploadId);
  alert(filled ? `표준코드 ${filled}건을 채웠어요.` : '다미스제품코드마스터DB와 매칭되는(표준코드가 비어있던) 줄이 없었어요.');
  const company = (document.getElementById('pharmregCompany')||{}).value || '';
  if(pharmregRawRows.length && PHARMREG_UPLOADTABLE_COMPANIES[company] === uploadId){
    computePharmregResults();
    renderPharmregModeInfo();
    renderPharmregTable();
  }
}

function renderPharmregCodeTableInfo(company){
  const el = document.getElementById('pharmregCodeTableInfo');
  const rows = pharmregCodeTables[company] || [];
  const ts = pharmregCodeTableUpdatedAt[company];
  if(!rows.length){ el.textContent = '아직 저장된 코드표가 없어요'; return; }
  const tsTxt = ts ? new Date(ts).toLocaleString('ko-KR') : '';
  el.textContent = `${rows.length.toLocaleString()}행 저장됨 · 최종 업데이트: ${tsTxt}`;
}
function updatePharmregCodeTableAreaVisibility(){
  const company = document.getElementById('pharmregCompany').value;
  const area = document.getElementById('pharmregCodeTableArea');
  const show = PHARMREG_CODETABLE_COMPANIES.includes(company);
  area.style.display = show ? 'block' : 'none';
  if(show){
    const rows = pharmregCodeTables[company] || [];
    document.getElementById('pharmregCodeTablePasteArea').value = rows.map(r=>r.join('\t')).join('\n');
    renderPharmregCodeTableInfo(company);
  }
}
function updatePharmregUploadTableAreaVisibility(){
  const company = document.getElementById('pharmregCompany').value;
  Object.entries(PHARMREG_UPLOADTABLE_COMPANIES).forEach(([c, id])=>{
    const wrap = document.getElementById(id + '-wrap');
    if(wrap) wrap.style.display = (c === company) ? 'block' : 'none';
  });
}

// ---------- 동아에스티: 공급내역신고자료(공급내역신고 탭과 같은 22열 형식)로 제조번호·사용기한 보완 ----------
let pharmregDongaSupplyRows = [];
let pharmregDongaSupplyUpdatedAt = null;
const PHARMREG_DONGA_SUPPLY_STORAGE_KEY = 'stockout_dashboard_pharmreg_donga_supply_v1';

async function savePharmregDongaSupply(){
  try{ await window.storage.set(PHARMREG_DONGA_SUPPLY_STORAGE_KEY, JSON.stringify({ rows: pharmregDongaSupplyRows, updatedAt: pharmregDongaSupplyUpdatedAt }), true); }catch(e){ console.error('동아에스티 공급내역신고자료 저장 실패:', e); }
}
async function loadPharmregDongaSupply(){
  try{
    const res = await window.storage.get(PHARMREG_DONGA_SUPPLY_STORAGE_KEY, true);
    if(res && res.value){
      const parsed = JSON.parse(res.value);
      pharmregDongaSupplyRows = parsed.rows || [];
      pharmregDongaSupplyUpdatedAt = parsed.updatedAt || null;
    }
  }catch(e){}
}
function renderPharmregDongaSupplyInfo(){
  const el = document.getElementById('pharmregDongaSupplyInfo');
  if(!el) return;
  if(!pharmregDongaSupplyRows.length){ el.textContent = '아직 저장된 공급내역신고자료가 없어요'; return; }
  const tsTxt = pharmregDongaSupplyUpdatedAt ? new Date(pharmregDongaSupplyUpdatedAt).toLocaleString('ko-KR') : '';
  el.textContent = `${pharmregDongaSupplyRows.length.toLocaleString()}행 저장됨 · 최종 업데이트: ${tsTxt}`;
}
function updatePharmregDongaSupplyAreaVisibility(){
  const company = document.getElementById('pharmregCompany').value;
  const area = document.getElementById('pharmregDongaSupplyArea');
  if(!area) return;
  const show = company === '동아에스티';
  area.style.display = show ? 'block' : 'none';
  if(show){
    document.getElementById('pharmregDongaSupplyPasteArea').value = pharmregDongaSupplyRows.map(r=>r.join('\t')).join('\n');
    renderPharmregDongaSupplyInfo();
  }
}

// 일동제약은 명세서를 붙여넣기 대신 파일 업로드로 받습니다.
const PHARMREG_FILE_INPUT_COMPANIES = ['뉴신팜','유나이티드','동아에스티','온라인팜','일동제약','티알엔','휴온스'];
let pharmregMainFileName = '';
function updatePharmregInputModeVisibility(){
  const company = document.getElementById('pharmregCompany').value;
  const useFile = PHARMREG_FILE_INPUT_COMPANIES.includes(company);
  document.getElementById('pharmregPasteWrap').style.display = useFile ? 'none' : 'block';
  document.getElementById('pharmregFileWrap').style.display = useFile ? 'block' : 'none';
  if(useFile) updatePharmregFileInfo();
}
function updatePharmregFileInfo(){
  const el = document.getElementById('pharmregFileInfo');
  el.textContent = pharmregRawRows.length ? `${pharmregMainFileName || '업로드된 파일'} · ${pharmregRawRows.length.toLocaleString()}행 인식됨` : '아직 업로드된 파일이 없어요';
}
// 표준코드 → {lotNo, expiry} 맵을 만듭니다(공급내역신고자료와 같은 22열 형식: K(10)=표준코드, S(18)=제조번호, T(19)=사용기한 뒷자리).
function buildPharmregDongaSupplyMap(){
  const map = new Map();
  // 공급내역신고(전체) 형식(헤더 있는 A~W 23열): L(11)=표준코드, S(18)=제조번호, T(19)=유효기간("YY-MM-DD").
  pharmregDongaSupplyRows.forEach(f=>{
    const std = String(f[11]||'').trim();
    if(!std) return;
    const lotNo = String(f[18]||'').trim();
    const expiryRaw = String(f[19]||'').trim().replace(/-/g,'');
    const expiry = expiryRaw ? ('20' + expiryRaw.padStart(6,'0')) : '';
    if(!map.has(std)) map.set(std, { lotNo, expiry });
  });
  return map;
}

// ---------- 제약사 선택: 드롭다운 대신 상단에 나열된 버튼(칩)으로 골라요 ----------
function renderPharmregCompanyButtons(){
  const wrap = document.getElementById('pharmregCompanyButtons');
  if(!wrap) return;
  const select = document.getElementById('pharmregCompany');
  const options = Array.from(select.options).map(o=>({ value: o.value || o.textContent, label: o.textContent }));
  const current = select.value;
  const chipStyle = (active) => `padding:6px 14px; border-radius:999px; border:1px solid ${active?'var(--accent)':'var(--line)'}; background:${active?'var(--accent)':'var(--panel)'}; color:${active?'#fff':'var(--ink)'}; font-size:13px; cursor:pointer; font-weight:${active?'700':'400'};`;
  let html = '';
  options.forEach(({value, label})=>{
    html += `<button type="button" class="pharmreg-chip" data-company="${value}" style="${chipStyle(current===value)}">${label}${value==='동아에스티'?' 🔗':''}</button>`;
  });
  wrap.innerHTML = html;
  wrap.querySelectorAll('.pharmreg-chip').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      select.value = btn.dataset.company;
      select.dispatchEvent(new Event('change'));
    });
  });
}

function bindPharmregTab(){
  document.getElementById('pharmregPasteArea').addEventListener('paste', (e)=>{
    const html = e.clipboardData && e.clipboardData.getData('text/html');
    if(!html) return; // text/html이 없으면 평소처럼 일반 텍스트 붙여넣기가 그대로 진행됩니다.
    const rows = parseExcelHtmlTable(html);
    if(rows && rows.length){
      e.preventDefault();
      document.getElementById('pharmregPasteArea').value = rows.map(r=>r.join('\t')).join('\n');
    }
  });
  document.getElementById('pharmregApplyBtn').addEventListener('click', async ()=>{
    const text = document.getElementById('pharmregPasteArea').value;
    pharmregRawRows = parsePharmregPasteText(text);
    computePharmregResults();
    updatePharmregPasteInfo();
  });
  document.getElementById('pharmregClearBtn').addEventListener('click', async ()=>{
    if(!confirm('붙여넣은 데이터를 지울까요?')) return;
    pharmregRawRows = []; pharmregComputed = []; pharmregFinalRows = []; pharmregDecision = null; pharmregEditsMap = new Map();
    document.getElementById('pharmregPasteArea').value = '';
    updatePharmregPasteInfo();
    renderPharmregModeInfo();
    renderPharmregTable();
    renderPharmregEditsList();
    try{ await window.storage.delete(PHARMREG_STORAGE_KEY, true); }catch(e){ console.error('매입전표입력(제약사사이트) 붙여넣은 데이터 삭제 실패:', e); }
  });
  document.getElementById('pharmregCompany').addEventListener('change', async ()=>{
    renderPharmregCompanyButtons();
    updatePharmregCodeTableAreaVisibility();
    updatePharmregUploadTableAreaVisibility();
    updatePharmregDongaSupplyAreaVisibility();
    updatePharmregInputModeVisibility();
    if(pharmregRawRows.length){
      computePharmregResults();
      renderPharmregModeInfo();
      renderPharmregTable();
    }
  });
  document.getElementById('pharmregCodeTableSaveBtn').addEventListener('click', async ()=>{
    const company = document.getElementById('pharmregCompany').value;
    if(!company){ alert('제약사를 먼저 선택해주세요.'); return; }
    const text = document.getElementById('pharmregCodeTablePasteArea').value;
    pharmregCodeTables[company] = parsePharmregPasteText(text);
    pharmregCodeTableUpdatedAt[company] = new Date().toISOString();
    renderPharmregCodeTableInfo(company);
    await savePharmregCodeTables();
    if(pharmregRawRows.length){
      computePharmregResults();
      renderPharmregModeInfo();
      renderPharmregTable();
    }
  });
  document.getElementById('pharmregDongaSupplySaveBtn').addEventListener('click', async ()=>{
    const text = document.getElementById('pharmregDongaSupplyPasteArea').value;
    let rows = parsePharmregPasteText(text);
    // 공급내역신고(전체) 형식은 헤더가 있어서, 첫 줄의 공급수량 자리(N열, index13)가 숫자가 아니면
    // 헤더 줄로 보고 건너뛰어요(헤더 없이 붙여넣어도 숫자라 그대로 안전하게 씀).
    if(rows.length){
      const qtyCell = String((rows[0]||[])[13] || '').trim();
      if(!qtyCell || isNaN(Number(qtyCell))) rows = rows.slice(1);
    }
    pharmregDongaSupplyRows = rows;
    pharmregDongaSupplyUpdatedAt = new Date().toISOString();
    renderPharmregDongaSupplyInfo();
    await savePharmregDongaSupply();
    if(pharmregRawRows.length){
      computePharmregResults();
      renderPharmregModeInfo();
      renderPharmregTable();
    }
  });
  document.getElementById('pharmregMainFile').addEventListener('change', async (e)=>{
    const file = e.target.files[0];
    if(!file) return;
    const buf = await file.arrayBuffer();
    const aoa = readWorkbookAoaFromBuffer(buf, file.name);
    pharmregRawRows = aoa.map(row => row.map(v => v===null ? '' : v));
    pharmregMainFileName = file.name;
    updatePharmregFileInfo();
    computePharmregResults();
    e.target.value = '';
  });
  document.getElementById('pharmregFileClearBtn').addEventListener('click', async ()=>{
    if(!confirm('업로드한 명세서 데이터를 지울까요?')) return;
    pharmregRawRows = []; pharmregComputed = []; pharmregFinalRows = []; pharmregDecision = null; pharmregEditsMap = new Map();
    pharmregMainFileName = '';
    updatePharmregFileInfo();
    renderPharmregModeInfo();
    renderPharmregTable();
    renderPharmregEditsList();
    try{ await window.storage.delete(PHARMREG_STORAGE_KEY, true); }catch(e){ console.error('매입전표입력(제약사사이트) 업로드 명세서 삭제 실패:', e); }
  });
  document.getElementById('pharmregExportXlsxBtn').addEventListener('click', exportPharmregXlsx);
  document.getElementById('pharmregExportXlsBtn').addEventListener('click', exportPharmregXls);
  document.getElementById('pharmregCalcResetBtn').addEventListener('click', ()=>{
    if(!confirm('매입전표 합계액 계산기 값을 모두 지울까요?')) return;
    resetPharmregCalc();
  });
}

async function initPharmregTab(){
  bindPharmregTab();
  renderPharmregCalcTable();
  renderPharmregCompanyButtons();
  Object.values(PHARMREG_UPLOADTABLE_COMPANIES).forEach(uploadId=>{
    const btn = document.getElementById('fillstd-' + uploadId);
    if(btn) btn.addEventListener('click', ()=> fillPharmregStdCodeFromProductCode(uploadId));
  });
  await Promise.all([
    loadPharmregColumnWidths(),
    loadPharmregCodeTables(),
    loadPharmregDongaSupply()
  ]);
  updatePharmregCodeTableAreaVisibility();
  updatePharmregUploadTableAreaVisibility();
  updatePharmregDongaSupplyAreaVisibility();
  updatePharmregInputModeVisibility();
  if(pharmregRawRows.length){
    computePharmregResults();
    updatePharmregPasteInfo();
    updatePharmregFileInfo();
  }
}


// 뉴신팜/메디카코리아/티알엔의 제약사상품정보도 같은 방식(엑셀 업로드+표+수기수정+표준코드 채우기 버튼)으로
// 만들어줍니다. 이미 있는 에이치케이이노엔/일동제약 블록과 똑같은 구조를 코드로 생성해서, HTML을
// 세 번 더 그대로 옮겨적지 않고 재사용합니다.
function createPharminfoUploadBlock(uploadId, titleNote){
  const wrap = document.createElement('div');
  wrap.id = uploadId + '-wrap';
  wrap.style.display = 'none';
  wrap.style.marginBottom = '10px';
  wrap.innerHTML = `
    <div class="sub-section-title" style="font-size:13px; margin-bottom:6px;">제약사상품정보</div>
    <div class="foot-note" style="margin-bottom:6px;">${titleNote}</div>
    <div class="upload-bar" id="upload-${uploadId}-bar">
      <label class="upload-drop compact" for="file-${uploadId}">
        <span class="upload-icon">⬆</span>
        <span><b>제약사상품정보</b> 엑셀/CSV 파일을 올려서 갱신하세요</span>
      </label>
      <input type="file" id="file-${uploadId}" accept=".xlsx,.xls,.csv" hidden>
      <div class="upload-actions">
        <button class="btn primary" id="save-${uploadId}" style="display:none;">💾 저장</button>
        <button class="btn danger" id="clear-${uploadId}" style="display:none;">데이터 지우기</button>
        <div class="upload-meta" id="meta-${uploadId}">아직 업로드된 데이터가 없어요</div>
        <div class="save-indicator" id="saveState-${uploadId}" style="display:none;"><span class="save-dot"></span><span>대기 중</span></div>
      </div>
    </div>
    <div class="toolbar" id="toolbar-${uploadId}" style="display:none;">
      <input type="text" id="search-${uploadId}" placeholder="전체 컬럼 검색...">
      <span class="count-badge" id="count-${uploadId}"></span>
      <div class="spacer"></div>
      <button class="btn primary" id="fillstd-${uploadId}">🔎 제품코드로 표준코드 채우기</button>
      <div class="pager" id="pager-${uploadId}"></div>
    </div>
    <div class="table-scroll" id="scroll-${uploadId}" style="display:none; max-height:260px; overflow-y:auto;">
      <table id="table-${uploadId}">
        <thead><tr id="head-${uploadId}"></tr></thead>
        <tbody id="body-${uploadId}"></tbody>
      </table>
    </div>`;
  document.getElementById('pharminfo-extra-wraps').appendChild(wrap);
}
createPharminfoUploadBlock('pharminfo_newshin', '표준코드/제품명/단가 열로 된 엑셀을 올려서 관리하세요 — 이 회사는 명세서에 표준코드가 이미 있어서 매칭용이 아니라, 명세서에 없는 <b>단가</b>를 표준코드 기준으로 보완하는 용도예요 · 표 안 셀을 클릭하면 바로 수정할 수 있어요.');
createPharminfoUploadBlock('pharminfo_medica', '제품명/포장단위/의약품표준코드 열로 된 엑셀을 올려서 관리하세요(제품명+포장단위를 합쳐서 매칭해요) · 표 안 셀을 클릭하면 바로 수정할 수 있어요 · 명세서에 있는데 여기 없는 제품명은 표준코드가 빈 채로 자동 추가돼요.');
createPharminfoUploadBlock('pharminfo_tr', '표준코드/제품명/단가 열로 된 엑셀을 올려서 관리하세요 — 이 회사는 명세서에 표준코드가 이미 있어서 매칭용이 아니라, 명세서에 없는 <b>단가</b>를 표준코드 기준으로 보완하는 용도예요 · 표 안 셀을 클릭하면 바로 수정할 수 있어요.');

// ---------- 관리품목등록: 영업사원요청품목 · 수급불안정품목 ----------
// 제품정보(제약사/제품명/규격)는 항상 다미스제품코드마스터DB(uploadState['productMaster'])에서만 조회해서 채워요.
// 데이터는 구매부 직원 전체가 같이 봐야 하니 shared:true로 저장합니다(모든 사용자에게 공유).
// "현재 선택된 구매부 직원"은 그 사람의 브라우저에만 기억되면 되니 shared:false로 따로 저장해요.
const MI_STORAGE_KEY = 'shared_managed_items_v1';
const MI_EMPLOYEE_KEY = 'mi_selected_employee_v1';
const MI_EMPLOYEE_BRANCH = {
  '최형욱':'광주', '김은경':'광주', '전송이':'광주', '예상화':'광주', '이상연':'광주',
  '서호진':'의정부', '유아름':'의정부', '김동재':'의정부'
};
let managedItems = []; // { id, type:'sales'|'supply', branch, code, maker, name, spec, qty, note, registeredBy, registeredAt, modifiedAt }
let miSelectedEmployee = '';
let miLookupSelected = null; // 마지막으로 조회/선택된 제품 {code, maker, name, spec}
let miEditingId = null; // 지금 목록에서 [수정] 중인 관리품목의 id (한 번에 한 행만 편집)

// 다미스제품코드마스터DB(코드→제약사/제품명/규격)에서 정확히 그 코드 하나를 찾아요. 없으면 null.
function miLookupProductByCode(code){
  const pm = uploadState['productMaster'];
  if(!pm || !pm.headers || !pm.rows) return null;
  const idxCode = findHeaderIndex(pm.headers, '코드');
  const idxMaker = pm.headers.indexOf('제약사');
  const idxName = pm.headers.indexOf('상품명');
  const idxSpec = pm.headers.indexOf('규격');
  const idxSplit = pm.headers.indexOf('소분');
  if(idxCode === -1) return null;
  const target = String(code||'').trim();
  if(!target) return null;
  const row = pm.rows.find(r => String(r[idxCode]||'').trim() === target);
  if(!row) return null;
  const spec = idxSpec!==-1 ? String(row[idxSpec]||'').trim() : '';
  if((idxSplit!==-1 && String(row[idxSplit]||'').trim()==='Y') || spec.includes('소분')) return null; // 소분 품목은 관리품목으로 등록 대상이 아니에요.
  return {
    code: target,
    maker: idxMaker!==-1 ? String(row[idxMaker]||'').trim() : '',
    name: idxName!==-1 ? String(row[idxName]||'').trim() : '',
    spec
  };
}

async function loadManagedItems(){
  try{
    const res = await window.storage.get(MI_STORAGE_KEY, true);
    managedItems = res && res.value ? JSON.parse(res.value) : [];
  }catch(e){ managedItems = []; } // 저장된 관리품목 없음(정상) — 아직 아무도 등록 안 한 최초 상태
}
async function saveManagedItems(){
  try{
    await window.storage.set(MI_STORAGE_KEY, JSON.stringify(managedItems), true);
  }catch(e){ console.error('관리품목 저장 실패:', e); }
}

async function loadMiEmployee(){
  try{
    const res = await window.storage.get(MI_EMPLOYEE_KEY, false);
    miSelectedEmployee = res && res.value ? res.value : '';
  }catch(e){ miSelectedEmployee = ''; } // 아직 직원 선택 안 함(정상, 최초 사용)
}
async function saveMiEmployee(){
  try{ await window.storage.set(MI_EMPLOYEE_KEY, miSelectedEmployee, false); }catch(e){ console.error('구매부 직원 선택 저장 실패:', e); }
}

function renderMiEmployeeSelect(){
  const sel = document.getElementById('miEmployeeSelect');
  const groups = { '광주':[], '의정부':[] };
  Object.entries(MI_EMPLOYEE_BRANCH).forEach(([name, branch]) => groups[branch].push(name));
  sel.innerHTML = '<option value="">-- 이름을 선택하세요 --</option>' +
    Object.entries(groups).map(([branch, names]) =>
      `<optgroup label="${branch}">` + names.map(n => `<option value="${n}" ${n===miSelectedEmployee?'selected':''}>${n}</option>`).join('') + '</optgroup>'
    ).join('');
  const branchEl = document.getElementById('miEmployeeBranch');
  branchEl.textContent = miSelectedEmployee ? `(${MI_EMPLOYEE_BRANCH[miSelectedEmployee]} 소속)` : '';
}

function miCurrentType(){
  return (document.querySelector('input[name="miType"]:checked')||{}).value || 'sales';
}
function miTypeLabel(type){ return type === 'sales' ? '영업사원요청품목' : '수급불안정품목'; }
function miQtyRequired(type){ return type === 'sales'; } // 영업사원요청품목만 수량이 필요해요 — 수급불안정품목은 품목 자체만 등록하면 됩니다.
function miUpdateQtyFieldVisibility(){
  const field = document.getElementById('miQtyField');
  const required = miQtyRequired(miCurrentType());
  field.style.display = required ? '' : 'none';
  if(!required) document.getElementById('miQtyInput').value = '';
}

function renderMiList(){
  const body = document.getElementById('miListBody');
  const statusEl = document.getElementById('miListStatus');
  const type = miCurrentType();
  const rows = managedItems.filter(it => it.type === type);
  const qtyRequired = miQtyRequired(type);
  statusEl.textContent = `${miTypeLabel(type)} · ${rows.length.toLocaleString()}건`;
  body.innerHTML = rows.map(it => {
    if(it.id === miEditingId){
      return `<tr data-mi-edit-row="${it.id}">
        <td>
          <select data-mi-edit-field="branch" style="width:80px;">
            <option value="광주" ${it.branch==='광주'?'selected':''}>광주</option>
            <option value="의정부" ${it.branch==='의정부'?'selected':''}>의정부</option>
            <option value="전체" ${it.branch==='전체'?'selected':''}>전체</option>
          </select>
        </td>
        <td><input type="text" data-mi-edit-field="code" value="${escapeAttr(it.code)}" style="width:90px;"></td>
        <td data-mi-edit-name>${escapeHtml(it.name)}</td>
        <td data-mi-edit-spec>${escapeHtml(it.spec)}</td>
        <td class="num">${qtyRequired ? `<input type="number" min="1" data-mi-edit-field="qty" value="${it.qty||''}" style="width:70px;">` : '<span style="color:var(--ink-dim);">해당없음</span>'}</td>
        <td><textarea data-mi-edit-field="note" rows="2" style="width:100%; box-sizing:border-box;">${escapeHtml(it.note||'')}</textarea></td>
        <td style="font-size:11.5px; color:var(--ink-dim);">${escapeHtml(it.registeredBy||'')}<br>${escapeHtml((it.registeredAt||'').slice(0,16).replace('T',' '))}</td>
        <td colspan="2" style="white-space:nowrap;">
          <button class="btn primary" data-mi-save="${it.id}" style="padding:3px 8px; font-size:11.5px;">저장</button>
          <button class="btn ghost" data-mi-cancel="${it.id}" style="padding:3px 8px; font-size:11.5px;">취소</button>
        </td>
      </tr>`;
    }
    return `
    <tr>
      <td>${escapeHtml(it.branch)}</td>
      <td>${escapeHtml(it.code)}</td>
      <td>${escapeHtml(it.name)}</td>
      <td>${escapeHtml(it.spec)}</td>
      <td class="num">${(it.qty===null || it.qty===undefined || it.qty==='') ? '-' : Number(it.qty).toLocaleString()}</td>
      <td>${escapeHtml(it.note||'')}</td>
      <td style="font-size:11.5px; color:var(--ink-dim);">${escapeHtml(it.registeredBy||'')}<br>${escapeHtml((it.registeredAt||'').slice(0,16).replace('T',' '))}</td>
      <td><button class="btn ghost" data-mi-edit="${it.id}" style="padding:3px 8px; font-size:11.5px;">수정</button></td>
      <td><button class="btn danger" data-mi-del="${it.id}" style="padding:3px 8px; font-size:11.5px;">삭제</button></td>
    </tr>`;
  }).join('') || '<tr><td colspan="9" style="text-align:center; color:var(--ink-dim);">등록된 품목이 없어요.</td></tr>';

  body.querySelectorAll('[data-mi-del]').forEach(btn=>{
    btn.addEventListener('click', async ()=>{
      if(!confirm('이 관리품목을 삭제할까요?')) return;
      const id = btn.dataset.miDel;
      managedItems = managedItems.filter(it => it.id !== id); // 고유 id 기준 삭제 — 같은 제품코드의 다른 관리품목은 안 지워짐
      await saveManagedItems();
      renderMiList();
    });
  });

  body.querySelectorAll('[data-mi-edit]').forEach(btn=>{
    btn.addEventListener('click', ()=>{ miEditingId = btn.dataset.miEdit; renderMiList(); });
  });
  body.querySelectorAll('[data-mi-cancel]').forEach(btn=>{
    btn.addEventListener('click', ()=>{ miEditingId = null; renderMiList(); }); // 수정 전 상태로 되돌림 — 아무것도 저장하지 않음
  });

  // 수정 중인 행에서 제품코드를 바꾸면, 저장 전 미리보기로 제품명·규격을 다미스제품코드마스터DB에서 다시 조회해 보여줘요.
  body.querySelectorAll('[data-mi-edit-field="code"]').forEach(input=>{
    input.addEventListener('blur', ()=>{
      const tr = input.closest('tr');
      const prod = miLookupProductByCode(input.value.trim());
      tr.querySelector('[data-mi-edit-name]').textContent = prod ? prod.name : '(코드 확인 필요)';
      tr.querySelector('[data-mi-edit-spec]').textContent = prod ? prod.spec : '';
    });
  });

  body.querySelectorAll('[data-mi-save]').forEach(btn=>{
    btn.addEventListener('click', async ()=>{
      const id = btn.dataset.miSave;
      const tr = btn.closest('tr');
      const item = managedItems.find(x => x.id === id);
      if(!item) return;
      const code = tr.querySelector('[data-mi-edit-field="code"]').value.trim();
      const prod = miLookupProductByCode(code);
      if(!prod){ alert('⚠ 다미스제품코드마스터DB에 없는 제품코드는 저장할 수 없어요.'); return; }
      let qty = item.qty;
      if(qtyRequired){
        qty = Number(tr.querySelector('[data-mi-edit-field="qty"]').value);
        if(!qty || qty <= 0){ alert('⚠ 수량은 0보다 큰 숫자로 입력해주세요.'); return; }
      }
      item.branch = tr.querySelector('[data-mi-edit-field="branch"]').value;
      item.code = prod.code; item.name = prod.name; item.spec = prod.spec; item.maker = prod.maker;
      item.qty = qty;
      item.note = tr.querySelector('[data-mi-edit-field="note"]').value; // 사용자가 이 칸에서 건드리지 않으면 원래 비고 값 그대로 저장돼요.
      item.modifiedAt = new Date().toISOString();
      await saveManagedItems();
      miEditingId = null;
      renderMiList();
    });
  });
}

function miApplyLookupResult(prod){
  miLookupSelected = prod;
  document.getElementById('miCodeInput').value = prod ? prod.code : '';
  document.getElementById('miMakerView').value = prod ? prod.maker : '';
  document.getElementById('miNameView').value = prod ? prod.name : '';
  document.getElementById('miSpecView').value = prod ? prod.spec : '';
}

function renderMiSearchDropdown(filterText){
  const pm = uploadState['productMaster'];
  const dropdown = document.getElementById('miSearchDropdown');
  const terms = String(filterText||'').trim().split(/\s+/).filter(Boolean); // 공백으로 여러 단어를 나눠서 각각 다 만족해야 걸리게 해요.
  if(!terms.length){ dropdown.style.display = 'none'; dropdown.innerHTML = ''; return; }
  if(!pm || !pm.headers || !pm.rows){
    dropdown.innerHTML = '<div style="padding:10px 12px; color:var(--ink-dim); font-size:13px;">다미스제품코드마스터DB가 아직 업로드되지 않았어요.</div>';
    dropdown.style.display = 'block';
    return;
  }
  const idxCode = findHeaderIndex(pm.headers, '코드');
  const idxMaker = pm.headers.indexOf('제약사');
  const idxName = pm.headers.indexOf('상품명');
  const idxSpec = pm.headers.indexOf('규격');
  const idxSplit = pm.headers.indexOf('소분');
  const rows = pm.rows.filter(r=>{
    const spec = idxSpec!==-1 ? String(r[idxSpec]||'') : '';
    if((idxSplit!==-1 && String(r[idxSplit]||'').trim()==='Y') || spec.includes('소분')) return false; // 소분 품목은 검색에서 아예 빠져요.
    const hay = [idxCode,idxMaker,idxName,idxSpec].map(i => i!==-1 ? String(r[i]||'') : '').join(' '); // 제품코드/제품명/제약사/규격으로 찾아요.
    return terms.every(t => hay.includes(t));
  }).slice(0, 50); // 드롭다운은 한 화면에 다 안 보이니 50개까지만.
  dropdown.innerHTML = rows.map(r=>{
    const code = idxCode!==-1 ? String(r[idxCode]||'') : '';
    const maker = idxMaker!==-1 ? String(r[idxMaker]||'') : '';
    const name = idxName!==-1 ? String(r[idxName]||'') : '';
    const spec = idxSpec!==-1 ? String(r[idxSpec]||'') : '';
    return `<div class="mi-search-row" data-code="${escapeAttr(code)}" style="padding:8px 12px; cursor:pointer; border-bottom:1px solid var(--line-strong); font-size:13px;">
      <b>${escapeHtml(name)}</b> <span style="color:var(--ink-dim);">${escapeHtml(spec)}</span><br>
      <span style="font-size:11.5px; color:var(--ink-dim);">${escapeHtml(code)} · ${escapeHtml(maker)}</span>
    </div>`;
  }).join('') || '<div style="padding:10px 12px; color:var(--ink-dim); font-size:13px;">검색 결과가 없어요.</div>';
  dropdown.style.display = 'block';
  dropdown.querySelectorAll('.mi-search-row').forEach(row=>{
    // click보다 먼저 발생하는 mousedown에서 선택 처리 — input의 blur로 드롭다운이 먼저 닫혀서 click이 안 먹는 걸 방지해요.
    row.addEventListener('mousedown', (e)=>{
      e.preventDefault();
      const prod = miLookupProductByCode(row.dataset.code);
      miApplyLookupResult(prod);
      document.getElementById('miSearchInput').value = prod ? `${prod.name} ${prod.spec}` : '';
      dropdown.style.display = 'none';
      dropdown.innerHTML = '';
    });
  });
}

// 매입전표(건별/전체/제약사사이트)에서 "최종 제품목록"이 새로 만들어진 직후에만 호출해요
// (computeXResults()의 맨 끝에서만 부르고, 계산기 값 조정 등으로 finalizeXMode()가 다시 불릴 때는
// 안 걸리게, finalize가 아니라 compute 쪽에 걸어뒀어요 — 25항 "중복 실행 방지"에 해당).
//
// 주의: finalRows의 productCode는 buildProductBarcodeMap()을 거쳐서 나온 값이라, 소분='Y'·구매금지일·
// 생산중지일이 있는 품목은 매입전표 매칭에서 일부러 제외돼 있어(productCode가 빈 값) 여기로 넘어와요.
// 수급불안정품목은 오히려 그런 품목(구매금지·생산중지 등)일 가능성이 높아서, productCode만 보면 관리품목이
// 있어도 팝업이 안 뜨는 문제가 있었어요. buildProductBarcodeMap({includeExcluded:true})로 제외 없는
// 인덱스를 다시 만들어서(지수표기 코드 보정 등 실제 매칭 로직 그대로) 바코드로 코드를 보충합니다.
let miMatchModalIds = [];
function checkManagedItemsForFinalRows(finalRows){
  if(!miSelectedEmployee) return; // 직원을 아직 선택 안 했으면 소속지점을 몰라서 판단할 수 없어요 — 조용히 넘어감
  const myBranch = MI_EMPLOYEE_BRANCH[miSelectedEmployee];
  if(!myBranch) return;
  const rawIndex = buildProductBarcodeMap({includeExcluded:true});
  const codes = new Set();
  (finalRows || []).forEach(r=>{
    let code = String(r.productCode||'').trim();
    if(!code && r.barcode){
      const info = lookupProductByBarcode(String(r.barcode).trim(), rawIndex, r.productName);
      if(info) code = String(info.code||'').trim();
    }
    if(code) codes.add(code);
  });
  if(!codes.size) return;
  const matches = managedItems.filter(it => codes.has(it.code) && (it.branch === myBranch || it.branch === '전체'));
  if(!matches.length) return;
  showManagedItemsMatchPopup(matches);
}

function renderMiMatchModalBody(){
  const body = document.getElementById('miMatchModalBody');
  const ids = new Set(miMatchModalIds);
  const matches = managedItems.filter(it => ids.has(it.id));
  if(!matches.length){
    document.getElementById('miMatchModalOverlay').style.display = 'none';
    return;
  }
  const sales = matches.filter(it=>it.type==='sales');
  const supply = matches.filter(it=>it.type==='supply');
  const renderGroup = (title, items, startNum, showDelete) => items.map((it,i)=>`
    <div style="border:1px solid var(--line-strong); border-radius:8px; padding:10px 12px; margin-bottom:8px;">
      <div style="font-weight:700; font-size:12.5px; color:var(--teal-ink); margin-bottom:4px;">${startNum+i} ${title}</div>
      <div style="font-size:13px;">${escapeHtml(it.branch)} · ${escapeHtml(it.code)} · ${escapeHtml(it.name)} ${escapeHtml(it.spec)}</div>
      <div style="font-size:12.5px; color:var(--ink-dim); margin:2px 0 6px;">${(it.qty===null||it.qty===undefined||it.qty==='') ? '수량 해당없음' : '수량 '+Number(it.qty).toLocaleString()} · 비고: ${escapeHtml(it.note||'-')}</div>
      ${showDelete
        ? `<button class="btn danger" data-mi-match-del="${it.id}" style="padding:3px 10px; font-size:11.5px;">삭제</button>`
        : `<span style="font-size:11.5px; color:var(--ink-dim);">삭제는 관리품목등록 &gt; 수급불안정품목 탭에서 해주세요.</span>`}
    </div>`).join('');
  body.innerHTML = renderGroup('영업사원요청품목', sales, 1, true) + renderGroup('수급불안정품목', supply, sales.length+1, false);
  body.querySelectorAll('[data-mi-match-del]').forEach(btn=>{
    btn.addEventListener('click', async ()=>{
      if(!confirm('이 관리품목을 삭제할까요?')) return;
      const id = btn.dataset.miMatchDel;
      managedItems = managedItems.filter(it => it.id !== id);
      miMatchModalIds = miMatchModalIds.filter(x => x !== id);
      await saveManagedItems();
      renderMiList(); // 관리품목등록 탭이 열려있으면 그쪽 목록도 같이 갱신
      renderMiMatchModalBody(); // 팝업에서도 즉시 제거(24항: 삭제 후 다시 안 나타나야 함)
    });
  });
}

function showManagedItemsMatchPopup(matches){
  miMatchModalIds = matches.map(it => it.id);
  renderMiMatchModalBody();
  document.getElementById('miMatchModalOverlay').style.display = 'flex';
}

// ---------- 관리품목등록: 메신저 쪽지 이미지 OCR ----------
// 정해진 양식(지점|코드|제품명|규격|수량|비고)을 요구하지 않아요. 줄에 있는 숫자들 중 실제
// 다미스제품코드마스터DB에 존재하는 코드를 찾아 제품코드로 확정하고(이 DB에 없는 숫자는 코드로 안 봐요 —
// 오탐 방지), 개/박스/EA/정처럼 단위가 붙은 숫자나 코드가 아닌 남은 숫자를 수량으로 판별해요.
// 제품명/규격은 OCR을 신뢰하지 않고 항상 인식된 제품코드로 다미스제품코드마스터DB를 다시 조회해서 채워요.
const MI_BRANCH_ALIASES = {
  '광주':'광주', '광주점':'광주', '광주지점':'광주',
  '의정부':'의정부', '의정부점':'의정부', '의정부지점':'의정부',
  '전체':'전체', '전사':'전체', '전지점':'전체'
};
function miStandardizeBranch(raw){
  const t = String(raw||'').trim();
  if(MI_BRANCH_ALIASES[t]) return MI_BRANCH_ALIASES[t];
  for(const [k,v] of Object.entries(MI_BRANCH_ALIASES)){
    if(t.includes(k)) return v;
  }
  return null; // 확실하게 판단 안 되면 null — 사용자가 확인 화면에서 직접 고르게 해요.
}

let miOcrItems = []; // OCR 확인 화면에 떠 있는 후보 항목들
const MI_QTY_UNIT_RE = /(\d[\d,]*)\s*(개|박스|box|BOX|Box|EA|ea|Ea|정|병|바이알|팩|세트|건)/;

// 쪽지 텍스트 한 줄을 관리품목 후보 하나로 분해해요. 특정 구분자나 순서를 요구하지 않고, 줄 안의 숫자들을
// 훑어서 실제 존재하는 제품코드와 수량을 스스로 판별해요.
function miParseOcrText(text){
  const lines = String(text||'').split(/\r?\n/).map(l=>l.trim()).filter(Boolean);
  const items = [];
  let pendingContext = ''; // 제품코드가 없는 줄("김안과 요청건", "○○약국분" 등)은 버리지 않고, 다음 제품 줄의 비고로 이어붙여요.
  lines.forEach(line=>{
    // 이 줄에 있는 모든 숫자 덩어리(콤마 포함)를 후보로 놓아요.
    const numTokens = [...line.matchAll(/\d[\d,]*/g)].map(m => m[0].replace(/,/g,''));

    // 제품코드 확정: 실제 다미스제품코드마스터DB에 있는 코드와 일치하는 숫자만 인정해요(가장 확실한 판단 기준 —
    // 정해진 자리 수나 위치를 가정하지 않아도, DB에 없는 숫자는 애초에 코드가 될 수 없으니까요).
    let code = '', prod = null;
    for(const tok of numTokens){
      const found = miLookupProductByCode(tok);
      if(found){ code = tok; prod = found; break; }
    }
    if(!code){
      // 제품코드가 안 잡히는 줄은 "김안과 요청건"처럼 맥락을 설명하는 줄일 수 있어요 — 버리지 않고
      // 모아뒀다가 다음에 나오는 제품 줄의 비고 앞에 붙여줘요.
      pendingContext = pendingContext ? `${pendingContext} ${line}` : line;
      return;
    }

    // 수량 판별: "20개"/"3박스"처럼 단위가 붙은 숫자를 최우선으로 하고, 없으면 코드·제품명·규격에
    // 이미 쓰인 숫자(예: "90T"의 90)를 제외한 첫 번째 숫자를 수량으로 봐요.
    let qty = null;
    const unitMatch = line.match(MI_QTY_UNIT_RE);
    if(unitMatch && unitMatch[1].replace(/,/g,'') !== code){
      qty = Number(unitMatch[1].replace(/,/g,''));
    } else {
      const specNameNums = new Set([
        ...(prod && prod.spec ? String(prod.spec).match(/\d+/g) || [] : []),
        ...(prod && prod.name ? String(prod.name).match(/\d+/g) || [] : [])
      ]);
      const qtyTok = numTokens.find(t => t !== code && !specNameNums.has(t)) || numTokens.find(t => t !== code);
      if(qtyTok) qty = Number(qtyTok);
    }

    // 지점: 줄 어디에 있든 "광주"/"의정부" 같은 지점 단어가 보이면 그걸 우선 써요. 그런 단어가 없으면,
    // 보낸사람 이름(구매부 직원)이 줄이나 바로 위 맥락에 있는지 보고 그 사람 소속 지점으로 대신 판단해요
    // (예: "최형욱"이 보이면 광주, "서호진"이 보이면 의정부).
    let branch = miStandardizeBranch(line);
    if(!branch){
      const senderText = line + ' ' + pendingContext;
      for(const [empName, empBranch] of Object.entries(MI_EMPLOYEE_BRANCH)){
        if(senderText.includes(empName)){ branch = empBranch; break; }
      }
    }

    // 비고: 코드·수량으로 이미 쓰인 부분을 뺀 나머지 텍스트 + 앞서 모아둔 맥락 설명을 합쳐서 남겨요.
    let note = line.replace(code, '');
    if(unitMatch) note = note.replace(unitMatch[0], '');
    note = note.replace(/[|｜]/g, ' ').replace(/\s{2,}/g, ' ').trim();
    if(pendingContext){ note = note ? `${pendingContext} ${note}` : pendingContext; pendingContext = ''; }

    items.push({
      branch: branch || '', code,
      name: prod ? prod.name : '', spec: prod ? prod.spec : '',
      qty: qty || '', note,
      uncertain: { branch: !branch, code: false, qty: !qty || qty<=0, note: !note }
    });
  });
  return items;
}

async function miProcessOcrImage(file){
  if(!file) return;
  const statusEl = document.getElementById('miOcrStatus');
  if(typeof Tesseract === 'undefined'){
    statusEl.textContent = '⚠ OCR 라이브러리를 불러오지 못했어요. 인터넷 연결을 확인하고 다시 시도해주세요.';
    return;
  }
  statusEl.textContent = '🔎 OCR 처리 중이에요... (이미지에 따라 몇 초~수십 초 걸릴 수 있어요)';
  try{
    const { data } = await Tesseract.recognize(file, 'kor+eng');
    const items = miParseOcrText(data.text);
    if(!items.length){
      statusEl.textContent = '⚠ 이미지에서 다미스제품코드마스터DB에 있는 제품코드를 찾지 못했어요. 이미지를 다시 확인해주세요.';
      return;
    }
    statusEl.textContent = `${items.length}건 인식됨 — 확인 화면에서 등록 전에 검토해주세요.`;
    miShowOcrConfirmModal(items);
  }catch(e){
    console.error('OCR 처리 실패:', e);
    statusEl.textContent = '⚠ OCR 처리 중 오류가 발생했어요. 이미지를 바꿔서 다시 시도해주세요.';
  }
}

function miShowOcrConfirmModal(items){
  miOcrItems = items;
  renderMiOcrConfirmBody();
  document.getElementById('miOcrConfirmModalOverlay').style.display = 'flex';
}

function renderMiOcrConfirmBody(){
  const body = document.getElementById('miOcrConfirmBody');
  const warnStyle = (flag) => flag ? ' style="border:2px solid var(--red);"' : '';
  const qtyRequired = miQtyRequired(miCurrentType());
  body.innerHTML = miOcrItems.map((it,i)=>`
    <tr data-mi-ocr-row="${i}">
      <td>
        <select data-mi-ocr-field="branch"${warnStyle(it.uncertain.branch)}>
          <option value="" ${!it.branch?'selected':''}>${it.uncertain.branch?'⚠️ 확인필요':'선택'}</option>
          <option value="광주" ${it.branch==='광주'?'selected':''}>광주</option>
          <option value="의정부" ${it.branch==='의정부'?'selected':''}>의정부</option>
          <option value="전체" ${it.branch==='전체'?'selected':''}>전체</option>
        </select>
      </td>
      <td><input type="text" data-mi-ocr-field="code" value="${escapeAttr(it.code)}"${warnStyle(it.uncertain.code)} style="width:90px;"></td>
      <td>${it.name ? escapeHtml(it.name) : '<span style="color:var(--ink-dim);">-</span>'}</td>
      <td>${it.spec ? escapeHtml(it.spec) : '<span style="color:var(--ink-dim);">-</span>'}</td>
      <td>${qtyRequired ? `<input type="number" min="1" data-mi-ocr-field="qty" value="${it.qty||''}"${warnStyle(it.uncertain.qty)} style="width:70px;">` : '<span style="color:var(--ink-dim);">해당없음</span>'}</td>
      <td><input type="text" data-mi-ocr-field="note" value="${escapeAttr(it.note)}"${warnStyle(it.uncertain.note)} style="width:140px;"></td>
      <td><button class="btn danger" data-mi-ocr-remove="${i}" style="padding:3px 8px; font-size:11.5px;">제외</button></td>
    </tr>`).join('') || '<tr><td colspan="7" style="text-align:center; color:var(--ink-dim);">인식된 항목이 없어요.</td></tr>';

  body.querySelectorAll('[data-mi-ocr-field="code"]').forEach(input=>{
    input.addEventListener('blur', ()=>{
      const i = Number(input.closest('tr').dataset.miOcrRow);
      const code = input.value.trim();
      const prod = miLookupProductByCode(code);
      miOcrItems[i].code = code;
      miOcrItems[i].uncertain.code = !prod;
      miOcrItems[i].name = prod ? prod.name : '';
      miOcrItems[i].spec = prod ? prod.spec : '';
      renderMiOcrConfirmBody(); // 제품명·규격을 새로 반영하려고 다시 그려요.
    });
  });
  body.querySelectorAll('[data-mi-ocr-field="branch"]').forEach(sel=>{
    sel.addEventListener('change', ()=>{
      const i = Number(sel.closest('tr').dataset.miOcrRow);
      miOcrItems[i].branch = sel.value;
      miOcrItems[i].uncertain.branch = !sel.value;
    });
  });
  body.querySelectorAll('[data-mi-ocr-field="qty"]').forEach(input=>{
    input.addEventListener('input', ()=>{
      const i = Number(input.closest('tr').dataset.miOcrRow);
      const qty = Number(input.value);
      miOcrItems[i].qty = qty;
      miOcrItems[i].uncertain.qty = !qty || qty<=0;
    });
  });
  body.querySelectorAll('[data-mi-ocr-field="note"]').forEach(input=>{
    input.addEventListener('input', ()=>{
      const i = Number(input.closest('tr').dataset.miOcrRow);
      miOcrItems[i].note = input.value;
    });
  });
  body.querySelectorAll('[data-mi-ocr-remove]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      miOcrItems.splice(Number(btn.dataset.miOcrRemove), 1);
      renderMiOcrConfirmBody();
    });
  });
}

function miApplyEmployeeBranchDefault(){
  // 구매부 직원을 고르면, 지점을 따로 안 만져도 그 사람이 근무하는 지점이 기본으로 선택되게 해요.
  const branch = MI_EMPLOYEE_BRANCH[miSelectedEmployee];
  if(branch) document.getElementById('miBranchInput').value = branch;
}

async function initManagedItemsTab(){
  renderMiEmployeeSelect(); // 저장된 선택을 불러오기 전에 옵션부터 먼저 채워서, 네트워크가 느려도 드롭다운이 비어 보이지 않게 해요.
  await Promise.all([loadManagedItems(), loadMiEmployee()]);
  renderMiEmployeeSelect(); // 저장돼 있던 직원 선택을 반영해서 다시 그려요.
  miApplyEmployeeBranchDefault(); // 이전에 선택해둔 직원이 있으면 화면 진입 시에도 지점을 맞춰줘요.
  renderMiList();

  document.getElementById('miEmployeeSelect').addEventListener('change', async (e)=>{
    miSelectedEmployee = e.target.value;
    await saveMiEmployee();
    renderMiEmployeeSelect();
    miApplyEmployeeBranchDefault();
  });

  function miUpdateOcrSectionVisibility(){
    // 요구사양: 메신저 쪽지 OCR은 영업사원요청품목 탭에서만 제공하고, 수급불안정품목 탭에는 넣지 않아요.
    document.getElementById('miOcrSection').style.display = (miCurrentType() === 'sales') ? '' : 'none';
  }
  document.querySelectorAll('input[name="miType"]').forEach(r=>{
    r.addEventListener('change', ()=>{ miEditingId = null; renderMiList(); miUpdateQtyFieldVisibility(); miUpdateOcrSectionVisibility(); });
  });
  miUpdateQtyFieldVisibility(); // 처음 화면 열릴 때도 현재 선택된 탭 기준으로 한 번 맞춰줘요.
  miUpdateOcrSectionVisibility();

  // 제품코드는 이제 직접 타이핑할 수 없고, 🔍 제품조회로 선택한 값만 보여져요.
  const searchInput = document.getElementById('miSearchInput');
  searchInput.addEventListener('input', ()=>{ renderMiSearchDropdown(searchInput.value); });
  searchInput.addEventListener('focus', ()=>{ if(searchInput.value.trim()) renderMiSearchDropdown(searchInput.value); });
  searchInput.addEventListener('keydown', (e)=>{
    if(e.key !== 'Enter') return;
    // 제품코드를 정확히 입력했으면(코드 검색도 포함이니까) Enter로 바로 확정할 수 있게 해요.
    const prod = miLookupProductByCode(searchInput.value.trim());
    if(prod){
      e.preventDefault();
      miApplyLookupResult(prod);
      searchInput.value = `${prod.name} ${prod.spec}`;
      document.getElementById('miSearchDropdown').style.display = 'none';
    }
  });
  searchInput.addEventListener('blur', ()=>{
    // 드롭다운 항목 클릭은 mousedown에서 먼저 처리되니, blur로 살짝 늦게 닫아도 선택엔 지장 없어요.
    setTimeout(()=>{ document.getElementById('miSearchDropdown').style.display = 'none'; }, 150);
  });
  document.getElementById('miMatchModalCloseBtn').addEventListener('click', ()=>{
    document.getElementById('miMatchModalOverlay').style.display = 'none';
  });

  // 메신저 쪽지 OCR: Ctrl+V 붙여넣기, 파일 선택 둘 다 같은 처리 함수(miProcessOcrImage)로 모아요(PC 웹 브라우저 전용 — 모바일 카메라 촬영은 지원하지 않아요).
  // 일반 div는 브라우저에 따라 paste 이벤트가 안정적으로 안 붙을 수 있어서, 투명한 textarea를 붙여넣기 영역
  // 전체에 깔아두고 거기서 캡처해요(클릭하면 자연스럽게 그 textarea가 포커스를 받아요).
  const pasteCapture = document.getElementById('miOcrPasteCapture');
  pasteCapture.addEventListener('paste', (e)=>{
    const items = e.clipboardData && e.clipboardData.items;
    if(!items) return;
    for(const it of items){
      if(it.type && it.type.startsWith('image/')){
        miProcessOcrImage(it.getAsFile());
        e.preventDefault();
        break;
      }
    }
    pasteCapture.value = '';
  });
  document.getElementById('miOcrFileInput').addEventListener('change', (e)=>{
    const file = e.target.files[0];
    if(file) miProcessOcrImage(file);
    e.target.value = '';
  });
  document.getElementById('miOcrConfirmCloseBtn').addEventListener('click', ()=>{
    document.getElementById('miOcrConfirmModalOverlay').style.display = 'none';
  });
  document.getElementById('miOcrConfirmRegisterBtn').addEventListener('click', async ()=>{
    const msgEl = document.getElementById('miOcrConfirmMsg');
    msgEl.textContent = '';
    if(!miSelectedEmployee){ msgEl.textContent = '⚠ 먼저 구매부 직원 이름을 선택해주세요.'; return; }
    const type = miCurrentType(); // 13항: 현재 탭 기준으로 종류 결정
    const qtyRequired = miQtyRequired(type);
    let registered = 0, skipped = 0;
    miOcrItems.forEach(it=>{
      const prod = miLookupProductByCode(it.code);
      if(!prod || !it.branch || (qtyRequired && (!it.qty || it.qty <= 0))){ skipped++; return; }
      managedItems.push({
        id: 'mi_' + Date.now() + '_' + Math.random().toString(36).slice(2,8),
        type, branch: it.branch, code: prod.code, maker: prod.maker, name: prod.name, spec: prod.spec,
        qty: qtyRequired ? it.qty : null, note: it.note || '',
        registeredBy: miSelectedEmployee, registeredAt: new Date().toISOString()
      });
      registered++;
    });
    if(!registered){ msgEl.textContent = '⚠ 등록 가능한 항목이 없어요 — 지점·제품코드' + (qtyRequired ? '·수량' : '') + '을 확인해주세요.'; return; }
    await saveManagedItems();
    renderMiList();
    document.getElementById('miOcrConfirmModalOverlay').style.display = 'none';
    document.getElementById('miOcrStatus').textContent = `✅ ${registered}건 등록 완료${skipped ? ` (⚠ ${skipped}건은 지점/제품코드/수량 확인이 안 돼서 제외됨)` : ''}`;
  });

  document.getElementById('miRegisterBtn').addEventListener('click', async ()=>{
    const msgEl = document.getElementById('miFormMsg');
    msgEl.textContent = '';
    if(!miSelectedEmployee){ msgEl.textContent = '⚠ 먼저 구매부 직원 이름을 선택해주세요.'; return; }
    const branch = document.getElementById('miBranchInput').value;
    const prod = miLookupSelected;
    if(!prod){ msgEl.textContent = '⚠ 🔍 제품조회로 제품을 검색해서 선택해주세요.'; return; }
    const type = miCurrentType();
    let qty = null;
    if(miQtyRequired(type)){
      qty = Number(document.getElementById('miQtyInput').value);
      if(!qty || qty <= 0){ msgEl.textContent = '⚠ 수량은 0보다 큰 숫자로 입력해주세요.'; return; }
    }
    const note = document.getElementById('miNoteInput').value;

    managedItems.push({
      id: 'mi_' + Date.now() + '_' + Math.random().toString(36).slice(2,8),
      type,
      branch, code: prod.code, maker: prod.maker, name: prod.name, spec: prod.spec,
      qty, note,
      registeredBy: miSelectedEmployee,
      registeredAt: new Date().toISOString()
    });
    await saveManagedItems();
    renderMiList();

    // 폼 리셋(지점·탭 선택은 편의상 유지, 나머지만 비움)
    document.getElementById('miSearchInput').value = '';
    document.getElementById('miQtyInput').value = '';
    document.getElementById('miNoteInput').value = '';
    miApplyLookupResult(null);
  });
}
initAppTheme();
init();
initUploadTabs().then(async ()=>{
  await Promise.all([loadPriceHistoryLog(), loadStockHistory(), loadMonthlyStockArchive()]);
  // 예전에 다른 계산식(÷1000 포함)으로 저장된 월별 스냅샷이 남아있을 수 있어, 보관된 창고 원본으로
  // 모든 달을 지금 계산식으로 다시 돌려 정확한 원 단위로 맞춥니다.
  rebuildStockHistoryFromArchive();
  // 로딩 순서와 무관하게, 모든 업로드가 로드된 뒤 한 번 더 확실히 재계산합니다.
  rebuildStockData();
  renderStockQuerySelectors();
  buildStockFilterOptions();
  renderStockTable();
  renderStockKpis();
  await initReturnCycleTracker();
  renderStockHistoryYearFilter();
  renderStockChart();
  renderStockHistoryDamageYearFilter();
  renderStockDamageChart();
  renderStockDamageByManagerChart();
  bindDamageView();
  bindDamageManagerModal();
  renderDamageViewMonthSelector();
  renderDamageView();


  document.querySelectorAll('input[name="payinputMode"]').forEach(r=>{
    r.addEventListener('change', ()=>{
      const mode = (document.querySelector('input[name="payinputMode"]:checked')||{}).value || 'supply';
      document.getElementById('panel-supply').style.display = mode==='supply' ? 'block' : 'none';
      document.getElementById('panel-inbound').style.display = mode==='inbound' ? 'block' : 'none';
      document.getElementById('panel-pharmreg').style.display = mode==='pharmreg' ? 'block' : 'none';
    });
  });
  // Promise.all이었을 때는 이 중 하나라도 실패하면(모바일에서 네트워크가 불안정할 때 자주 발생)
  // 아래 initManagedItemsTab() 등 나머지 탭 초기화가 통째로 실행되지 않는 문제가 있었어요.
  // allSettled로 바꿔서 하나가 실패해도 나머지 탭은 정상적으로 켜지게 해요.
  const tabInitResults = await Promise.allSettled([initSupplyTab(), initInboundTab(), initPlookupTab(), initPharmregTab()]);
  tabInitResults.forEach(r => { if(r.status === 'rejected') console.error('탭 초기화 실패:', r.reason); });
  try{ initManagedItemsTab(); }catch(e){ console.error('관리품목등록 탭 초기화 실패:', e); }
  initProductInfoTab();
  initProductSearch2Tab();
  initPriceHistoryTab();
  initChecklistTab();
  initBaljuFormTab();
  renderSummaryDashboard();
});
document.getElementById('stockHistoryYearFilter').addEventListener('change', renderStockChart);
document.getElementById('stockDamageYearFilter').addEventListener('change', renderStockDamageChart);
document.getElementById('stockQueryYear').addEventListener('change', ()=>{
  // 연도를 바꾸면 해당 연도에서 고를 수 있는 월로 다시 채우고(가장 최근 달을 기본 선택), 바로 반영합니다.
  document.getElementById('stockQueryMonth').value = '';
  renderStockQuerySelectors();
  applyStockQuerySelection();
});
document.getElementById('stockQueryMonth').addEventListener('change', applyStockQuerySelection);

document.getElementById('search-stock').addEventListener('input', renderStockTable);
document.getElementById('returnMgrFilter-stock').addEventListener('change', renderStockTable);
document.getElementById('orderMgrFilter-stock').addEventListener('change', renderStockTable);

</script>
<script>
(function(){
const SEAL_IMG_SRC = "data:image/png;base64,";

/* ============================================================
   상태 & 저장
   ============================================================ */
const STORAGE_KEY = 'dongwon_return_dashboard_v3';
/* 페이지 구성: 1페이지만 상단 제목/수신·발신처 정보가 들어가고, 2페이지부터는 표만 이어서 출력됩니다.
   각 상수는 "표 데이터 행이 몇 줄까지 그 페이지에 들어갈 수 있는가"를 나타냅니다. */

let state = {
  rawRows: [],
  headers: [],
  items: [],
  sumQty: 0,
  meta: {
    sender: { org:'동원헬스케어', person:'최형욱 차장', tel:'02-440-1811', fax:'031-768-7027', addr:'경기도 광주시 초월읍 경충대로 1331-11 동원헬스케어 경기도광주 물류센터' },
    recv: { org:'', personSuffix:' 반품담당자님', tel:'02-3489-6281', fax:'02-3489-6106', orgManual:'' },
    footerMsg: '상기제품을 반품 요청하오니 확인 후 회신 부탁드립니다.',
    title: '㈜동원헬스케어 반품요청서',
    date: new Date().toISOString().slice(0,10)
  }
};
let activeView = 'main';
let uploadedAt = null;

function updateUploadedLabel(){
  const el = document.getElementById('lastSavedInfo');
  if(!el) return;
  el.textContent = uploadedAt ? ('업로드: ' + uploadedAt.toLocaleString('ko-KR')) : '아직 업로드된 파일 없음';
}

function saveState(){
  try{
    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
  }catch(e){ /* 반품신청서는 저장 실패해도 화면에는 업로드 시각만 표기하므로 별도 안내하지 않음 */ }
}
function loadState(){
  try{
    const raw = localStorage.getItem(STORAGE_KEY);
    if(raw){
      const parsed = JSON.parse(raw);
      state = Object.assign(state, parsed);
      state.meta = Object.assign({}, state.meta, parsed.meta);
    }
  }catch(e){ /* ignore */ }
}

/* ============================================================
   헤더 정규화 / 필수 컬럼
   ============================================================ */
const REQUIRED = ['코드','상품명','규격','수량','제조번호','사용기한','표준코드','우선처'];
function normalizeKey(k){ return String(k||'').replace(/\s+/g,'').trim(); }

/* ============================================================
   파일 업로드 처리
   ============================================================ */
const fileInput = document.getElementById('fileInput');
const dropZone = document.getElementById('dropZone');
const uploadStatus = document.getElementById('uploadStatus');

dropZone.addEventListener('dragover', (e)=>{ e.preventDefault(); dropZone.classList.add('dragover'); });
dropZone.addEventListener('dragleave', ()=> dropZone.classList.remove('dragover'));
dropZone.addEventListener('drop', (e)=>{
  e.preventDefault(); dropZone.classList.remove('dragover');
  if(e.dataTransfer.files.length) handleReturnFormFile(e.dataTransfer.files[0]);
});
fileInput.addEventListener('change', (e)=>{ if(e.target.files.length) handleReturnFormFile(e.target.files[0]); });

const returnFormPasteApplyBtn = document.getElementById('returnFormPasteApply');
if(returnFormPasteApplyBtn){
  returnFormPasteApplyBtn.addEventListener('click', ()=>{
    const text = document.getElementById('returnFormPasteText').value;
    if(!text.trim()){ alert('붙여넣을 데이터가 없어요.'); return; }
    handleReturnFormPaste(text);
  });
}

function handleReturnFormFile(file){
  uploadStatus.className = 'status-line';
  uploadStatus.textContent = '읽는 중...';
  const reader = new FileReader();
  reader.onload = function(e){
    try{
      const data = new Uint8Array(e.target.result);
      const wb = XLSX.read(data, {type:'array'});
      const ws = wb.Sheets[wb.SheetNames[0]];
      const aoa = XLSX.utils.sheet_to_json(ws, {header:1, raw:true, defval:''});
      processReturnFormAoa(aoa);
    }catch(err){
      uploadStatus.className = 'status-line error';
      uploadStatus.textContent = '오류: ' + err.message;
    }
  };
  reader.readAsArrayBuffer(file);
}

// 파일이든 붙여넣기든, 2차원 배열(aoa)만 준비되면 이 처리는 똑같이 거칩니다.
// 반품_담당자_정보.xlsx 기준: 반품담당자별 발신인·TEL·FAX (발신처는 항상 '동원헬스케어'로 고정)
const RETURN_SENDER_MAP = {
  '이상연': { person:'이상연 상무', tel:'02-440-1810', fax:'031-768-7027' },
  '최형욱': { person:'최형욱 차장', tel:'02-440-1811', fax:'031-768-7027' },
  '김은경': { person:'김은경 과장', tel:'02-440-1813', fax:'031-768-7027' },
  '전송이': { person:'전송이 사원', tel:'02-440-1812', fax:'031-768-7027' },
  '예상화': { person:'예상화 사원', tel:'02-440-1814', fax:'031-768-7027' },
};

// 거래처정보마스터DB에서 해당 거래처(수신처)의 반품담당자를 찾습니다.
function findReturnManagerForClient(clientName){
  const vm = uploadState['vendorMaster'];
  if(!vm || !clientName) return '';
  const headers = vm.headers;
  const idxName = findHeaderIndex(headers, '매입처명', '거래처명', '거래처');
  const idxReturnMgr = headers.indexOf('반품담당자');
  if(idxName === -1 || idxReturnMgr === -1) return '';
  const row = vm.rows.find(r => String(r[idxName]||'').trim() === String(clientName).trim());
  return row ? String(row[idxReturnMgr]||'').trim() : '';
}

// 수신처(거래처)가 바뀌면, 그 거래처의 반품담당자를 찾아서 발신인·TEL·FAX를 자동으로 맞춰줍니다.
function updateSenderFromClient(clientName){
  const mgr = findReturnManagerForClient(clientName);
  const info = RETURN_SENDER_MAP[mgr];
  if(!info) return;
  state.meta.sender.org = state.meta.sender.org || '동원헬스케어';
  state.meta.sender.person = info.person;
  state.meta.sender.tel = info.tel;
  state.meta.sender.fax = info.fax;
}

function processReturnFormAoa(aoa){
  if(!aoa.length){ throw new Error('시트에 데이터가 없습니다.'); }

  let headerRowIdx = 0;
  for(let i=0;i<Math.min(5,aoa.length);i++){
    const norm = aoa[i].map(normalizeKey);
    const hits = REQUIRED.filter(r => norm.includes(r)).length;
    if(hits >= 4){ headerRowIdx = i; break; }
  }
  const headerRow = aoa[headerRowIdx].map(normalizeKey);
  const missing = REQUIRED.filter(r => !headerRow.includes(r));
  if(missing.length){ throw new Error('필수 컬럼을 찾을 수 없습니다: ' + missing.join(', ')); }

  const rows = [];
  for(let i=headerRowIdx+1;i<aoa.length;i++){
    const arr = aoa[i];
    if(!arr || arr.every(v => v === '' || v === null || v === undefined)) continue;
    const obj = {};
    headerRow.forEach((h,idx) => { if(h) obj[h] = arr[idx] !== undefined ? arr[idx] : ''; });
    rows.push(obj);
  }

  state.rawRows = rows;
  state.headers = headerRow;
  const firstClient = rows.length ? String(rows[0]['우선처']||'').trim() : '';
  if(!state.meta.recv.orgManual){ state.meta.recv.org = firstClient; }
  updateSenderFromClient(firstClient);

  computeItems();
  saveState();
  renderAll();
  uploadedAt = new Date();
  updateUploadedLabel();
  uploadStatus.className = 'status-line good';
  uploadStatus.textContent = `업로드 완료 · ${rows.length}행 · 품목 ${state.items.length}건 정리됨 (수신처: ${firstClient})`;
}

function handleReturnFormPaste(text){
  uploadStatus.className = 'status-line';
  try{
    const lines = text.split(/\r\n|\r|\n/).map(l=>l.replace(/\r+$/,'')).filter(l=>l.length>0);
    const useTab = text.includes('\t');
    const aoa = lines.map(line => useTab ? line.split('\t').map(v=>v.trim()) : line.split(',').map(v=>v.trim()));
    processReturnFormAoa(aoa);
  }catch(err){
    uploadStatus.className = 'status-line error';
    uploadStatus.textContent = '오류: ' + err.message;
  }
}

/* ============================================================
   데이터시트 수식 로직 재현: 전체 자료를 하나로 합쳐 (코드+제조번호+사용기한) 중복 정리
   ============================================================ */
function computeItems(){
  const rows = state.rawRows.filter(r => String(r['코드']||'').trim());
  const seen = new Map();
  const items = [];
  rows.forEach(r => {
    const code = String(r['코드']||'').trim();
    const lot = String(r['제조번호']||'').trim();
    const exp = String(r['사용기한']||'').trim();
    const key = code+'|'+lot+'|'+exp;
    if(!seen.has(key)){
      seen.set(key, items.length);
      items.push({
        code:code, std:String(r['표준코드']||'').trim(), name:String(r['상품명']||'').trim(),
        spec:String(r['규격']||'').trim(), maker:String(r['제약사']||'').trim(), lot:lot, exp:exp, qty:0, note:''
      });
    }
  });
  items.forEach(it => {
    it.qty = rows.reduce((s,r)=>{
      const code = String(r['코드']||'').trim();
      const lot = String(r['제조번호']||'').trim();
      const exp = String(r['사용기한']||'').trim();
      return (code===it.code && lot===it.lot && exp===it.exp) ? s + (Number(r['수량'])||0) : s;
    },0);
  });
  // 붙여넣은 순서가 뒤죽박죽이어도, 항상 제약사 → 상품명 → 규격 순으로 정렬해서 예전처럼 가지런히 모아줍니다.
  items.sort((a,b)=>{
    return a.maker.localeCompare(b.maker, 'ko') || a.name.localeCompare(b.name, 'ko') || a.spec.localeCompare(b.spec, 'ko');
  });
  const firstIdx = new Map(); const codeTotal = new Map();
  items.forEach((it,i)=>{
    if(!firstIdx.has(it.code)) firstIdx.set(it.code, i);
    codeTotal.set(it.code, (codeTotal.get(it.code)||0) + it.qty);
  });
  items.forEach((it,i)=>{ it.totalForCode = (firstIdx.get(it.code) === i) ? codeTotal.get(it.code) : null; });

  state.items = items;
  state.sumQty = items.reduce((s,it)=>s+it.qty,0);
}

/* ============================================================
   렌더링 유틸 (화면 편집용)
   ============================================================ */
function el(tag, attrs, children){
  const e = document.createElement(tag);
  if(attrs) Object.entries(attrs).forEach(([k,v])=>{
    if(k==='class') e.className = v;
    else if(k.startsWith('on')) e.addEventListener(k.slice(2), v);
    else e.setAttribute(k,v);
  });
  (children||[]).forEach(c => e.appendChild(typeof c==='string'? document.createTextNode(c) : c));
  return e;
}
function fmtNum(n){ if(n===null||n===''||n===undefined) return ''; return Number(n).toLocaleString('ko-KR'); }

function renderSidebar(){
  document.querySelectorAll('#staticNav .nav-item').forEach(item=>{
    item.classList.toggle('active', item.dataset.view === activeView);
    item.onclick = () => { activeView = item.dataset.view; renderAll(); };
  });
}

function buildSheetDom(){
  const m = state.meta;
  const wrap = el('div', {class:'sheet-wrap'});

  const titleRow = el('div', {class:'sheet-title'});
  const titleInput = el('input', {value: m.title});
  titleInput.addEventListener('input', e=>{ m.title = e.target.value; saveState(); });
  titleRow.appendChild(titleInput);
  wrap.appendChild(titleRow);

  const headRow = el('div', {class:'head-row'});
  const dateLine = el('div', {class:'date-line'});
  dateLine.appendChild(document.createTextNode('반품요청일 : '));
  const dateInput = el('input', {type:'date', value: m.date});
  dateInput.addEventListener('input', e=>{ m.date = e.target.value; saveState(); });
  dateLine.appendChild(dateInput);
  headRow.appendChild(dateLine);
  wrap.appendChild(headRow);

  const cols = el('div', {class:'contact-cols'});

  const recvCol = el('div', {class:'contact-col'});
  const recvOrgRow = el('div', {class:'crow'});
  recvOrgRow.appendChild(el('label', {}, ['수신처']));
  recvOrgRow.appendChild(el('span', {}, [':']));
  const recvOrgInput = el('input', {value: m.recv.org});
  recvOrgInput.addEventListener('input', e=>{ m.recv.org = e.target.value; m.recv.orgManual = e.target.value; updateSenderFromClient(e.target.value); saveState(); renderAll(); });
  recvOrgRow.appendChild(recvOrgInput);
  recvCol.appendChild(recvOrgRow);

  const recvPersonRow = el('div', {class:'crow'});
  recvPersonRow.appendChild(el('label', {}, ['수신인']));
  recvPersonRow.appendChild(el('span', {}, [':']));
  const recvPersonInput = el('input', {value: m.recv.org + m.recv.personSuffix});
  recvPersonInput.addEventListener('input', e=>{
    const v = e.target.value;
    m.recv.personSuffix = v.startsWith(m.recv.org) ? v.slice(m.recv.org.length) : (' '+v);
    saveState();
  });
  recvPersonRow.appendChild(recvPersonInput);
  recvCol.appendChild(recvPersonRow);

  [['TEL','tel'],['FAX','fax']].forEach(([label,field])=>{
    const row = el('div', {class:'crow'});
    row.appendChild(el('label', {}, [label]));
    row.appendChild(el('span', {}, [':']));
    const inp = el('input', {value: m.recv[field] || ''});
    inp.addEventListener('input', e=>{ m.recv[field] = e.target.value; saveState(); });
    row.appendChild(inp);
    recvCol.appendChild(row);
  });
  cols.appendChild(recvCol);

  const sendCol = el('div', {class:'contact-col'});
  [['발신처','org'],['발신인','person'],['TEL','tel'],['FAX','fax'],['주소','addr']].forEach(([label,field])=>{
    const row = el('div', {class:'crow'});
    row.appendChild(el('label', {}, [label]));
    row.appendChild(el('span', {}, [':']));
    const inp = el('input', {value: m.sender[field]});
    inp.addEventListener('input', e=>{ m.sender[field] = e.target.value; saveState(); });
    row.appendChild(inp);
    sendCol.appendChild(row);
  });
  cols.appendChild(sendCol);
  wrap.appendChild(cols);

  const tableScroll = el('div', {class:'table-scroll'});
  const table = el('table', {class:'items'});
  const headers = ['다미스코드','표준코드','제 품 명','규 격','총수량','제조번호별\n수량','제조번호','유효기간','비고','삭제'];
  const thead = el('thead', {}, [ el('tr', {}, headers.map(h => el('th', {}, [h]))) ]);
  table.appendChild(thead);

  const tbody = el('tbody');
  state.items.forEach((it, idx) => {
    const tr = el('tr', {class: it.totalForCode!==null ? 'group-start':''});
    tr.appendChild(el('td', {}, [it.code]));
    tr.appendChild(el('td', {}, [it.std]));
    tr.appendChild(el('td', {class:'name'}, [it.name]));
    tr.appendChild(el('td', {}, [it.spec]));
    tr.appendChild(el('td', {class:'etotal'}, [it.totalForCode!==null ? fmtNum(it.totalForCode) : '']));
    tr.appendChild(el('td', {}, [fmtNum(it.qty)]));
    tr.appendChild(el('td', {}, [it.lot]));
    tr.appendChild(el('td', {}, [it.exp]));
    const noteTd = el('td');
    const noteInput = el('input', {value: it.note || ''});
    noteInput.addEventListener('input', e=>{ it.note = e.target.value; saveState(); });
    noteTd.appendChild(noteInput);
    tr.appendChild(noteTd);
    const delTd = el('td');
    const delBtn = el('button', {class:'row-del', onclick: ()=>{ state.items.splice(idx,1); saveState(); renderAll(); }}, ['삭제']);
    delTd.appendChild(delBtn);
    tr.appendChild(delTd);
    tbody.appendChild(tr);
  });

  const totalTr = el('tr', {class:'rt-total-row'});
  totalTr.appendChild(el('td', {colspan:'4'}, ['합계']));
  totalTr.appendChild(el('td', {}, [fmtNum(state.sumQty)]));
  totalTr.appendChild(el('td', {}, [fmtNum(state.sumQty)]));
  totalTr.appendChild(el('td', {colspan: '3'}, ['']));
  tbody.appendChild(totalTr);

  table.appendChild(tbody);
  tableScroll.appendChild(table);
  wrap.appendChild(tableScroll);

  const footer = el('div', {class:'sheet-footer'});
  const msgInput = el('input', {value: m.footerMsg});
  msgInput.addEventListener('input', e=>{ m.footerMsg = e.target.value; saveState(); });
  footer.appendChild(msgInput);
  footer.appendChild(el('div', {class:'addr'}, [`※ 발송처 : ${m.sender.addr} (인쇄물 맨 아래에 표시돼요 · 수정은 위 발신처 항목의 '주소'에서)`]));
  wrap.appendChild(footer);

  const sealPreview = el('div', {class:'seal-preview'});
  const sealImg = el('img', {src: SEAL_IMG_SRC, alt:'상호인'});
  sealPreview.appendChild(sealImg);
  wrap.appendChild(sealPreview);
  wrap.appendChild(el('div', {class:'seal-preview-note'}, ['인쇄/PDF 저장 시 이 직인 이미지가 마지막 페이지에 그대로 포함됩니다.']));

  return wrap;
}

function renderFormView(){
  const root = document.getElementById('formSection');
  root.innerHTML = '';
  if(!state.items.length){
    return;
  }
  const topbar = el('div', {class:'topbar', style:'margin-top:28px;'}, [
    el('div', {}, [
      el('h2', {}, ['반품요청서'])
    ])
  ]);
  root.appendChild(topbar);

  const toolbar = el('div', {class:'form-toolbar', style:'flex-direction:column;align-items:stretch;gap:10px;'}, [
    el('div', {style:'display:flex;flex-wrap:wrap;align-items:center;gap:18px;'}, [
      buildFormatButtonRow('1'),
      buildFormatButtonRow('2')
    ])
  ]);
  root.appendChild(toolbar);
  root.appendChild(buildSheetDom());
}

function buildFormatButtonRow(ft){
  return el('div', {class:'right', style:'gap:8px;align-items:center;'}, [
    el('b', {style:'color:#0f3d68;margin-right:2px;'}, ['서식'+ft+' :']),
    el('button', {class:'btn primary', onclick: ()=>printForm(ft)}, ['🖨️ 출력']),
    el('button', {class:'btn primary', onclick: (e)=>generatePdf(ft, e.currentTarget)}, ['📄 PDF저장']),
    el('button', {class:'btn primary', onclick: ()=>downloadReturnFormXlsx(ft)}, ['⬇ 엑셀저장'])
  ]);
}

function renderRawPreview(){
  const wrap = document.getElementById('rawPreviewWrap');
  const emptyHint = document.getElementById('uploadEmptyHint');
  if(!state.rawRows.length){ wrap.style.display = 'none'; emptyHint.style.display = 'block'; return; }
  emptyHint.style.display = 'none';
  wrap.style.display = 'block';
  document.getElementById('rawCount').textContent = state.rawRows.length;
  document.getElementById('itemCount').textContent = state.items.length;

  const tableWrap = document.getElementById('rawPreviewTableWrap');
  const cols = ['코드','제약사','상품명','규격','상태','수량','제조번호','사용기한','표준코드','우선처'].filter(c => state.headers.includes(c));
  const table = document.createElement('table');
  table.className = 'items';
  const thead = document.createElement('thead');
  const trh = document.createElement('tr');
  cols.forEach(c => { const th = document.createElement('th'); th.textContent = c; trh.appendChild(th); });
  thead.appendChild(trh);
  table.appendChild(thead);
  const tbody = document.createElement('tbody');
  state.rawRows.slice(0,50).forEach(r=>{
    const tr = document.createElement('tr');
    cols.forEach(c=>{ const td = document.createElement('td'); td.textContent = r[c]; tr.appendChild(td); });
    tbody.appendChild(tr);
  });
  table.appendChild(tbody);
  tableWrap.innerHTML = '';
  tableWrap.appendChild(table);
  if(state.rawRows.length > 50){
    const note = document.createElement('div');
    note.style.cssText = 'font-size:11px;color:var(--muted);margin-top:8px;';
    note.textContent = `처음 50행만 표시됩니다 (전체 ${state.rawRows.length}행 업로드됨).`;
    tableWrap.appendChild(note);
  }
}

function renderAll(){
  renderSidebar();
  renderRawPreview();
  renderFormView();
}

document.getElementById('toggleRawPreview').addEventListener('click', function(){
  const t = document.getElementById('rawPreviewTableWrap');
  const show = t.style.display === 'none';
  t.style.display = show ? 'block' : 'none';
  this.textContent = show ? '원자료 미리보기 닫기' : '원자료 미리보기 열기';
});

function doResetUpload(){
  if(!confirm('업로드한 반품 원자료(엑셀에서 불러온 품목 데이터)를 초기화할까요? 수신처·발신처 등 서식 정보는 그대로 유지됩니다.')) return;
  state.rawRows = [];
  state.headers = [];
  state.items = [];
  state.sumQty = 0;
  state.meta.recv.org = '';
  state.meta.recv.orgManual = '';
  saveState();
  renderAll();
  uploadedAt = null;
  updateUploadedLabel();
}
document.getElementById('uploadResetBtn').addEventListener('click', doResetUpload);

/* ============================================================
   엑셀 다운로드 (서식1 / 서식2 각각 단일 시트로 다운로드, 다미스코드·표준코드 포함)
   ============================================================ */
function itemsAoaRows(formatType){
  return state.items.map(it=>{
    const showNameSpec = (formatType==='1') || (it.totalForCode!==null);
    return [
      it.code, it.std,
      showNameSpec ? it.name : '',
      showNameSpec ? it.spec : '',
      it.totalForCode!==null ? it.totalForCode : '',
      it.qty, it.lot, it.exp, it.note||''
    ];
  });
}

async function downloadReturnFormXlsx(formatType){
  const m = state.meta;
  const COLS = 9;
  const THIN_LIGHT = { style:'thin', color:{ argb:'FFE3E7EF' } };
  const THIN_HEAD  = { style:'thin', color:{ argb:'FFB9C2D6' } };

  const wb = new ExcelJS.Workbook();
  const ws = wb.addWorksheet('서식'+formatType, { views: [{ state:'frozen', ySplit: 9 }] });
  ws.columns = [12,16,26,16,9,12,14,11,14].map(w=>({ width: w }));

  // 1) 제목
  ws.mergeCells(1,1,1,COLS);
  const titleCell = ws.getCell(1,1);
  titleCell.value = m.title;
  titleCell.font = { bold:true, size:16 };
  titleCell.alignment = { horizontal:'center', vertical:'middle' };
  ws.getRow(1).height = 26;

  // 2) 반품요청일
  ws.getCell(2,1).value = '반품요청일';
  ws.getCell(2,1).font = { bold:true };
  ws.getCell(2,2).value = m.date;

  // 4~7행: 수신처 / 발신처 정보
  const infoRows = [
    ['수신처', m.recv.org, '', '발신처', m.sender.org],
    ['수신인', m.recv.org + m.recv.personSuffix, '', '발신인', m.sender.person],
    ['TEL', m.recv.tel, '', 'TEL', m.sender.tel],
    ['FAX', m.recv.fax, '', 'FAX', m.sender.fax]
  ];
  infoRows.forEach((r, i)=>{
    const rowNum = 4 + i;
    r.forEach((v, ci)=>{
      const cell = ws.getCell(rowNum, ci+1);
      cell.value = v;
      if(ci===0 || ci===3) cell.font = { bold:true };
    });
  });

  // 9행: 품목 표 헤더 (다른 메뉴 엑셀저장과 동일한 스타일)
  const headerRowNum = 9;
  const headers = ['다미스코드','표준코드','제 품 명','규 격','총수량','제조번호별 수량','제조번호','유효기간','비고'];
  const headerRow = ws.getRow(headerRowNum);
  headers.forEach((h, ci)=>{
    const cell = headerRow.getCell(ci+1);
    cell.value = h;
    cell.font = { bold:true, size:11, color:{ argb:'FFFFFFFF' } };
    cell.fill = { type:'pattern', pattern:'solid', fgColor:{ argb:'FF2F5FD6' } };
    cell.alignment = { vertical:'middle', horizontal:'center' };
    cell.border = { top:THIN_HEAD, left:THIN_HEAD, bottom:THIN_HEAD, right:THIN_HEAD };
  });
  headerRow.height = 22;

  // 품목 행 (줄무늬 배경)
  const items = itemsAoaRows(formatType);
  items.forEach((r, i)=>{
    const row = ws.getRow(headerRowNum + 1 + i);
    const banded = i % 2 === 1;
    r.forEach((v, ci)=>{
      const cell = row.getCell(ci+1);
      cell.value = v;
      cell.border = { top:THIN_LIGHT, left:THIN_LIGHT, bottom:THIN_LIGHT, right:THIN_LIGHT };
      const isNum = (ci===4 || ci===5);
      cell.alignment = { vertical:'middle', horizontal: (ci===2 || ci===3) ? 'left' : 'center' };
      if(isNum) cell.numFmt = '#,##0';
      if(banded) cell.fill = { type:'pattern', pattern:'solid', fgColor:{ argb:'FFF4F6FB' } };
    });
  });

  // 합계 행
  const totalRowNum = headerRowNum + 1 + items.length;
  const totalRow = ws.getRow(totalRowNum);
  const totalVals = ['합계','','','', state.sumQty, state.sumQty,'','',''];
  totalVals.forEach((v, ci)=>{
    const cell = totalRow.getCell(ci+1);
    cell.value = v;
    cell.font = { bold:true };
    cell.border = { top:THIN_HEAD, left:THIN_LIGHT, bottom:THIN_HEAD, right:THIN_LIGHT };
    if(ci===4 || ci===5){ cell.numFmt = '#,##0'; cell.alignment = { horizontal:'center' }; }
  });

  // 안내문 / 발송처
  const footRow1 = totalRowNum + 2;
  ws.mergeCells(footRow1, 1, footRow1, COLS);
  ws.getCell(footRow1, 1).value = m.footerMsg;
  const footRow2 = footRow1 + 1;
  ws.mergeCells(footRow2, 1, footRow2, COLS);
  ws.getCell(footRow2, 1).value = '※ 발송처 : ' + m.sender.addr;

  ws.autoFilter = { from:{ row:headerRowNum, column:1 }, to:{ row:headerRowNum, column:COLS } };

  const buf = await wb.xlsx.writeBuffer();
  const blob = new Blob([buf], { type:'application/octet-stream' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = `반품신청서_서식${formatType}_${state.meta.recv.org||'미지정'}_${state.meta.date}.xlsx`;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

/* ============================================================
   인쇄 / PDF (실측 기반 자동 페이지네이션)
   화면에 보이지 않는 곳에 실제 인쇄용 요소를 그대로 그려본 뒤,
   각 블록(제목/거래처정보, 표 머리글, 각 행, 합계, 안내문·발송처·직인, 쪽번호)의
   실제 렌더링 높이를 측정해서 A4 한 장(297mm - 상하 여백 20mm)에
   들어가는 만큼만 채우고 넘치면 다음 장으로 넘깁니다.
   발송처 주소가 길어지거나 품명이 줄바꿈되는 등 내용 길이가 달라져도
   페이지가 넘치거나 잘리지 않도록 고정된 행수 추정을 쓰지 않습니다.
   ============================================================ */
function mmToPx(mm){
  const probe = document.createElement('div');
  probe.style.cssText = `position:fixed;visibility:hidden;height:${mm}mm;width:0;left:-99999px;top:0;`;
  document.body.appendChild(probe);
  const px = probe.getBoundingClientRect().height;
  document.body.removeChild(probe);
  return px;
}

function buildPrintContactBlock(m){
  const grid = el('div', {class:'print-contact'});
  const recvCol = el('div', {class:'pcol'});
  [
    ['수신처', m.recv.org],
    ['수신인', m.recv.org + m.recv.personSuffix],
    ['TEL', m.recv.tel],
    ['FAX', m.recv.fax]
  ].forEach(([k,v])=>{
    const row = el('div', {class:'prow'});
    row.appendChild(el('span', {class:'k'}, [k]));
    row.appendChild(el('span', {}, [':']));
    row.appendChild(el('span', {}, [v||'']));
    recvCol.appendChild(row);
  });
  grid.appendChild(recvCol);

  const sendCol = el('div', {class:'pcol'});
  [
    ['발신처', m.sender.org],
    ['발신인', m.sender.person],
    ['TEL', m.sender.tel],
    ['FAX', m.sender.fax]
  ].forEach(([k,v])=>{
    const row = el('div', {class:'prow'});
    row.appendChild(el('span', {class:'k'}, [k]));
    row.appendChild(el('span', {}, [':']));
    row.appendChild(el('span', {}, [v||'']));
    sendCol.appendChild(row);
  });
  grid.appendChild(sendCol);
  return grid;
}

function buildItemsTable(items, formatType, withTotal){
  const table = el('table', {class:'p-items'});
  const headers = ['제 품 명','규 격','총수량','제조번호별\n수량','제조번호','유효기간','비고'];
  table.appendChild(el('thead', {}, [el('tr', {}, headers.map(h=>el('th', {}, [h])))]));
  const tbody = el('tbody');
  items.forEach(it=>{
    const showNameSpec = (formatType==='1') || (it.totalForCode!==null);
    const tr = el('tr');
    tr.appendChild(el('td', {class:'pname'}, [showNameSpec ? it.name : '']));
    tr.appendChild(el('td', {}, [showNameSpec ? it.spec : '']));
    tr.appendChild(el('td', {class:'p-etotal'}, [it.totalForCode!==null ? fmtNum(it.totalForCode) : '']));
    tr.appendChild(el('td', {}, [fmtNum(it.qty)]));
    tr.appendChild(el('td', {}, [it.lot]));
    tr.appendChild(el('td', {}, [it.exp]));
    tr.appendChild(el('td', {}, [it.note||'']));
    tbody.appendChild(tr);
  });
  if(withTotal){
    const totalTr = el('tr', {class:'p-total'});
    totalTr.appendChild(el('td', {colspan:'2'}, ['합계']));
    totalTr.appendChild(el('td', {}, [fmtNum(state.sumQty)]));
    totalTr.appendChild(el('td', {}, [fmtNum(state.sumQty)]));
    totalTr.appendChild(el('td', {colspan:'3'}, ['']));
    tbody.appendChild(totalTr);
  }
  table.appendChild(tbody);
  return table;
}

function buildFooterBlock(m){
  const wrap = el('div');
  wrap.appendChild(el('div', {class:'p-footer-msg'}, [m.footerMsg]));
  wrap.appendChild(el('div', {class:'p-footer-addr'}, ['※ 발송처 : ' + m.sender.addr]));
  const sealRow = el('div', {class:'p-seal-row'});
  sealRow.appendChild(el('img', {src: SEAL_IMG_SRC, alt:'상호인'}));
  wrap.appendChild(sealRow);
  return wrap;
}

function buildPrintPage(pageInfo, pageNum, totalPages, formatType){
  const m = state.meta;
  const isFirst = pageInfo.isFirst;
  const isLast = pageInfo.isLast;
  const page = el('div', {class:'print-page'});
  if(isFirst){
    page.appendChild(el('div', {class:'rt-p-title'}, [m.title]));
    page.appendChild(el('div', {class:'p-date'}, ['반품요청일 : ' + m.date]));
    page.appendChild(buildPrintContactBlock(m));
  }
  page.appendChild(buildItemsTable(pageInfo.items, formatType, isLast));
  if(isLast){
    page.appendChild(buildFooterBlock(m));
  }
  page.appendChild(el('div', {class:'p-pagenum'}, [`${totalPages}페이지 중 ${pageNum}페이지`]));
  return page;
}

/* 실제 인쇄와 동일한 요소를 화면 밖(왼쪽 -99999px)에 그려서 각 블록의 실제 높이를 잰다 */
function measurePrintLayout(items, formatType){
  const m = state.meta;
  const root = el('div', {style:'position:fixed;left:-99999px;top:0;visibility:hidden;'});
  document.body.appendChild(root);
  const measurePage = el('div', {class:'print-page', style:'min-height:0;'});
  root.appendChild(measurePage);

  // 1) 상단 제목+거래처 정보 블록 (1페이지에만 들어감)
  const headerBlock = el('div', {}, [
    el('div', {class:'rt-p-title'}, [m.title]),
    el('div', {class:'p-date'}, ['반품요청일 : ' + m.date]),
    buildPrintContactBlock(m)
  ]);
  measurePage.appendChild(headerBlock);
  const headerHeight = headerBlock.getBoundingClientRect().height;
  measurePage.removeChild(headerBlock);

  // 2) 표 머리글 높이
  const theadTable = buildItemsTable([], formatType, false);
  measurePage.appendChild(theadTable);
  const theadHeight = theadTable.querySelector('thead').getBoundingClientRect().height;
  measurePage.removeChild(theadTable);

  // 3) 쪽번호 줄 높이
  const pageNumEl = el('div', {class:'p-pagenum'}, ['1페이지 중 1페이지']);
  measurePage.appendChild(pageNumEl);
  const pageNumHeight = pageNumEl.getBoundingClientRect().height;
  measurePage.removeChild(pageNumEl);

  // 4) 안내문 + 발송처 + 직인 블록 높이 (실제 입력된 발송처 주소 길이를 그대로 반영)
  const footerBlock = buildFooterBlock(m);
  measurePage.appendChild(footerBlock);
  const footerHeight = footerBlock.getBoundingClientRect().height;
  measurePage.removeChild(footerBlock);

  // 5) 합계 행 높이
  const totalOnlyTable = buildItemsTable([], formatType, true);
  measurePage.appendChild(totalOnlyTable);
  const totalRowHeight = totalOnlyTable.querySelector('tr.p-total').getBoundingClientRect().height;
  measurePage.removeChild(totalOnlyTable);

  // 6) 각 품목 행 높이 (품명이 길어서 줄바꿈되는 경우도 실제 높이 그대로 측정)
  const fullTable = buildItemsTable(items, formatType, false);
  measurePage.appendChild(fullTable);
  const rowHeights = Array.from(fullTable.querySelectorAll('tbody tr')).map(tr => tr.getBoundingClientRect().height);
  measurePage.removeChild(fullTable);

  document.body.removeChild(root);

  // A4 한 장의 실제 사용 가능 높이(상하 여백 10mm씩 제외) - 약간의 여유(버퍼) 확보
  const buffer = 20;
  const pageContentHeight = mmToPx(297 - 10*2) - buffer;

  return { headerHeight, theadHeight, pageNumHeight, footerHeight, totalRowHeight, rowHeights, pageContentHeight };
}

function paginateItems(items, formatType){
  if(items.length === 0){
    return [{ items: [], isFirst:true, isLast:true }];
  }
  const L = measurePrintLayout(items, formatType);
  // 페이지번호가 용지 밑에서 5mm 위치에 절대 고정되므로, 표 내용이 그 영역과
  // 겹치지 않도록 페이지번호 실제 높이 + 5mm 여유를 예약해둡니다.
  const pageNumReserved = L.pageNumHeight + mmToPx(5);
  const availableFirst = L.pageContentHeight - L.headerHeight - L.theadHeight - pageNumReserved;
  const availableOther = L.pageContentHeight - L.theadHeight - pageNumReserved;
  const neededForFooter = L.totalRowHeight + L.footerHeight;
  const n = items.length;

  // 1) 표(품목 행)를 채우는 것을 최우선으로 합니다 — 합계·안내문·발송처·직인이
  //    같이 들어갈 자리를 미리 걱정하지 않고, 각 페이지에 최대한 많은 행을 채웁니다.
  const ranges = [];
  let idx = 0;
  while(idx < n){
    const isFirstPage = ranges.length === 0;
    const avail = isFirstPage ? availableFirst : availableOther;
    let used = 0, count = 0;
    while(idx + count < n){
      const rh = L.rowHeights[idx + count];
      if(used + rh > avail){
        if(count === 0){ used += rh; count = 1; } // 한 행조차 안 들어가면 그래도 최소 1행은 배치(무한루프 방지)
        break;
      }
      used += rh; count++;
    }
    if(count === 0) count = 1;
    ranges.push({ start: idx, end: idx + count, used });
    idx += count;
  }

  // 2) 표를 다 채운 뒤에, 마지막 페이지에 합계·안내문·발송처·직인이 들어갈 자리가
  //    남아있는지 확인합니다. 자리가 없으면 이미 채운 품목 행은 그대로 두고,
  //    합계·안내문·직인만 담을 새 페이지를 하나 더 추가합니다(품목 행은 옮기지 않음).
  const lastRange = ranges[ranges.length - 1];
  const lastIsFirstPage = ranges.length === 1;
  const lastAvail = lastIsFirstPage ? availableFirst : availableOther;
  const footerFitsOnLastPage = (lastRange.used + neededForFooter) <= lastAvail;
  if(!footerFitsOnLastPage){
    ranges.push({ start: n, end: n, used: 0 });
  }

  const total = ranges.length;
  return ranges.map((r, i) => ({
    items: items.slice(r.start, r.end),
    isFirst: i === 0,
    isLast: i === total - 1
  }));
}

function printForm(formatType){
  const printArea = document.getElementById('printArea');
  printArea.innerHTML = '';
  const pages = paginateItems(state.items, formatType);
  const total = pages.length;
  pages.forEach((pageInfo, idx)=>{
    printArea.appendChild(buildPrintPage(pageInfo, idx+1, total, formatType));
  });
  window.print();
}

/* PDF저장 버튼: 인쇄창을 거치지 않고 바로 PDF 파일로 다운로드합니다.
   (각 페이지를 화면 밖에 그려서 html2canvas로 캡처한 뒤 jsPDF로 이어붙입니다) */
async function generatePdf(formatType, btn){
  const originalLabel = btn ? btn.textContent : null;
  if(btn){ btn.disabled = true; btn.textContent = 'PDF 생성 중…'; }

  const printArea = document.getElementById('printArea');
  printArea.innerHTML = '';
  const pages = paginateItems(state.items, formatType);
  const total = pages.length;
  pages.forEach((pageInfo, idx)=>{
    printArea.appendChild(buildPrintPage(pageInfo, idx+1, total, formatType));
  });

  // html2canvas가 캡처할 수 있도록 화면 밖(사용자 눈에는 보이지 않는 위치)에 실제 레이아웃으로 그려둡니다.
  printArea.style.cssText = 'display:block; position:fixed; left:-99999px; top:0; background:#fff;';

  try{
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF({ unit:'mm', format:'a4', orientation:'portrait' });
    const pageEls = Array.from(printArea.querySelectorAll('.print-page'));
    for(let i=0; i<pageEls.length; i++){
      const canvas = await html2canvas(pageEls[i], { scale:2, useCORS:true, backgroundColor:'#ffffff' });
      const imgData = canvas.toDataURL('image/jpeg', 0.95);
      if(i > 0) doc.addPage();
      doc.addImage(imgData, 'JPEG', 0, 0, 210, 297);
    }
    doc.save(`반품신청서_서식${formatType}_${state.meta.recv.org||'미지정'}_${state.meta.date}.pdf`);
  } catch(err){
    console.error(err);
    alert('PDF 생성 중 오류가 발생했습니다. 다시 시도해 주세요.');
  } finally {
    printArea.style.cssText = '';
    printArea.innerHTML = '';
    if(btn){ btn.disabled = false; btn.textContent = originalLabel; }
  }
}

/* ============================================================
   초기화
   ============================================================ */
loadState();
computeItems();
renderAll();

})();
</script>
</body>
</html>
