  // (엑셀 '통합' 시트가 이 값들로 매출액·재고·파손재고를 계산하는 수식을 그대로 재현하기 위한 원자재입니다.)
  stockGJ: { sheetNames: ['우선처별 재고 및 매입실적-당월(광주)','우선처별 재고 및 매입실적 당월(광주)','우선처별 재고 및 매입실적-전월(광주)','우선처별 재고 및 매입실적 전월(광주)','우선처별 재고 및 매입실적(광주)','우선처별 재고 및 매입실적 광주'], sheetKeyword: '광주', storageKey: 'stockout_dashboard_upload_stockGJ_v1', label: '우선처별 재고 및 매입실적-광주',
                 essentialColumns: { colIndexes: [0,1,5,8,9,10,11,12,13,14,15,16], labels: ['코드','우선처명','純매출금액','재고액합계','가용재고금액','파손재고금액','잔고','잔고%','보상입고','미착殘','선입殘','선출殘'] } },
  stockEJ: { sheetNames: ['우선처별 재고 및 매입실적-당월(의정부)','우선처별 재고 및 매입실적 당월(의정부)','우선처별 재고 및 매입실적-전월(의정부)','우선처별 재고 및 매입실적 전월(의정부)','우선처별 재고 및 매입실적(의정부)','우선처별 재고 및 매입실적 의정부'], sheetKeyword: '의정부', storageKey: 'stockout_dashboard_upload_stockEJ_v1', label: '우선처별 재고 및 매입실적-의정부',
                 essentialColumns: { colIndexes: [0,1,5,8,9,10,11,12,13,14,15,16], labels: ['코드','우선처명','純매출금액','재고액합계','가용재고금액','파손재고금액','잔고','잔고%','보상입고','미착殘','선입殘','선출殘'] } },
  returnmgr:   { sheetNames: ['반품담당자'], storageKey: 'stockout_dashboard_upload_returnmgr_v1', label: '반품담당자', headerHint: '반품담당자' },
